        ns1:MetricMultipleUnit ;
    skos:altLabel "DekaPrefixedUnit"@en ;
    skos:prefLabel "DecaPrefixedUnit"@en ;
    ns1:elucidation "Superclass for all units prefixed with \"deca\" (10)."@en .


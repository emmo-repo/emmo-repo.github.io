            owl:hasValue "R"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Ronna"@en ;
    ns1:elucidation "SI prefix who's value is 1e27."@en .

ns1:Ronto a owl:Class ;
    rdfs:label "Ronto"@en ;

@prefix : <https://w3id.org/emmo/hume/disciplines/units/siunits#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/emmo#> .
@prefix ns2: <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 a owl:AnnotationProperty ;
    rdfs:label "unitSymbol"@en ;
    rdfs:domain ns1:MeasurementUnit ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:comment ;
    owl:deprecated true ;
    skos:prefLabel "unitSymbol"@en ;
    ns1:elucidation "The standard symbol for a unit."@en ;
    ns1:note "A unit symbol may be a symbolic construct (e.g. km) or a symbol (e.g. m)."@en .

ns1:NonSISpecialUnit a owl:Class ;
    rdfs:label "NonSISpecialUnit"@en ;
    rdfs:subClassOf ns1:NonSIUnit,
        ns1:SpecialUnit ;
    skos:prefLabel "NonSISpecialUnit"@en ;
    ns1:elucidation "A special unit that does not belong to the SI system."@en .

ns1:SIMetricPrefixedUnit a owl:Class ;
    rdfs:label "SIMetricPrefixedUnit"@en ;
    rdfs:subClassOf ns1:MetricPrefixedUnit,
        ns1:SINonCoherentUnit ;
    owl:disjointWith ns1:SINonCoherentDerivedUnit ;
    skos:prefLabel "SIMetricPrefixedUnit"@en ;
    ns1:elucidation "A SI base unit or SI derived unit with a metric prefix."@en .

ns1:hasPrefixSymbol a owl:DatatypeProperty ;
    rdfs:label "hasPrefixSymbol"@en ;
    ns2:python_name "hasPrefixSymbol"@en ;
    rdfs:domain ns1:MetricPrefixedUnit ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:prefLabel "hasPrefixSymbol"@en ;
    ns1:elucidation "Relates a SI prefixed unit to the prefix symbol."@en .

ns1:hasSIConversionMultiplier a owl:DatatypeProperty ;
    rdfs:label "hasSIConversionMultiplier"@en ;
    ns2:python_name "hasSIConversionMultiplier"@en ;
    rdfs:domain ns1:MeasurementUnit ;
    rdfs:range xsd:double ;
    skos:prefLabel "hasSIConversionMultiplier"@en ;
    ns1:elucidation "Number to multiply a SI coherent unit with when converting to a given non-SI coherent unit."@en ;
    ns1:note """Conversion formula:

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset"""@en .

ns1:hasSIConversionOffset a owl:DatatypeProperty ;
    rdfs:label "hasSIConversionOffset"@en ;
    ns2:python_name "hasSIConversionOffset"@en ;
    rdfs:domain ns1:MeasurementUnit ;
    rdfs:range xsd:double ;
    skos:prefLabel "hasSIConversionOffset"@en ;
    ns1:elucidation "Number to add to a SI coherent unit when converting to a given non-SI coherent unit."@en ;
    ns1:note """Conversion formula:

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset"""@en .

ns1:unitSymbol a owl:AnnotationProperty ;
    rdfs:label "unitSymbol"@en ;
    rdfs:domain ns1:MeasurementUnit ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:prefLabel "unitSymbol"@en ;
    ns1:elucidation "The standard symbol for a unit."@en ;
    ns1:note "A unit symbol may be a symbolic construct (e.g. km) or a symbol (e.g. m)."@en .

: a owl:Ontology ;
    dcterms:abstract """The module 'siunits' defines the 7 base units and 22 derived units as well as the metric prefixes specified in the SI system.

All other SI units goes into one of the following modules:
- prefixedsiunits: SI units made of a metric prefix and a SI base, derived or accepted unit. Examples: km, mg...
- coherentsiunits: Coherent SI-units. Products of integer powers of the base and derived SI units. Examples: A/J, Nm, m³, ...
- noncoherentsiunits: Non-coherent SI-units whos numerical factor in front of the product of base SI units is NOT equal to one. This include all SI-units not included in the modules above. Examples: g, mg/s..."""@en ;
    dcterms:contributor <https://orcid.org/GerhardGoldbeck>,
        <https://orcid.org/SimonClark> ;
    dcterms:creator <https://orcid.org/EmanueleGhedini>,
        <https://orcid.org/JesperFriis> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "SI units"@en ;
    rdfs:comment "The EMMO should be reasoned with HermiT to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.1.0/disciplines/metrology>,
        <https://w3id.org/emmo/1.1.0/disciplines/units/sidimensionalunits> ;
    owl:versionIRI <https://w3id.org/emmo/1.1.0/hume/disciplines/units/siunits> ;
    owl:versionInfo "1.1.0"^^xsd:string ;
    ns1:contact "emmo@emmc.eu"^^xsd:string .

ns1:AttoPrefixedUnit a owl:Class ;
    rdfs:label "AttoPrefixedUnit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasMetricPrefix ;
            owl:someValuesFrom ns1:Atto ],
        [ a owl:Restriction ;
            owl:hasValue 1e-18 ;
            owl:onProperty ns1:hasPrefixMultiplier ],
        ns1:MetricSubMultipleUnit ;
    skos:prefLabel "AttoPrefixedUnit"@en ;
    ns1:elucidation "Superclass for all units prefixed with \"atto\" (1e-18)."@en .

ns1:CentiPrefixedUnit a owl:Class ;
    rdfs:label "CentiPrefixedUnit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e-02 ;
            owl:onProperty ns1:hasPrefixMultiplier ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasMetricPrefix ;
            owl:someValuesFrom ns1:Centi ],
        ns1:MetricSubMultipleUnit ;
    skos:prefLabel "CentiPrefixedUnit"@en ;
    ns1:elucidation "Superclass for all units prefixed with \"centi\" (0.01)."@en .


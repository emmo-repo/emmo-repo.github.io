            owl:hasValue "Q"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Quetta"@en ;
    ns1:elucidation "SI prefix who's value is 1e30."@en .

ns1:Ronna a owl:Class ;

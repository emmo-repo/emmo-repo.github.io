ns1:Mega a owl:Class ;
    rdfs:label "Mega"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e+06 ;
            owl:onProperty ns1:numberValue ],
        [ a owl:Restriction ;
            owl:hasValue "M"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Mega"@en ;
    ns1:elucidation "SI prefix who's value is 1e6."@en .

ns1:Micro a owl:Class ;
    rdfs:label "Micro"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e-06 ;
            owl:onProperty ns1:numberValue ],
        [ a owl:Restriction ;
            owl:hasValue "μ"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Micro"@en ;
    ns1:elucidation "SI prefix who's value is 1e-6."@en .

ns1:Milli a owl:Class ;
    rdfs:label "Milli"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e-03 ;
            owl:onProperty ns1:numberValue ],
        [ a owl:Restriction ;
            owl:hasValue "m"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Milli"@en ;
    ns1:elucidation "SI prefix who's value is 1/1000."@en .

ns1:Nano a owl:Class ;
    rdfs:label "Nano"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "n"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        [ a owl:Restriction ;
            owl:hasValue 1e-09 ;
            owl:onProperty ns1:numberValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Nano"@en ;
    ns1:elucidation "SI prefix who's value is 1e-9."@en .

ns1:Peta a owl:Class ;
    rdfs:label "Peta"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e+15 ;
            owl:onProperty ns1:numberValue ],
        [ a owl:Restriction ;
            owl:hasValue "P"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Peta"@en ;
    ns1:elucidation "SI prefix who's value is 1e15."@en .

ns1:Pico a owl:Class ;
    rdfs:label "Pico"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "p"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        [ a owl:Restriction ;
            owl:hasValue 1e-12 ;
            owl:onProperty ns1:numberValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Pico"@en ;
    ns1:elucidation "SI prefix who's value is 1e-12."@en .

ns1:SIDerivedUnit a owl:Class ;
    rdfs:label "SIDerivedUnit"@en ;
    rdfs:subClassOf ns1:DerivedUnit,
        ns1:SIUnit ;
    skos:prefLabel "SIDerivedUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: SICoherentDerivedUnit, SINonCoherentDerivedUnit"^^xsd:string ;
    ns1:elucidation "A derived unit that belongs to the SI system."@en .

ns1:SINonCoherentDerivedUnit a owl:Class ;
    rdfs:label "SINonCoherentDerivedUnit"@en ;
    rdfs:subClassOf ns1:SIDerivedUnit,
        ns1:SINonCoherentUnit ;
    skos:example "cm/s"^^xsd:string ;
    skos:prefLabel "SINonCoherentDerivedUnit"@en ;
    ns1:elucidation "A derived unit whos numerical factor in front of the product of base units is NOT equal to one."@en .

ns1:SINonCoherentUnit a owl:Class ;
    rdfs:label "SINonCoherentUnit"@en ;
    rdfs:subClassOf ns1:SIUnit ;
    skos:prefLabel "SINonCoherentUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: SIMetricPrefixedUnit, SINonCoherentDerivedUnit"^^xsd:string ;
    ns1:elucidation "An SI unit whos numerical factor in front of the product of base SI units is NOT equal to one."@en ;
    ns1:note """A non-SI coherent can be expressed in terms of its corresponding SI coherent unit, as

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset

where `multiplier` and `offset` are specified via the 'hasConversionMultiplier' and 'hasConversionOffset' data properties, respectively."""@en .

ns1:SIPrefix a owl:Class ;
    rdfs:label "SIPrefix"@en ;
    rdfs:subClassOf ns1:MetricPrefix ;
    skos:prefLabel "SIPrefix"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: SIMultiplePrefix, SISubMultiplePrefix"^^xsd:string ;
    ns1:elucidation "Metric prefix defined in the SI system."@en .

ns1:SIUnitSymbol a owl:Class ;
    rdfs:label "SIUnitSymbol"@en ;
    rdfs:subClassOf ns1:UnitSymbol ;
    skos:prefLabel "SIUnitSymbol"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: SIBaseUnit, SISpecialUnit"^^xsd:string ;
    ns1:elucidation "A unit symbol that belongs to the SI system. Is either a SI base unit or a SI special unit."@en .

ns1:Tera a owl:Class ;
    rdfs:label "Tera"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e+12 ;
            owl:onProperty ns1:numberValue ],
        [ a owl:Restriction ;
            owl:hasValue "T"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Tera"@en ;
    ns1:elucidation "SI prefix who's value is 1e12."@en .

ns1:Yocto a owl:Class ;
    rdfs:label "Yocto"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "y"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        [ a owl:Restriction ;
            owl:hasValue 1e-24 ;
            owl:onProperty ns1:numberValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Yocto"@en ;
    ns1:elucidation "SI prefix who's value is 1e-24."@en .

ns1:Yotta a owl:Class ;
    rdfs:label "Yotta"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "Y"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        [ a owl:Restriction ;
            owl:hasValue 1e+24 ;
            owl:onProperty ns1:numberValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Yotta"@en ;
    ns1:elucidation "SI prefix who's value is 1e24."@en .

ns1:Zepto a owl:Class ;
    rdfs:label "Zepto"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1e-21 ;
            owl:onProperty ns1:numberValue ],
        [ a owl:Restriction ;
            owl:hasValue "z"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Zepto"@en ;
    ns1:elucidation "SI prefix who's value is 1e-21."@en .

ns1:Zetta a owl:Class ;
    rdfs:label "Zetta"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "Z"^^xsd:string ;
            owl:onProperty ns1:unitSymbolValue ],
        [ a owl:Restriction ;
            owl:hasValue 1e-21 ;
            owl:onProperty ns1:numberValue ],
        ns1:SIMultiplePrefix ;
    skos:prefLabel "Zetta"@en ;
    ns1:elucidation "SI prefix who's value is 1e21."@en .

ns1:SICoherentUnit a owl:Class ;
    rdfs:label "SICoherentUnit"@en ;
    rdfs:subClassOf ns1:SIUnit ;
    skos:prefLabel "SICoherentUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: SICoherentDerivedUnit, SIBaseUnit, SISpecialUnit"^^xsd:string ;
    ns1:elucidation "A unit that can be expressed as a product of powers of SI base units with no pre-factor or offset."@en ;
    ns1:note "Derived units are defined as products of powers of the base units. When the numerical factor of this product is one, the derived units are called coherent derived units. The base and coherent derived units of the SI form a coherent set, designated the set of coherent SI units."@en .

ns1:MetricPrefixedUnit a owl:Class ;
    rdfs:label "MetricPrefixedUnit"@en ;
    rdfs:comment "The presence of the prefix makes this units non-coherent with SI system."@en ;
    rdfs:subClassOf ns1:PrefixedUnit ;
    skos:prefLabel "MetricPrefixedUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: MetricMultipleUnit, MetricSubMultipleUnit"^^xsd:string ;
    ns1:elucidation "A special unit with a metric prefix."@en .

ns1:SIUnit a owl:Class ;
    rdfs:label "SIUnit"@en ;
    rdfs:comment "The complete set of SI units includes both the coherent set and the multiples and sub-multiples formed by using the SI prefixes."@en,
        """The names, symbols and prefixes of SI units are defined by the General Conference on Weights and Measures (CGPM).

https://en.wikipedia.org/wiki/General_Conference_on_Weights_and_Measures"""@en ;
    rdfs:subClassOf ns1:SystemUnit ;
    skos:prefLabel "SIUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: SICoherentDerivedUnit, SIMetricPrefixedUnit, SIBaseUnit, SINonCoherentDerivedUnit, SISpecialUnit"^^xsd:string ;
    ns1:elucidation "The set of units provided by the SI referring to the ISQ."@en .

ns1:MetricMultipleUnit a owl:Class ;
    rdfs:label "MetricMultipleUnit"@en ;
    rdfs:subClassOf ns1:MetricPrefixedUnit ;
    owl:disjointWith ns1:MetricSubMultipleUnit ;
    skos:prefLabel "MetricMultipleUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: DecaPrefixedUnit, HectoPrefixedUnit, TeraPrefixedUnit, PetaPrefixedUnit, ExaPrefixedUnit, MegaPrefixedUnit, KiloPrefixedUnit, GigaPrefixedUnit, ZettaPrefixedUnit, YottaPrefixedUnit"^^xsd:string ;
    ns1:elucidation "Measurement unit obtained by multiplying a given measurement unit by an integer SI prefix greater than one."@en .

ns1:MetricSubMultipleUnit a owl:Class ;
    rdfs:label "MetricSubMultipleUnit"@en ;
    rdfs:subClassOf ns1:MetricPrefixedUnit ;
    skos:prefLabel "MetricSubMultipleUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: PicoPrefixedUnit, DeciPrefixedUnit, FemtoPrefixedUnit, ZeptoPrefixedUnit, AttoPrefixedUnit, MicroPrefixedUnit, MilliPrefixedUnit, CentiPrefixedUnit, NanoPrefixedUnit, YoctoPrefixedUnit"^^xsd:string ;
    ns1:elucidation "Measurement unit obtained by dividing a given measurement unit by an integer SI prefix greater than one."@en .

ns1:SIMultiplePrefix a owl:Class ;
    rdfs:label "SIMultiplePrefix"@en ;
    rdfs:subClassOf ns1:SIPrefix ;
    owl:disjointWith ns1:SISubMultiplePrefix ;
    skos:prefLabel "SIMultiplePrefix"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: Giga, Tera, Exa, Hecto, Kilo, Mega, Ronna, Yotta, Peta, Quetta, Deca, Zetta"^^xsd:string ;
    ns1:elucidation "SI prefix who's value is a positive integer larger than 1."@en .

ns1:SISubMultiplePrefix a owl:Class ;
    rdfs:label "SISubMultiplePrefix"@en ;
    rdfs:subClassOf ns1:SIPrefix ;
    skos:prefLabel "SISubMultiplePrefix"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: Centi, Pico, Milli, Zepto, Quecto, Micro, Yocto, Femto, Deci, Nano, Atto, Ronto"^^xsd:string ;
    ns1:elucidation "SI prefix who's value is 1/N where N is a positive integer larger than 1."@en .

ns1:hasPrefixMultiplier a owl:DatatypeProperty ;
    rdfs:label "hasPrefixMultiplier"@en ;
    ns2:python_name "hasPrefixMultiplier"@en ;
    rdfs:domain ns1:PrefixedUnit ;
    rdfs:range xsd:double ;
    skos:prefLabel "hasPrefixMultiplier"@en ;
    ns1:elucidation "Relates a SI prefixed unit to the multiplication factor corresponding to the prefix."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Giga ns1:Tera ns1:Exa ns1:Hecto ns1:Kilo ns1:Mega ns1:Ronna ns1:Yotta ns1:Peta ns1:Quetta ns1:Deca ns1:Zetta ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:PicoPrefixedUnit ns1:DeciPrefixedUnit ns1:FemtoPrefixedUnit ns1:ZeptoPrefixedUnit ns1:AttoPrefixedUnit ns1:MicroPrefixedUnit ns1:MilliPrefixedUnit ns1:CentiPrefixedUnit ns1:NanoPrefixedUnit ns1:YoctoPrefixedUnit ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:DecaPrefixedUnit ns1:HectoPrefixedUnit ns1:TeraPrefixedUnit ns1:PetaPrefixedUnit ns1:ExaPrefixedUnit ns1:MegaPrefixedUnit ns1:KiloPrefixedUnit ns1:GigaPrefixedUnit ns1:ZettaPrefixedUnit ns1:YottaPrefixedUnit ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:SICoherentDerivedUnit ns1:SIBaseUnit ns1:SISpecialUnit ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Centi ns1:Pico ns1:Milli ns1:Zepto ns1:Quecto ns1:Micro ns1:Yocto ns1:Femto ns1:Deci ns1:Nano ns1:Atto ns1:Ronto ) .


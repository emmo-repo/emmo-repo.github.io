    skos:prefLabel "Ronto"@en ;
    ns1:elucidation "SI prefix who's value is 1e-27."@en .

ns1:SIBaseUnit a owl:Class ;
    rdfs:label "SIBaseUnit"@en ;
    rdfs:seeAlso "https://www.bipm.org/utils/common/pdf/si-brochure/SI-Brochure-9-EN.pdf"^^xsd:string ;
    rdfs:subClassOf ns1:BaseUnit,
        ns1:SICoherentUnit,
        ns1:SIUnitSymbol ;
    skos:prefLabel "SIBaseUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: Ampere, Candela, Kelvin, Kilogram, Metre, Mole, Second"^^xsd:string ;
    ns1:elucidation "The base units in the SI system."@en .

ns1:SICoherentDerivedUnit a owl:Class ;
    rdfs:label "SICoherentDerivedUnit"@en ;
    rdfs:comment "This class collects all units that are products or powers of SI base or SI special units only."@en ;
    rdfs:subClassOf ns1:SICoherentUnit,
        ns1:SIDerivedUnit ;
    owl:disjointWith ns1:SINonCoherentDerivedUnit ;
    skos:example """m/s
kg/m^3"""^^xsd:string ;
    skos:prefLabel "SICoherentDerivedUnit"@en ;
    ns1:elucidation "A SI derived unit whos numerical factor in front of the product of SI base units is one."@en .

ns1:SISpecialUnit a owl:Class ;
    rdfs:label "SISpecialUnit"@en ;
    rdfs:subClassOf ns1:SICoherentUnit,
        ns1:SIUnitSymbol,
        ns1:SpecialUnit ;
    skos:prefLabel "SISpecialUnit"@en ;
    ns1:OWLRL2DLAxioms "disjointUnionOf: Becquerel, Coulomb, DegreeCelsius, Farad, Gray, Henry, Hertz, Joule, Katal, Lumen, Lux, Newton, Ohm, Pascal, Radian, Siemens, Sievert, Steradian, Tesla, Volt, Watt, Weber"^^xsd:string ;
    ns1:elucidation "The 22 derived units that are given a special name in the SI system that stands for units derived by SI base units."@en ;
    ns1:note "These units are SI coherent by definition."@en ;
    ns1:wikipediaReference "https://en.wikipedia.org/wiki/International_System_of_Units#Derived_units"^^xsd:string .

ns1:TeraPrefixedUnit a owl:Class ;
    rdfs:label "TeraPrefixedUnit"@en ;

            owl:onProperty ns1:numberValue ],
        ns1:SISubMultiplePrefix ;
    skos:prefLabel "Quecto"@en ;
    ns1:elucidation "SI prefix who's value is 1e-30."@en .

ns1:Quetta a owl:Class ;
    rdfs:label "Quetta"@en ;

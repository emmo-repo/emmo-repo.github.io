@prefix : <https://w3id.org/emmo/hume/disciplines/metrology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#> .
@prefix ns2: <https://w3id.org/emmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

schema:unitCode a owl:AnnotationProperty ;
    rdfs:domain ns2:MeasurementUnit ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://schema.org/unitCode"^^xsd:string,
        "The normative list of all codes is available at http://www.unece.org/fileadmin/DAM/cefact/recommendations/rec20/rec20_Rev9e_2014.xls"@en ;
    rdfs:subPropertyOf ns2:metrologyReference ;
    ns2:elucidation "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL."@en ;
    ns2:note "Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon."@en,
        "The UN/CEFACT Recommendation 20 provides three character alphabetic and alphanumeric codes for representing units of measurement for length, area, volume/capacity, mass (weight), time, and other quantities used in international trade. The codes are intended for use in manual and/or automated systems for the exchange of information between participants in international trade."@en .

ns2:Assigned a owl:Class ;
    rdfs:label "Assigned"@en ;
    rdfs:subClassOf ns2:Estimated ;
    skos:example "Input parameter to a model that has been assigned by a modeller (agent)."@en ;
    skos:prefLabel "Assigned"@en ;
    ns2:elucidation "An estimated that has been assigned by an agent."@en .

ns2:Assigner a owl:Class ;
    rdfs:label "Assigner"@en ;
    rdfs:subClassOf ns2:Estimator ;
    skos:example "I estimate the molecular mass of the gas in my bottle as 1.00784 u because it is tagged as H."@en ;
    skos:prefLabel "Assigner"@en ;
    ns2:elucidation "A estimator that uses its predefined knowledge to declare a property of an object."@en .

ns2:Assignment a owl:Class ;
    rdfs:label "Assignment"@en ;
    rdfs:subClassOf ns2:Estimation ;
    skos:example "The Argon gas in my bottle has ionisation energy of 15.7596 eV. This is not measured but assigned to this material by previous knowledge."@en ;
    skos:prefLabel "Assignment"@en ;
    ns2:elucidation "A estimation of a property by a criteria based on the pre-existing knowledge of the estimator."@en .

ns2:CategorizedPhysicalQuantity a owl:Class ;
    rdfs:label "CategorizedPhysicalQuantity"@en ;
    rdfs:seeAlso "https://physics.nist.gov/cuu/Constants"^^xsd:string ;
    rdfs:subClassOf ns2:PhysicalQuantity ;
    skos:prefLabel "CategorizedPhysicalQuantity"@en ;
    ns2:elucidation "The superclass for all physical quantities classes that are categorized according to some domain of interests (e.g. metallurgy, chemistry), property (intensive/extensive) or application."@en .

ns2:Coded rdfs:label "Coded"@en .

ns2:CodedByObservation rdfs:label "CodedByObservation"@en .

ns2:CodedByStructure rdfs:label "CodedByStructure"@en .

ns2:CodedBySubjectivity rdfs:label "CodedBySubjectivity"@en .

ns2:Conventional rdfs:label "Conventional"@en .

ns2:CountingUnit a owl:Class ;
    rdfs:label "CountingUnit"@en ;
    rdfs:subClassOf ns2:DimensionlessUnit ;
    owl:disjointWith ns2:FractionUnit ;
    skos:example """Unit of atomic number
Unit of number of cellular
Unit of degeneracy in quantum mechanics"""@en ;
    skos:prefLabel "CountingUnit"@en ;
    ns2:elucidation "Unit for dimensionless quantities that have the nature of count."@en ;
    ns2:qudtReference "http://qudt.org/vocab/unit/NUM"^^xsd:anyURI ;
    ns2:ucumCode "1"^^xsd:string .

ns2:Declaration rdfs:label "Declaration"@en .

ns2:Declarer rdfs:label "Declarer"@en .

ns2:DerivedQuantity a owl:Class ;
    rdfs:label "DerivedQuantity"@en ;
    rdfs:subClassOf ns2:PhysicalQuantiyByDefinition ;
    owl:disjointWith ns2:BaseQuantity ;
    skos:prefLabel "DerivedQuantity"@en ;
    ns2:VIMTerm "derived quantity"@en ;
    ns2:elucidation "\"Quantity, in a system of quantities, defined in terms of the base quantities of that system\"."@en .

ns2:Determiner rdfs:label "Determiner"@en .

ns2:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc a owl:AnnotationProperty ;
    rdfs:label "qudtReference"@en ;
    rdfs:seeAlso "http://www.qudt.org/2.1/catalog/qudt-catalog.html"@en ;
    rdfs:subPropertyOf ns2:metrologicalReference ;
    owl:deprecated true ;
    skos:changeNote "Replaced by emmo:qudtReference"@en ;
    skos:prefLabel "qudtReference"@en ;
    ns2:elucidation "URL to corresponing entity in QUDT."@en .

ns2:EMMO_209ba1b3_149f_4ff0_b672_941610eafd72 a owl:AnnotationProperty ;
    rdfs:label "omReference"@en ;
    rdfs:seeAlso "https://enterpriseintegrationlab.github.io/icity/OM/doc/index-en.html"^^xsd:string,
        "https://github.com/HajoRijgersberg/OM"^^xsd:string ;
    rdfs:subPropertyOf ns2:metrologicalReference ;
    owl:deprecated true ;
    skos:changeNote "Replaced by emmo:omReference"@en ;
    skos:prefLabel "omReference"@en ;
    ns2:elucidation "IRI to corresponding concept in the Ontology of units of Measure."@en .

ns2:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 a owl:AnnotationProperty ;
    rdfs:label "ucumCode"@en ;
    rdfs:domain ns2:MeasurementUnit ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://ucum.org/"^^xsd:anyURI ;
    rdfs:subPropertyOf ns2:metrologicalReference ;
    owl:deprecated true ;
    skos:changeNote "Replaced by emmo:ucumCode"@en ;
    skos:prefLabel "ucumCode"@en ;
    ns2:elucidation "Unified Code for Units of Measure (UCUM)."@en ;
    ns2:note "The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units."@en .

ns2:EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6 a owl:AnnotationProperty ;
    rdfs:label "VIMTerm"@en ;
    rdfs:seeAlso "https://www.bipm.org/documents/20126/2071204/JCGM_200_2012.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf rdfs:isDefinedBy,
        ns2:metrologicalReference ;
    owl:deprecated true ;
    skos:changeNote "Replaced by emmo:VIMTerm"@en ;
    skos:example "quantity value (term in VIM that corresponds to Quantity in EMMO)"@en ;
    skos:prefLabel "VIMTerm"@en ;
    ns2:note "The term in the International vocabulary of metrology (VIM) (JCGM 200:2008) that corresponds to the annotated term in EMMO."@en .

ns2:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 a owl:AnnotationProperty ;
    rdfs:label "iupacReference"@en ;
    rdfs:comment "DOI to corresponding concept in IUPAC"@en ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso "https://goldbook.iupac.org/"^^xsd:anyURI ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    owl:deprecated true ;
    skos:changeNote "Replaced by emmo:iupacReference"@en ;
    skos:prefLabel "iupacReference"@en .

ns2:Interpreter rdfs:label "Interpreter"@en .

ns2:InterpreterByReferent rdfs:label "InterpreterByReferent"@en .

ns2:LogarithmicUnit a owl:Class ;
    rdfs:label "LogarithmicUnit"@en ;
    rdfs:subClassOf ns2:DimensionlessUnit ;
    skos:example "Decibel"@en ;
    skos:prefLabel "LogarithmicUnit"@en ;
    ns2:elucidation "A logarithmic unit is a unit that can be used to express a quantity (physical or mathematical) on a logarithmic scale, that is, as being proportional to the value of a logarithm function applied to the ratio of the quantity and a reference quantity of the same type."@en ;
    ns2:note """Note that logarithmic units like decibel or neper are not univocally defines, since their definition depends on whether they are used to measure a "power" or a "root-power" quantity.

It is advisory to create a uniquely defined subclass these units for concrete usage."""@en ;
    ns2:qudtReference "http://qudt.org/schema/qudt/LogarithmicUnit"^^xsd:anyURI ;
    ns2:wikipediaReference "https://en.wikipedia.org/wiki/Logarithmic_scale#Logarithmic_units"^^xsd:anyURI .

ns2:MeasuredConstant a owl:Class ;
    rdfs:label "MeasuredConstant"@en ;
    rdfs:subClassOf ns2:PhysicalConstant ;
    owl:disjointWith ns2:ExactConstant ;
    skos:prefLabel "MeasuredConstant"@en ;
    ns2:elucidation "For a given unit system, measured constants are physical constants that are not used to define the unit system. Hence, these constants have to be measured and will therefore be associated with an uncertainty."@en .

ns2:MetrologicalConstruct a owl:Class ;
    rdfs:label "MetrologicalConstruct"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:SymbolicConstruct ns2:Metrological ) ] ;
    skos:prefLabel "MetrologicalConstruct"@en ;
    ns2:elucidation "A symbolic construct used within the discipline of metrology."@en .

ns2:MetrologicalSymbol a owl:Class ;
    rdfs:label "MetrologicalSymbol"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf ns2:Metrological ] ;
            owl:onProperty ns2:hasProperPart ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:Metrological ns2:Symbol ) ] ;
    skos:prefLabel "MetrologicalSymbol"@en ;
    ns2:elucidation "A symbol that stands for a concept in the language of the meterological domain of ISO 80000."@en .

ns2:NominalProperty a owl:Class ;
    rdfs:label "NominalProperty"@en ;
    rdfs:comment """"Property of a phenomenon, body, or substance, where the property has no magnitude."

"A nominal property has a value, which can be expressed in words, by alphanumerical codes, or by other means."

International vocabulary of metrology (VIM)"""@en ;
    rdfs:subClassOf ns2:Objective ;
    skos:example """CFC is a 'sign' that stands for the fact that the morphology of atoms composing the microstructure of an entity is predominantly Cubic Face Centered

A color is a nominal property.

Sex of a human being."""@en ;
    skos:prefLabel "NominalProperty"@en ;
    ns2:VIMTerm "nominal property"@en ;
    ns2:elucidation "An 'ObjectiveProperty' that cannot be quantified."@en .

ns2:Observer rdfs:label "Observer"@en .

ns2:OrdinalQuantity a owl:Class ;
    rdfs:label "OrdinalQuantity"@en ;
    rdfs:comment """"Ordinal quantities, such as Rockwell C hardness, are usually not considered to be part of a system of quantities because they are related to other quantities through empirical relations only."
International vocabulary of metrology (VIM)"""@en ;
    rdfs:subClassOf ns2:QuantityByPhysicalNature ;
    skos:example """Hardness
Resilience"""@en ;
    skos:prefLabel "OrdinalQuantity"@en ;
    ns2:VIMTerm "ordinal quantity"@en ;
    ns2:elucidation """"Quantity, defined by a conventional measurement procedure, for which a total ordering relation can be established, according to magnitude, with other quantities of the same kind, but for which no algebraic operations among those quantities exist"
International vocabulary of metrology (VIM)"""@en .

ns2:Semiosis rdfs:label "Semiosis"@en .

ns2:SemiosisByReferent rdfs:label "SemiosisByReferent"@en .

ns2:SemioticEntity rdfs:label "SemioticEntity"@en .

ns2:Semiotics rdfs:label "Semiotics"@en .

ns2:Sign rdfs:label "Sign"@en .

ns2:SignByReferent rdfs:label "SignByReferent"@en .

ns2:SpecialUnit a owl:Class ;
    rdfs:comment "Special units are semiotic shortcuts to more complex composed symbolic objects."@en ;
    rdfs:subClassOf ns2:DerivedUnit,
        ns2:UnitSymbol ;
    owl:disjointWith ns2:BaseUnit ;
    skos:example """Pa stands for N/m2
J stands for N m"""@en ;
    skos:prefLabel "SpecialUnit"@en ;
    ns2:elucidation "A unit symbol that stands for a derived unit."@en .

ns2:StandardUnit a owl:Class ;
    rdfs:label "StandardUnit"@en ;
    rdfs:subClassOf ns2:MetrologicalReference ;
    skos:altLabel "ReferenceMaterial"^^xsd:string ;
    skos:example "Arbitrary amount-of-substance concentration of lutropin in a given sample of plasma (WHO international standard 80/552): 5.0 International Unit/l"@en ;
    skos:prefLabel "StandardUnit"@en ;
    ns2:elucidation """A reference unit provided by a reference material.
International vocabulary of metrology (VIM)"""@en .

ns2:StandardizedPhysicalQuantity a owl:Class ;
    rdfs:label "StandardizedPhysicalQuantity"@en ;
    rdfs:subClassOf ns2:PhysicalQuantity ;
    skos:prefLabel "StandardizedPhysicalQuantity"@en ;
    ns2:elucidation "The superclass for all physical quantities classes that are categorized according to a standard (e.g. ISQ)."^^xsd:string .

ns2:SubjectiveProperty a owl:Class ;
    rdfs:label "SubjectiveProperty"@en ;
    rdfs:subClassOf ns2:QuantityBySubjectivity,
        ns2:Subjective ;
    owl:disjointWith ns2:ObjectiveProperty ;
    skos:example "The measure of beauty on a scale from 1 to 10."@en ;
    skos:prefLabel "SubjectiveProperty"@en ;
    ns2:elucidation "A quantity whos value that cannot be univocally determined and depends on an agent (e.g. a human individual, a community)."@en .

ns2:SystemUnit a owl:Class ;
    rdfs:label "SystemUnit"@en ;
    rdfs:subClassOf ns2:MeasurementUnit ;
    skos:prefLabel "SystemUnit"@en ;
    ns2:elucidation "A unit that belongs to one or more unit systems."@en .

ns2:UnitOne a owl:Class ;
    rdfs:label "UnitOne"@en ;
    rdfs:subClassOf ns2:DimensionlessUnit ;
    skos:altLabel "Unitless"@en ;
    skos:example "Refractive index or volume fraction."@en,
        "Typically used for ratios of two units whos dimensions cancels out."@en ;
    skos:prefLabel "UnitOne"@en ;
    ns2:definition "Represents the number 1, used as an explicit unit to say something has no units."@en ;
    ns2:elucidation """"The unit one is the neutral element of any system of units – necessary and present automatically."

-- SI Brochure"""@en ;
    ns2:qudtReference "http://qudt.org/vocab/unit/UNITLESS"^^xsd:string .

ns2:coverageInterval a owl:DatatypeProperty ;
    rdfs:label "coverageInterval"@en ;
    ns1:python_name "coverageInterval"@en ;
    rdfs:subPropertyOf ns2:dataValue ;
    skos:prefLabel "coverageInterval"@en ;
    ns2:VIMTerm "VIM4: 3.12 coverage interval"@en ;
    ns2:elucidation "An interval containing the a value with a stated probability, based on the information available."@en .

ns2:coverageProbability a owl:DatatypeProperty ;
    rdfs:label "coverageProbability"@en ;
    ns1:python_name "coverageProbability"@en ;
    rdfs:subPropertyOf ns2:dataValue ;
    skos:prefLabel "coverageProbability"@en ;
    ns2:VIMTerm "VIM4: 3.13 coverage probability"@en ;
    ns2:elucidation "The probability that a data value is contained within a specified coverage interval."@en .

ns2:hasConventionalProperty a owl:ObjectProperty ;
    rdfs:label "hasConventionalProperty"@en ;
    ns1:python_name "hasConventionalProperty"@en ;
    rdfs:comment """An object can be represented by a quantity for the fact that it has been recognized to belong to a specific class.

The quantity is selected without an observation aimed to measure its actual value, but by convention."""^^xsd:string ;
    rdfs:range ns2:ConventionalProperty ;
    rdfs:subPropertyOf ns2:hasObjectiveProperty ;
    skos:example "An Hydrogen atom has the quantity atomic number Z = 1 as its conventional property."@en ;
    skos:prefLabel "hasConventionalProperty"@en ;
    ns2:elucidation "Assigns a quantity to an object by convention."@en .

ns2:hasMeasuredProperty a owl:ObjectProperty ;
    rdfs:label "hasMeasuredProperty"@en ;
    ns1:python_name "hasMeasuredProperty"@en ;
    rdfs:range ns2:MeasuredProperty ;
    rdfs:subPropertyOf ns2:hasObjectiveProperty ;
    skos:prefLabel "hasMeasuredProperty"@en ;
    ns2:elucidation "Assigns a quantity to an object via a well-defined measurement procedure."@en .

ns2:hasModelledProperty a owl:ObjectProperty ;
    rdfs:label "hasModelledProperty"@en ;
    ns1:python_name "hasModelledProperty"@en ;
    rdfs:range ns2:ModelledProperty ;
    rdfs:subPropertyOf ns2:hasObjectiveProperty ;
    skos:prefLabel "hasModelledProperty"@en ;
    ns2:elucidation "Assigns a quantity to an object via a well-defined modelling procedure."@en .

ns2:meanQuantityValue a owl:DatatypeProperty ;
    rdfs:label "meanQuantityValue"@en ;
    ns1:python_name "meanQuantityValue"@en ;
    rdfs:subPropertyOf ns2:EMMO_ea67144c_56fd_4312_a4f4_af78edd5eacc ;
    skos:altLabel "expectationValue"@en,
        "expectedValue"@en,
        "meanValue"@en ;
    skos:prefLabel "meanQuantityValue"@en ;
    ns2:elucidation "The probabilistic expected value of an EMMO data entity."@en ;
    ns2:note "The expectation value (or expected value) is the theoretical long-run average outcome of a random variable over many trials, calculated as the sum of all possible values, each weighted by its probability of occurrence. It acts as a probability-weighted mean, representing the center of a probability distribution, denoted as 'E[X]' or 'µ'."@en .

ns2:omReference a owl:AnnotationProperty ;
    rdfs:label "omReference"@en ;
    rdfs:seeAlso "https://enterpriseintegrationlab.github.io/icity/OM/doc/index-en.html"^^xsd:string,
        "https://github.com/HajoRijgersberg/OM"^^xsd:string ;
    rdfs:subPropertyOf ns2:metrologyReference ;
    skos:prefLabel "omReference"@en ;
    ns2:elucidation "IRI to corresponding concept in the Ontology of units of Measure."@en .

ns2:qudtReference a owl:AnnotationProperty ;
    rdfs:label "qudtReference"@en ;
    rdfs:seeAlso "http://www.qudt.org/2.1/catalog/qudt-catalog.html"@en ;
    rdfs:subPropertyOf ns2:metrologyReference ;
    skos:prefLabel "qudtReference"@en ;
    ns2:elucidation "URL to corresponing entity in QUDT."@en .

ns2:standardUncertainty a owl:DatatypeProperty ;
    rdfs:label "standardUncertainty"@en ;
    ns1:python_name "standardUncertainty"@en ;
    rdfs:subPropertyOf ns2:uncertainty ;
    skos:altLabel "standardDeviation"@en,
        "standardMeasuremetnUncertainty"@en ;
    skos:prefLabel "standardUncertainty"@en ;
    ns2:VIMTerm "VIM4: 3.6 standard measurement uncertainty"@en ;
    ns2:elucidation "An uncertainty specified as a standard deviation."@en .

ns2:ucumCode a owl:AnnotationProperty ;
    rdfs:label "ucumCode"@en ;
    rdfs:domain ns2:MeasurementUnit ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://ucum.org/"^^xsd:anyURI ;
    rdfs:subPropertyOf ns2:metrologyReference ;
    skos:prefLabel "ucumCode"@en ;
    ns2:elucidation "Unified Code for Units of Measure (UCUM)."@en ;
    ns2:note "The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units."@en .

ns2:uneceCommonCode a owl:AnnotationProperty ;
    rdfs:label "uneceCommonCode"@en ;
    ns1:python_name "uneceCommonCode"@en ;
    rdfs:domain ns2:MeasurementUnit ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns2:metrologicalReference ;
    owl:deprecated true ;
    skos:changeNote "Replaced by schema:unitCode"@en ;
    skos:prefLabel "uneceCommonCode"@en ;
    ns2:elucidation "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL."@en ;
    ns2:note "The UN/CEFACT Recommendation 20 provides three character alphabetic and alphanumeric codes for representing units of measurement for length, area, volume/capacity, mass (weight), time, and other quantities used in international trade. The codes are intended for use in manual and/or automated systems for the exchange of information between participants in international trade."@en .

ns2:unitSymbolValue a owl:DatatypeProperty ;
    rdfs:label "unitSymbolValue"@en ;
    ns1:python_name "unitSymbolValue"@en ;
    rdfs:domain ns2:UnitSymbol ;
    rdfs:subPropertyOf ns2:symbolValue ;
    skos:prefLabel "unitSymbolValue"@en .

: a owl:Ontology ;
    dcterms:abstract """Defines the formal language of metrology, including theoretical and practical aspects of measurements.

This module is based on the International vocabulary of metrology (VIM) as well as the ISO/IEC 80000 standard."""@en ;
    dcterms:creator <https://orcid.org/EmanueleGhedini>,
        <https://orcid.org/GerhardGoldbeck>,
        <https://orcid.org/JesperFriis>,
        <https://orcid.org/SimonClark> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "Metrology"@en ;
    rdfs:comment "The EMMO requires HermiT reasoner plugin in order to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.0.4/disciplines/math>,
        <https://w3id.org/emmo/1.0.4/disciplines/properties>,
        <https://w3id.org/emmo/1.0.4/reference/persholistic>,
        <https://w3id.org/emmo/1.0.4/reference/symbolic>,
        <https://w3id.org/emmo/1.0.4/reference/workflow> ;
    owl:versionIRI <https://w3id.org/emmo/1.0.4/hume/disciplines/metrology> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    ns2:contact "emmo@emmc.eu"^^xsd:string .

ns2:BaseUnit a owl:Class ;
    rdfs:label "BaseUnit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:BaseQuantity ;
            owl:onProperty [ owl:inverseOf ns2:hasMeasurementUnit ] ],
        ns2:UnitSymbol ;
    skos:prefLabel "BaseUnit"@en ;
    ns2:VIMTerm "base unit"@en ;
    ns2:elucidation "A set of units that correspond to the base quantities in a system of units."@en .

ns2:ConventionalProperty a owl:Class ;
    rdfs:label "ConventionalProperty"@en ;
    rdfs:comment "A property that is associated to an object by convention, or assumption."@en ;
    rdfs:subClassOf ns2:ObjectiveProperty ;
    skos:example """The thermal conductivity of a copper sample in my laboratory can be assumed to be the conductivity that appears in the vendor specification. This value has been obtained by measurement of a sample which is not the one I have in my laboratory. This conductivity value is then a conventional quantitiative property assigned to my sample through a semiotic process in which no actual measurement is done by my laboratory.

If I don't believe the vendor, then I can measure the actual thermal conductivity. I then perform a measurement process that semiotically assign another value for the conductivity, which is a measured property, since is part of a measurement process.

Then I have two different physical quantities that are properties thanks to two different semiotic processes."""@en ;
    skos:prefLabel "ConventionalProperty"@en ;
    ns2:elucidation "A quantitative property attributed by agreement to a quantity for a given purpose."@en .

ns2:DerivedUnit a owl:Class ;
    rdfs:subClassOf ns2:MeasurementUnit ;
    skos:prefLabel "DerivedUnit"@en ;
    ns2:VIMTerm "derived unit"@en ;
    ns2:elucidation "Derived units are defined as a numerical factor times the products of powers of the base units corresponding to the relations defining the derived quantities in terms of the base quantities."@en ;
    ns2:note """A measurement unit for a derived quantity.
-- VIM"""@en,
        "When the numerical factor of this product is one, the derived units are called coherent derived units."@en .

ns2:DimensionalUnit a owl:Class ;
    rdfs:label "DimensionalUnit"@en ;
    rdfs:subClassOf ns2:MeasurementUnitByDimensionality ;
    skos:prefLabel "DimensionalUnit"@en ;
    ns2:elucidation "A subclass of measurement unit focusing on the physical dimensionality that is carried by the unit."@en ;
    ns2:note """The current version of EMMO does not provide explicit classes for physical dimensions. Rather it embraces the fact that the physical dimensionality of a physical quantity is carried by its measurement unit.

The role of dimensional unit and its subclasses is to express the physical dimensionality that is carried by the unit.

Since the dimensionality of a physical quantity can be written as the product of powers of the physical dimensions of the base quantities in the selected system of quantities, the physical dimensionality of a measurement unit is uniquely determined by the exponents. For a dimensional unit, at least one of these exponents must be non-zero (making it disjoint from dimensionless units)."""@en .

ns2:EMMO_ea67144c_56fd_4312_a4f4_af78edd5eacc a owl:DatatypeProperty ;
    rdfs:label "quantityValue"@en ;
    rdfs:subPropertyOf ns2:dataValue ;
    skos:altLabel "measuredQuantityValue"@en,
        "measuredValue"@en ;
    ns2:VIMTerm "VIM4: 2.11 measured value of a quantity"@en ;
    ns2:note "In VIM, dataValue correspond to \"measured value\" which is defined as a \"value of a quantity representing a measurement result\"."@en .

ns2:Estimated rdfs:label "Estimated"@en .

ns2:Estimation rdfs:label "Estimation"@en .

ns2:Estimator rdfs:label "Estimator"@en .

ns2:ExactConstant a owl:Class ;
    rdfs:label "ExactConstant"@en ;
    rdfs:subClassOf ns2:PhysicalConstant ;
    skos:prefLabel "ExactConstant"@en ;
    ns2:elucidation "Physical constant used to define a unit system. Hence, when expressed in that unit system they have an exact value with no associated uncertainty."@en .

ns2:FractionUnit a owl:Class ;
    rdfs:label "FractionUnit"@en ;
    rdfs:comment """Quantities that are ratios of quantities of the same kind (for example length ratios and amount fractions) have the option of being expressed with units (m/m, mol/mol to aid the understanding of the quantity being expressed and also allow the use of SI prefixes, if this
is desirable (μm/m, nmol/mol).
-- SI Brochure"""@en ;
    rdfs:subClassOf ns2:DimensionlessUnit ;
    skos:altLabel "RatioUnit"@en ;
    skos:prefLabel "FractionUnit"@en ;
    ns2:elucidation "Unit for fractions of quantities of the same kind, to aid the understanding of the quantity being expressed."@en .

ns2:MeasuredProperty a owl:Class ;
    rdfs:label "MeasuredProperty"@en ;
    rdfs:comment """The specification of a measurand requires knowledge of the kind of quantity, description of the state of the phenomenon, body, or substance carrying the quantity, including any relevant component, and the chemical entities involved.

-- VIM"""@en ;
    rdfs:subClassOf ns2:ObjectiveProperty ;
    skos:prefLabel "MeasuredProperty"@en ;
    ns2:elucidation "A quantity that is the result of a well-defined measurement procedure."@en .

ns2:MeasuringInstrument a owl:Class ;
    rdfs:label "MeasuringInstrument"@en ;
    rdfs:comment "A measuring instrument that can be used alone is a measuring system."@en ;
    rdfs:subClassOf ns2:Measurer ;
    skos:prefLabel "MeasuringInstrument"@en ;
    ns2:VIMTerm "measuring instrument"@en ;
    ns2:elucidation """Device used for making measurements, alone or in conjunction with one or more supplementary devices.

-- VIM"""@en .

ns2:MeasuringSystem a owl:Class ;
    rdfs:label "MeasuringSystem"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasPart ;
            owl:someValuesFrom ns2:MeasuringInstrument ],
        ns2:Measurer ;
    skos:prefLabel "MeasuringSystem"@en ;
    ns2:VIMTerm "measuring system"@en ;
    ns2:elucidation """A set of one or more 'MeasuringInstruments' and often other devices, including any reagent and supply, assembled and adapted to give information used to generate 'MeasuredQuantityProperty' within specified intervals for quantities of specified kinds.

-- VIM"""@en .

ns2:MetrologicalUncertainty a owl:Class ;
    rdfs:label "MetrologicalUncertainty"@en ;
    rdfs:comment "In general, for a given set of information, it is understood that the measurement uncertainty is associated with a stated quantity value. A modification of this value results in a modification of the associated uncertainty."@en,
        "Metrological uncertainty includes components arising from systematic effects, such as components associated with corrections and the assigned quantity values of measurement standards, as well as the definitional uncertainty. Sometimes estimated systematic effects are not corrected for but, instead, associated measurement uncertainty components are incorporated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasMetrologicalUncertainty ] ;
            owl:someValuesFrom ns2:QuantityValue ],
        ns2:ObjectiveProperty ;
    skos:altLabel "A metrological uncertainty can be assigned to any objective property via the 'hasMetrologicalUncertainty' relation."^^xsd:string ;
    skos:example """- Standard deviation
- Half-width of an interval with a stated coverage probability"""@en ;
    skos:prefLabel "MetrologicalUncertainty"@en ;
    ns2:elucidation "The uncertainty of a quantity obtained through a well-defined procedure, characterising of the dispersion of the quantity."@en ;
    ns2:note "Metrological uncertainty in EMMO is a slight generalisation of the VIM term 'measurement uncertainty', which is defined as \"a non-negative parameter characterising the dispersion of the quantity being measured\"."@en .

ns2:ModelledProperty a owl:Class ;
    rdfs:label "ModelledProperty"@en ;
    rdfs:subClassOf ns2:ObjectiveProperty ;
    skos:prefLabel "ModelledProperty"@en ;
    ns2:elucidation "A quantity obtained from a well-defined modelling procedure."@en .

ns2:NonPrefixedUnit a owl:Class ;
    rdfs:subClassOf ns2:MeasurementUnitByPrefix ;
    owl:disjointWith ns2:PrefixedUnit ;
    skos:prefLabel "NonPrefixedUnit"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: DerivedUnit or UnitSymbol"^^xsd:string ;
    ns2:elucidation "A measurement unit symbol that do not have a metric prefix as a direct spatial part."@en .

ns2:Observation rdfs:label "Observation"@en .

ns2:ProcedureUnit a owl:Class ;
    rdfs:label "ProcedureUnit"@en ;
    rdfs:subClassOf ns2:MetrologicalReference ;
    skos:altLabel "MeasurementProcedure"^^xsd:string ;
    skos:example "Rockwell C hardness of a given sample (150 kg load): 43.5HRC(150 kg)"@en ;
    skos:prefLabel "ProcedureUnit"@en ;
    ns2:elucidation "A reference unit provided by a measurement procedure."@en ;
    ns2:note "Procedure units and measurement units are disjoint."@en .

ns2:Subjective rdfs:label "Subjective"@en .

ns2:VIMTerm a owl:AnnotationProperty ;
    rdfs:label "VIMTerm"@en ;
    rdfs:seeAlso "https://www.bipm.org/documents/20126/2071204/JCGM_200_2012.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf rdfs:isDefinedBy,
        ns2:metrologyReference ;
    skos:example "quantity value (term in VIM that corresponds to Quantity in EMMO)"@en ;
    skos:prefLabel "VIMTerm"@en ;
    ns2:note "The term in the International vocabulary of metrology (VIM) (JCGM 200:2008) that corresponds to the annotated term in EMMO."@en .

ns2:hasDeterminedProperty a owl:ObjectProperty ;
    rdfs:label "hasDeterminedProperty"@en ;
    ns1:python_name "hasDeterminedProperty"@en ;
    rdfs:domain ns2:Determination ;
    rdfs:range ns2:Property ;
    rdfs:subPropertyOf ns2:hasSign ;
    skos:prefLabel "hasDeterminedProperty"@en ;
    ns2:elucidation "Relates a semiotic determination process to the determined property."@en .

ns2:hasDeterminedValue a owl:ObjectProperty ;
    rdfs:label "hasDeterminedValue"@en ;
    ns1:python_name "hasDeterminedValue"@en ;
    rdfs:domain ns2:Determination ;
    rdfs:range ns2:QuantityValue ;
    rdfs:subPropertyOf ns2:hasSign ;
    skos:prefLabel "hasDeterminedValue"@en ;
    ns2:elucidation "Relates a determination to a determined quantity value."@en .

ns2:hasMeasuredObject a owl:ObjectProperty ;
    rdfs:label "hasMeasuredObject"@en ;
    ns1:python_name "hasMeasuredObject"@en ;
    rdfs:domain ns2:Measurement ;
    rdfs:range ns2:Referent ;
    rdfs:subPropertyOf ns2:hasReferent ;
    skos:prefLabel "hasMeasuredObject"@en ;
    ns2:elucidation "Relates a measurement to the measured object (referent)."@en .

ns2:hasMetricPrefix a owl:ObjectProperty ;
    rdfs:label "hasMetricPrefix"@en ;
    ns1:python_name "hasMetricPrefix"@en ;
    rdfs:comment "Relates a prefixed unit to its metric prefix part."@en ;
    rdfs:domain ns2:PrefixedUnit ;
    rdfs:range ns2:MetricPrefix ;
    rdfs:subPropertyOf ns2:hasSpatialTile ;
    skos:prefLabel "hasMetricPrefix"@en .

ns2:hasMetrologicalUncertainty a owl:ObjectProperty ;
    rdfs:label "hasMetrologicalUncertainty"@en ;
    ns1:python_name "hasMetrologicalUncertainty"@en ;
    rdfs:domain ns2:ObjectiveProperty ;
    rdfs:range ns2:MetrologicalUncertainty ;
    rdfs:subPropertyOf ns2:hasObjectiveProperty ;
    skos:prefLabel "hasMetrologicalUncertainty"@en ;
    ns2:elucidation "Assigns a quantifiable uncertainty to an objective property through a well-defined procecure."@en ;
    ns2:note "Since measurement uncertainty is a subclass of objective property, this relation can also describe the uncertainty of an measurement uncertainty."@en .

ns2:hasNumericalPart a owl:AsymmetricProperty,
        owl:InverseFunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasNumericalPart"@en ;
    ns1:python_name "hasNumericalPart"@en ;
    rdfs:comment "Relates a quantity to its numerical value through spatial direct parthood."@en ;
    rdfs:domain ns2:QuantityValue ;
    rdfs:range ns2:Numerical ;
    rdfs:subPropertyOf ns2:hasSpatialTile ;
    skos:prefLabel "hasNumericalPart"@en .

ns2:hasQuantityValuePart a owl:ObjectProperty ;
    rdfs:label "hasQuantityValuePart"@en ;
    ns1:python_name "hasQuantityValuePart"@en ;
    rdfs:domain ns2:MeasurementResult ;
    rdfs:range ns2:QuantityValue ;
    rdfs:subPropertyOf ns2:hasSpatialTile ;
    skos:prefLabel "hasQuantityValuePart"@en ;
    ns2:elucidation "Relates a measurement result to one of its quantity value parts."@en .

ns2:hasReferencePart a owl:ObjectProperty ;
    rdfs:label "hasReferencePart"@en ;
    ns1:python_name "hasReferencePart"@en ;
    rdfs:domain ns2:QuantityValue ;
    rdfs:range ns2:MetrologicalReference ;
    rdfs:subPropertyOf ns2:hasSpatialTile ;
    skos:prefLabel "hasReferencePart"@en ;
    ns2:elucidation "Relates a quantity to its reference unit through spatial direct parthood."@en .

ns2:hasUnitNonPrefixPart a owl:ObjectProperty ;
    rdfs:label "hasUnitNonPrefixPart"@en ;
    ns1:python_name "hasUnitNonPrefixPart"@en ;
    rdfs:domain ns2:PrefixedUnit ;
    rdfs:range ns2:MeasurementUnit ;
    rdfs:subPropertyOf ns2:hasSpatialTile ;
    skos:example "For example the unit CentiNewtonMetre has prefix \"Centi\" and non-prefix part \"NewtonMetre\"."@en ;
    skos:prefLabel "hasUnitNonPrefixPart"@en ;
    ns2:elucidation "Relates a prefixed unit to its non-prefixed part."@en .

ns2:hasUnitSymbol a owl:ObjectProperty ;
    rdfs:label "hasUnitSymbol"@en ;
    ns1:python_name "hasUnitSymbol"@en ;
    rdfs:domain ns2:PrefixedUnit ;
    rdfs:range ns2:UnitSymbol ;
    rdfs:subPropertyOf ns2:hasUnitNonPrefixPart ;
    skos:prefLabel "hasUnitSymbol"@en ;
    ns2:elucidation "Relates a prefixed unit to its unit symbol part."@en .

ns2:uncertainty a owl:DatatypeProperty ;
    rdfs:label "uncertainty"@en ;
    ns1:python_name "uncertainty"@en ;
    rdfs:subPropertyOf ns2:dataValue ;
    skos:altLabel "measurementUncertainty"@en ;
    skos:prefLabel "uncertainty"@en ;
    ns2:VIMTerm "VIM4: 3.1 measurement uncertainty"@en ;
    ns2:elucidation "A parameter characterising the dispersion of a data value."@en ;
    ns2:note "The uncertainty data property doesn't specify how the uncertainty is defined. For accuracy, use one of the specialised sub-properties."@en,
        "VIM defined 'measurement uncertainty' as a \"parameter characterising the dispersion of the values being attributed to a measurand, based on the information used\"."@en .

ns2:BaseQuantity a owl:Class ;
    rdfs:label "BaseQuantity"@en ;
    rdfs:subClassOf ns2:PhysicalQuantiyByDefinition ;
    skos:prefLabel "BaseQuantity"@en ;
    ns2:VIMTerm "base quantity"@en ;
    ns2:elucidation """"Quantity in a conventionally chosen subset of a given system of quantities, where no quantity in the subset can be expressed in terms of the other quantities within that subset"
ISO 80000-1"""@en .

ns2:Determination rdfs:label "Determination"@en .

ns2:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "A measurement always implies a causal interaction between the object and the observer."@en,
        "A measurement is the process of experimentally obtaining one or more measurement results that can reasonably be attributed to a quantity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasMeasuredObject ;
            owl:someValuesFrom ns2:Referent ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:MeasuringSystem ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasDeterminedValue ;
            owl:someValuesFrom ns2:QuantityValue ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasDeterminedProperty ;
            owl:someValuesFrom ns2:Quantity ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasOutput ;
            owl:someValuesFrom ns2:MeasurementResult ],
        ns2:Observation,
        ns2:Procedure ;
    skos:altLabel "MeasurementProcedure"@en ;
    skos:prefLabel "Measurement"@en ;
    ns2:VIMTerm "measurement"@en ;
    ns2:elucidation "An 'observation' that results in a quantitative comparison of a 'property' of an 'object' with a standard reference based on a well defined mesurement procedure."@en ;
    ns2:note "For convinience, the semiotic shortcuts `hasMeasurementValue` and `hasMeasurementQuantity` allows the user to directly relate a measurement to the measured QuantityValue and Quantity, respectively."@en,
        "The output of a measurement is in EMMO a measurement result, which in turn is attributed to one or more measurement values."@en .

ns2:MeasurementResult a owl:Class ;
    rdfs:label "MeasurementResult"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasQuantityValuePart ;
            owl:someValuesFrom ns2:QuantityValue ],
        ns2:Objective ;
    skos:prefLabel "MeasurementResult"@en ;
    ns2:VIMTerm "measurement result"@en ;
    ns2:elucidation """Result of a measurement.

A set of quantity values being attributed to a measurand (quantity) together with any other available relevant information, like measurement uncertainty.

-- VIM"""@en ;
    ns2:note "A measurement result generally contains “relevant information” about the set of measured quantity properties, such that some may be more representative of the measured quantity than others. This may be expressed in the form of a probability density function (pdf)."@en,
        "A measurement result has the measured quantity, measurement uncertainty and other relevant attributes as holistic parts."@en .

ns2:MeasurementUnitByDimensionality a owl:Class ;
    rdfs:label "MeasurementUnitByDimensionality"@en ;
    rdfs:subClassOf ns2:MeasurementUnit ;
    skos:prefLabel "MeasurementUnitByDimensionality"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: DimensionalUnit or DimensionlessUnit"^^xsd:string ;
    ns2:elucidation "Categorisation of measurement units by their physical dimensionality."@en .

ns2:MeasurementUnitByPrefix a owl:Class ;
    rdfs:subClassOf ns2:MeasurementUnit ;
    skos:prefLabel "MeasurementUnitByPrefix"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: PrefixedUnit or NonPrefixedUnit"^^xsd:string ;
    ns2:elucidation "Categorisation of measurement units by whether they are prefixed or not."@en .

ns2:Measurer rdfs:label "Measurer"@en .

ns2:MetricPrefix a owl:Class ;
    rdfs:label "MetricPrefix"@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Metric_prefix"^^xsd:anyURI ;
    rdfs:subClassOf ns2:Constant,
        ns2:Metrological,
        ns2:Symbol ;
    skos:prefLabel "MetricPrefix"@en ;
    ns2:elucidation "Dimensionless multiplicative unit prefix."@en .

ns2:PhysicalConstant a owl:Class ;
    rdfs:label "PhysicalConstant"@en ;
    rdfs:subClassOf ns2:PhysicalQuantity ;
    skos:prefLabel "PhysicalConstant"@en ;
    ns2:OWLRL2DLAxioms "DisjointUnionOf: MeasuredConstant, ExactConstant"^^xsd:string ;
    ns2:elucidation """Physical constants are categorised into "exact" and measured constants.

With "exact" constants, we refer to physical constants that have an exact numerical value after the revision of the SI system that was enforsed May 2019."""@en ;
    ns2:wikipediaReference "https://en.wikipedia.org/wiki/List_of_physical_constants"^^xsd:string .

ns2:PhysicalQuantiyByDefinition a owl:Class ;
    rdfs:label "PhysicalQuantiyByDefinition"@en ;
    rdfs:subClassOf ns2:PhysicalQuantity ;
    skos:prefLabel "PhysicalQuantiyByDefinition"@en ;
    ns2:elucidation "Categorisation of physical quantities by how they are defined."@en .

ns2:Property rdfs:label "Property"@en .

ns2:QuantityByPhysicalNature a owl:Class ;
    rdfs:label "QuantityByPhysicalNature"@en ;
    rdfs:subClassOf ns2:Quantity ;
    skos:hiddenLabel "QuantityByPhysical"@en ;
    skos:prefLabel "QuantityByPhysicalNature"@en ;
    ns2:elucidation "Categorisation of quantities by their physical nature."@en .

ns2:QuantityBySubjectivity a owl:Class ;
    rdfs:label "QuantityBySubjectivity"@en ;
    rdfs:subClassOf ns2:Quantity ;
    skos:prefLabel "QuantityBySubjectivity"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: ObjectiveProperty or SubjectiveProperty"^^xsd:string ;
    ns2:elucidation "Categorisation of quantities by whether they can be obtained fully objectively or not."@en .

ns2:hasMeasurementUnit a owl:ObjectProperty ;
    rdfs:label "hasMeasurementUnit"@en ;
    ns1:python_name "hasMeasurementUnit"@en ;
    rdfs:comment "A conventional semiotic relation that relates a physical quantity to its unit."@en ;
    rdfs:domain ns2:PhysicalQuantity ;
    rdfs:range ns2:MeasurementUnit ;
    rdfs:subPropertyOf ns2:hasMetrologicalReference ;
    skos:example "Length hasUnit only LengthUnit"@en ;
    skos:prefLabel "hasMeasurementUnit"@en .

ns2:hasMetrologicalReference a owl:AsymmetricProperty,
        owl:InverseFunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasMetrologicalReference"@en ;
    ns1:python_name "hasMetrologicalReference"@en ;
    rdfs:comment "Relates a quantity to its metrological reference through a semiotic process."@en ;
    rdfs:domain ns2:Quantity ;
    rdfs:range ns2:MetrologicalReference ;
    rdfs:subPropertyOf ns2:isConventionFor ;
    owl:versionInfo """In EMMO version 1.0.0, physical quantities used the hasMetrologicalReference object property to relate them to their units via physical dimensionality. This was simplified in 1.0.0-alpha3 in order to make reasoning faster.

The restriction (e.g. for the physical quantity Length)

    Length hasMetrologicalReference only (hasPhysicsDimension only LengthDimension)

was in 1.0.0-alpha3 changed to

    Length hasPhysicsDimension some LengthDimension

Likewise were the universal restrictions on the corresponding unit changed to excistential. E.g.

    Metre hasPhysicsDimension only LengthDimension

was changed to

    Metre hasPhysicsDimension some LengthDimension

The label of this class was also changed from PhysicsDimension to PhysicalDimension."""^^xsd:string ;
    skos:prefLabel "hasMetrologicalReference"@en .

ns2:Objective rdfs:label "Objective"@en .

ns2:DimensionlessUnit a owl:Class ;
    rdfs:label "DimensionlessUnit"@en ;
    rdfs:subClassOf ns2:MeasurementUnitByDimensionality ;
    owl:disjointWith ns2:DimensionalUnit ;
    skos:example """Refractive index
Plane angle
Number of apples"""@en ;
    skos:prefLabel "DimensionlessUnit"@en ;
    ns2:elucidation "The subclass of measurement units with no physical dimension."@en ;
    ns2:qudtReference "http://qudt.org/vocab/unit/UNITLESS"^^xsd:anyURI .

ns2:PrefixedUnit a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns2:UnitSymbol ;
            owl:onProperty ns2:hasUnitSymbol ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:MetricPrefix ;
            owl:onProperty ns2:hasMetricPrefix ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns2:MeasurementUnitByPrefix ;
    skos:prefLabel "PrefixedUnit"@en ;
    ns2:elucidation "A measurement unit that is made of a metric prefix and a unit symbol."@en .

ns2:hasObjectiveProperty a owl:ObjectProperty ;
    rdfs:label "hasObjectiveProperty"@en ;
    ns1:python_name "hasObjectiveProperty"@en ;
    rdfs:comment "Relates an object to a quantity describing a quantifiable property of the object obtained via a well-defined procedure."@en ;
    rdfs:range ns2:ObjectiveProperty ;
    rdfs:subPropertyOf ns2:hasProperty ;
    skos:prefLabel "hasObjectiveProperty"@en .

ns2:PhysicalQuantity a owl:Class ;
    rdfs:label "PhysicalQuantity"@en ;
    rdfs:comment """In the same system of quantities, dim ρB = ML−3 is the quantity dimension of mass concentration of component B, and ML−3 is also the quantity dimension of mass density, ρ.
ISO 80000-1"""@en,
        """Measured or simulated 'physical propertiy'-s are always defined by a physical law, connected to a physical entity through a model perspective and measurement is done according to the same model.

Systems of units suggests that this is the correct approach, since except for the fundamental units (length, time, charge) every other unit is derived by mathematical relations between these fundamental units, implying a physical laws or definitions."""@en,
        """Measurement units of quantities of the same quantity dimension may be designated by the same name and symbol even when the quantities are not of the same kind.

For example, joule per kelvin and J/K are respectively the name and symbol of both a measurement unit of heat capacity and a measurement unit of entropy, which are generally not considered to be quantities of the same kind.

However, in some cases special measurement unit names are restricted to be used with quantities of specific kind only.

For example, the measurement unit ‘second to the power minus one’ (1/s) is called hertz (Hz) when used for frequencies and becquerel (Bq) when used for activities of radionuclides.

As another example, the joule (J) is used as a unit of energy, but never as a unit of moment of force, i.e. the newton metre (N · m)."""@en,
        """— quantities of the same kind have the same quantity dimension,
— quantities of different quantity dimensions are always of different kinds, and
— quantities having the same quantity dimension are not necessarily of the same kind.
ISO 80000-1"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:MeasurementUnit ;
            owl:onProperty ns2:hasMeasurementUnit ],
        ns2:QuantityByPhysicalNature ;
    skos:prefLabel "PhysicalQuantity"@en ;
    ns2:OWLRL2DLAxioms "DisjointUnionOf: DerivedQuantity, BaseQuantity"^^xsd:string ;
    ns2:elucidation "A 'Mathematical' entity that is made of a 'Numeral' and a 'MeasurementUnit' defined by a physical law, connected to a physical entity through a model perspective. Measurement is done according to the same model."@en .

ns2:Quantity a owl:Class ;
    rdfs:label "Quantity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns2:MetrologicalReference ;
            owl:onProperty ns2:hasMetrologicalReference ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns2:Property ;
    skos:altLabel "Measurand"@en ;
    skos:example """length
Rockwell C hardness
electric resistance"""@en ;
    skos:prefLabel "Quantity"@en ;
    ns2:OWLRL2DLAxioms "DisjointUnionOf: SubjectiveProperty, ObjectiveProperty"^^xsd:string,
        "EquivalentTo: PhysicalQuantity or OrdinalQuantity"^^xsd:string ;
    ns2:VIMTerm "measurand"@en,
        "quantity"@en ;
    ns2:elucidation "A quantifiable property of a phenomenon, body, or substance."@en ;
    ns2:note """VIM defines a quantity as a "property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed as a number and a reference".

A quantity in EMMO is a property and therefore only addresses the first part of the VIM definition (that is a property of a phenomenon, body, or substance). The second part (that it can be expressed as a number and a reference) is syntactic and addressed by emmo:QuantityValue."""@en ;
    ns2:qudtReference "https://qudt.org/schema/qudt/Quantity"^^xsd:anyURI .

ns2:UnitSymbol a owl:Class ;
    rdfs:subClassOf ns2:NonPrefixedUnit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:Symbol ns2:MeasurementUnit ) ] ;
    skos:example "Some examples are \"Pa\", \"m\" and \"J\"."@en ;
    skos:prefLabel "UnitSymbol"@en ;
    ns2:OWLRL2DLAxioms "DisjointUnionOf: SpecialUnit, BaseUnit"^^xsd:string ;
    ns2:elucidation "A symbol that stands for a single unit."@en .

ns2:metrologicalReference a owl:AnnotationProperty ;
    rdfs:label "metrologicalReference"@en ;
    ns1:python_name "metrologicalReference"@en ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    owl:deprecated true ;
    skos:changeNote "Replaced by emmo:metrologicalReference"@en ;
    skos:prefLabel "metrologicalReference"@en .

ns2:metrologyReference a owl:AnnotationProperty ;
    rdfs:label "metrologyReference"@en ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    skos:prefLabel "metrologyReference"@en .

ns2:Metrological a owl:Class ;
    rdfs:subClassOf ns2:Language ;
    skos:prefLabel "Metrological"@en ;
    ns2:elucidation "A language entity used in the metrology discipline."@en ;
    ns2:note "Metrology is the science of measurement and its application and includes all theoretical and practical aspects of measurement, whatever the measurement uncertainty and field of application (VIM3 2.2)"@en .

ns2:MetrologicalReference a owl:Class ;
    rdfs:subClassOf ns2:Metrological ;
    skos:prefLabel "MetrologicalReference"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: StandardUnit or MeasurementUnit or ProcedureUnit"^^xsd:string ;
    ns2:elucidation "A reference can be a measurement unit, a measurement procedure, a reference material, or a combination of such (VIM3 1.1 NOTE 2)."@en ;
    ns2:note """A symbolic is recognized as reference unit also if it is not part of a quantity (e.g. as in the sentence "the Bq is the reference unit of Becquerel").
For this reason we can't declare the axiom:
MetrologicalReference SubClassOf: inverse(hasMetrologicalReference) some Quantity
because there exist reference units without being part of a quantity.
This is peculiar to EMMO, where quantities as syntatic entities (explicit quantities) are distinct with quantities as semantic entities (properties)."""@en .

ns2:ObjectiveProperty a owl:Class ;
    rdfs:label "ObjectiveProperty"@en ;
    rdfs:comment "Subclasses of 'ObjectiveProperty' classify objects according to the type semiosis that is used to connect the property to the object (e.g. by measurement, by convention, by modelling)."@en ;
    rdfs:subClassOf ns2:Objective,
        ns2:QuantityBySubjectivity ;
    skos:altLabel "PhysicalProperty"@en,
        "QuantitativeProperty"@en ;
    skos:prefLabel "ObjectiveProperty"@en ;
    ns2:elucidation "A quantity that is obtained from a well-defined procedure."@en ;
    ns2:note """The word objective does not mean that each observation will provide the same results. It means that the observation followed a well defined procedure.

This class refers to what is commonly known as physical property, i.e. a measurable property of physical system, whether is quantifiable or not."""@en .

ns2:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue"@en ;
    rdfs:comment """Following the International Vocabulary of Metrology (VIM), EMMO distinguishes between a quantity (a property) and the quantity value (a numerical and a reference).

So, for the EMMO the symbol "kg" is not a physical quantity but simply a 'Symbolic' object categorized as a 'MeasurementUnit'.

While the string "1 kg" is a 'QuantityValue'."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns2:MetrologicalReference ;
            owl:onProperty ns2:hasReferencePart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:Numerical ;
            owl:onProperty ns2:hasNumericalPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns2:Metrological ;
    skos:example """6.8 m
0.9 km
8 K
6 MeV
43.5 HRC(150 kg)"""@en ;
    skos:prefLabel "QuantityValue"@en ;
    ns2:VIMTerm "quantity value"@en ;
    ns2:elucidation "A symbolic that has parts a numerical object and a reference expressing the value of a quantity (expressed as the product of the numerical and the unit)."@en ;
    ns2:note "A quantity value is not necessarily a property, since it is possible to write \"10 kg\", without assigning this quantity to a specific object."@en .

ns2:MeasurementUnit a owl:Class ;
    rdfs:subClassOf ns2:MetrologicalReference ;
    owl:disjointWith ns2:ProcedureUnit ;
    skos:example """kg
m/s
km"""@en ;
    skos:prefLabel "MeasurementUnit"@en ;
    ns2:OWLRL2DLAxioms "DisjointUnionOf: DimensionlessUnit, DimensionalUnit"^^xsd:string,
        "DisjointUnionOf: NonPrefixedUnit, PrefixedUnit"^^xsd:string ;
    ns2:VIMTerm "measurement unit (VIM3 1.9)"@en ;
    ns2:elucidation "A metrological reference for a physical quantity."@en ;
    ns2:note """"Real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number"
ISO 80000-1"""@en,
        """"Unit symbols are mathematical entities and not abbreviations."

"Symbols for units are treated as mathematical entities. In expressing the value of a quantity as the product of a numerical value and a unit, both the numerical value and the unit may be treated by the ordinary rules of algebra."

https://www.bipm.org/utils/common/pdf/si-brochure/SI-Brochure-9-EN.pdf"""@en,
        "Measurement units and procedure units are disjoint."@en,
        "Quantitative value are expressed as a multiple of the 'MeasurementUnit'."@en .

[] a owl:Axiom ;
    owl:annotatedProperty ns2:VIMTerm ;
    owl:annotatedSource ns2:Quantity ;
    owl:annotatedTarget "measurand"@en ;
    ns2:note "VIM defines measurand as a quantity intended to be measured. This is redundant in EMMO and correspond to Quantity."@en .

[] a owl:Axiom ;
    rdfs:isDefinedBy "https://www.bipm.org/documents/20126/2071204/JCGM_200_2012.pdf"^^xsd:string ;
    owl:annotatedProperty ns2:note ;
    owl:annotatedSource ns2:Metrological ;
    owl:annotatedTarget "Metrology is the science of measurement and its application and includes all theoretical and practical aspects of measurement, whatever the measurement uncertainty and field of application (VIM3 2.2)"@en .

[] a owl:Axiom ;
    rdfs:isDefinedBy "https://www.iso.org/standard/45324.html"^^xsd:anyURI ;
    owl:annotatedProperty rdfs:comment ;
    owl:annotatedSource ns2:Measurement ;
    owl:annotatedTarget "A measurement is the process of experimentally obtaining one or more measurement results that can reasonably be attributed to a quantity."@en .


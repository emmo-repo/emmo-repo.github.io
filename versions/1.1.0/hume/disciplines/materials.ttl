@prefix : <https://w3id.org/emmo/hume/disciplines/materials#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/emmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:alternative a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:edition a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:isPartOf a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:subject a owl:AnnotationProperty .

xsd:gYear a rdfs:Datatype .

ns1:Abrasive a owl:Class ;
    rdfs:label "Abrasive"@en ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:prefLabel "Abrasive"@en .

ns1:AdvancedCeramic a owl:Class ;
    rdfs:label "AdvancedCeramic"@en ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:prefLabel "AdvancedCeramic"@en .

ns1:AluminumAlloy a owl:Class ;
    rdfs:label "AluminumAlloy"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "AluminumAlloy"@en .

ns1:AntiferromagneticMaterial a owl:Class ;
    rdfs:label "AntiferromagneticMaterial"@en ;
    rdfs:subClassOf ns1:MagneticResponseMaterial ;
    skos:prefLabel "AntiferromagneticMaterial"@en ;
    ns1:elucidation "Materials where adjacent atomic magnetic moments align antiparallel with equal magnitudes via exchange coupling, resulting in zero net macroscopic magnetization."@en .

ns1:ArtificialMaterial a owl:Class ;
    rdfs:label "ArtificialMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByOrigin ;
    skos:prefLabel "ArtificialMaterial"@en .

ns1:AusteniticStainlessSteel a owl:Class ;
    rdfs:label "AusteniticStainlessSteel"@en ;
    rdfs:subClassOf ns1:StainlessSteel ;
    skos:prefLabel "AusteniticStainlessSteel"@en .

ns1:BasicRefractoryCeramic a owl:Class ;
    rdfs:label "BasicRefractoryCeramic"@en ;
    rdfs:subClassOf ns1:RefractoryCeramic ;
    skos:prefLabel "BasicRefractoryCeramic"@en .

ns1:Beer a owl:Class ;
    rdfs:label "Beer"@en ;
    rdfs:subClassOf ns1:AqueousSolution,
        ns1:LiquidGasSuspension ;
    skos:prefLabel "Beer"@en .

ns1:Brass a owl:Class ;
    rdfs:label "Brass"@en ;
    rdfs:subClassOf ns1:CopperAlloy ;
    skos:prefLabel "Brass"@en .

ns1:BrittleMaterial a owl:Class ;
    rdfs:label "BrittleMaterial"@en ;
    rdfs:subClassOf ns1:MechanicalResponseMaterial ;
    skos:prefLabel "BrittleMaterial"@en ;
    ns1:elucidation "Materials that fracture with little to no prior plastic deformation, propagating cracks rapidly along atomic planes or grain boundaries once a critical stress intensity is reached."@en .

ns1:Bronze a owl:Class ;
    rdfs:label "Bronze"@en ;
    rdfs:subClassOf ns1:CopperAlloy ;
    skos:prefLabel "Bronze"@en .

ns1:Catalyst a owl:Class ;
    rdfs:label "Catalyst"@en ;
    rdfs:subClassOf ns1:ChemicalAndBiochemicalMaterial ;
    skos:prefLabel "Catalyst"@en ;
    ns1:elucidation "Materials that lower the activation energy of chemical reactions when activated thermally or photonically without being consumed by the process."@en .

ns1:Cement a owl:Class ;
    rdfs:label "Cement"@en ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:prefLabel "Cement"@en .

ns1:ChromicMaterial a owl:Class ;
    rdfs:label "ChromicMaterial"@en ;
    rdfs:subClassOf ns1:OpticalAndOptoelectronicMaterial ;
    skos:prefLabel "ChromicMaterial"@en ;
    ns1:elucidation "Materials that reversibly change their optical transmission properties, absorption spectrum, or color when subjected to external fields (electrochromic) or light (photochromic)."@en .

ns1:CompactedGraphiteIron a owl:Class ;
    rdfs:label "CompactedGraphiteIron"@en ;
    rdfs:subClassOf ns1:CastIron ;
    skos:prefLabel "CompactedGraphiteIron"@en .

ns1:CompositeMaterial a owl:Class ;
    rdfs:label "CompositeMaterial"@en ;
    rdfs:isDefinedBy <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MaterialByType ;
    skos:altLabel "Composite"@en ;
    skos:example "Carbon fiber reinforced polymer (CFRP)"@en,
        "Fiberglass"@en ;
    skos:prefLabel "CompositeMaterial"@en ;
    ns1:elucidation "A material that is composed of two or more individual materials which come from ceramic, metallic or polymeric categories."@en .

ns1:Conductor a owl:Class ;
    rdfs:label "Conductor"@en ;
    rdfs:subClassOf ns1:ElectricalResponseMaterial ;
    skos:prefLabel "Conductor"@en ;
    ns1:elucidation "Materials with high concentrations of mobile charge carriers (e.g., free electron gas) that respond to an electric field by establishing a continuous macroscopic current density governed by Ohm's law."@en .

ns1:CrystalCell a owl:Class ;
    rdfs:label "CrystalCell"@en ;
    rdfs:subClassOf ns1:MesoscopicSubstance ;
    skos:altLabel "UnitCell"@en ;
    skos:prefLabel "CrystalCell"@en .

ns1:CrystallineCeramic a owl:Class ;
    rdfs:label "CrystallineCeramic"@en ;
    rdfs:subClassOf ns1:CeramicMaterial,
        ns1:CrystallineMaterial ;
    skos:example "Alumina"@en,
        "Silicon Carbide"@en,
        "Zirconia"@en ;
    skos:prefLabel "CrystallineCeramic"@en ;
    ns1:elucidation "A ceramic material that shows a crystalline (poly- or single-crystalline) structure."@en ;
    ns1:note "Crystalline ceramics are the vast majority of traditional and technical ceramics"@en .

ns1:DiamagneticMaterial a owl:Class ;
    rdfs:label "DiamagneticMaterial"@en ;
    rdfs:subClassOf ns1:MagneticResponseMaterial ;
    skos:prefLabel "DiamagneticMaterial"@en ;
    ns1:elucidation "Materials composed of atoms with no net intrinsic magnetic moment, responding to an external field by inducing a weak, opposing magnetic moment."@en .

ns1:DuctileIron a owl:Class ;
    rdfs:label "DuctileIron"@en ;
    rdfs:subClassOf ns1:CastIron ;
    skos:altLabel "NodularIron"@en ;
    skos:prefLabel "DuctileIron"@en .

ns1:DuctileMaterial a owl:Class ;
    rdfs:label "DuctileMaterial"@en ;
    rdfs:subClassOf ns1:MechanicalResponseMaterial ;
    skos:prefLabel "DuctileMaterial"@en ;
    ns1:elucidation "Materials capable of sustaining significant plastic deformation and absorbing substantial energy before sustaining macroscopic fracture."@en .

ns1:ElasticMaterial a owl:Class ;
    rdfs:label "ElasticMaterial"@en ;
    rdfs:subClassOf ns1:MechanicalResponseMaterial ;
    skos:prefLabel "ElasticMaterial"@en ;
    ns1:elucidation "Materials that exhibit an instantaneous, fully reversible deformation response to stress, governed by Hooke's law where atomic bonds stretch without permanent slippage."@en .

ns1:FastIonConductor a owl:Class ;
    rdfs:label "FastIonConductor"@en ;
    rdfs:subClassOf ns1:ElectricalAndElectronicMaterial ;
    skos:prefLabel "FastIonConductor"@en ;
    ns1:elucidation "Solid electrolytes that allow high mobility of specific ions through their crystal lattice while remaining electronically insulating."@en .

ns1:FerrimagneticMaterial a owl:Class ;
    rdfs:label "FerrimagneticMaterial"@en ;
    rdfs:subClassOf ns1:MagneticResponseMaterial ;
    skos:prefLabel "FerrimagneticMaterial"@en ;
    ns1:elucidation "Materials where adjacent atomic magnetic moments align antiparallel but possess unequal magnitudes, leaving a net usable macroscopic magnetization."@en .

ns1:FerriticStainlessSteel a owl:Class ;
    rdfs:label "FerriticStainlessSteel"@en ;
    rdfs:subClassOf ns1:StainlessSteel ;
    skos:prefLabel "FerriticStainlessSteel"@en .

ns1:Ferroelectric a owl:Class ;
    rdfs:label "Ferroelectric"@en ;
    rdfs:subClassOf ns1:DielectricAndFerroicFunctionalMaterial,
        ns1:DielectricMaterial ;
    skos:prefLabel "Ferroelectric"@en ;
    ns1:elucidation "Materials possessing a spontaneous electric polarization that can be reversed or reoriented by the application of an external electric field."@en .

ns1:FerromagneticMaterial a owl:Class ;
    rdfs:label "FerromagneticMaterial"@en ;
    rdfs:subClassOf ns1:DielectricAndFerroicFunctionalMaterial,
        ns1:MagneticResponseMaterial ;
    skos:prefLabel "FerromagneticMaterial"@en ;
    ns1:elucidation "Materials that possess spontaneous, long-range magnetic ordering, utilized to transform energy or store data via magnetic domain manipulation."@en .

ns1:Fireclay a owl:Class ;
    rdfs:label "Fireclay"@en ;
    rdfs:subClassOf ns1:RefractoryCeramic ;
    skos:prefLabel "Fireclay"@en .

ns1:GasSensingMaterial a owl:Class ;
    rdfs:label "GasSensingMaterial"@en ;
    rdfs:subClassOf ns1:ChemicalAndBiochemicalMaterial ;
    skos:prefLabel "GasSensingMaterial"@en ;
    ns1:elucidation "Materials, typically metal oxides, whose surface electronic conductivity changes predictably upon interaction with target gas molecules."@en .

ns1:Glass a owl:Class ;
    rdfs:label "Glass"@en ;
    rdfs:subClassOf ns1:AmorphousMaterial,
        ns1:GlassyMaterial ;
    skos:example "Borosilicate"@en ;
    skos:prefLabel "Glass"@en ;
    ns1:conceptualisation "To be considered a true glass, an amorphous ceramic must have been formed via the glass transition (usually by cooling a liquid fast enough to freeze its chaotic structure in place). A glass lacks long-range translational order. Its structure is disordered and isotropic (the same in all directions)."@en ;
    ns1:elucidation "An amorphous ceramic material obtained through a glass transition."@en ;
    ns1:note """A glass is not always a mechanical solid. From a strict physics and thermodynamics standpoint, glass is a state of matter. Specifically, an amorphous network trapped in a structurally frozen state. Because this state is entirely dependent on temperature, glass can exist as a flowing, viscous liquid just as easily as it can exist as a brittle windowpane.
The boundary between "liquid glass" and "solid glass" isn't a sharp melting point like you see when ice turns to water. Instead, it is a gradual, temperature-dependent zone called the glass transition temperature Tg."""@en ;
    ns1:wikipediaReference <https://en.wikipedia.org/wiki/Glass> .

ns1:GlassCeramic a owl:Class ;
    rdfs:label "GlassCeramic"@en ;
    rdfs:subClassOf ns1:GlassyMaterial ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:PolyCrystallineMaterial ns1:CeramicMaterial ) ] ;
    skos:altLabel "PolyCrystallineCeramic"@en ;
    skos:prefLabel "GlassCeramic"@en .

ns1:GrayIron a owl:Class ;
    rdfs:label "GrayIron"@en ;
    rdfs:subClassOf ns1:CastIron ;
    skos:prefLabel "GrayIron"@en .

ns1:HighCarbonSteel a owl:Class ;
    rdfs:label "HighCarbonSteel"@en ;
    rdfs:subClassOf ns1:LowAlloySteel ;
    skos:prefLabel "HighCarbonSteel"@en ;
    ns1:elucidation "Steel with a carbon content between 0.60 nd 1.4 wt%"@en .

ns1:IsotropicMaterial a owl:Class ;
    rdfs:label "IsotropicMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByIsotropy ;
    skos:prefLabel "IsotropicMaterial"@en ;
    ns1:elucidation "A material whose properties do not depend on the direction in which measurements are taken."@en .

ns1:LowCarbonSteel a owl:Class ;
    rdfs:label "LowCarbonSteel"@en ;
    rdfs:subClassOf ns1:LowAlloySteel ;
    skos:example "AISI 1010"^^xsd:string ;
    skos:prefLabel "LowCarbonSteel"@en ;
    ns1:elucidation "Steel with a carbon content of less than 0.25 wt%"@en .

ns1:LuminescentMaterial a owl:Class ;
    rdfs:label "LuminescentMaterial"@en ;
    rdfs:subClassOf ns1:OpticalAndOptoelectronicMaterial ;
    skos:prefLabel "LuminescentMaterial"@en ;
    ns1:elucidation "Materials (phosphors) that absorb energy from photons, fields, or electron beams and re-emit it as lower-energy visible light."@en .

ns1:MagnesiumAlloy a owl:Class ;
    rdfs:label "MagnesiumAlloy"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "MagnesiumAlloy"@en .

ns1:MalleableIron a owl:Class ;
    rdfs:label "MalleableIron"@en ;
    rdfs:subClassOf ns1:CastIron ;
    skos:prefLabel "MalleableIron"@en .

ns1:MartensiticStainlessSteel a owl:Class ;
    rdfs:label "MartensiticStainlessSteel"@en ;
    rdfs:subClassOf ns1:StainlessSteel ;
    skos:prefLabel "MartensiticStainlessSteel"@en .

ns1:MediumCarbonSteel a owl:Class ;
    rdfs:label "MediumCarbonSteel"@en ;
    rdfs:subClassOf ns1:LowAlloySteel ;
    skos:prefLabel "MediumCarbonSteel"@en ;
    ns1:elucidation "Steel with a carbon content between 0.25 and 0.60 wt%"@en .

ns1:Metamaterial a owl:Class ;
    rdfs:label "Metamaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "Metamaterial"@en ;
    ns1:elucidation "Artificially engineered, structured materials designed to exhibit physical and wave-modulation properties not found in naturally occurring homogeneous substances."@en .

ns1:MiscellaneousNonFerrousAlloy a owl:Class ;
    rdfs:label "MiscellaneousNonFerrousAlloy"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "MiscellaneousNonFerrousAlloy"@en .

ns1:Multiferroic a owl:Class ;
    rdfs:label "Multiferroic"@en ;
    rdfs:subClassOf ns1:DielectricAndFerroicFunctionalMaterial ;
    skos:prefLabel "Multiferroic"@en ;
    ns1:elucidation "Materials that exhibit more than one primary ferroic property simultaneously (e.g., coupled ferroelectricity and ferromagnetism), enabling cross-domain field control."@en .

ns1:NanoMaterial a owl:Class ;
    rdfs:label "NanoMaterial"@en ;
    rdfs:isDefinedBy <https://www.iso.org/obp/ui/#iso:std:iso:80004:-1:ed-1:v1:en:term:3.1.4> ;
    rdfs:subClassOf ns1:MaterialBySize ;
    skos:prefLabel "NanoMaterial"@en ;
    ns1:elucidation "Material with any external dimension in the nanoscale or having internal structure or surface structure in the nanoscale [ISO 80004-1:2023(en), 3.1.4]"@en .

ns1:NanoParticle a owl:Class ;
    rdfs:label "NanoParticle"@en ;
    rdfs:subClassOf ns1:MesoscopicSubstance ;
    skos:prefLabel "NanoParticle"@en .

ns1:NaturalMaterial a owl:Class ;
    rdfs:label "NaturalMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByOrigin ;
    skos:prefLabel "NaturalMaterial"@en ;
    ns1:elucidation "A material occurring in nature, without the need of human intervention."@en .

ns1:NobleMetal a owl:Class ;
    rdfs:label "NobleMetal"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "NobleMetal"@en .

ns1:ParamagneticMaterial a owl:Class ;
    rdfs:label "ParamagneticMaterial"@en ;
    rdfs:subClassOf ns1:MagneticResponseMaterial ;
    skos:prefLabel "ParamagneticMaterial"@en ;
    ns1:elucidation "Materials with unpaired electron spins that exhibit random, uncoupled magnetic moments, generating a weak parallel alignment to an external field which is readily disrupted by thermal agitation."@en .

ns1:PhaseChangeMaterial a owl:Class ;
    rdfs:label "PhaseChangeMaterial"@en ;
    rdfs:subClassOf ns1:ThermalAndThermoelectricMaterial ;
    skos:prefLabel "PhaseChangeMaterial"@en ;
    ns1:elucidation "Materials that absorb or release large quantities of latent heat during a reversible phase transition at a specific temperature."@en .

ns1:PhotovoltaicMaterial a owl:Class ;
    rdfs:label "PhotovoltaicMaterial"@en ;
    rdfs:subClassOf ns1:OpticalAndOptoelectronicMaterial ;
    skos:prefLabel "PhotovoltaicMaterial"@en ;
    ns1:elucidation "Semiconducting systems that absorb photons to generate electron-hole pairs, converting solar radiation directly into electrical current."@en .

ns1:Piezoelectric a owl:Class ;
    rdfs:label "Piezoelectric"@en ;
    rdfs:subClassOf ns1:DielectricAndFerroicFunctionalMaterial,
        ns1:DielectricMaterial ;
    skos:prefLabel "Piezoelectric"@en ;
    ns1:elucidation "Materials that generate an electric charge when mechanically stressed (direct effect) and reversibly deform when an electric field is applied (converse effect)."@en .

ns1:PlasticMaterial a owl:Class ;
    rdfs:label "PlasticMaterial"@en ;
    rdfs:subClassOf ns1:MechanicalResponseMaterial ;
    skos:prefLabel "PlasticMaterial"@en ;
    ns1:elucidation "Materials that undergo permanent, non-reversible deformation after exceeding a critical yield strength threshold, typically via dislocation glide or viscous flow."@en .

ns1:PolymericMaterial a owl:Class ;
    rdfs:label "PolymericMaterial"@en ;
    rdfs:isDefinedBy <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MaterialByType ;
    skos:example "Nylon"@en,
        "PTFE"@en,
        "Poly Vinyl Chloride (PVC)"@en,
        "Polyethylene (PE)"@en,
        "Polystyrene (PS)"@en,
        "Rubber"@en ;
    skos:prefLabel "PolymericMaterial"@en ;
    ns1:elucidation "A substance made of macromolecules formed by linking many smaller, repeating chemical units called monomers into long chains or networks, resulting in unique properties like toughness, elasticity, or flexibility, found in both natural forms (like DNA, protein) and synthetic plastics, rubbers, and fibers."@en .

ns1:RefractoryMetal a owl:Class ;
    rdfs:label "RefractoryMetal"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "RefractoryMetal"@en .

ns1:SemiCrystallineCeramic a owl:Class ;
    rdfs:label "SemiCrystallineCeramic"@en ;
    rdfs:isDefinedBy <https://doi.org/10.1016/j.jnoncrysol.2018.01.033> ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:altLabel "GlassCeramic"@en,
        "MixedCeramic"@en ;
    skos:example "Porcelain"@en,
        "Pottery"@en ;
    skos:prefLabel "SemiCrystallineCeramic"@en ;
    ns1:elucidation "Hybrid crystalline/amorphous ceramics, generated from a completely amorphous state and then subjected to a controlled thermal treatment that coaxes a massive number of tiny crystals to grow inside the amorphous matrix."@en .

ns1:Semiconductor a owl:Class ;
    rdfs:label "Semiconductor"@en ;
    rdfs:subClassOf ns1:ElectricalAndElectronicMaterial ;
    skos:prefLabel "Semiconductor"@en ;
    ns1:elucidation "Materials with a tunable bandgap whose electrical conductivity can be altered via doping, thermal energy, or electrical gating."@en .

ns1:ShapeMemoryMaterial a owl:Class ;
    rdfs:label "ShapeMemoryMaterial"@en ;
    rdfs:subClassOf ns1:AdaptiveMaterial ;
    skos:prefLabel "ShapeMemoryMaterial"@en ;
    ns1:elucidation "Materials (alloys or polymers) that can be severely deformed and subsequently recover their original macroscopic shape when heated above a transition threshold."@en .

ns1:Silica a owl:Class ;
    rdfs:label "Silica"@en ;
    rdfs:subClassOf ns1:RefractoryCeramic ;
    skos:prefLabel "Silica"@en .

ns1:SingleCrystal a owl:Class ;
    rdfs:label "SingleCrystal"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:AnisotropicMaterial,
        ns1:CrystallineMaterial ;
    skos:altLabel "CrystallineState"@en,
        "Monocrystalline"@en ;
    skos:prefLabel "SingleCrystal"@en ;
    ns1:conceptualisation "In a single crystal the periodic atomic lattice is continuous and unbroken across the entire specimen. There are no internal boundaries. Examples include silicon wafers used in microchips, or gem-quality diamond."@en ;
    ns1:elucidation "A crystalline state is a single crystal when the periodic and repeated arrangement of atoms is perfect or extends throughout the entirety of the specimen without interruption."@en ;
    ns1:iupacReference <https://doi.org/10.1351/goldbook.12754> .

ns1:SpecialRefractoryCeramic a owl:Class ;
    rdfs:label "SpecialRefractoryCeramic"@en ;
    rdfs:subClassOf ns1:RefractoryCeramic ;
    skos:prefLabel "SpecialRefractoryCeramic"@en .

ns1:StructuralClayProduct a owl:Class ;
    rdfs:label "StructuralClayProduct"@en ;
    rdfs:subClassOf ns1:ClayProduct ;
    skos:prefLabel "StructuralClayProduct"@en .

ns1:StructuralMaterial a owl:Class ;
    rdfs:label "StructuralMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByFunction ;
    skos:prefLabel "StructuralMaterial"@en ;
    ns1:elucidation "Materials selected primarily for their mechanical properties, such as strength, toughness, and hardness, to bear loads or resist deformation."@en .

ns1:Superalloy a owl:Class ;
    rdfs:label "Superalloy"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "Superalloy"@en .

ns1:Superconductor a owl:Class ;
    rdfs:label "Superconductor"@en ;
    rdfs:subClassOf ns1:ElectricalAndElectronicMaterial ;
    skos:prefLabel "Superconductor"@en ;
    ns1:elucidation "Materials that exhibit zero electrical resistance and the expulsion of magnetic fields (the Meissner effect) when cooled below a critical temperature."@en .

ns1:TexturedMaterial a owl:Class ;
    rdfs:label "TexturedMaterial"@en ;
    rdfs:isDefinedBy <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:AnisotropicMaterial,
        ns1:PolyCrystallineMaterial ;
    skos:prefLabel "TexturedMaterial"@en ;
    ns1:elucidation "A polycrystalline materials with a preferential crystallographic orientation."@en .

ns1:ThermalResponseMaterial a owl:Class ;
    rdfs:label "ThermalResponseMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByForceResponse ;
    skos:prefLabel "ThermalResponseMaterial"@en ;
    ns1:elucidation "Materials classified by how they conduct kinetic thermal energy or expand volumetrically when exposed to a thermal field or temperature gradient."@en .

ns1:ThermoelectricMaterial a owl:Class ;
    rdfs:label "ThermoelectricMaterial"@en ;
    rdfs:subClassOf ns1:ThermalAndThermoelectricMaterial ;
    skos:prefLabel "ThermoelectricMaterial"@en ;
    ns1:elucidation "Materials that directly convert temperature gradients into electrical voltage (Seebeck effect) or electrical current into thermal gradients (Peltier effect)."@en .

ns1:TitaniumAlloy a owl:Class ;
    rdfs:label "TitaniumAlloy"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "TitaniumAlloy"@en .

ns1:ViscoelasticMaterial a owl:Class ;
    rdfs:label "ViscoelasticMaterial"@en ;
    rdfs:subClassOf ns1:MechanicalResponseMaterial ;
    skos:prefLabel "ViscoelasticMaterial"@en ;
    ns1:elucidation "Materials exhibiting a time-dependent mechanical response that combines elastic solid behavior and viscous fluid flow, characterized by creep and stress relaxation."@en .

ns1:WhiteIron a owl:Class ;
    rdfs:label "WhiteIron"@en ;
    rdfs:subClassOf ns1:CastIron ;
    skos:prefLabel "WhiteIron"@en .

ns1:Whitewares a owl:Class ;
    rdfs:label "Whitewares"@en ;
    rdfs:subClassOf ns1:ClayProduct ;
    skos:prefLabel "Whitewares"@en .

: a owl:Ontology ;
    dcterms:abstract "The materials module populates the physicalistic perspective with materials subclasses categorised according to modern applied physical sciences."@en ;
    dcterms:contributor <https://orcid.org/FrancescaBleken>,
        <https://orcid.org/FrancescoZaccarini> ;
    dcterms:creator <https://orcid.org/EmanueleGhedini>,
        <https://orcid.org/GerhardGoldbeck>,
        <https://orcid.org/JesperFriis> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "Materials"@en ;
    rdfs:comment "The EMMO requires HermiT reasoner plugin in order to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.0.4/disciplines/statesofmatter> ;
    owl:versionIRI <https://w3id.org/emmo/1.0.4/hume/disciplines/materials> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    ns1:contact "emmo@emmc.eu"^^xsd:string .

<https://doi.org/10.1016/j.jnoncrysol.2018.01.033> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:bibliographicCitation "Journal of Non-Crystalline Solids, Vol. 501, 2018, pp. 3-10"^^xsd:string ;
    dcterms:creator "Arun K. Varshneya"^^xsd:string,
        "Joachim Deubener"^^xsd:string,
        "Marie Allix"^^xsd:string,
        "Matthew J. Davis"^^xsd:string ;
    dcterms:description "A consensus paper providing an updated, rigorous scientific definition and nomenclature guidelines for glass-ceramic materials."^^xsd:string ;
    dcterms:identifier "10.1016/j.jnoncrysol.2018.01.033"^^xsd:string ;
    dcterms:isPartOf [ a dcmitype:Text ;
            dcterms:title "Journal of Non-Crystalline Solids"^^xsd:string ] ;
    dcterms:issued "2018"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Elsevier"^^xsd:string ;
    dcterms:subject "Amorphous Materials"^^xsd:string,
        "Crystallization"^^xsd:string,
        "Glass-ceramics"^^xsd:string,
        "Material Definition"^^xsd:string,
        "Nomenclature"^^xsd:string ;
    dcterms:title "Updated definition of glass-ceramics"^^xsd:string .

ns1:AdaptiveMaterial a owl:Class ;
    rdfs:label "AdaptiveMaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "AdaptiveMaterial"@en ;
    ns1:elucidation "Functional materials capable of macroscopic geometric or structural reconfiguration in response to environmental triggers."@en .

ns1:AmorphousMaterial a owl:Class ;
    rdfs:label "AmorphousMaterial"@en ;
    rdfs:subClassOf ns1:AmorphousState,
        ns1:MaterialByStructure ;
    skos:prefLabel "AmorphousMaterial"@en ;
    ns1:conceptualisation "While the strict definition of amorphous state includes gases and plasmas, in these states are usually not considered materials in matearial science. Restricting amorphous state only to condensed matter, is the way in which we define the class of amorphous materials."@en ;
    ns1:elucidation "An amorphous state which is also condensed matter."@en .

ns1:CompactMaterial a owl:Class ;
    rdfs:label "CompactMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByCompactness ;
    skos:prefLabel "CompactMaterial"@en .

ns1:GranularMaterial a owl:Class ;
    rdfs:label "GranularMaterial"@en ;
    rdfs:seeAlso <urn:isbn:9780387986562> ;
    rdfs:subClassOf ns1:MaterialByCompactness ;
    skos:prefLabel "GranularMaterial"@en ;
    ns1:elucidation "A granular material is a conglomeration of discrete solid, macroscopic particles that are  large enough to avoid thermal motion fluctuations, and characterized by a loss of energy whenever the particles interact."@en ;
    ns1:wikipediaReference <https://en.wikipedia.org/wiki/Granular_material> .

ns1:HighAlloySteel a owl:Class ;
    rdfs:label "HighAlloySteel"@en ;
    rdfs:subClassOf ns1:Steel ;
    skos:prefLabel "HighAlloySteel"@en .

ns1:MaterialBySize a owl:Class ;
    rdfs:label "MaterialBySize"@en ;
    rdfs:seeAlso <https://www.iso.org/obp/ui/#iso:std:iso:80004:-1:ed-1:v1:en> ;
    rdfs:subClassOf ns1:Material ;
    skos:prefLabel "MaterialBySize"@en .

ns1:MetallicMaterial a owl:Class ;
    rdfs:label "MetallicMaterial"@en ;
    rdfs:isDefinedBy <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MaterialByType ;
    skos:example "Aluminum"@en,
        "Platinum"@en,
        "Steel"@en,
        "Titanium"@en ;
    skos:prefLabel "MetallicMaterial"@en ;
    ns1:elucidation "Inorganic substance, consisting of one or more metallic elements, and often small amount of nonmetallic elements."@en ;
    ns1:note "Metallic materials are known for their shiny luster, excellent electrical/thermal conductivity, malleability (shapable by hammering), and ductility (can be drawn into wires), due to metallic bonding (shared electrons); they often form alloys (like steel from iron/carbon) to enhance these properties for diverse applications."@en .

ns1:Powder a owl:Class ;
    rdfs:label "Powder"@en ;
    rdfs:isDefinedBy <urn:isbn:9780387986562> ;
    rdfs:subClassOf ns1:GranularMaterial ;
    skos:prefLabel "Powder"@en ;
    ns1:elucidation "A powder is a granular material composed of many very fine dry solid particles that may flow freely when shaken or tilted."@en ;
    ns1:wikipediaReference "https://en.wikipedia.org/wiki/Powder"@en .

ns1:AnisotropicMaterial a owl:Class ;
    rdfs:label "AnisotropicMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByIsotropy ;
    skos:prefLabel "AnisotropicMaterial"@en ;
    ns1:elucidation "A material whose properties depend on the direction in which measurements are taken."@en .

ns1:ChemicalAndBiochemicalMaterial a owl:Class ;
    rdfs:label "ChemicalAndBiochemicalMaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "ChemicalAndBiochemicalMaterial"@en ;
    ns1:elucidation "Materials that drive chemical transformations or respond dynamically to specific molecular and biochemical environments."@en .

ns1:ClayProduct a owl:Class ;
    rdfs:label "ClayProduct"@en ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:prefLabel "ClayProduct"@en .

ns1:CopperAlloy a owl:Class ;
    rdfs:label "CopperAlloy"@en ;
    rdfs:subClassOf ns1:NonFerrousAlloy ;
    skos:prefLabel "CopperAlloy"@en .

ns1:DielectricMaterial a owl:Class ;
    rdfs:label "DielectricMaterial"@en ;
    rdfs:subClassOf ns1:ElectricalResponseMaterial ;
    skos:prefLabel "DielectricMaterial"@en ;
    ns1:elucidation "Insulating materials with bound charges and wide bandgaps that respond to an external electric field via localized electrostatic polarization rather than long-range conduction."@en .

ns1:ElectricalResponseMaterial a owl:Class ;
    rdfs:label "ElectricalResponseMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByForceResponse ;
    skos:prefLabel "ElectricalResponseMaterial"@en ;
    ns1:elucidation "Materials classified by the mobility of their internal charge carriers or the behavior of their electric dipoles under an external electric field stimulus."@en .

ns1:FerrousAlloy a owl:Class ;
    rdfs:label "FerrousAlloy"@en ;
    rdfs:subClassOf ns1:MetalAlloy ;
    skos:prefLabel "FerrousAlloy"@en ;
    ns1:elucidation "A metal alloy in which iron is the primary constituent."@en .

ns1:GlassyMaterial a owl:Class ;
    rdfs:label "GlassyMaterial"@en ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:prefLabel "GlassyMaterial"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Glass or GlassCeramic"^^xsd:string .

ns1:MaterialByClassicalMaterialsScience a owl:Class ;
    rdfs:label "MaterialByClassicalMaterialsScience"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:Material ;
    skos:prefLabel "MaterialByClassicalMaterialsScience"@en ;
    ns1:OWLRL2DLAxioms "Equivalent To: AmorphousMaterial or CrystallineMaterial"^^xsd:string,
        "Equivalent To: MetallicMaterial or CeramicMaterial or CompositeMaterial or PolymericMaterial"^^xsd:string ;
    ns1:elucidation "The class for materials categorised according to classical materials science, focusing on amorphous/crystalline nature, and main type categories (i.e., ceramic, composite, metallic and polymeric)."@en .

ns1:MaterialByCompactness a owl:Class ;
    rdfs:label "MaterialByCompactness"@en ;
    rdfs:seeAlso <urn:isbn:9780387986562> ;
    rdfs:subClassOf ns1:Material ;
    skos:prefLabel "MaterialByCompactness"@en ;
    ns1:elucidation "The class for materials categorised according to their compactness, distinguishing between granular an compact materials."@en .

ns1:MaterialByFunction a owl:Class ;
    rdfs:label "MaterialByFunction"@en ;
    rdfs:subClassOf ns1:Material ;
    skos:altLabel "FunctionalMaterial"@en ;
    skos:prefLabel "MaterialByFunction"@en .

ns1:MaterialByOrigin a owl:Class ;
    rdfs:label "MaterialByOrigin"@en ;
    rdfs:subClassOf ns1:Material ;
    skos:prefLabel "MaterialByOrigin"@en .

ns1:MetalAlloy a owl:Class ;
    rdfs:label "MetalAlloy"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MetallicMaterial ;
    skos:prefLabel "MetalAlloy"@en ;
    ns1:elucidation "A metallic material composed of two or more elements."@en .

ns1:PolyCrystallineMaterial a owl:Class ;
    rdfs:label "PolyCrystallineMaterial"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:CrystallineMaterial ;
    skos:prefLabel "PolyCrystallineMaterial"@en ;
    ns1:conceptualisation """From a strict thermodynamic and physical standpoint, a polycrystalline material is in a crystalline state. The word "state" often implies a single, uniform condition, and a polycrystal is full of messy, mismatched grain boundaries. However, in materials science and condensed matter physics, the "state" of a material is defined by its atomic structure and thermodynamic phase, not by its macro-scale uniformity.
Because the vast majority of the matter possesses long-range translational order, the bulk material exhibits the thermodynamic properties of the crystalline state (such as a sharp, distinct melting point, rather than the gradual softening seen in amorphous states like glass)."""@en ;
    ns1:elucidation "A material composed of a collection of many small individual crystalline units called grains."@en ;
    ns1:note """A polyscrystalline state is a mosaic of tiny single crystals. Inside any single grain, the atoms are perfectly ordered. However, each grain is tilted or rotated at a different angle relative to its neighbors. Where these mismatching orientations meet, they form irregular atomic interfaces known as grain boundaries. Most engineered metals, alloys, and ceramics are polycrystalline.
Inside a polycrystal, more than 99% of the atoms sit precisely on a periodic, highly ordered crystalline lattice. They have undergone a distinct phase transition (solidification/crystallization) into a crystalline state. The only atoms not in a perfect lattice are the thin, few-atom-wide walls at the grain boundaries."""@en .

ns1:Steel a owl:Class ;
    rdfs:label "Steel"@en ;
    rdfs:subClassOf ns1:FerrousAlloy ;
    skos:prefLabel "Steel"@en ;
    ns1:elucidation "Iron-carbon alloys containing other alloying elements specifically designed to enhance the properties of the material."@en .

ns1:ThermalAndThermoelectricMaterial a owl:Class ;
    rdfs:label "ThermalAndThermoelectricMaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "ThermalAndThermoelectricMaterial"@en ;
    ns1:elucidation "Materials designed to manage heat flow, store thermal energy, or directly exploit temperature differentials."@en .

<urn:isbn:9780080966656> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:creator "David R. H. Jones"^^xsd:string,
        "Michael F. Ashby"^^xsd:string ;
    dcterms:description "An introduction to the properties and applications of engineering materials, focusing on design-led selection."^^xsd:string ;
    dcterms:edition "4th Edition"^^xsd:string ;
    dcterms:identifier "ISBN-13. 9780080966656"^^xsd:string ;
    dcterms:issued "2012"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Butterworth-Heinemann"^^xsd:string ;
    dcterms:subject "Materials Science"^^xsd:string,
        "Materials Selection"^^xsd:string,
        "Mechanical Engineering"^^xsd:string,
        "Structural Materials"^^xsd:string ;
    dcterms:title "Engineering Materials 1: An Introduction to Properties, Applications, and Design"@en .

ns1:ElectricalAndElectronicMaterial a owl:Class ;
    rdfs:label "ElectricalAndElectronicMaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "ElectricalAndElectronicMaterial"@en ;
    ns1:elucidation "Materials that manipulate the behavior of electrons, holes, or mobile ions to control electrical currents or store electrical energy."@en .

ns1:LowAlloySteel a owl:Class ;
    rdfs:label "LowAlloySteel"@en ;
    rdfs:subClassOf ns1:Steel ;
    skos:prefLabel "LowAlloySteel"@en .

ns1:MaterialByIsotropy a owl:Class ;
    rdfs:label "MaterialByIsotropy"@en ;
    rdfs:subClassOf ns1:Material ;
    skos:prefLabel "MaterialByIsotropy"@en ;
    ns1:conceptualisation "A material is property-isotropic with respect to a given property if that property has the same value regardless of the direction in which you measure it. Isotropy is always property-specific: a material can be isotropic in one property and anisotropic in another simultaneously."@en ;
    ns1:elucidation "The class for materials categorised according to the isotropicity of their properties."@en .

ns1:MaterialByStructure a owl:Class ;
    rdfs:label "MaterialByStructure"@en ;
    rdfs:seeAlso <urn:isbn:9780080966656>,
        <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MaterialByClassicalMaterialsScience ;
    skos:prefLabel "MaterialByStructure"@en ;
    ns1:elucidation "The superclass for all materials that are categorised according to their periodicity/crystalline structure"@en ;
    ns1:note "The distinction between amorphous and crystalline is about structural isotropy. Property isotropy is not necessarly related to structural isotropy (e.g., an amorphous material can express some anisotropic property under external conditions such a stress, flow, fields)."@en .

ns1:OpticalAndOptoelectronicMaterial a owl:Class ;
    rdfs:label "OpticalAndOptoelectronicMaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "OpticalAndOptoelectronicMaterial"@en ;
    ns1:elucidation "Materials that interact directly with photons, modulating light transmission or converting light into electrical energy and vice versa.\"@en ."@en .

ns1:StainlessSteel a owl:Class ;
    rdfs:label "StainlessSteel"@en ;
    rdfs:subClassOf ns1:HighAlloySteel ;
    skos:prefLabel "StainlessSteel"@en ;
    ns1:elucidation "Steel with chromium as predominant alloy with a concentration of at least 11 wt%, characterised by high corrosion resistance."@en .

<urn:isbn:9780387986562> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:contributor "Axel Reisinger"^^xsd:string,
        "Pierre-Gilles de Gennes"^^xsd:string ;
    dcterms:creator "Jacques Duran"^^xsd:string ;
    dcterms:description "An introductory text focusing on the fundamental physical principles, flow behavior, and segregation mechanics of granular media."^^xsd:string ;
    dcterms:identifier "ISBN-10. 0387986561"^^xsd:string,
        "ISBN-13. 9780387986562"^^xsd:string ;
    dcterms:issued "1999"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Springer New York"^^xsd:string ;
    dcterms:subject "Fluidization"^^xsd:string,
        "Granular materials"^^xsd:string,
        "Powder mechanics"^^xsd:string,
        "Soft matter physics"^^xsd:string ;
    dcterms:title "Sands, Powders, and Grains: An Introduction to the Physics of Granular Materials"@en .

ns1:CrystallineMaterial a owl:Class ;
    rdfs:label "CrystallineMaterial"@en ;
    rdfs:isDefinedBy <https://dictionary.iucr.org/Crystal> ;
    rdfs:subClassOf ns1:CondensedMatter,
        ns1:MaterialByStructure ;
    skos:prefLabel "CrystallineMaterial"@en ;
    ns1:elucidation "A substance is in a crystal material if it has essentially a sharp diffraction pattern. The word essentially means that most of the intensity of the diffraction is concentrated in relatively sharp Bragg peaks, besides the always present diffuse scattering."@en ;
    ns1:note """A crystalline material is always condensed matter since it cannot be gaseous. In fact, in a gas we observe:
a) Thermal Dominance: The kinetic energy kB T of the particles completely overwhelms any attractive intermolecular forces
b) Mean Free Path: Gas particles are separated by vast distances relative to their size and are in constant, chaotic, random motion. They collide and scatter continuously.
Because a gas has absolutely zero correlation between the position and orientation of neighboring particles over time, it possesses no translational or orientational order which is the definition of a crystalline state."""@en,
        """Crystalline material can be solid or liquid. In fact, crystallinity is defined by atomic or molecular order, not by mechanical rigidity. Historically, "crystal" and "solid" were used interchangeably because the most common materials with long-range atomic order happen to be rigid.
However, the modern definition focuses entirely on symmetry and diffraction patterns. If a material has a regular, repeating spatial arrangement that produces a sharp, discrete X-ray diffraction pattern, it possesses crystallinity. If a material can permanently resist a shear force without flowing, it is mechanically a solid. Because these two properties are governed by different physical mechanisms, they can be decoupled."""@en,
        "Crystalline material does not imply that the entity is a single crystal, but only that its parts are in crystalline state (single crystal). Thus, a poly crystalline entity, made of crystal grains packed together is 99% a crystalline material, even if they are not oriented in the same way."@en .

ns1:DielectricAndFerroicFunctionalMaterial a owl:Class ;
    rdfs:label "DielectricAndFerroicFunctionalMaterial"@en ;
    rdfs:subClassOf ns1:FunctionalMaterial ;
    skos:prefLabel "DielectricAndFerroicFunctionalMaterial"@en ;
    ns1:elucidation "Materials that rely on the alignment and manipulation of internal electric dipoles, magnetic moments, or spontaneous lattice strains."@en .

ns1:MaterialByForceResponse a owl:Class ;
    rdfs:label "MaterialByForceResponse"@en ;
    rdfs:subClassOf ns1:Material ;
    skos:prefLabel "MaterialByForceResponse"@en ;
    ns1:elucidation "A classification system categorization of materials based on their constitutive behavior, energy storage, or deformation mechanisms when subjected to external physical fields or mechanical loads."@en .

ns1:MaterialByType a owl:Class ;
    rdfs:label "MaterialByType"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MaterialByClassicalMaterialsScience ;
    skos:prefLabel "MaterialByType"@en ;
    ns1:elucidation "The class for materials categorised according material science main type categories (i.e., ceramic, composite, metallic and polymeric)."@en .

ns1:RefractoryCeramic a owl:Class ;
    rdfs:label "RefractoryCeramic"@en ;
    rdfs:subClassOf ns1:CeramicMaterial ;
    skos:prefLabel "RefractoryCeramic"@en .

dcmitype:Text a owl:Class .

ns1:CastIron a owl:Class ;
    rdfs:label "CastIron"@en ;
    rdfs:subClassOf ns1:FerrousAlloy ;
    skos:prefLabel "CastIron"@en .

ns1:MagneticResponseMaterial a owl:Class ;
    rdfs:label "MagneticResponseMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByForceResponse ;
    skos:prefLabel "MagneticResponseMaterial"@en ;
    ns1:elucidation "Materials classified by the orientation, coupling, and net macroscopic alignment of their atomic magnetic moments under an external magnetic field force."@en .

ns1:MechanicalResponseMaterial a owl:Class ;
    rdfs:label "MechanicalResponseMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByForceResponse ;
    skos:prefLabel "MechanicalResponseMaterial"@en ;
    ns1:elucidation "Materials classified by their structural deformation and energy dissipation behaviors when subjected to mechanical tensile, compressive, or shear stress."@en .

ns1:FunctionalMaterial a owl:Class ;
    rdfs:label "FunctionalMaterial"@en ;
    rdfs:subClassOf ns1:MaterialByFunction ;
    skos:prefLabel "FunctionalMaterial"@en ;
    ns1:elucidation "A functional material is any material that exhibits distinct, reproducible changes in its electronic, magnetic, optical, chemical, or thermal properties when exposed to an external field or environmental change."@en ;
    ns1:note "Materials categorised for what they do rather than what they hold up. They are designed to react to their environment, convert energy, or process information."@en .

ns1:Material a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:seeAlso <urn:isbn:9780080966656>,
        <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:CondensedMatter,
        ns1:OrdinaryMatter ;
    skos:prefLabel "Material"@en ;
    ns1:conceptualisation "It is quite hard to define what a material is, given the wide range of use of such term, especially in order to distinguish it from the more general matter concept. First, we decided to restrict the term's domain with respect to matter, by making a material always an ordinary and condensed matter entity, thus excluding antimatter, particulate matter (e.g., molecular entities such as atoms and molecules), and mesoscopic entities (e.g., nanoparticles). Then, to call material every entity that can be categorised according to the typical criteria used in material science (e.g., by structure, function, size, isotropy). Such criteria usually categorise a substance according to kind, quality or quantity and are expressed in order to facilitate the identification of specific class of substances according to an intended use. In short, a material is what is called material in material science."@en ;
    ns1:elucidation "A material is condensed matter categorized according to some criteria based on kind, quality or quantity. An intended use is typically associated with each of the classes used to categorize a material entity."@en ;
    ns1:note "A instance of a material (e.g. nitrogen) can represent any state of matter. The fact that the individual also belongs to other classes (e.g. liquid) would reveal the actual form in which the material is found."@en,
        "A material may be either a fluid or a solid substance. Gas is not a material, because the material concept is here restricted to classical material science, focusing exclusively on condensed matter."@en,
        """Materials are here restricted to condensed matter. The core paradigm of materials science is the Structure-Property-Processing-Performance relationship. This paradigm relies entirely on atoms being close enough to interact continuously, thus excluding non-condensed matter from the materials field:
- Structure: refers to crystal lattices, defects, grain boundaries, or amorphous molecular networks. Gases, by definition, lack any long-range or short-range structural arrangement because their particles are in constant, random motion.
- Properties: materials science measures collective mechanical properties (elastic modulus, hardness), thermal properties (conductivity), and electrical properties (band gaps). A gas cannot support a shear stress, deform plastically, or possess a structural microstructure.
Because gases lack a fixed structure, they are traditionally handed over to chemistry, thermodynamics, or fluid mechanics, rather than materials science."""@en,
        "The concept of material is not an ontological one i.e., does not originate from the entity per se, but originates from actual materials science practitioners and their categorisation habits. For this reason, all materials subclasses are grouped according to classification criteria (e.g., by compactness, by function, by size)."@en .

ns1:NonFerrousAlloy a owl:Class ;
    rdfs:label "NonFerrousAlloy"@en ;
    rdfs:subClassOf ns1:MetalAlloy ;
    skos:prefLabel "NonFerrousAlloy"@en ;
    ns1:elucidation "A metal alloy in which iron is not the primary constituent."@en .

ns1:CeramicMaterial a owl:Class ;
    rdfs:label "CeramicMaterial"@en ;
    rdfs:isDefinedBy <urn:isbn:9780471736967> ;
    rdfs:subClassOf ns1:MaterialByType ;
    skos:altLabel "Ceramic"@en ;
    skos:example "Al₂O₃ based compunds"@en,
        "Concrete"@en,
        "Glass"@en,
        "SiC or Si₃N₄ based compunds"@en,
        "ZrO₂ based compunds"@en ;
    skos:prefLabel "CeramicMaterial"@en ;
    ns1:conceptualisation "Ceramic is defined commonly as an inorganic non-metallic substance made from elements (metals, non-metals, semi-metals like silicon) combined into compounds. Ceramics are mostly oxides, nitrides and carbides."@en ;
    ns1:elucidation "An inorganic non-metallic substance made from elements (metals, non-metals, semi-metals like silicon) combined into compounds (oxides, carbides, nitrides) that are typically hard, strong, brittle, corrosion-resistant, and good insulators."@en ;
    ns1:note """A ceramic with a disordered, random structure frozen in place, is considered amorphous. An amorphous ceramic can be categorised according to its formation process, depending on the fact that it went or not through a glass transition in glass or amorphous solid.
The distinction is about the thermodynamic state of the material. Because a true glass was once a liquid, it occupies a specific metastable energy state dictated by how fast it was cooled. If you take an amorphous solid thin film (e.g., made by PVD) and heat it up, it will often crystallize abruptly or behave unpredictably because it has a highly stressed, ultra-high-energy structure. A true glass, when heated, will predictably soften into a supercooled liquid once it hits its Tg."""@en,
        """While the word "ceramic" instantly brings to mind brittle, rigid objects like coffee mugs, brick, or technical alumina plates, a ceramic is defined purely by its chemical bonds and atomic structure, as an inorganic non-metallic substance.
Here we embrace this definition in its wide and literal meaning, even if in practical cases the term ceramic is restricted only to high-temperature, corrosion and wear resistant materials."""@en .


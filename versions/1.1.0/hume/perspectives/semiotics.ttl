@prefix : <https://w3id.org/emmo/hume/perspectives/semiotics#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#> .
@prefix ns2: <https://w3id.org/emmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:Communicating a owl:Class ;
    rdfs:label "Communicating"@en ;
    rdfs:subClassOf ns2:FullSemiosis ;
    skos:example "I (interpreter) see an entity (referent) whose perception stimulates in me an internal representation (interpretant). Then I say: \"Ketchup.\" (sign) with the intention of communicate externally something about that entity."@en ;
    skos:prefLabel "Communicating"@en ;
    ns2:elucidation "A semiosis where the interpreter perceives a referent, that generates the interpretant as interpreter's internal representation. Than the interpretant is communicated by the interpreter by the production of a sign, i.e. the entity that stands for the referent according to the interpreter."@en .

ns2:EMMO_607b00f2_812c_4aa9_9253_266d266af1fa a owl:ObjectProperty ;
    rdfs:label "isPropertyPart"@en ;
    rdfs:subPropertyOf ns2:isPortionPartOf ;
    owl:inverseOf ns2:EMMO_64e4d7b0_f07b_4328_9282_7bf9fb0c3d09 .

ns2:Estimated a owl:Class ;
    rdfs:subClassOf ns2:CodedByObservation ;
    skos:example "The biography of a person that the author have not met."@en ;
    skos:prefLabel "Estimated"@en ;
    ns2:elucidation "A coded that is assigned from an estimation."@en .

ns2:Expressing a owl:Class ;
    rdfs:label "Expressing"@en ;
    rdfs:subClassOf ns2:PartialSemiosis ;
    skos:prefLabel "Expressing"@en ;
    ns2:elucidation "A semiosis where the interpreter wants to express an interpretant (e.g., an idea, a reasoning, a distant entity) to the rest of the world by the production of a sign. In the intention of the interpreter, the sign should impress another agent with an intended interpretation that should match his one."@en .

ns2:Learning a owl:Class ;
    rdfs:label "Learning"@en ;
    rdfs:subClassOf ns2:PartialSemiosis ;
    skos:prefLabel "Learning"@en ;
    ns2:elucidation "A semiosis where the interpreter perceives a referent, that generates the interpretant as interpreter's internal representation.The interpretant is not commmunicated to the external world, but kept in the internal representational space of the interpreter."@en .

ns2:Objective a owl:Class ;
    rdfs:comment """The word objective does not mean that each observation will provide the same results. It means that the observation followed a well defined procedure.

This class refers to what is commonly known as physical property, i.e. a measurable property of physical system, whether is quantifiable or not."""@en ;
    rdfs:subClassOf ns2:CodedBySubjectivity ;
    skos:prefLabel "Objective"@en ;
    ns2:elucidation "A coded conventional that is determined by each interpeter following a well defined determination procedure through a specific perception channel."@en .

ns2:Observed a owl:Class ;
    rdfs:subClassOf ns2:CodedByObservation ;
    skos:example "The biography of a person met by the author."@en ;
    skos:prefLabel "Observed"@en ;
    ns2:elucidation "A coded that has been observed by an interpreter."@en .

ns2:Resolving a owl:Class ;
    rdfs:label "Resolving"@en ;
    rdfs:subClassOf ns2:FullSemiosis ;
    skos:example "Someone says: \"Ketchup.\" (sign). I (interpreter) hear that, elaborate internally the perception by creating an internal representation (interpretant), and then reach for the ketchup bottle (referent)."@en ;
    skos:prefLabel "Resolving"@en ;
    ns2:elucidation "A semiosis where the interpreter perceives a sign, that generates the interpretant as interpreter's internal representation. Than the interpretant is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding."@en .

ns2:Subjective a owl:Class ;
    rdfs:comment """The word subjective applies to property intrisically subjective or non-well defined. In general, when an black-box-like procedure is used for the definition of the property.

This happens due to e.g. the complexity of the object, the lack of a underlying model for the representation of the object, the non-well specified meaning of the property symbols.

A 'SubjectiveProperty' cannot be used to univocally compare 'Object'-s.

e.g. you cannot evaluate the beauty of a person on objective basis."""@en ;
    rdfs:subClassOf ns2:CodedBySubjectivity ;
    skos:example """The beauty of that girl.
The style of your clothing."""@en ;
    skos:prefLabel "Subjective"@en ;
    ns2:elucidation "A coded conventional that cannot be univocally determined and depends on an agent (e.g. a human individual, a community) acting as black-box."@en .

ns2:Uncoded a owl:Class ;
    rdfs:label "Uncoded"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasSign ] ;
            owl:someValuesFrom ns2:Naming ],
        ns2:Conventional ;
    skos:example "A random generated id for a product."@en ;
    skos:prefLabel "Uncoded"@en ;
    ns2:elucidation "A conventional that provides no possibility to infer the characteristics of the object to which it refers."@en .

ns2:Understanding a owl:Class ;
    rdfs:label "Understanding"@en ;
    rdfs:subClassOf ns2:PartialSemiosis ;
    skos:prefLabel "Understanding"@en ;
    ns2:elucidation "A semiosis where the interpreter perceives a sign, that generates the interpretant as interpreter's internal representation, leading to potential interpretations."@en .

ns2:Verifying a owl:Class ;
    rdfs:label "Verifying"@en ;
    rdfs:subClassOf ns2:PartialSemiosis ;
    skos:prefLabel "Verifying"@en ;
    ns2:elucidation "A semiosis where an interpretant, already present in the internal representational space of the interpreter, is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding."@en .

ns2:hasCognised a owl:ObjectProperty ;
    rdfs:label "hasCognised"@en ;
    ns1:python_name "hasCognised"@en ;
    rdfs:domain ns2:Cogniser ;
    rdfs:subPropertyOf ns2:providesInterpretation ;
    owl:inverseOf ns2:isCognisedBy ;
    skos:prefLabel "hasCognised"@en ;
    ns2:elucidation "A semiotic relation connecting a recogniting interpreter to the \"cognised\" semiotic object in a cognition process."@en .

ns2:hasCogniser a owl:ObjectProperty ;
    rdfs:label "hasCogniser"@en ;
    ns1:python_name "hasCogniser"@en ;
    rdfs:domain ns2:Icon ;
    rdfs:range ns2:Cogniser ;
    rdfs:subPropertyOf ns2:isInterpretedBy ;
    owl:inverseOf ns2:isCogniserFor ;
    skos:prefLabel "hasCogniser"@en ;
    ns2:elucidation "A semiotic relation connecting an icon to a interpreter (cogniser) in a cognition process."@en .

ns2:hasDeduced a owl:ObjectProperty ;
    rdfs:label "hasDeduced"@en ;
    ns1:python_name "hasDeduced"@en ;
    rdfs:domain ns2:Deducer ;
    rdfs:subPropertyOf ns2:providesInterpretation ;
    owl:inverseOf ns2:isDeducedBy ;
    skos:prefLabel "hasDeduced"@en ;
    ns2:elucidation "A semiotic relation connecting a deducing interpreter to the \"deduced\" semiotic object in a deduction process."@en .

ns2:hasDeducer a owl:ObjectProperty ;
    rdfs:label "hasDeducer"@en ;
    ns1:python_name "hasDeducer"@en ;
    rdfs:domain ns2:Index ;
    rdfs:range ns2:Deducer ;
    rdfs:subPropertyOf ns2:isInterpretedBy ;
    owl:inverseOf ns2:isDeducerFor ;
    skos:prefLabel "hasDeducer"@en ;
    ns2:elucidation "A semiotic relation connecting an index sign to the interpreter (deducer) in a deduction process."@en .

ns2:hasDescription a owl:ObjectProperty ;
    rdfs:label "hasDescription"@en ;
    ns1:python_name "hasDescription"@en ;
    rdfs:range ns2:Description ;
    rdfs:subPropertyOf ns2:hasConvention ;
    owl:inverseOf ns2:isDescriptionFor ;
    skos:prefLabel "hasDescription"@en ;
    ns2:elucidation "A semiotic relation that connects a declared semiotic object to a description in a declaration process."@en .

ns2:hasIcon a owl:ObjectProperty ;
    rdfs:label "hasIcon"@en ;
    ns1:python_name "hasIcon"@en ;
    rdfs:range ns2:Icon ;
    rdfs:subPropertyOf ns2:isRepresentedBy ;
    owl:inverseOf ns2:isIconFor ;
    skos:prefLabel "hasIcon"@en ;
    ns2:elucidation "A semiotic relation that connects a recognised semiotic object to an icon in a cognition process."@en .

ns2:hasIndex a owl:ObjectProperty ;
    rdfs:label "hasIndex"@en ;
    ns1:python_name "hasIndex"@en ;
    rdfs:range ns2:Index ;
    rdfs:subPropertyOf ns2:isRepresentedBy ;
    owl:inverseOf ns2:IsIndexFor ;
    skos:prefLabel "hasIndex"@en ;
    ns2:elucidation "A semiotic relation that connects a deduced semiotic object to an index in a deduction process."@en .

ns2:isDeclaredBy a owl:ObjectProperty ;
    rdfs:label "isDeclaredBy"@en ;
    ns1:python_name "isDeclaredBy"@en ;
    rdfs:subPropertyOf ns2:isInterpretationAccordingTo ;
    owl:inverseOf ns2:hasDeclared ;
    skos:prefLabel "isDeclaredBy"@en .

ns2:isDeclarerFor a owl:ObjectProperty ;
    rdfs:label "isDeclarerFor"@en ;
    ns1:python_name "isDeclarerFor"@en ;
    rdfs:subPropertyOf ns2:interprets ;
    owl:inverseOf ns2:hasDeclarer ;
    skos:prefLabel "isDeclarerFor"@en .

ns2:isInternalRepresentationBy a owl:ObjectProperty ;
    rdfs:label "isInternalRepresentationBy"@en ;
    ns1:python_name "isInternalRepresentationBy"@en ;
    rdfs:isDefinedBy ns2:hasInternalRepresentation ;
    rdfs:subPropertyOf ns2:semioticOvercrossedBy ;
    owl:inverseOf ns2:hasInternalRepresentation ;
    skos:prefLabel "isInternalRepresentationBy"@en .

ns2:isInterpreterFor a owl:ObjectProperty ;
    rdfs:label "isInterpreterFor"@en ;
    ns1:python_name "isInterpreterFor"@en ;
    rdfs:isDefinedBy ns2:hasInterpreter ;
    rdfs:subPropertyOf ns2:semioticOvercrossedBy ;
    owl:inverseOf ns2:hasInterpreter ;
    skos:prefLabel "isInterpreterFor"@en .

ns2:isPropertyFor a owl:ObjectProperty ;
    rdfs:label "isPropertyFor"@en ;
    ns1:python_name "isPropertyFor"@en ;
    rdfs:subPropertyOf ns2:isConventionFor ;
    owl:inverseOf ns2:hasProperty ;
    skos:prefLabel "isPropertyFor"@en .

ns2:isSignFor a owl:ObjectProperty ;
    rdfs:label "isSignFor"@en ;
    ns1:python_name "isSignFor"@en ;
    rdfs:isDefinedBy ns2:hasSign ;
    rdfs:subPropertyOf ns2:semioticOvercrossedBy ;
    owl:inverseOf ns2:hasSign ;
    skos:prefLabel "isSignFor"@en .

: a owl:Ontology ;
    dcterms:abstract """The semiotics module is inspired by the semiotic theory by Charles S. Peirce. It introduces the triadic semiotic process, called semiosis, with its participants an 'object' that is represented by a 'sign' producing another sign, the 'interpretant' and finally the 'interpreter' who connects the 'object', 'sign' and 'interpretant'.
The role of abstract objects are in EMMO fulfilled by semiotic objects, i.e. real world objects (e.g. symbol or sign) that stand for other real world objects that are to be interpreted by an agent. These symbols appear in actions (semiotic processes) meant to communicate meaning by establishing relationships between symbols (signs)."""@en ;
    dcterms:contributor <https://orcid.org/AdhamHashibon>,
        <https://orcid.org/AnnedeBaas>,
        <https://orcid.org/FrancescoZaccarini>,
        <https://orcid.org/OtelloRoscioni> ;
    dcterms:creator <https://orcid.org/EmanueleGhedini>,
        <https://orcid.org/GerhardGoldbeck>,
        <https://orcid.org/JesperFriis> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "Semiotics"@en ;
    rdfs:comment "The EMMO requires HermiT reasoner plugin in order to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.0.4/perspectives/perspective> ;
    owl:versionIRI <https://w3id.org/emmo/1.0.4/hume/perspectives/semiotics> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    ns2:contact "emmo@emmc.eu"^^xsd:string .

ns2:AnalogicalIcon a owl:Class ;
    rdfs:label "AnalogicalIcon"@en ;
    rdfs:subClassOf ns2:Icon ;
    skos:example "A physics equation is replicating the mechanisms internal to the object."@en,
        "Electrical diagram is diagrammatic and resemblance"@en,
        "MODA and CHADA are diagrammatic representation of a simulation or a characterisation workflow."@en ;
    skos:prefLabel "AnalogicalIcon"@en ;
    ns2:elucidation "An icon that represents the internal logical structure of the object."@en ;
    ns2:note "An icon that focus on HOW the object works."@en,
        "The subclass of icon inspired by Peirceian category (b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy (with the same logic) the relations in something (e.g. math formula, geometric flowchart)."@en .

ns2:EMMO_64e4d7b0_f07b_4328_9282_7bf9fb0c3d09 a owl:ObjectProperty ;
    rdfs:label "hasPropertyPart"@en ;
    rdfs:domain ns2:Description ;
    rdfs:range ns2:Property ;
    rdfs:subPropertyOf ns2:hasPortionPart ;
    ns2:elucidation "The relation connecting a description with its property parts. Description and parts are signs for the same entity"@en ;
    ns2:note "This relation is used to specify the detailed information that make up the overall description for an entity. A description can be used to summarize in one single entiity several properties relaterd to the same referent."@en .

ns2:Estimator a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Estimation ],
        ns2:Determiner ;
    skos:prefLabel "Estimator"@en ;
    ns2:elucidation "A characteriser that declares a property for an object without actually interact with it with the specific interaction required by the property definition (i.e. infer a property from other properties)."@en .

ns2:FunctionalIcon a owl:Class ;
    rdfs:subClassOf ns2:Icon ;
    skos:example "A data based model is only a functional icon, since it provide the same relations between the properties of the object (e.g., it can predict some properties as function of others) but is not considering the internal mechanisms (i.e., it can ignore the physics)."@en ;
    skos:prefLabel "FunctionalIcon"@en ;
    ns2:elucidation "An icon that imitates one representative character of the object. It share external similarities with the object, but not necessarily the same internal logical structure."@en ;
    ns2:note "An icon that focusing WHAT the object does."@en,
        "This subclass of icon inspired by Peirceian category (c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else."@en .

ns2:IsIndexFor a owl:ObjectProperty ;
    rdfs:label "IsIndexFor"@en ;
    ns1:python_name "IsIndexFor"@en ;
    rdfs:subPropertyOf ns2:standsFor ;
    skos:prefLabel "IsIndexFor"@en .

ns2:Namer a owl:Class ;
    rdfs:label "Namer"@en ;
    rdfs:subClassOf ns2:Declarer ;
    skos:prefLabel "Namer"@en ;
    ns2:elucidation "An interpreter who assigns a name to an object without any motivations related to the object characters."@en .

ns2:Naming a owl:Class ;
    rdfs:label "Naming"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Namer ],
        ns2:Declaration ;
    skos:example "A unique id attached to an entity."@en ;
    skos:prefLabel "Naming"@en ;
    ns2:elucidation "A declaration that provides a sign for an object that is independent from any assignment rule."@en .

ns2:Observer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Observation ],
        ns2:Determiner ;
    skos:prefLabel "Observer"@en ;
    ns2:elucidation "A characteriser that declares a property for an object through the specific interaction required by the property definition."@en .

ns2:ResemblanceIcon a owl:Class ;
    rdfs:label "ResemblanceIcon"@en ;
    rdfs:subClassOf ns2:Icon ;
    skos:example "A geographical map that imitates the shape of the landscape and its properties at a specific historical time."@en ;
    skos:prefLabel "ResemblanceIcon"@en ;
    ns2:elucidation "An icon that mimics the spatial or temporal shape of the object."@en ;
    ns2:note "An icon that focus on WHERE/WHEN the object is, in the sense of spatial or temporal shape."@en,
        "The subclass of icon inspired by Peirceian category a) the image, which depends on a simple quality (e.g. picture)."@en .

ns2:hasDeclared a owl:ObjectProperty ;
    rdfs:label "hasDeclared"@en ;
    ns1:python_name "hasDeclared"@en ;
    rdfs:domain ns2:Declarer ;
    rdfs:subPropertyOf ns2:providesInterpretation ;
    skos:prefLabel "hasDeclared"@en ;
    ns2:elucidation "A semiotic relation connecting a declaring interpreter to the \"declared\" semiotic object in a declaration process."@en .

ns2:hasDeclarer a owl:ObjectProperty ;
    rdfs:label "hasDeclarer"@en ;
    ns1:python_name "hasDeclarer"@en ;
    rdfs:domain ns2:Conventional ;
    rdfs:range ns2:Declarer ;
    rdfs:subPropertyOf ns2:isInterpretedBy ;
    skos:prefLabel "hasDeclarer"@en ;
    ns2:elucidation "A semiotic relation connecting a conventional sign to the interpreter (declarer) in a declaration process."@en .

ns2:hasProperty a owl:ObjectProperty ;
    rdfs:label "hasProperty"@en ;
    ns1:python_name "hasProperty"@en ;
    rdfs:domain ns2:Referent ;
    rdfs:range ns2:Property ;
    rdfs:subPropertyOf ns2:hasConvention ;
    skos:prefLabel "hasProperty"@en ;
    ns2:elucidation "A semiotic relation that connects a semiotic object to a property in a declaration process."@en .

ns2:isCognisedBy a owl:ObjectProperty ;
    rdfs:label "isCognisedBy"@en ;
    ns1:python_name "isCognisedBy"@en ;
    rdfs:subPropertyOf ns2:isInterpretationAccordingTo ;
    skos:prefLabel "isCognisedBy"@en .

ns2:isCogniserFor a owl:ObjectProperty ;
    rdfs:label "isCogniserFor"@en ;
    ns1:python_name "isCogniserFor"@en ;
    rdfs:subPropertyOf ns2:interprets ;
    skos:prefLabel "isCogniserFor"@en .

ns2:isDeducedBy a owl:ObjectProperty ;
    rdfs:label "isDeducedBy"@en ;
    ns1:python_name "isDeducedBy"@en ;
    rdfs:subPropertyOf ns2:isInterpretationAccordingTo ;
    skos:prefLabel "isDeducedBy"@en .

ns2:isDeducerFor a owl:ObjectProperty ;
    rdfs:label "isDeducerFor"@en ;
    ns1:python_name "isDeducerFor"@en ;
    rdfs:subPropertyOf ns2:interprets ;
    skos:prefLabel "isDeducerFor"@en .

ns2:isDescriptionFor a owl:ObjectProperty ;
    rdfs:label "isDescriptionFor"@en ;
    ns1:python_name "isDescriptionFor"@en ;
    rdfs:domain ns2:Description ;
    rdfs:subPropertyOf ns2:isConventionFor ;
    skos:prefLabel "isDescriptionFor"@en ;
    ns2:elucidation "A semiotic relation that connects a description to a declared semiotic objec in a declaration process."@en .

ns2:isIconFor a owl:ObjectProperty ;
    rdfs:label "isIconFor"@en ;
    ns1:python_name "isIconFor"@en ;
    rdfs:subPropertyOf ns2:standsFor ;
    skos:prefLabel "isIconFor"@en .

ns2:isInterpretantFor a owl:ObjectProperty ;
    rdfs:label "isInterpretantFor"@en ;
    ns1:python_name "isInterpretantFor"@en ;
    rdfs:isDefinedBy ns2:hasInterpretant ;
    rdfs:subPropertyOf ns2:semioticOvercrossedBy ;
    skos:prefLabel "isInterpretantFor"@en .

ns2:isReferentFor a owl:ObjectProperty ;
    rdfs:label "isReferentFor"@en ;
    ns1:python_name "isReferentFor"@en ;
    rdfs:isDefinedBy ns2:hasReferent ;
    rdfs:subPropertyOf ns2:semioticOvercrossedBy ;
    skos:prefLabel "isReferentFor"@en .

ns2:isSignificationFor a owl:ObjectProperty ;
    rdfs:label "isSignificationFor"@en ;
    ns1:python_name "isSignificationFor"@en ;
    rdfs:domain ns2:Sign ;
    rdfs:range ns2:Interpretant ;
    rdfs:subPropertyOf ns2:semiotical ;
    owl:inverseOf ns2:isSignifiedBy ;
    skos:prefLabel "isSignificationFor"@en .

ns2:refersTo a owl:ObjectProperty ;
    rdfs:label "refersTo"@en ;
    ns1:python_name "refersTo"@en ;
    rdfs:domain ns2:Interpretant ;
    rdfs:range ns2:Referent ;
    rdfs:subPropertyOf ns2:semiotical ;
    owl:inverseOf ns2:isReferredBy ;
    skos:prefLabel "refersTo"@en .

ns2:CodedByObservation a owl:Class ;
    rdfs:subClassOf ns2:Coded ;
    skos:prefLabel "CodedByObservation"@en ;
    ns2:elucidation "A coded classified by observation."@en .

ns2:CodedByStructure a owl:Class ;
    rdfs:subClassOf ns2:Coded ;
    skos:prefLabel "CodedByStructure"@en ;
    ns2:elucidation "A coded classified by its structure."@en .

ns2:CodedBySubjectivity a owl:Class ;
    rdfs:subClassOf ns2:Coded ;
    skos:prefLabel "CodedBySubjectivity"@en ;
    ns2:elucidation "A coded classified by whether it is determined subjectively or objectively."@en .

ns2:Cognition a owl:Class ;
    rdfs:label "Cognition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Cogniser ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasSign ;
            owl:someValuesFrom ns2:Icon ],
        ns2:SemiosisByReferent ;
    skos:altLabel "IconSemiosis"@en ;
    skos:prefLabel "Cognition"@en ;
    ns2:elucidation "A semiotic process that assigns a sign by recognising an object by how it resemble or imitate what the sign stands for, in shape, function or by sharing a similar logical structure."@en .

ns2:Deduction a owl:Class ;
    rdfs:label "Deduction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Deducer ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasSign ;
            owl:someValuesFrom ns2:Index ],
        ns2:SemiosisByReferent ;
    skos:altLabel "IndexSemiosis"@en ;
    skos:example "The interpreter feels that the plate is hot and assigns the status of the kitchen stove to be on."@en ;
    skos:prefLabel "Deduction"@en ;
    ns2:elucidation "A semiotic process that assigns a sign by deduction from causal continguity."@en .

ns2:Estimation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Estimator ],
        ns2:Determination ;
    skos:prefLabel "Estimation"@en ;
    ns2:elucidation "A determination of an object without any actual interaction."@en .

ns2:FullSemiosis a owl:Class ;
    rdfs:label "FullSemiosis"@en ;
    rdfs:subClassOf ns2:SemiosisByStructure ;
    skos:prefLabel "FullSemiosis"@en ;
    ns2:elucidation "A semiosis where the triangle of relations is completely developed."@en .

ns2:Observation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Observer ],
        ns2:Determination ;
    skos:prefLabel "Observation"@en ;
    ns2:elucidation "A characterisation of an object with an actual interaction."@en .

ns2:SemiosisByStructure a owl:Class ;
    rdfs:label "SemiosisByStructure"@en ;
    rdfs:subClassOf ns2:Semiosis ;
    skos:prefLabel "SemiosisByStructure"@en ;
    ns2:elucidation "Semiosis classified as complete or partial representation of the semiotic triangle (interpretant, sign, referent)."@en .

ns2:hasReferent a owl:ObjectProperty ;
    rdfs:label "hasReferent"@en ;
    ns1:python_name "hasReferent"@en ;
    rdfs:domain ns2:Semiosis ;
    rdfs:range ns2:Referent ;
    rdfs:subPropertyOf ns2:semioticOvercrosses ;
    owl:inverseOf ns2:isReferentFor ;
    skos:prefLabel "hasReferent"@en ;
    ns2:elucidation "The relation between a semiotic process and the referent i.e., the object of the semiotic process."@en .

ns2:isConventionFor a owl:ObjectProperty ;
    rdfs:label "isConventionFor"@en ;
    ns1:python_name "isConventionFor"@en ;
    rdfs:subPropertyOf ns2:standsFor ;
    owl:inverseOf ns2:hasConvention ;
    skos:prefLabel "isConventionFor"@en .

ns2:isReferredBy a owl:ObjectProperty ;
    rdfs:label "isReferredBy"@en ;
    ns1:python_name "isReferredBy"@en ;
    rdfs:subPropertyOf ns2:semiotical ;
    skos:prefLabel "isReferredBy"@en .

ns2:isSignifiedBy a owl:ObjectProperty ;
    rdfs:label "isSignifiedBy"@en ;
    ns1:python_name "isSignifiedBy"@en ;
    rdfs:subPropertyOf ns2:semiotical ;
    skos:prefLabel "isSignifiedBy"@en .

ns2:Coded a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasSign ] ;
            owl:someValuesFrom ns2:Determination ],
        ns2:Conventional ;
    skos:example "A biography that makes use of a code that is provided by the meaning of the element of the language used by the author."@en,
        "The name \"red\" that stands for the color of an object."@en ;
    skos:prefLabel "Coded"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Description or Property"^^xsd:string,
        "EquivalentTo: Observed or Estimated"^^xsd:string,
        "EquivalentTo: Subjective or Objective"^^xsd:string ;
    ns2:elucidation "A conventional that stands for an object according to a code of interpretation to which the interpreter refers."@en ;
    ns2:note """A conventional referring to an object according to a specific code that reflects the results of a specific interaction mechanism and is shared between other interpreters.
A coded is always a partial representation of an object since it reflects the object capability to be part of a specific determination.
A coded is a sort of name or label that we put upon objects that interact with an determiner in the same specific way.

For example, "hot" objects are objects that interact with an observer through a perception mechanism aimed to perceive an heat source. The code is made of terms such as "hot", "warm", "cold", that commonly refer to the perception of heat."""@en,
        """Let's define the class Colour as the subclass of the coded signs that involve photon emission and electromagnetic radiation sensible observers.
An individual C of this class Colour can be defined be declaring the process individual (e.g. daylight illumination) and the observer (e.g. my eyes)
Stating that an entity E hasCoded C, we mean that it can be observed by such setup of process + observer (i.e. observed by my eyes under daylight).
This definition can be specialised for human eye perception, so that the observer can be a generic human, or to camera perception so that the observer can be a device.
This can be used in material characterization, to define exactly the type of measurement done, including the instrument type."""@en .

ns2:Deducer a owl:Class ;
    rdfs:label "Deducer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Deduction ],
        ns2:InterpreterByReferent ;
    skos:example "Someone who deduces an emotional status of a persona according to facial expression."^^xsd:string,
        "Someone who deduces the occurring of a physical phenomenon through other phenomena."^^xsd:string ;
    skos:prefLabel "Deducer"@en ;
    ns2:elucidation "An interpreter who establish the connection between an index sign and an object according to a causal contiguity."@en .

ns2:Description a owl:Class ;
    rdfs:subClassOf ns2:CodedByStructure ;
    skos:example "A biography."@en,
        "A sentence about some object, depticting its properties."@en ;
    skos:prefLabel "Description"@en ;
    ns2:elucidation "A coded that is not atomic with respect to a code of description."@en ;
    ns2:note "A description is a collection of properties that depicts an object. It is not atomic since it is made of several properties collected together."@en .

ns2:Determiner a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Determination ],
        ns2:Declarer ;
    skos:prefLabel "Determiner"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Estimator or Observer"^^xsd:string ;
    ns2:elucidation "An 'interpreter' that perceives another 'entity' (the 'object') through a specific perception mechanism and produces a 'property' (the 'sign') that stands for the result of that particular perception."@en .

ns2:InterpreterByReferent a owl:Class ;
    rdfs:subClassOf ns2:Interpreter ;
    skos:prefLabel "InterpreterByReferent"@en ;
    ns2:elucidation "Interpreter classified by how the sign stands for its reference object."@en .

ns2:SemiosisByReferent a owl:Class ;
    rdfs:seeAlso "https://plato.stanford.edu/entries/peirce-semiotics/"^^xsd:anyURI ;
    rdfs:subClassOf ns2:Semiosis ;
    skos:prefLabel "SemiosisByReferent"@en ;
    ns2:elucidation "Semiosis classified by how the sign stands for its reference object."@en .

ns2:SignByReferent a owl:Class ;
    rdfs:subClassOf ns2:Sign ;
    skos:prefLabel "SignByReferent"@en ;
    ns2:elucidation "Sign classified by how the sign stands for its reference object."@en .

ns2:hasConvention a owl:ObjectProperty ;
    rdfs:label "hasConvention"@en ;
    ns1:python_name "hasConvention"@en ;
    rdfs:range ns2:Conventional ;
    rdfs:subPropertyOf ns2:isRepresentedBy ;
    skos:prefLabel "hasConvention"@en ;
    ns2:elucidation "A semiotic relation that connects a declared semiotic object to a conventional sign in a declaration process."@en .

ns2:hasInterpretant a owl:ObjectProperty ;
    rdfs:label "hasInterpretant"@en ;
    ns1:python_name "hasInterpretant"@en ;
    rdfs:domain ns2:Semiosis ;
    rdfs:range ns2:Interpretant ;
    rdfs:subPropertyOf ns2:semioticOvercrosses ;
    owl:inverseOf ns2:isInterpretantFor ;
    skos:prefLabel "hasInterpretant"@en ;
    ns2:elucidation "A relation that connects a semiotic object to the interpretant in a semiotic process."@en .

ns2:Cogniser a owl:Class ;
    rdfs:label "Cogniser"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Cognition ],
        ns2:InterpreterByReferent ;
    skos:example "The scientist that connects an equation to a physical phenomenon."^^xsd:string ;
    skos:prefLabel "Cogniser"@en ;
    ns2:elucidation "An interpreter who establish the connection between an icon an an object recognizing their resemblance (e.g. logical, pictorial)"@en .

ns2:Declaration a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Declarer ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasSign ;
            owl:someValuesFrom ns2:Conventional ],
        ns2:SemiosisByReferent ;
    skos:altLabel "ConventionalSemiosis"@en ;
    skos:prefLabel "Declaration"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Determination or Naming"^^xsd:string ;
    ns2:elucidation "A semiotic process that assigns a sign based on conventions."@en .

ns2:Determination a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasSign ;
            owl:someValuesFrom ns2:Property ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Determiner ],
        ns2:Declaration ;
    skos:altLabel "Characterisation"@en ;
    skos:example "Assigning the word \"red\" as sign for an object provides an information to all other interpreters about the outcome of a specific observation procedure according to the determiner."@en ;
    skos:prefLabel "Determination"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Estimation or Observation"^^xsd:string ;
    ns2:elucidation "A 'Semiosis' that involves an 'Observer' that perceives another 'Physical' (the 'Object') through a specific perception mechanism and produces a 'Property' (the 'Sign') that stands for the result of that particular perception according to a well defined conventional procedure."@en .

ns2:Index a owl:Class ;
    rdfs:label "Index"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasSign ] ;
            owl:someValuesFrom ns2:Deduction ],
        ns2:SignByReferent ;
    skos:example """Smoke stands for a combustion process (a fire).
My facial expression stands for my emotional status."""@en ;
    skos:prefLabel "Index"@en ;
    ns2:elucidation "A 'Sign' that stands for an 'Object' due to causal continguity."@en .

ns2:PartialSemiosis a owl:Class ;
    rdfs:label "PartialSemiosis"@en ;
    rdfs:subClassOf ns2:SemiosisByStructure ;
    skos:prefLabel "PartialSemiosis"@en ;
    ns2:elucidation "A semiosis where the triangle of relation is not completely developed."@en .

ns2:Property a owl:Class ;
    rdfs:subClassOf ns2:CodedByStructure ;
    skos:example """Hardness is a subclass of properties.
Vickers hardness is a subclass of hardness that involves the procedures and instruments defined by the standard hardness test."""@en,
        "The name \"red\" which is atomic in the code made of the list of colors."@en ;
    skos:prefLabel "Property"@en ;
    ns2:elucidation "A coded that makes use of an atomic symbol with respect to the code used to refer to the interaction."@en ;
    ns2:note "A property is atomic in the sense that is aimed to deliver one and one only aspect of the object according to one code, such as the color with one sign (e.g., black) or a quantitiative property (e.g., 1.4 kg)."@en .

ns2:SemioticEntity a owl:Class ;
    rdfs:subClassOf ns2:Semiotics ;
    skos:prefLabel "SemioticEntity"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Interpreter or SemioticObject or Sign"^^xsd:string ;
    ns2:elucidation "The class of individuals that stands for semiotic objects, i.e. objects that take part on a semiotic process."@en ;
    ns2:note """Semiotic subclasse are defined using Peirce's semiotic theory.

"Namely, a sign is something, A, which brings something, B, its interpretant sign determined or created by it, into the same sort of correspondence with something, C, its object, as that in which itself stands to C." (Peirce 1902, NEM 4, 20–21).

The triadic elements:
- 'sign': the sign A (e.g. a name)
- 'interpretant': the sign B as the effects of the sign A on the interpreter (e.g. the mental concept of what a name means)
- 'object': the object C (e.g. the entity to which the sign A and B refer to)

This class includes also the 'interpeter' i.e. the entity that connects the 'sign' to the 'object'"""@en .

ns2:Semiotics a owl:Class ;
    rdfs:seeAlso "https://plato.stanford.edu/entries/peirce-semiotics/"^^xsd:anyURI,
        "https://github.com/emmo-repo/EMMO/wiki/EMMO-Introduction#25-Semiotic-Framework"^^xsd:string ;
    rdfs:subClassOf ns2:Perspective ;
    skos:prefLabel "Semiotics"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Semiosis or SemioticEntity"^^xsd:string ;
    ns2:elucidation "A perspective based on Pierce semiotics, where an interpreter relates a referent to a sign in through semiotic relations."@en .

ns2:hasInternalRepresentation a owl:ObjectProperty ;
    rdfs:label "hasInternalRepresentation"@en ;
    ns1:python_name "hasInternalRepresentation"@en ;
    rdfs:domain ns2:Interpreter ;
    rdfs:range ns2:Interpretant ;
    rdfs:subPropertyOf ns2:semioticOvercrosses ;
    skos:prefLabel "hasInternalRepresentation"@en ;
    ns2:elucidation "The relation between the interpreter and the interpretant, being its internal representation."@en .

ns2:isInterpretationAccordingTo a owl:ObjectProperty ;
    rdfs:label "isInterpretationAccordingTo"@en ;
    ns1:python_name "isInterpretationAccordingTo"@en ;
    rdfs:subPropertyOf ns2:semiotical ;
    owl:inverseOf ns2:providesInterpretation ;
    skos:prefLabel "isInterpretationAccordingTo"@en .

ns2:Conventional a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasSign ] ;
            owl:someValuesFrom ns2:Declaration ],
        ns2:SignByReferent ;
    skos:prefLabel "Conventional"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Uncoded or Coded"^^xsd:string ;
    ns2:elucidation "A 'Sign' that stands for an 'Object' through convention, norm or habit, without any resemblance to it."@en ;
    ns2:note "In Peirce semiotics this kind of sign category is called symbol. However, since symbol is also used in formal languages, the name is changed in conventional."@en .

ns2:Declarer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Declaration ],
        ns2:InterpreterByReferent ;
    skos:example "A scientist that assigns a quantity to a physical objects without actually measuring it but taking it for granted due to its previous experience (e.g. considering an electron charge as 1.6027663e-19 C, assigning a molecular mass to a gas only by the fact of a name on the bottle)."^^xsd:string,
        "Someone who assigns a name to an object."^^xsd:string ;
    skos:prefLabel "Declarer"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Determiner or Namer"^^xsd:string ;
    ns2:elucidation "An interpreter who establish the connection between an conventional sign and an object according to a specific convention."@en .

ns2:interprets a owl:ObjectProperty ;
    rdfs:label "interprets"@en ;
    ns1:python_name "interprets"@en ;
    rdfs:subPropertyOf ns2:semiotical ;
    skos:prefLabel "interprets"@en .

ns2:semioticOvercrossedBy a owl:ObjectProperty ;
    rdfs:label "semioticOvercrossedBy"@en ;
    ns1:python_name "semioticOvercrossedBy"@en ;
    rdfs:isDefinedBy ns2:semioticOvercrosses ;
    rdfs:subPropertyOf ns2:isOvercrossedBy ;
    owl:inverseOf ns2:semioticOvercrosses ;
    skos:prefLabel "semioticOvercrossedBy"@en .

ns2:standsFor a owl:ObjectProperty ;
    rdfs:label "standsFor"@en ;
    ns1:python_name "standsFor"@en ;
    rdfs:subPropertyOf ns2:semiotical ;
    skos:prefLabel "standsFor"@en .

<urn:swrl:var#x> a swrl:Variable .

<urn:swrl:var#y> a swrl:Variable .

<urn:swrl:var#z> a swrl:Variable .

ns2:isInterpretedBy a owl:ObjectProperty ;
    rdfs:label "isInterpretedBy"@en ;
    ns1:python_name "isInterpretedBy"@en ;
    rdfs:domain ns2:Sign ;
    rdfs:range ns2:Interpreter ;
    rdfs:subPropertyOf ns2:semiotical ;
    owl:inverseOf ns2:interprets ;
    skos:prefLabel "isInterpretedBy"@en ;
    ns2:elucidation "A relation connecting a sign to the interpreter in a semiotic process."@en .

ns2:isRepresentedBy a owl:ObjectProperty ;
    rdfs:label "isRepresentedBy"@en ;
    ns1:python_name "isRepresentedBy"@en ;
    rdfs:domain ns2:Referent ;
    rdfs:range ns2:Sign ;
    rdfs:subPropertyOf ns2:semiotical ;
    owl:inverseOf ns2:standsFor ;
    skos:prefLabel "isRepresentedBy"@en ;
    ns2:elucidation "A relation that connects the semiotic object to the sign in a semiotic process."@en .

ns2:semioticOvercrosses a owl:ObjectProperty ;
    rdfs:label "semioticOvercrosses"@en ;
    ns1:python_name "semioticOvercrosses"@en ;
    rdfs:domain ns2:Semiotics ;
    rdfs:range ns2:Semiotics ;
    rdfs:subPropertyOf ns2:overcrosses ;
    skos:prefLabel "semioticOvercrosses"@en ;
    ns2:elucidation "The superproperties for overcrossing relations between semiotic entities."@en .

ns2:Interpretant a owl:Class ;
    rdfs:label "Interpretant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInternalRepresentation ] ;
            owl:someValuesFrom ns2:Interpreter ],
        [ a owl:Restriction ;
            owl:onProperty ns2:refersTo ;
            owl:someValuesFrom ns2:Referent ],
        [ a owl:Restriction ;
            owl:onProperty ns2:isSignifiedBy ;
            owl:someValuesFrom ns2:Sign ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpretant ] ;
            owl:someValuesFrom ns2:Semiosis ],
        ns2:SemioticEntity ;
    skos:example """A film is the interpretant for a camera, which is the interpreter. The object captured by the camera is the referent. The film is the internal representation of the object, i.e. how the camera understand the object according to its capacity. The film (interpretant) refers to the object (referent) according to the camera (interpreter).
When the film is removed from the camera, developed and printed on photographic paper (or for digital camera the image is downloaded as jpeg and displayed on a laptop) then we create a sign other than the interpretant.
However, in case of analogic film we can always look at the negatve that will suggest the intended referent. This is because both sign and interpretant are related to the referent in a similar way.
(What we call sign and interpretant in EMMO are both intended as "signs" in Peirce semiotics, the first being external signal for the interpreter and the second the internal sign)"""@en ;
    skos:prefLabel "Interpretant"@en ;
    ns2:elucidation "The interpreter's internal representation of the object in a semiosis process."@en .

ns2:Referent a owl:Class ;
    rdfs:label "Referent"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:isReferredBy ;
            owl:someValuesFrom ns2:Interpretant ],
        [ a owl:Restriction ;
            owl:onProperty ns2:isRepresentedBy ;
            owl:someValuesFrom ns2:Sign ],
        [ a owl:Restriction ;
            owl:onProperty ns2:isInterpretationAccordingTo ;
            owl:someValuesFrom ns2:Interpreter ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasReferent ] ;
            owl:someValuesFrom ns2:Semiosis ],
        ns2:SemioticEntity ;
    skos:altLabel "Object"@en,
        "SemioticObject"@en ;
    skos:prefLabel "Referent"@en ;
    ns2:elucidation "The object, in Peirce semiotics, as participant to a semiotic process."@en ;
    ns2:note """Here is assumed that the concept of 'object' is always relative to a 'semiotic' process. An 'object' does not exists per se, but it's always part of an interpretation.

The EMMO relies on strong reductionism, i.e. everything real is a formless collection of elementary particles: we give a meaning to real world entities only by giving them boundaries and defining them using 'sign'-s.

In this way the 'sign'-ed entity becomes an 'object', and the 'object' is the basic entity needed in order to apply a logical formalism to the real world entities (i.e. we can speak of it through its sign, and use logics on it through its sign)."""@en .

ns2:providesInterpretation a owl:ObjectProperty ;
    rdfs:label "providesInterpretation"@en ;
    ns1:python_name "providesInterpretation"@en ;
    rdfs:domain ns2:Interpreter ;
    rdfs:range ns2:Referent ;
    rdfs:subPropertyOf ns2:semiotical ;
    skos:prefLabel "providesInterpretation"@en ;
    ns2:elucidation "A relation that connects the interpreter to the semiotic object in a semiotic process."@en .

ns2:Interpreter a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInternalRepresentation ;
            owl:someValuesFrom ns2:Interpretant ],
        [ a owl:Restriction ;
            owl:onProperty ns2:interprets ;
            owl:someValuesFrom ns2:Sign ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasInterpreter ] ;
            owl:someValuesFrom ns2:Semiosis ],
        [ a owl:Restriction ;
            owl:onProperty ns2:providesInterpretation ;
            owl:someValuesFrom ns2:Referent ],
        ns2:SemioticEntity ;
    skos:example """For example, the ontologist may be interest in cataloguing in the EMMO how the same object (e.g. a cat) is addressed using different signs (e.g. cat, gatto, chat) by different interpreters (e.g. english, italian or french people).

The same applies for the results of measurements: the ontologist may be interest to represent in the EMMO how different measurement processes (i.e. semiosis) lead to different quantitative results (i.e. signs) according to different measurement devices (i.e. interpreters)."""@en ;
    skos:prefLabel "Interpreter"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo. Cogniser or Declarer or Deducer"^^xsd:string ;
    ns2:elucidation "The entity (or agent, or observer, or cognitive entity) who connects 'Sign', 'Interpretant' and 'Object'."@en ;
    ns2:note """The interpreter is not the ontologist, being the ontologist acting outside the ontology at the meta-ontology level.

On the contrary, the interpreter is an agent recognized by the ontologist. The semiotic branch of the EMMO is the tool used by the ontologist to represent an interpreter's semiotic activity."""@en .

ns2:Sign a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:isInterpretedBy ;
            owl:someValuesFrom ns2:Interpreter ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasSign ] ;
            owl:someValuesFrom ns2:Semiosis ],
        [ a owl:Restriction ;
            owl:onProperty ns2:standsFor ;
            owl:someValuesFrom ns2:Referent ],
        [ a owl:Restriction ;
            owl:onProperty ns2:isSignificationFor ;
            owl:someValuesFrom ns2:Interpretant ],
        ns2:SemioticEntity ;
    skos:example """A novel is made of chapters, paragraphs, sentences, words and characters (in a direct parthood mereological hierarchy).

Each of them are 'sign'-s.

A character can be the a-tomistic 'sign' for the class of texts.

The horizontal segment in the character "A" is direct part of "A" but it is not a 'sign' itself.

For plain text we can propose the ASCII symbols, for math the fundamental math symbols."""@en ;
    skos:prefLabel "Sign"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Index or Conventional or Icon"^^xsd:string ;
    ns2:elucidation "A CausalStructure that is used as sign (\"semeion\" in greek) that stands for another CausalStructure through an semiotic process."@en ;
    ns2:note """A 'Sign' can have temporal-direct-parts which are 'Sign' themselves.

A 'Sign' usually havs 'sign' spatial direct parts only up to a certain elementary semiotic level, in which the part is only a 'Physical' and no more a 'Sign' (i.e. it stands for nothing). This elementary semiotic level is peculiar to each particular system of signs (e.g. text, painting).

Just like an 'Elementary' in the 'Physical' branch, each 'Sign' branch should have an a-tomistic mereological part."""@en,
        """According to Peirce, 'Sign' includes three subcategories:
- symbols: that stand for an object through convention
- indeces: that stand for an object due to causal continguity
- icons: that stand for an object due to similitudes e.g. in shape or composition"""@en .

ns2:Icon a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns2:hasSign ] ;
            owl:someValuesFrom ns2:Cognition ],
        ns2:SignByReferent ;
    skos:altLabel "Model"@en,
        "Simulacrum"@en ;
    skos:example "A picture that reproduces the aspect of a person."@en,
        "An equation that reproduces the logical connection of the properties of a physical entity."@en ;
    skos:prefLabel "Icon"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: AnalogicalIcon or ResemblanceIcon or FunctionalIcon"^^xsd:string ;
    ns2:elucidation "A sign that stands for an object by resembling or imitating it, in shape, function or by sharing a similar logical structure."@en ;
    ns2:note """If object and sign belongs to the same class, then the sign is fuctional, diagrammatic and resemblance.
For example, when a Boeing 747 is used as a sign for another Boeing 747."""@en,
        """In Peirce semiotics three subtypes of icon are possible:
(a) the image, which depends on a simple quality (e.g. picture)
(b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy the relations in something (e.g. math formula, geometric flowchart)
(c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else
[Wikipedia]"""@en .

ns2:Semiosis a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpretant ;
            owl:someValuesFrom ns2:Interpretant ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasInterpreter ;
            owl:someValuesFrom ns2:Interpreter ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasSign ;
            owl:someValuesFrom ns2:Sign ],
        ns2:Semiotics ;
    skos:example """Me looking a cat and saying loud: "Cat!" -> the semiosis process

me -> interpreter
cat -> object (in Peirce semiotics)
the cat perceived by my mind -> interpretant
"Cat!" -> sign, the produced sign"""@en ;
    skos:prefLabel "Semiosis"@en ;
    ns2:OWLRL2DLAxioms "EquivalentTo: Deduction or Declaration or Cognition"^^xsd:string,
        "EquivalentTo: FullSemiosis or PartialSemiosis"^^xsd:string ;
    ns2:elucidation "The class for entities where an interpreter, interpretant, reference and sign relate with each others semiotically."@en ;
    ns2:note """Semiosis is intended here as a 4D entity, meaning that is not necessarily intended as a process. This enables users to represent more general state of things without necessarily committing to a process/object classification (which in a 4D framework is subjective, and not ontological) through the persistence perspective (in fact semiotics module is independent from persistence module).
For example, in a deduction (semiosis) the yellow tinted skin (index) of a patient is a symptom for liver desease (referent) according to a doctor (interpreter). If the user wants to include a commit towards persistency then the deduction can be either:
- an obejct: the deduction is a system (object) and the doctor, skin and patient are object components
-  a process: where the deduction is a process and the doctor, skin and patient are participants
Since in the EMMO the object/process categorisation is relation-driven and object/process are not disjointed, the abovementioned deduction can be seen both as a process or object depending on the relation used by the user to navigate the graph."""@en .

ns2:semiotical a owl:ObjectProperty ;
    rdfs:label "semiotical"@en ;
    ns1:python_name "semiotical"@en ;
    rdfs:subPropertyOf ns2:EMMORelation ;
    skos:prefLabel "semiotical"@en ;
    ns2:elucidation "The generic EMMO semiotical relation."@en .

ns2:hasSign a owl:ObjectProperty ;
    rdfs:label "hasSign"@en ;
    ns1:python_name "hasSign"@en ;
    rdfs:domain ns2:Semiosis ;
    rdfs:range ns2:Sign ;
    rdfs:subPropertyOf ns2:semioticOvercrosses ;
    skos:prefLabel "hasSign"@en ;
    ns2:elucidation "The relation between a semiotic process and the sign standing for the referent."@en .

ns2:hasInterpreter a owl:ObjectProperty ;
    rdfs:label "hasInterpreter"@en ;
    ns1:python_name "hasInterpreter"@en ;
    rdfs:domain ns2:Semiosis ;
    rdfs:range ns2:Interpreter ;
    rdfs:subPropertyOf ns2:semioticOvercrosses ;
    skos:prefLabel "hasInterpreter"@en ;
    ns2:elucidation "The relation between a semiotic process and the interpreter that is responsible for the sign-referent correspondance."@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource ns2:FunctionalIcon ;
    owl:annotatedTarget "FunctionalIcon"@en ;
    ns2:etymology "From Latin functiō (“performance, execution”), from functus, perfect participle of fungor (“to perform, execute, discharge”)."@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource ns2:Property ;
    owl:annotatedTarget "Property"@en ;
    ns2:etymology "From Latin proprietas (“a peculiarity, one's peculiar nature or quality, right or fact of possession, property”), from proprius (“special, particular, one's own”)."@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource ns2:Observation ;
    owl:annotatedTarget "Observation"@en ;
    ns2:etymology "From Latin observare (“to watch, note, mark, heed, guard, keep, pay attention to, regard, comply with, etc.”), from ob (“before”) + servare (“to keep”),"@en .

[] ns2:note """The rule for the subproperty chain:
inverse (hasSign) o inverse (hasReferent) ⇒ hasInterpreter"""@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource ns2:Cogniser ;
    owl:annotatedTarget "Cogniser"@en ;
    ns2:etymology "From Latin cognitio (“knowledge, perception, a judicial examination, trial”), from cognitus, past participle of cognoscere (“to know”), from co- (“together”) + *gnoscere, older form of noscere (“to know”"@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource ns2:Index ;
    owl:annotatedTarget "Index"@en ;
    ns2:etymology "From Latin index (“a discoverer, informer, spy; of things, an indicator, the forefinger, a title, superscription”), from indicō (“point out, show”)."@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:altLabel ;
    owl:annotatedSource ns2:Icon ;
    owl:annotatedTarget "Model"@en ;
    ns2:etymology "From Latin modus (“measure”)."@en .

[] ns2:note """The rule for the subproperty chain:
 inverse (hasReferent) o inverse (hasInterpreter) ⇒ hasSign"""@en .

[] ns2:note """The rule for the subproperty chain:
 inverse (hasInterpreter) o inverse (hasSign) ⇒ hasReferent"""@en .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl:var#x> ;
                    swrl:argument2 <urn:swrl:var#y> ;
                    swrl:propertyPredicate ns2:isRepresentedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 <urn:swrl:var#y> ;
                            swrl:argument2 <urn:swrl:var#z> ;
                            swrl:propertyPredicate ns2:isInterpretedBy ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl:var#z> ;
                    swrl:argument2 <urn:swrl:var#x> ;
                    swrl:propertyPredicate ns2:providesInterpretation ] ;
            rdf:rest () ] .

[] a owl:Axiom ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Semiotic_theory_of_Charles_Sanders_Peirce#II._Icon,_index,_symbol"^^xsd:anyURI ;
    owl:annotatedProperty ns2:note ;
    owl:annotatedSource ns2:Icon ;
    owl:annotatedTarget """In Peirce semiotics three subtypes of icon are possible:
(a) the image, which depends on a simple quality (e.g. picture)
(b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy the relations in something (e.g. math formula, geometric flowchart)
(c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else
[Wikipedia]"""@en .


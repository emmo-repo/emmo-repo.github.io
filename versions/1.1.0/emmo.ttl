emmo:Degree a owl:NamedIndividual,
        emmo:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac,
        emmo:EMMO_cdc962d8_f3ea_4764_a57a_c7caa4859179 ;
    rdfs:label "Degree"@en ;
    rdfs:comment """A degree (in full, a degree of arc, arc degree, or arcdegree), usually denoted by ° (the degree symbol), is a measurement of plane angle, representing 1/360 of a full rotation; one degree is equivalent to  2π /360 rad, 0.017453 rad. It is not an SI unit, as the SI unit for angles is radian, but is an accepted SI unit.

-- QUDT"""@en,
        "Degree is a measurement of plane angle, defined by representing a full rotation as 360 degrees."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedspecialunits-abox#> ;
    skos:prefLabel "Degree"@en ;
    schema:unitCode "DD"^^xsd:string ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1.745329e-02 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "°"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/page/Degree_(angle)"^^xsd:string ;
    emmo:definition "Degree is a measurement of plane angle, defined by representing a full rotation as 360 degrees."@en ;
    emmo:elucidation """A degree (in full, a degree of arc, arc degree, or arcdegree), usually denoted by ° (the degree symbol), is a measurement of plane angle, representing 1/360 of a full rotation; one degree is equivalent to  2π /360 rad, 0.017453 rad. It is not an SI unit, as the SI unit for angles is radian, but is an accepted SI unit.

-- QUDT"""@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.D01560"^^xsd:string ;
    emmo:qudtReference "http://qudt.org/vocab/unit/DEG"^^xsd:string ;
    emmo:ucumCode "deg"^^xsd:string .


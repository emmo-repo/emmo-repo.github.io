    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "B"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/resource/Bel"^^xsd:anyURI ;
    emmo:definition "One bel is defined as `1⁄2 ln(10) neper`."@en ;
    emmo:elucidation """A logarithmic unit of sound pressure equal to 10 decibels (dB),  It is defined as: 1 B = (1/2) log₁₀(Np)

-- QUDT"""@en ;

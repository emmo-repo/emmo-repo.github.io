    rdfs:label "Becquerel"@en ;
    rdfs:comment "Radioactive decays per second."@en,
        "SI unit for radioactive activity."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits-abox#> ;
    skos:prefLabel "Becquerel"@en ;
    schema:unitCode "BQL"^^xsd:string ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "Bq"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/resource/Becquerel"^^xsd:anyURI ;
    emmo:definition "Radioactive decays per second."@en ;
    emmo:elucidation "SI unit for radioactive activity."@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.B00624"^^xsd:string ;
    emmo:note """The SI derived unit of activity, usually meaning radioactivity. "Radioactivity" is caused when atoms disintegrate, ejecting energetic particles. One becquerel is the radiation caused by one disintegration per second; this is equivalent to about 27.0270 picocuries (pCi). The unit is named for a French physicist, Antoine-Henri Becquerel (1852-1908), the discoverer of radioactivity. Note: both the becquerel and the hertz are basically defined as one event per second, yet they measure different things. The hertz is used to measure the rates of events that happen periodically in a fixed and definite cycle. The becquerel is used to measure the rates of events that happen sporadically and unpredictably, not in a definite cycle.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/BQ"^^xsd:string ;
    emmo:ucumCode "Bq"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Becquerel?oldid=493710036"^^xsd:anyURI .

emmo:EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf a owl:Class ;
    rdfs:label "Quantity"@en ;
    rdfs:comment "A quantifiable property of a phenomenon, body, or substance."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/isq#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass emmo:EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae ;
            owl:onProperty emmo:EMMO_67fc0a36_8dcb_4ffa_9a43_31074efa3296 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
    skos:altLabel "Measurand"@en ;
    skos:example """length
Rockwell C hardness
electric resistance"""@en ;
    skos:prefLabel "Quantity"@en ;
    emmo:OWLRL2DLAxioms "DisjointUnionOf: SubjectiveProperty, ObjectiveProperty"^^xsd:string,
        "EquivalentTo: PhysicalQuantity or OrdinalQuantity"^^xsd:string ;
    emmo:VIMTerm "measurand"@en,
        "quantity"@en ;
    emmo:elucidation "A quantifiable property of a phenomenon, body, or substance."@en ;
    emmo:note """VIM defines a quantity as a "property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed as a number and a reference".

A quantity in EMMO is a property and therefore only addresses the first part of the VIM definition (that is a property of a phenomenon, body, or substance). The second part (that it can be expressed as a number and a reference) is syntactic and addressed by emmo:QuantityValue."""@en ;
    emmo:qudtReference "https://qudt.org/schema/qudt/Quantity"^^xsd:anyURI .


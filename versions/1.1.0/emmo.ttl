emmo:EMMO_4f2d1fcc_e20c_4479_9ad7_7a0480dd3e44 a owl:Class ;
    rdfs:label "AnalogicalIcon"@en ;
    rdfs:comment "An icon that represents the internal logical structure of the object."@en ;

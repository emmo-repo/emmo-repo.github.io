    skos:example "A molecule is a distinct part of a fluid."@en ;
    skos:prefLabel "hasDistinctPart"@en ;
    emmo:definition "DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]"^^xsd:string ;
    emmo:elucidation "The superproperty of all object property relations between an entity and one of its proper parts that belongs to different taxonomical branch."@en ;
    emmo:note "A part is always distinct xor redundant."@en .


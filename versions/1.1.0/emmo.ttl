        emmo:EMMO_707c6032_e272_4a20_98b5_d35c4f67be68 ;
    skos:prefLabel "SISpecialUnit"@en ;
    emmo:OWLRL2DLAxioms "disjointUnionOf: Becquerel, Coulomb, DegreeCelsius, Farad, Gray, Henry, Hertz, Joule, Katal, Lumen, Lux, Newton, Ohm, Pascal, Radian, Siemens, Sievert, Steradian, Tesla, Volt, Watt, Weber"^^xsd:string ;
    emmo:elucidation "The 22 derived units that are given a special name in the SI system that stands for units derived by SI base units."@en ;
    emmo:note "These units are SI coherent by definition."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/International_System_of_Units#Derived_units"^^xsd:string .


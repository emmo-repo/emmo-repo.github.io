    skos:prefLabel "FundamentalFermion"@en ;
    emmo:OWLRL2DLAxioms "DisjointUnionOf: FundamentalAntiMatterParticle, FundamentalMatterParticle"^^xsd:string,
        "DisjointUnionOf: RightHandedParticle, LeftHandedParticle"^^xsd:string,
        "DisjointUnionOf: SecondGenerationFermion, FirstGenerationFermion, ThirdGenerationFermion"^^xsd:string ;
    emmo:conceptualisation "A particle with half odd integer spin (1/2, 3/2, etc...) that follows Fermi-Dirac statistics."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/Fermion"@en .


        emmo:EMMO_06448f64_8db6_4304_8b2c_e785dba82044,
        emmo:EMMO_a293f923_954c_4af5_9f97_9600ebd362cb,
        emmo:EMMO_a356870d_409a_4de6_a910_0d8498e593ff ;
    skos:prefLabel "MassConcentration"@en ;
    emmo:elucidation "Mass of a constituent divided by the volume of the mixture."@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.M03713"^^xsd:string ;
    emmo:qudtReference "http://qudt.org/vocab/quantitykind/MassConcentration"^^xsd:string .


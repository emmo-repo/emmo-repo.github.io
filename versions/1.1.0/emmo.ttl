    emmo:elucidation "The exponential of the ratio of the chemical potential to R*T where R is the gas constant and T the thermodynamic temperature."@en ;
    emmo:iupacReference "https://goldbook.iupac.org/terms/view/A00019"^^xsd:string ;
    emmo:qudtReference "https://qudt.org/vocab/quantitykind/AbsoluteActivity"^^xsd:string ;
    emmo:wikidataReference "https://www.wikidata.org/wiki/Q56638155"^^xsd:string .


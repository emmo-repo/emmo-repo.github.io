    owl:inverseOf emmo:EMMO_ee73c4f1_1405_44af_abf5_d06f2e71ed03 ;
    skos:prefLabel "hasReferent"@en ;
    emmo:elucidation "The relation between a semiotic process and the referent i.e., the object of the semiotic process."@en .


        emmo:EMMO_28fbea28_2204_4613_87ff_6d877b855fcd ;
    skos:altLabel "LinearArray"^^xsd:string,
        "1DArray"@en ;
    skos:prefLabel "Vector"@en ;
    emmo:elucidation "1-dimensional array who's spatial direct parts are numbers."@en .


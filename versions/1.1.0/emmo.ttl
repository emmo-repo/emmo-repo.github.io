    skos:prefLabel "ISQBaseQuantity"@en ;
    emmo:OWLRL2DLAxioms "DisjointUnionOf: LuminousIntensity, AmountOfSubstance, ThermodynamicTemperature, ElectricCurrent, Length, Time, Mass"^^xsd:string ;
    emmo:elucidation "Base quantities defined in the International System of Quantities (ISQ)."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/International_System_of_Quantities"^^xsd:string .

emmo:EMMO_1d0064d2_d77e_4ec7_b74a_00f98616156f a owl:Class ;
    rdfs:label "FunctionalMaterial"@en ;
    rdfs:comment "A functional material is any material that exhibits distinct, reproducible changes in its electronic, magnetic, optical, chemical, or thermal properties when exposed to an external field or environmental change."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/materials#> ;
    rdfs:subClassOf emmo:EMMO_8820f251_ad36_43f4_a693_c0e86a89cc1f ;
    skos:prefLabel "FunctionalMaterial"@en ;
    emmo:elucidation "A functional material is any material that exhibits distinct, reproducible changes in its electronic, magnetic, optical, chemical, or thermal properties when exposed to an external field or environmental change."@en ;
    emmo:note "Materials categorised for what they do rather than what they hold up. They are designed to react to their environment, convert energy, or process information."@en .


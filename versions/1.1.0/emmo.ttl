emmo:EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8 a owl:Class ;
    rdfs:label "Fluid"@en ;
    rdfs:comment "A continuum that has no fixed shape and yields easily under an applied shear stress, or external force."@en ;

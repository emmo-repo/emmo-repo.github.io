        emmo:EMMO_fa9c8c56_314f_4a5a_a71d_bae66446b185 ;
    rdfs:label "HenryPerMetre"@en ;
    rdfs:comment """The henry per meter (symbolized H/m) is the unit of magnetic permeability in the International System of Units ( SI ). Reduced to base units in SI, 1 H/m is the equivalent of one kilogram meter per square second per square ampere.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#>,
        "http://qudt.org/2.1/vocab/unit"^^xsd:string ;
    skos:altLabel "Henry per Metre"@en ;
    skos:prefLabel "HenryPerMetre"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1e+00 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """The henry per meter (symbolized H/m) is the unit of magnetic permeability in the International System of Units ( SI ). Reduced to base units in SI, 1 H/m is the equivalent of one kilogram meter per square second per square ampere.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/H-PER-M"^^xsd:string ;
    emmo:ucumCode "H.m-1"^^xsd:string ;
    emmo:unitSymbol "H/m"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Henry?oldid=491435978"^^xsd:string .


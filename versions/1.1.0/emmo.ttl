emmo:SquareMetrePerSecond a owl:NamedIndividual,
        emmo:EMMO_1273eb34_de48_43a9_925f_104110469dd2,
        emmo:EMMO_b33cc5b5_a9dc_4082_b497_14d1654c5591 ;
    rdfs:label "SquareMetrePerSecond"@en ;
    rdfs:comment """Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as "metres per second times metres", i.e. the momentum of an object with respect to a position.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#>,
        "http://qudt.org/2.1/vocab/unit"^^xsd:string ;
    skos:altLabel "Square Metre per Second"@en ;
    skos:prefLabel "SquareMetrePerSecond"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1e+00 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as "metres per second times metres", i.e. the momentum of an object with respect to a position.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/M2-PER-SEC"^^xsd:string ;
    emmo:ucumCode "m2.s-1"^^xsd:string,
        "m2/s"^^xsd:string ;
    emmo:unitSymbol "m²/s"^^xsd:string .


    skos:prefLabel "ZeptoPrefixedUnit"@en ;
    emmo:elucidation "Superclass for all units prefixed with \"zepto\" (1e-21)."@en .

emmo:EMMO_29108c7c_9087_4992_ab1c_02561665df21 a owl:Class ;
    rdfs:label "CompositeFermion"@en ;

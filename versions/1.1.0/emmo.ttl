    emmo:ucumCode "[fur_us]"^^xsd:string ;
    emmo:unitSymbol "furlong"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Furlong?oldid=492237369"^^xsd:string .


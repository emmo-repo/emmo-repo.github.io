    emmo:ucumCode "W.m-2.sr-1"^^xsd:string ;
    emmo:unitSymbol "W/(m²⋅sr)"^^xsd:string ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/Radiance"^^xsd:string .


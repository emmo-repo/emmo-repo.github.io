emmo:Katal a owl:NamedIndividual,
        emmo:EMMO_ce7d4720_aa20_4a8c_93e8_df41a35b6723,
        emmo:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b ;

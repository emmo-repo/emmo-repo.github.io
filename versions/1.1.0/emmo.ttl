emmo:KiloByte a owl:NamedIndividual,
        emmo:EMMO_15d62b55_38ea_4aec_b7c4_25db1a2e5a01,
        emmo:EMMO_74931b1b_c133_4e59_9a75_1bf0e1626201,
        emmo:EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375,
        emmo:EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e ;
    rdfs:label "KiloByte"@en ;
    rdfs:comment """The kilobyte is a multiple of the unit byte for digital information equivalent to 1000 bytes. Although the prefix kilo- means 1000, the term kilobyte and symbol kB have historically been used to refer to either 1024 (210) bytes or 1000 (103) bytes, dependent upon context, in the fields of computer science and information technology. This ambiguity is removed in QUDT, with KibiBYTE used to refer to 1024 bytes.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/otherunits-abox#> ;
    skos:altLabel "Kilo Byte"@en ;
    skos:prefLabel "KiloByte"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1e+03 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 emmo:Byte ;
    emmo:elucidation """The kilobyte is a multiple of the unit byte for digital information equivalent to 1000 bytes. Although the prefix kilo- means 1000, the term kilobyte and symbol kB have historically been used to refer to either 1024 (210) bytes or 1000 (103) bytes, dependent upon context, in the fields of computer science and information technology. This ambiguity is removed in QUDT, with KibiBYTE used to refer to 1024 bytes.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/KiloBYTE"^^xsd:string ;
    emmo:ucumCode "kBy"^^xsd:string ;
    emmo:unitSymbol "kB"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Byte?oldid=493588918"^^xsd:string .

emmo:KiloBytePerSecond a owl:NamedIndividual,

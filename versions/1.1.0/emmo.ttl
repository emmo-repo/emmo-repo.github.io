emmo:Tesla a owl:NamedIndividual,
        emmo:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b,
        emmo:EMMO_ec903946_ddc9_464a_903c_7373e0d1eeb5 ;
    rdfs:label "Tesla"@en ;
    rdfs:comment "SI unit for magnetic flux density or induction."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits-abox#> ;
    skos:prefLabel "Tesla"@en ;
    schema:unitCode "D33"^^xsd:string ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "T"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/resource/Tesla"^^xsd:anyURI ;
    emmo:elucidation "SI unit for magnetic flux density or induction."@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.T06283"^^xsd:string ;
    emmo:note "T = V·s·m⁻² = N/(A·m) = Wb/m²"^^xsd:string,
        """The SI unit of flux density (or field intensity) for magnetic fields (also called the magnetic induction). The intensity of a magnetic field can be measured by placing a current-carrying conductor in the field. The magnetic field exerts a force on the conductor, a force which depends on the amount of the current and on the length of the conductor. One tesla is defined as the field intensity generating one newton of force per ampere of current per meter of conductor. Equivalently, one tesla represents a magnetic flux density of one weber per square meter of area. A field of one tesla is quite strong: the strongest fields available in laboratories are about 20 teslas, and the Earth's magnetic flux density, at its surface, is about 50 microteslas. The tesla, defined in 1958, honors the Serbian-American electrical engineer Nikola Tesla (1856-1943), whose work in electromagnetic induction led to the first practical generators and motors using alternating current.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/T"^^xsd:string ;
    emmo:ucumCode "T"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Tesla_(unit)"^^xsd:anyURI .

emmo:Volt a owl:NamedIndividual,
        emmo:EMMO_2e7e5796_4a80_4d73_bb84_f31138446c0c,
        emmo:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b ;
    rdfs:label "Volt"@en ;
    rdfs:comment "SI unit for electric potential difference."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits-abox#> ;
    skos:prefLabel "Volt"@en ;
    schema:unitCode "VLT"^^xsd:string ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "V"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/resource/Volt"^^xsd:anyURI ;
    emmo:elucidation "SI unit for electric potential difference."@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.V06634"^^xsd:string ;
    emmo:note "The volt is the unit of electric potential difference—electric potential difference is also known as voltage. The size of 1 volt is officially defined as the potential difference between two points of a wire carrying a current of 1 ampere when the power dissipated in the wire is 1 watt."@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/V"^^xsd:string ;
    emmo:ucumCode "V"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Volt?oldid=494812083"^^xsd:anyURI .

emmo:VoltPerMetre a owl:NamedIndividual,
        emmo:EMMO_1273eb34_de48_43a9_925f_104110469dd2,
        emmo:EMMO_ebf9a5c6_ca80_45d4_a991_24a1bf4b6720 ;
    rdfs:label "VoltPerMetre"@en ;
    rdfs:comment """Volt Per Meter (V/m) is a unit in the category of Electric field strength. It is also known as volts per meter, volt/meter, volt/metre, volt per metre, volts per metre. This unit is commonly used in the SI unit system. Volt Per Meter (V/m) has a dimension of MLT⁻³I⁻¹ where M is mass, L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#>,
        "http://qudt.org/2.1/vocab/unit"^^xsd:string ;
    rdfs:seeAlso "http://www.efunda.com/glossary/units/units--electric_field_strength--volt_per_meter.cfm"^^xsd:string ;
    skos:altLabel "Volt per Metre"@en ;
    skos:prefLabel "VoltPerMetre"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1e+00 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """Volt Per Meter (V/m) is a unit in the category of Electric field strength. It is also known as volts per meter, volt/meter, volt/metre, volt per metre, volts per metre. This unit is commonly used in the SI unit system. Volt Per Meter (V/m) has a dimension of MLT⁻³I⁻¹ where M is mass, L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/V-PER-M"^^xsd:string ;
    emmo:ucumCode "V.m-1"^^xsd:string ;
    emmo:unitSymbol "V/m"^^xsd:string .

<urn:isbn:9780471400653> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:creator "Charles F. Curtiss"^^xsd:string,
        "Joseph O. Hirschfelder"^^xsd:string,
        "R. Byron Bird"^^xsd:string ;
    dcterms:description "A rigorous treatment of the molecular characteristics and behaviors of gases and liquids."^^xsd:string ;
    dcterms:identifier "9780471400653"^^xsd:string ;
    dcterms:issued "1964"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Wiley-Interscience"^^xsd:string ;
    dcterms:subject "Fluid Dynamics"^^xsd:string,
        "Kinetic Theory"^^xsd:string,
        "Molecular Interactions"^^xsd:string,
        "Statistical Mechanics"^^xsd:string ;
    dcterms:title "The Molecular Theory of Gases and Liquids"^^xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/statesofmatter#> .


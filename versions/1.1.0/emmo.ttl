emmo:EMMO_a6f34396_1b31_4f42_abc6_cce491336bf6 a owl:Class ;
    rdfs:label "IdealGas"@en ;
    rdfs:comment "A gas where the PV=nRT relation holds, with compressibility factor Z=1. Since no gas really fits whis model, an ideal gas is intended to be a substance for which this model is a reasonable apporoximation."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/statesofmatter#> ;

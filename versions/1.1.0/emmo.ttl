    rdfs:subClassOf emmo:EMMO_89762966_8076_4f7c_b745_f718d653e8e2 ;
    skos:prefLabel "SIExactConstant"@en ;
    emmo:elucidation "Physical constant that by definition (after the latest revision of the SI system that was enforsed May 2019) has a known exact numerical value when expressed in SI units."@en .

emmo:Joule a owl:NamedIndividual,
        emmo:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b,
        emmo:EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f ;
    rdfs:label "Joule"@en ;
    rdfs:comment "SI unit for energy."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits-abox#> ;
    skos:prefLabel "Joule"@en ;
    schema:unitCode "JOU"^^xsd:string ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "J"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/resource/Joule"^^xsd:anyURI ;
    emmo:elucidation "SI unit for energy."@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.J03363"^^xsd:string ;
    emmo:note """The SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of 1 m/s.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/J"^^xsd:string ;
    emmo:ucumCode "J"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Joule?oldid=494340406"^^xsd:anyURI .

emmo:Metre a owl:NamedIndividual,
        emmo:EMMO_3a185e6c_9e19_4776_b583_19c978156aa0,
        emmo:EMMO_b3600e73_3e05_479d_9714_c041c3acf5cc ;
    rdfs:label "Metre"@en ;
    rdfs:comment "The metre, symbol m, is the SI unit of length. It is defined by taking the fixed numerical value of the speed of light in vacuum c to be 299792458 when expressed in the unit m s−1, where the second is defined in terms of ∆νCs."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits-abox#> ;
    skos:altLabel "Meter"@en-us ;
    skos:prefLabel "Metre"@en ;
    schema:unitCode "MTR"^^xsd:string ;
    emmo:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 "m"^^xsd:string ;
    emmo:dbpediaReference "http://dbpedia.org/resource/Metre"^^xsd:anyURI ;
    emmo:definition "The metre, symbol m, is the SI unit of length. It is defined by taking the fixed numerical value of the speed of light in vacuum c to be 299792458 when expressed in the unit m s−1, where the second is defined in terms of ∆νCs."@en ;
    emmo:iupacReference "https://doi.org/10.1351/goldbook.M03884"^^xsd:string ;
    emmo:qudtReference "http://qudt.org/vocab/unit/M"^^xsd:string ;
    emmo:ucumCode "m"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Metre?oldid=495145797"^^xsd:anyURI .

foaf:Person rdfs:subClassOf emmo:EMMO_3674bfb6_6636_4e9d_aae1_07023ad96d61 .


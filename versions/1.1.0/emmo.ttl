emmo:FootPerSecond a owl:NamedIndividual,
        emmo:EMMO_4f5c7c54_1c63_4d17_b12b_ea0792c2b187,
        emmo:EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375,
        emmo:EMMO_868ae137_4d25_493e_b270_21ea3d94849e,
        emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 ;
    rdfs:label "FootPerSecond"@en ;
    rdfs:comment """`foot per second` (plural `feet per second`) is a unit of both speed (scalar) and velocity (vector quantity, which includes direction). It expresses the distance in feet (ft) traveled or displaced, divided by the time in seconds (s, or sec). The corresponding unit in the International System of Units (SI) is the `metre per second`. Abbreviations include ft/s, ft/sec and fps, and the rarely used scientific notation ft s.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/otherunits-abox#>,
        "http://qudt.org/2.1/vocab/unit"^^xsd:string ;
    skos:altLabel "Foot per Second"@en ;
    skos:prefLabel "FootPerSecond"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 3.048e-01 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """`foot per second` (plural `feet per second`) is a unit of both speed (scalar) and velocity (vector quantity, which includes direction). It expresses the distance in feet (ft) traveled or displaced, divided by the time in seconds (s, or sec). The corresponding unit in the International System of Units (SI) is the `metre per second`. Abbreviations include ft/s, ft/sec and fps, and the rarely used scientific notation ft s.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/FT-PER-SEC"^^xsd:string ;
    emmo:ucumCode "[ft_i].s-1"^^xsd:string,
        "[ft_i]/s"^^xsd:string ;
    emmo:unitSymbol "ft/s"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Foot_per_second?oldid=491316573"^^xsd:string .


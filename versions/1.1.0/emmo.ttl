        emmo:EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064,
        emmo:EMMO_a242d3e9_c6d3_411e_a667_71ffbc248a1a ;
    skos:altLabel "Position"@en ;
    skos:prefLabel "PositionVector"@en ;
    emmo:IEVReference "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=102-03-15"^^xsd:string ;
    emmo:ISO80000Reference "3-1.10"^^xsd:string ;
    emmo:dbpediaReference "https://dbpedia.org/page/Position_(geometry)"^^xsd:string ;
    emmo:elucidation "Vector quantity from the origin of a coordinate system to a point in space."@en ;
    emmo:note """In the usual geometrical three-dimensional space, position vectors are quantities of the dimension length.

-- IEC"""@en,
        """Position vectors are so-called bounded vectors, i.e. their magnitude and direction depend on the particular coordinate system used.

-- ISO 80000-3"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/quantitykind/PositionVector"^^xsd:anyURI ;

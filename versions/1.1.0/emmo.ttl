            owl:someValuesFrom emmo:EMMO_1c0b22a2_be82_4fa8_9e2b_a569a625d442 ],
        emmo:EMMO_1b52ee70_121e_4d8d_8419_3f97cd0bd89c ;
    skos:prefLabel "Estimator"@en ;
    emmo:elucidation "A characteriser that declares a property for an object without actually interact with it with the specific interaction required by the property definition (i.e. infer a property from other properties)."@en .


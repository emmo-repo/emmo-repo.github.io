emmo:Bu_Us a owl:NamedIndividual,
        emmo:EMMO_15344998_4490_4b40_b242_c3d92e5cdc27,
        emmo:EMMO_9141801c_c539_4c72_b423_8c74ff6b8f05,
        emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 ;
    rdfs:label "Bu_Us"@en ;
    rdfs:comment """A bushel is an imperial and U.S. customary unit of dry volume, equivalent in each of these systems to 4 pecks or 8 gallons. It is used for volumes of dry commodities (not liquids), most often in agriculture. It is abbreviated as bsh. or bu. In modern usage, the dry volume is usually only nominal, with bushels referring to standard weights instead.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#>,
        "http://qudt.org/2.1/vocab/unit"^^xsd:string ;
    skos:altLabel "bushel (US)"@en ;
    skos:prefLabel "Bu_Us"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 3.523907e-02 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """A bushel is an imperial and U.S. customary unit of dry volume, equivalent in each of these systems to 4 pecks or 8 gallons. It is used for volumes of dry commodities (not liquids), most often in agriculture. It is abbreviated as bsh. or bu. In modern usage, the dry volume is usually only nominal, with bushels referring to standard weights instead.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/BU_US"^^xsd:string ;
    emmo:ucumCode "[bu_us]"^^xsd:string ;
    emmo:unitSymbol "bsh{US}"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Bushel?oldid=476704875"^^xsd:string .


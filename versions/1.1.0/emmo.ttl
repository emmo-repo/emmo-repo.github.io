    emmo:elucidation """A sidereal year is the time taken for Sun to return to the same position with respect to the stars of the celestial sphere.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/YR_Sidereal"^^xsd:string ;
    emmo:unitSymbol "yr{sidereal}"^^xsd:string .


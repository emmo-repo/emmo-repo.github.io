emmo:EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c a owl:Class ;
    rdfs:label "Vapor"@en ;
    rdfs:comment "A gas made of a substance below its critical temperature"@en,
        "Vapor is defined as the gas-phase form of a substance that is below its critical temperature T𞁞, meaning it can be condensed to liquid by pressure alone (condensability). It is a single, homogeneous phase. Vapos are typically invisible."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/statesofmatter#> ;
    rdfs:subClassOf emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 ;
    skos:altLabel "SubcriticalGaseousState"@en ;
    skos:prefLabel "Vapor"@en ;
    emmo:conceptualisation "Vapor is defined as the gas-phase form of a substance that is below its critical temperature T𞁞, meaning it can be condensed to liquid by pressure alone (condensability). It is a single, homogeneous phase. Vapos are typically invisible."@en ;
    emmo:elucidation "A gas made of a substance below its critical temperature"@en .

emmo:EMMO_4e36a0b8_e6c7_456e_bef5_c830e3c0ed17 a owl:Class ;
    rdfs:label "AntiElectronType"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/standardmodel-full#> ;

emmo:EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54 a owl:Class ;
    rdfs:label "MaterialByStructure"@en ;
    rdfs:comment "The superclass for all materials that are categorised according to their periodicity/crystalline structure"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/materials#> ;
    rdfs:seeAlso <urn:isbn:9780080966656>,
        <urn:isbn:9780471736967> ;

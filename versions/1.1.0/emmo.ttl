    emmo:ucumCode "GF"^^xsd:string ;
    emmo:unitSymbol "abF"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Abfarad?oldid=407124018"^^xsd:string .


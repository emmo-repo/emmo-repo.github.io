    skos:example """Unit of atomic number
Unit of number of cellular
Unit of degeneracy in quantum mechanics"""@en ;
    skos:prefLabel "CountingUnit"@en ;
    emmo:elucidation "Unit for dimensionless quantities that have the nature of count."@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/NUM"^^xsd:anyURI ;
    emmo:ucumCode "1"^^xsd:string .


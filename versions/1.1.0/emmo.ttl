emmo:EMMO_7efab93d_c8fe_49c7_ba8e_d21d13b38c85 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasSpatioTemporalTile"^^xsd:string ;

emmo:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd a owl:Class ;
    rdfs:label "CondensedMatter"@en ;
    rdfs:comment "Matter in liquid or solid physical state."@en,
        "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/statesofmatter#> ;
    rdfs:subClassOf emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;

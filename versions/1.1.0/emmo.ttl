    skos:prefLabel "CubicMetrePerMole"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1e+00 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """The molar volume, symbol Vm, is the volume occupied by one mole of a substance (chemical element or chemical compound) at a given temperature and pressure. It is equal to the molar mass (M) divided by the mass density. It has the SI unit cubic metres per mole m3/mol, although it is more practical to use the units cubic decimetres per mole dm3/mol for gases and cubic centimetres per mole cm3/mol for liquids and solids.

-- QUDT"""@en ;
    emmo:qudtReference "http://qudt.org/vocab/unit/M3-PER-MOL"^^xsd:string ;
    emmo:ucumCode "m3.mol-1"^^xsd:string,
        "m3/mol"^^xsd:string ;
    emmo:unitSymbol "m³/mol"^^xsd:string .

emmo:CubicMetrePerSecond a owl:NamedIndividual,
        emmo:EMMO_1273eb34_de48_43a9_925f_104110469dd2,
        emmo:EMMO_a88475b9_c745_4a47_9403_ab0d158b9b1b ;
    rdfs:label "CubicMetrePerSecond"@en ;
    rdfs:comment """A cubic metre per second (m³s⁻¹, m³/s), cumecs or cubic meter per second in American English) is a derived SI unit of flow rate equal to that of a stere or cube with sides of one metre ( u0303 39.37 in) in length exchanged or moving each second. It is popularly used for water flow, especially in rivers and streams, and fractions for HVAC values measuring air flow.

-- QUDT"""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#>,
        "http://qudt.org/2.1/vocab/unit"^^xsd:string ;
    skos:altLabel "Cubic Metre per Second"@en ;
    skos:prefLabel "CubicMetrePerSecond"@en ;
    emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf 1e+00 ;
    emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd 0e+00 ;
    emmo:elucidation """A cubic metre per second (m³s⁻¹, m³/s), cumecs or cubic meter per second in American English) is a derived SI unit of flow rate equal to that of a stere or cube with sides of one metre ( u0303 39.37 in) in length exchanged or moving each second. It is popularly used for water flow, especially in rivers and streams, and fractions for HVAC values measuring air flow.

-- QUDT"""@en ;

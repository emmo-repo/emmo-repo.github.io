    emmo:ucumCode "10.nV"^^xsd:string ;
    emmo:unitSymbol "abV"^^xsd:string ;
    emmo:wikipediaReference "http://en.wikipedia.org/wiki/Abvolt?oldid=477198646"^^xsd:string .


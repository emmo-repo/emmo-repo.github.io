<owl:Class rdf:about="#EMMO_7608d504_7a6f_4cf5_bc91_a6bd8c5b094f">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_cc6988f0_136a_4933_b986_270cff5e1137"/>

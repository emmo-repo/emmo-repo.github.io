  <core:prefLabel xml:lang="en">ElectricCurrentDensity</core:prefLabel>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-11</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-8</ISO80000Reference>
  <elucidation xml:lang="en">Electric current divided by the cross-sectional area it is passing through.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E01928</iupacReference>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/ElectricCurrentDensity</qudtReference>

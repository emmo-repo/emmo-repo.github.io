<owl:Class rdf:about="#EMMO_b4494d69_6393_4eb4_8346_7fedd4df0bc5">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
  <rdfs:label xml:lang="en">Maximal</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole are not proper part of an entity of that type.</rdfs:comment>
  <core:prefLabel xml:lang="en">Maximal</core:prefLabel>
  <elucidation xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole are not proper part of an entity of that type.</elucidation>
  <illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Maximal.png</illustration>
  <note xml:lang="en">A maximal class M (subclass of Maximal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and if you add something to x, then x is no more a φ.</note>
</owl:Class>

<owl:Class rdf:about="#EMMO_214e9a99_58de_40e2_86cf_fa6aa1d180a8">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_6fba4018_24bd_450c_abc3_354e2c7809c9"/>
  <rdfs:label xml:lang="en">Widening</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widening is tensile forming to increase the circumference of a hollow body. A distinction is made between: Widening, bulging.</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weiten</core:altLabel>
  <core:prefLabel xml:lang="en">Widening</core:prefLabel>
</owl:Class>


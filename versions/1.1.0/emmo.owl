<owl:NamedIndividual rdf:about="#Kilogram">
  <rdf:type rdf:resource="#EMMO_3a185e6c_9e19_4776_b583_19c978156aa0"/>
  <rdf:type rdf:resource="#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits-abox#"/>
  <rdfs:label xml:lang="en">Kilogram</rdfs:label>
  <rdfs:comment xml:lang="en">The kilogram, symbol kg, is the SI unit of mass. It is defined by taking the fixed numerical value of the Planck constant h to be 6.62607015×10−34 when expressed in the unit J s, which is equal to kg m2 s−1, where the metre and the second are defined in terms of c and ∆νCs.</rdfs:comment>
  <core:altLabel xml:lang="en">Kilogram</core:altLabel>
  <core:prefLabel xml:lang="en">Kilogram</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KGM</sche:unitCode>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kg</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Kilogram</dbpediaReference>
  <definition xml:lang="en">The kilogram, symbol kg, is the SI unit of mass. It is defined by taking the fixed numerical value of the Planck constant h to be 6.62607015×10−34 when expressed in the unit J s, which is equal to kg m2 s−1, where the metre and the second are defined in terms of c and ∆νCs.</definition>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.K03391</iupacReference>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/KiloGM</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kg</ucumCode>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Kilogram?oldid=493633626</wikipediaReference>
</owl:NamedIndividual>


<owl:NamedIndividual rdf:about="#SolarMass">
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">SolarMass</rdfs:label>
  <rdfs:comment xml:lang="en">The astronomical unit of mass is the solar mass.The symbol S is often used in astronomy to refer to this unit, although M⊙ is also common. The solar mass, 1.98844 × 10³⁰ kg, is a standard way to express mass in astronomy, used to describe the masses of other stars and galaxies. It is equal to the mass of the Sun, about 333,000 times the mass of the Earth or 1,048 times the mass of Jupiter. In practice, the masses of celestial bodies appear in the dynamics of the solar system only through the products GM, where G is the constant of gravitation.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Solar mass</core:altLabel>
  <core:prefLabel xml:lang="en">SolarMass</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.988435e+30</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">The astronomical unit of mass is the solar mass.The symbol S is often used in astronomy to refer to this unit, although M⊙ is also common. The solar mass, 1.98844 × 10³⁰ kg, is a standard way to express mass in astronomy, used to describe the masses of other stars and galaxies. It is equal to the mass of the Sun, about 333,000 times the mass of the Earth or 1,048 times the mass of Jupiter. In practice, the masses of celestial bodies appear in the dynamics of the solar system only through the products GM, where G is the constant of gravitation.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/SolarMass</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Solar_mass?oldid=494074016</wikipediaReference>
</owl:NamedIndividual>


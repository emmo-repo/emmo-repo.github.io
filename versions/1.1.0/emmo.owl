  <core:altLabel xml:lang="en">State</core:altLabel>
  <core:example xml:lang="en">A semi-naked man is a status in the process of a man's dressing.</core:example>
  <core:prefLabel xml:lang="en">Status</core:prefLabel>
  <elucidation xml:lang="en">An object which is a temporal part of a process.</elucidation>
</owl:Class>


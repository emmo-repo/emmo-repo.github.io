<owl:Class rdf:about="#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="#EMMO_7329967c_3972_4c99_b478_84f66436620d"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_9d799b43_e188_4047_8167_121d96b31a26"/>
  <rdfs:label xml:lang="en">SubObject</rdfs:label>
  <rdfs:comment xml:lang="en">An object which is a temporal part of another object.</rdfs:comment>
  <core:example xml:lang="en">If an inhabited house is considered as an house that is occupied by some people in its majority of time, then an interval of inhabited house in which occasionally nobody is in there is no more an inhabited house, but an unhinabited house, since this temporal part does not satisfy the criteria of the whole.</core:example>
  <core:prefLabel xml:lang="en">SubObject</core:prefLabel>
  <elucidation xml:lang="en">An object which is a temporal part of another object.</elucidation>
  <note xml:lang="en">Here we consider a temporal interval that is lower than the characteristic time of the physical process that provides the causality connection between the object parts.</note>
</owl:Class>

<owl:Class rdf:about="#EMMO_b725aad8_55e2_430a_b2d2_f84b8333484e">

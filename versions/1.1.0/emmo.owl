  <rdfs:subClassOf rdf:resource="#EMMO_602397bd_e302_42a6_be33_fe67ea81933a"/>
  <rdfs:subClassOf rdf:resource="#EMMO_af794e9d_dc7d_4756_83e1_2cd0e2ec864e"/>
  <rdfs:label xml:lang="en">ElectricCurrentDensity</rdfs:label>
  <rdfs:comment xml:lang="en">Electric current divided by the cross-sectional area it is passing through.</rdfs:comment>

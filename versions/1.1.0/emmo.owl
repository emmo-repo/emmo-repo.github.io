  <rdfs:subClassOf rdf:resource="#EMMO_f5dba4d2_41dd_4591_a9e2_d35f8aee99e8"/>
  <rdfs:label xml:lang="en">SupercriticalFluid</rdfs:label>
  <rdfs:comment xml:lang="en">A gas with T&gt;T𞁞 and p&gt;p𞁞, single phase with liquid-like density and solvating power but gas-like diffusivity and zero surface tension. Continuously connected to both liquid and gas (you can circle the critical point without ever crossing a phase boundary).</rdfs:comment>
  <core:prefLabel xml:lang="en">SupercriticalFluid</core:prefLabel>
  <conceptualisation xml:lang="en">A gas with T&gt;T𞁞 and p&gt;p𞁞, single phase with liquid-like density and solvating power but gas-like diffusivity and zero surface tension. Continuously connected to both liquid and gas (you can circle the critical point without ever crossing a phase boundary).</conceptualisation>
</owl:Class>


<owl:NamedIndividual rdf:about="#PlanckEnergy">
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdf:type rdf:resource="#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">PlanckEnergy</rdfs:label>
  <rdfs:comment xml:lang="en">In physics, the unit of energy in the system of natural units known as Planck units is called the Planck energy, denoted by Eₚ. Eₚ is a derived, as opposed to basic, Planck unit. An equivalent definition is: Eₚ = ℏ / tₚ where tₚ is the Planck time. Also: Eₚ = mₚ c² where mₚ is the Planck mass.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Planck Energy</core:altLabel>
  <core:prefLabel xml:lang="en">PlanckEnergy</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1956100000.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">In physics, the unit of energy in the system of natural units known as Planck units is called the Planck energy, denoted by Eₚ. Eₚ is a derived, as opposed to basic, Planck unit. An equivalent definition is: Eₚ = ℏ / tₚ where tₚ is the Planck time. Also: Eₚ = mₚ c² where mₚ is the Planck mass.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PlanckEnergy</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eᵨ</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Planck_energy?oldid=493639955</wikipediaReference>
</owl:NamedIndividual>


<owl:NamedIndividual rdf:about="#Hour">
  <rdf:type rdf:resource="#EMMO_02e894c3_b793_4197_b120_3442e08f58d1"/>
  <rdf:type rdf:resource="#EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits-abox#"/>
  <rdfs:label xml:lang="en">Hour</rdfs:label>
  <rdfs:comment xml:lang="en">Measure of time defined as 3600 seconds.</rdfs:comment>
  <rdfs:comment xml:lang="en">The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h.

-- QUDT</rdfs:comment>
  <core:prefLabel xml:lang="en">Hour</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUR</sche:unitCode>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3600.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">h</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <definition xml:lang="en">Measure of time defined as 3600 seconds.</definition>
  <elucidation xml:lang="en">The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h.

-- QUDT</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.H02866</iupacReference>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/HR</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">h</ucumCode>
</owl:NamedIndividual>


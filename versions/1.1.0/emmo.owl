<owl:NamedIndividual rdf:about="#CubicAngstrom">
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_9141801c_c539_4c72_b423_8c74ff6b8f05"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits-abox#"/>
  <rdfs:label xml:lang="en">CubicAngstrom</rdfs:label>
  <rdfs:comment xml:lang="en">A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m²/V and can be converted to Ångström³ by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m³ to Ångström³ through the SI base 10 conversion (multiplying by 10⁻³⁰).

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Cubic Angstrom</core:altLabel>
  <core:altLabel xml:lang="en">Cubic Ångström</core:altLabel>
  <core:altLabel xml:lang="en">CubicÅngström</core:altLabel>
  <core:prefLabel xml:lang="en">CubicAngstrom</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1e-40</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m²/V and can be converted to Ångström³ by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m³ to Ångström³ through the SI base 10 conversion (multiplying by 10⁻³⁰).

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/ANGSTROM3</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Å³</unitSymbol>
</owl:NamedIndividual>


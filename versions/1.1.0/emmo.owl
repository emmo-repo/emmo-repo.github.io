<owl:NamedIndividual rdf:about="#Lumen">
  <rdf:type rdf:resource="#EMMO_14ff4393_0f28_4fb4_abc7_c2cc00bc761d"/>
  <rdf:type rdf:resource="#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits-abox#"/>
  <rdfs:label xml:lang="en">Lumen</rdfs:label>
  <rdfs:comment xml:lang="en">SI unit for luminous flux.</rdfs:comment>
  <core:prefLabel xml:lang="en">Lumen</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LUM</sche:unitCode>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lm</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Lumen</dbpediaReference>
  <elucidation xml:lang="en">SI unit for luminous flux.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.L03639</iupacReference>
  <note xml:lang="en">The SI unit for measuring the flux of light being produced by a light source or received by a surface. The intensity of a light source is measured in candelas. One lumen represents the total flux of light emitted, equal to the intensity in candelas multiplied by the solid angle in steradians into which the light is emitted. A full sphere has a solid angle of 4·π steradians. A light source that uniformly radiates one candela in all directions has a total luminous flux of 1 cd·4π sr = 4π cd·sr ≈ 12.57 lumens. "Lumen" is a Latin word for light.

-- QUDT</note>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/LM</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lm</ucumCode>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Lumen_(unit)</wikipediaReference>
</owl:NamedIndividual>


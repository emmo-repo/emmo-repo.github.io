<owl:Class rdf:about="#EMMO_0914449c_ef24_4372_b669_9cdd13b59fed">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
  <rdfs:label xml:lang="en">Minimal</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type.</rdfs:comment>
  <core:prefLabel xml:lang="en">Minimal</core:prefLabel>
  <elucidation xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type.</elucidation>
  <illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Minimal.png</illustration>
  <note xml:lang="en">A minimal class M (subclass of Minimal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and x is proper part of a larger φ entity.</note>
</owl:Class>


  <core:prefLabel xml:lang="en">hasPiece</core:prefLabel>
  <elucidation xml:lang="en">The relation between two individuals representing an entity and a non-maximal proper part, meaning the the latter is connected with the rest of the whole.</elucidation>
  <note xml:lang="en">A non-maximal part is a proper part that is connected with the rest of the whole.</note>
</owl:ObjectProperty>


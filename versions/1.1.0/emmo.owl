<owl:NamedIndividual rdf:about="#LumenSecond">
  <rdf:type rdf:resource="#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdf:type rdf:resource="#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#"/>
  <rdfs:label xml:lang="en">LumenSecond</rdfs:label>
  <rdfs:comment xml:lang="en">In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol T).  An older name for the lumen second was the lumberg.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">lumen second</core:altLabel>
  <core:prefLabel xml:lang="en">LumenSecond</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol T).  An older name for the lumen second was the lumberg.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/LM-SEC</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lm.s</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lm⋅s</unitSymbol>
</owl:NamedIndividual>


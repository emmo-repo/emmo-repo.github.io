  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/prefixedsiunits-abox#"/>
  <EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 rdf:resource="#Metre"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KiloMetre</rdfs:label>
  <rdfs:comment xml:lang="en">A common metric unit of length or distance. One kilometer equals exactly 1000 meters, about 0.621 371 19 mile, 1093.6133 yards, or 3280.8399 feet. Oddly, higher multiples of the meter are rarely used; even the distances to the farthest galaxies are usually measured in kilometers.

-- QUDT</rdfs:comment>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KiloMetre</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1000.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">A common metric unit of length or distance. One kilometer equals exactly 1000 meters, about 0.621 371 19 mile, 1093.6133 yards, or 3280.8399 feet. Oddly, higher multiples of the meter are rarely used; even the distances to the farthest galaxies are usually measured in kilometers.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/KiloM</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">km</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">km</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Kilometre?oldid=494821851</wikipediaReference>
</owl:NamedIndividual>


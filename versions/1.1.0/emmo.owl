  <rdfs:subClassOf rdf:resource="#EMMO_1c0b22a2_be82_4fa8_9e2b_a569a625d442"/>
  <rdfs:subClassOf rdf:resource="#EMMO_eff42cb3_208e_4768_9a39_f8b6b3c3d7a2"/>
  <rdfs:label xml:lang="en">Simulation</rdfs:label>

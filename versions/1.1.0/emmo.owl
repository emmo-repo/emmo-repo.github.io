<owl:Class rdf:about="#EMMO_10a5fd39_06aa_4648_9e70_f962a9cb2069">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:subClassOf>

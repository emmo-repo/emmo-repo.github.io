  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E02032</iupacReference>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/ElementaryCharge</qudtReference>
</owl:Class>

<owl:Class rdf:about="#EMMO_9f4f4fab_80bc_44e9_81a2_b7ef07ba4011">

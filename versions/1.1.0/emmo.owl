<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_ecc10f05_b301_4dcf_8c84_b6f511117234"/>

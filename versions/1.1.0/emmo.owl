<owl:NamedIndividual rdf:about="#EarthMass">
  <rdf:type rdf:resource="#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_f0404eb3_433e_48af_a50f_67f1a03f5f0c"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/specialunits-abox#"/>
  <rdfs:label xml:lang="en">EarthMass</rdfs:label>
  <rdfs:comment xml:lang="en">Earth mass (M⊕) is the unit of mass equal to that of the Earth. In SI Units, 1 M⊕ = 5.9722 × 10²⁴ kg. Earth mass is often used to describe masses of rocky terrestrial planets. The four terrestrial planets of the Solar System, Mercury, Venus, Earth, and Mars, have masses of 0.055, 0.815, 1.000, and 0.107 Earth masses respectively.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Earth mass</core:altLabel>
  <core:prefLabel xml:lang="en">EarthMass</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.97219e+24</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">Earth mass (M⊕) is the unit of mass equal to that of the Earth. In SI Units, 1 M⊕ = 5.9722 × 10²⁴ kg. Earth mass is often used to describe masses of rocky terrestrial planets. The four terrestrial planets of the Solar System, Mercury, Venus, Earth, and Mars, have masses of 0.055, 0.815, 1.000, and 0.107 Earth masses respectively.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/EarthMass</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M⊕</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Earth_mass?oldid=495457885</wikipediaReference>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Newton">
  <rdf:type rdf:resource="#EMMO_53e825d9_1a09_483c_baa7_37501ebfbe1c"/>
  <rdf:type rdf:resource="#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits-abox#"/>
  <rdfs:label xml:lang="en">Newton</rdfs:label>
  <rdfs:comment xml:lang="en">SI unit for force.</rdfs:comment>
  <core:prefLabel xml:lang="en">Newton</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEW</sche:unitCode>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Newton</dbpediaReference>
  <elucidation xml:lang="en">SI unit for force.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.N04135</iupacReference>
  <note xml:lang="en">The "Newton" is the SI unit of force. A force of one newton will accelerate a mass of one kilogram at the rate of one meter per second per second. The newton is named for Isaac Newton (1642-1727), the British mathematician, physicist, and natural philosopher. He was the first person to understand clearly the relationship between force (F), mass (m), and acceleration (a) expressed by the formula F = m·a.

-- QUDT</note>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/N</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</ucumCode>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Newton?oldid=488427661</wikipediaReference>
</owl:NamedIndividual>


<owl:NamedIndividual rdf:about="#PoundPerHour">
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_8826aefb_0bf6_4378_8732_fc80aa95654c"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">PoundPerHour</rdfs:label>
  <rdfs:comment xml:lang="en">Pound per hour is a mass flow unit. It is abbreviated as PPH or more conventionally as lb/h. Fuel flow for engines is usually expressed using this unit, it is particularly useful when dealing with gases or liquids as volume flow varies more with temperature and pressure. 1 lb/h = 0.4535927 kg/h = 126.00 mg/s.  Minimum fuel intake on a jumbojet can be as low as 150 lb/h when idling, however this is not enough to sustain flight.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Pound per Hour</core:altLabel>
  <core:prefLabel xml:lang="en">PoundPerHour</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0001259979</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">Pound per hour is a mass flow unit. It is abbreviated as PPH or more conventionally as lb/h. Fuel flow for engines is usually expressed using this unit, it is particularly useful when dealing with gases or liquids as volume flow varies more with temperature and pressure. 1 lb/h = 0.4535927 kg/h = 126.00 mg/s.  Minimum fuel intake on a jumbojet can be as low as 150 lb/h when idling, however this is not enough to sustain flight.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/LB-PER-HR</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[lb_av].h-1</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPH</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Pound_per_hour?oldid=328571072</wikipediaReference>
</owl:NamedIndividual>


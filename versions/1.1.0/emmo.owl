      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="#EMMO_cb804456_9459_4be5_ac63_a291a872fbd0"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="#EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d"/>
    </owl:Restriction>

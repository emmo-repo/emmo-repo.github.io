  <rdfs:subPropertyOf rdf:resource="#EMMO_9cb984ca_48ad_4864_b09e_50d3fff19420"/>
  <rdfs:label xml:lang="en">hasProperPart</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between an entity and one of its parts, when both entities are distinct.</rdfs:comment>
  <core:prefLabel xml:lang="en">hasProperPart</core:prefLabel>
  <elucidation xml:lang="en">The relation between an entity and one of its parts, when both entities are distinct.</elucidation>
  <note xml:lang="en">The proper part relation has the following pair-covering sub-relations:
- hasMembers xor hasPiece
- hasPortionPart xor hasGatheredPart
. hasItemPart xor hasScatteredPart</note>
</owl:AsymmetricProperty>


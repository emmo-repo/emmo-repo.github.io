  <rdfs:subClassOf rdf:resource="#EMMO_b5957cef_a287_442d_a3ce_fd39f20ba1cd"/>
  <rdfs:label xml:lang="en">OneManifold</rdfs:label>
  <rdfs:comment xml:lang="en">A topological space with the property that each point has a neighborhood that is homeomorphic to an open subset of 1-dimensional Euclidean space.</rdfs:comment>
  <core:altLabel xml:lang="en">1-manifold</core:altLabel>
  <core:prefLabel xml:lang="en">OneManifold</core:prefLabel>
  <elucidation xml:lang="en">A topological space with the property that each point has a neighborhood that is homeomorphic to an open subset of 1-dimensional Euclidean space.</elucidation>
  <note xml:lang="en">One-dimensional manifolds include lines and circles, but not self-crossing curves. Two-dimensional manifolds are also called surfaces. Examples include the plane, the sphere, and the torus, and also the Klein bottle and real projective plane.</note>
</owl:Class>


  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits-abox#"/>
  <EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 rdf:resource="#BitPerSecond"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MegaBitPerSecond</rdfs:label>
  <rdfs:comment xml:lang="en">A megabit per second (Mbit/s or Mb/s; not to be confused with mbit/s which means millibit per second, or with Mbitps which means megabit picosecond) is a unit of data transfer rate equal to 1,000,000 bits per second or 1,000 kilobits per second or 125,000 bytes per second or 125 kilobytes per second.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Megabit per Second</core:altLabel>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MegaBitPerSecond</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">693147.2</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">A megabit per second (Mbit/s or Mb/s; not to be confused with mbit/s which means millibit per second, or with Mbitps which means megabit picosecond) is a unit of data transfer rate equal to 1,000,000 bits per second or 1,000 kilobits per second or 125,000 bytes per second or 125 kilobytes per second.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/MegaBIT-PER-SEC</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MBd</ucumCode>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mbit/s</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mbps</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Data_rate_units</wikipediaReference>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Absiemens">

<owl:AnnotationProperty rdf:about="#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652">
  <rdfs:domain rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:subPropertyOf rdf:resource="#EMMO_58e7c821_4af0_4394_89f7_a9649735f4d2"/>
  <rdfs:label xml:lang="en">ucumCode</rdfs:label>
  <rdfs:comment xml:lang="en">Unified Code for Units of Measure (UCUM).</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ucum.org/</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <core:changeNote xml:lang="en">Replaced by emmo:ucumCode</core:changeNote>
  <core:prefLabel xml:lang="en">ucumCode</core:prefLabel>
  <elucidation xml:lang="en">Unified Code for Units of Measure (UCUM).</elucidation>
  <note xml:lang="en">The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units.</note>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#EMMO_fe015383_afb3_44a6_ae86_043628697aa2">

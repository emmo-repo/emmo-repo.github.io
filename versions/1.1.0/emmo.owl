<owl:NamedIndividual rdf:about="#Shake">
  <rdf:type rdf:resource="#EMMO_02e894c3_b793_4197_b120_3442e08f58d1"/>
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">Shake</rdfs:label>
  <rdfs:comment xml:lang="en">A shake is an informal unit of time equal to 10 nanoseconds. It has applications in nuclear physics, helping to conveniently express the timing of various events in a nuclear explosion. The typical time required for one step in the chain reaction (i.e. the typical time for each neutron to cause a fission event which releases more neutrons) is of order 1 shake, and the chain reaction is typically complete by 50 to 100 shakes.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:prefLabel xml:lang="en">Shake</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1e-08</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">A shake is an informal unit of time equal to 10 nanoseconds. It has applications in nuclear physics, helping to conveniently express the timing of various events in a nuclear explosion. The typical time required for one step in the chain reaction (i.e. the typical time for each neutron to cause a fission event which releases more neutrons) is of order 1 shake, and the chain reaction is typically complete by 50 to 100 shakes.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/SH</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.ns</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shake</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Shake?oldid=494796779</wikipediaReference>
</owl:NamedIndividual>


  <rdfs:label xml:lang="en">hasSIConversionOffset</rdfs:label>
  <rdfs:comment xml:lang="en">Number to add to a SI coherent unit when converting to a given non-SI coherent unit.</rdfs:comment>
  <core:prefLabel xml:lang="en">hasSIConversionOffset</core:prefLabel>
  <elucidation xml:lang="en">Number to add to a SI coherent unit when converting to a given non-SI coherent unit.</elucidation>
  <note xml:lang="en">Conversion formula:

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset</note>
</owl:DatatypeProperty>


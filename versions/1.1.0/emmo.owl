  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-58</ISO80000Reference>
  <elucidation xml:lang="en">Differential quotient of q with respect to l, where q is the average total charge of all positive ions produced by an ionizing charged particle over a path l, divided by the elementary charge.</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/LinearIonization</qudtReference>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98690755</wikidataReference>
</owl:Class>


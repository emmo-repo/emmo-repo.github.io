<owl:NamedIndividual rdf:about="#Stokes">
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b33cc5b5_a9dc_4082_b497_14d1654c5591"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/specialunits-abox#"/>
  <rdfs:label xml:lang="en">Stokes</rdfs:label>
  <rdfs:comment xml:lang="en">`Stokes (St)` is a unit in the category of Kinematic viscosity. This unit is commonly used in the cgs unit system. Stokes (St) has a dimension of L²T⁻¹ where L is length, and T is time. It can be converted to the corresponding standard SI unit m²/s by multiplying its value by a factor of 0.0001.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--kinematic_viscosity--stokes.cfm</rdfs:seeAlso>
  <core:prefLabel xml:lang="en">Stokes</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0001</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">`Stokes (St)` is a unit in the category of Kinematic viscosity. This unit is commonly used in the cgs unit system. Stokes (St) has a dimension of L²T⁻¹ where L is length, and T is time. It can be converted to the corresponding standard SI unit m²/s by multiplying its value by a factor of 0.0001.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/ST</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">St</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">St</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Stokes?oldid=426159512</wikipediaReference>
</owl:NamedIndividual>


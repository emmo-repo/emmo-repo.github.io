  <rdfs:label xml:lang="en">MaterialByStructure</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all materials that are categorised according to their periodicity/crystalline structure</rdfs:comment>
  <core:prefLabel xml:lang="en">MaterialByStructure</core:prefLabel>
  <elucidation xml:lang="en">The superclass for all materials that are categorised according to their periodicity/crystalline structure</elucidation>
  <note xml:lang="en">The distinction between amorphous and crystalline is about structural isotropy. Property isotropy is not necessarly related to structural isotropy (e.g., an amorphous material can express some anisotropic property under external conditions such a stress, flow, fields).</note>
</owl:Class>

<owl:Class rdf:about="#EMMO_c1dad83e_974f_432e_ac92_d016f2445279">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_bfce8136_8f58_4ea5_ab3a_1734170c5d92"/>
  <rdfs:label xml:lang="en">Drilling</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">machining with a circular cutting movement in which the axis of rotation of the tool and the axis of the internal surface to be produced are identical and the feed movement is in the direction of this axis. The axis of rotation of the cutting movement maintains its position relative to the workpiece independently of the feed movement (axis of rotation workpiece-bound).</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bohren</core:altLabel>
  <core:prefLabel xml:lang="en">Drilling</core:prefLabel>
</owl:Class>


<owl:Class rdf:about="#EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="#EMMO_dba27ca1_33c9_4443_a912_1519ce4c39ec"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_9d799b43_e188_4047_8167_121d96b31a26"/>
  <rdfs:label xml:lang="en">Constituent</rdfs:label>
  <rdfs:comment xml:lang="en">An object which is a spatial part of another object.</rdfs:comment>
  <core:altLabel xml:lang="en">ObjectPart</core:altLabel>
  <core:example xml:lang="en">A tire is a constituent of a car.</core:example>

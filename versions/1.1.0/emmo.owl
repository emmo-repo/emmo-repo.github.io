<owl:NamedIndividual rdf:about="#PlanckLength">
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdf:type rdf:resource="#EMMO_b3600e73_3e05_479d_9714_c041c3acf5cc"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">PlanckLength</rdfs:label>
  <rdfs:comment xml:lang="en">In physics, the Planck length, denoted ℓₚ, is a unit of length, equal to 1.616199(97)×10⁻³⁵ metres. It is a base unit in the system of Planck units. The Planck length can be defined from three fundamental physical constants: the speed of light in a vacuum, Planck's constant, and the gravitational constant.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Planck Length</core:altLabel>
  <core:prefLabel xml:lang="en">PlanckLength</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.616252e-35</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">In physics, the Planck length, denoted ℓₚ, is a unit of length, equal to 1.616199(97)×10⁻³⁵ metres. It is a base unit in the system of Planck units. The Planck length can be defined from three fundamental physical constants: the speed of light in a vacuum, Planck's constant, and the gravitational constant.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PlanckLength</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ℓₚ</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Planck_units</wikipediaReference>
</owl:NamedIndividual>


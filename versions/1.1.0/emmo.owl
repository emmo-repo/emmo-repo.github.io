</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_02122e58_e0b3_4274_bdd4_745f64a61645"/>
  <owl:annotatedTarget xml:lang="en">Factory</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin factor, from fact- ‘done’, from the verb facere (to do).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
  <owl:annotatedSource rdf:resource="#EMMO_e97af6ec_4371_4bbc_8936_34b76e33302f"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cencenelec.eu/media/CEN-CENELEC/CWAs/RI/cwa17284_2018.pdf</rdfs:seeAlso>
  <owl:annotatedTarget xml:lang="en">CEN Workshop Agreement – CWA 17284 “Materials modelling – terminology, classification and metadata”</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_649bf97b_4397_4005_90d9_219755d92e34"/>
  <owl:annotatedTarget xml:lang="en">Perceptual</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin percipiō, past participle perceptus (“take hold of, obtain, receive, observe”), from per (“by, through”) + capiō (“to take”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:hasValue rdf:resource="#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="#EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f"/>
        </rdf:Description>
      </owl:onProperty>
    </owl:Restriction>
  </owl:annotatedTarget>
  <note xml:lang="en">All EMMO individuals are part of the most comprehensive entity which is the universe.</note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#elucidation"/>
  <owl:annotatedSource rdf:resource="#EMMO_db99b1e5_2f34_467b_a784_d104946d9f00"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.ietf.org/rfc/rfc3986.txt</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">The term "Uniform Resource Name" (URN) has been used historically to refer to both URIs under the "urn" scheme [RFC2141], which are required to remain globally unique and persistent even when the resource ceases to exist or becomes unavailable, and to any other URI with the properties of a name.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
  <owl:annotatedTarget xml:lang="en">Icon</owl:annotatedTarget>
  <etymology xml:lang="en">From Ancient Greek εἰκών (eikṓn, “likeness, image, portrait”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_52b8a39b_e5ff_46d3_b972_65bc43077a07"/>
  <owl:annotatedTarget xml:lang="en">CausalParticle</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin particula (“small part, particle”), diminutive of pars (“part, piece”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_479db031_b344_4488_9efa_4bc12c6c1765"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wiktionary.org/wiki/workpiece</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The raw material or partially finished piece that is shaped by performing various operations.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_65411b3d_c8d3_4111_86a9_a2ce0a64c647"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.linfo.org/program.html</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">A program is a sequence of instructions understandable by a computer's central processing unit (CPU) that indicates which operations the computer should perform on a set of data.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_49267eba_5548_4163_8f36_518d65b583f9"/>
  <owl:annotatedTarget xml:lang="en">Perspective</owl:annotatedTarget>
  <etymology xml:lang="en">From medieval Latin perspectiva ‘(science of) optics’, from perspect- ‘looked at closely’, from the verb perspicere, from per- ‘through’ + specere ‘to look’.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_2b9cbfb5_dbd0_4a68_9c6f_acc41b40dd72"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 14943:2006-03</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conversion of materials and assembly of components for the manufacture of products</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f"/>
      <owl:someValuesFrom rdf:resource="#EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <note xml:lang="en">Every entity is made of quantum parts. This axiomatisation is the expression of the radical reductionistic approach of the EMMO.</note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598"/>
  <owl:annotatedTarget xml:lang="en">hasSuccessor</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin succedĕre ("coming after").</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#elucidation"/>
  <owl:annotatedSource rdf:resource="#EMMO_8681074a_e225_4e38_b586_e85b0f43ce38"/>
  <rdfs:isDefinedBy xml:lang="en">https://www.iso.org/obp/ui/fr/#iso:std:iso-iec:2382:-1:ed-3:en</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">All or part of the programs, procedures, rules, and associated documentation of an information processing system.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#conceptualisation"/>
  <owl:annotatedSource rdf:resource="#EMMO_64c72d00_7582_44ea_a0b5_3a14e50acc36"/>
  <rdfs:isDefinedBy xml:lang="en">Luciano Floridi, "Information - A Very Short Introduction", Oxford University Press (2010) ISBN: 9780199551378</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">The General Definition of Information (GDI) can be used to define the concept of information.
(GDI) a is an instance of information, understood as semantic content, if and only if:
  GDI.l) a consists of n data, for n &gt; 1;
  GDI.2) the data are well formed;
  GDI.3) the well-formed data are meaningful.

In the EMMO conceptualisation, well-formed data are data with a specific syntactic structure (symbolic and reductionistic modules), while meaningful data are data that are part of a semiotic interpretation process that declares what the data are about (semiotic module).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68"/>
  <owl:annotatedTarget xml:lang="en">Quantum</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin quantum (plural quanta) "as much as, so much as".</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Semiotic_theory_of_Charles_Sanders_Peirce#II._Icon,_index,_symbol</rdfs:seeAlso>
  <owl:annotatedTarget xml:lang="en">In Peirce semiotics three subtypes of icon are possible:
(a) the image, which depends on a simple quality (e.g. picture)
(b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy the relations in something (e.g. math formula, geometric flowchart)
(c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else
[Wikipedia]</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_5b2222df_4da6_442f_8244_96e9e45887d1"/>
  <owl:annotatedTarget xml:lang="en">Matter</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin materia (“matter, stuff, material”), from mater (“mother”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_c7171429_b9e3_4812_95c1_e97309370538"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 9110:2018-08</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">action to disassemble a product or a component by removing all or some of its constituent parts with the intent to salvage</owl:annotatedTarget>
</owl:Axiom>

<rdf:Description>
  <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
</rdf:Description>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_912ac3a2_a124_4233_92dd_06c9aebea46c"/>
  <owl:annotatedTarget xml:lang="en">Assemblying</owl:annotatedTarget>
  <etymology xml:lang="en">From Old French asembler, based on Latin ad- ‘to’ + simul ‘together’.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_8681074a_e225_4e38_b586_e85b0f43ce38"/>
  <owl:annotatedTarget xml:lang="en">Software</owl:annotatedTarget>
  <etymology xml:lang="en">From soft +‎ -ware, by contrast with hardware (“the computer itself”). Coined by Paul Niquette in 1953.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
  <owl:annotatedTarget xml:lang="en">Lifetime</owl:annotatedTarget>
  <etymology xml:lang="en">From Middle English liftime, equivalent to life +‎ time.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_3f2e4ac2_8ef3_4a14_b826_60d37f15f8ee"/>
  <owl:annotatedTarget xml:lang="en">mereological</owl:annotatedTarget>
  <etymology xml:lang="en">Coined by Stanisław Leśniewski in 1927, from Ancient Greek μέρος (méros, “part”) +‎ -logy (“study, discussion, science”).
https://en.wiktionary.org/wiki/mereology</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_6ab555fd_5803_4f03_82e8_127c01aabfea"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8593-0:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The permanent joining or other bringing together of two or more workpieces of a geometric shape or of similar workpieces with shapeless material. In each case, the cohesion is created locally and increased as a whole.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_214e9a99_58de_40e2_86cf_fa6aa1d180a8"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8585-3:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widening is tensile forming to increase the circumference of a hollow body. A distinction is made between: Widening, bulging.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_a4d66059_5dd3_4b90_b4cb_10960559441b"/>
  <owl:annotatedTarget xml:lang="en">Manufacturing</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin manu factum ("made by hand").</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_3b19eab4_79be_4b02_bdaf_ecf1f0067a68"/>
  <owl:annotatedTarget xml:lang="en">Observation</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin observare (“to watch, note, mark, heed, guard, keep, pay attention to, regard, comply with, etc.”), from ob (“before”) + servare (“to keep”),</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895"/>
  <owl:annotatedTarget xml:lang="en">Variable</owl:annotatedTarget>
  <etymology xml:lang="en">Fom Latin variabilis ("changeable").</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_fa3c9d4d_9fc9_4e8a_82c1_28c84e34133a"/>
  <owl:annotatedTarget xml:lang="en">FundamentalBoson</owl:annotatedTarget>
  <etymology xml:lang="en">1940s: named after S.N. Bose.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_d5f98475_00ce_4987_99fb_262aed395e46"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8588:2013-08</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanical separation of workpieces without the formation of shapeless material, i.e. also without chips (chipless).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_61846411_8c6f_410b_ae7b_8999ec18f2b2"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN ISO 4885:2018-07</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Treatment carried out after hardening or case hardening consisting of cooling to a temperature below room temperature to complete the transformation of austenite to martensite</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_22744495_4f32_4a17_b189_259c644268f9"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8587:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of a solid body, whereby the plastic state is essentially brought about by shear stress.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#definition"/>
  <owl:annotatedSource rdf:resource="#EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]</owl:annotatedTarget>
  <note xml:lang="en">We usa a predicate template notation as DP&lt;φ&gt;(x,y) to specify subclasses of DP(x,y) for the class φ, meaning that DP&lt;φ&gt;(x, y) ≡ PP(x, y) ∧ (φ(x) ↔ ¬φ(y))</note>
  <note xml:lang="en">φ is a class of the theory</note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8"/>
  <owl:annotatedTarget xml:lang="en">Device</owl:annotatedTarget>
  <etymology xml:lang="en">From Old French "deviser", meaning: arrange, plan, contrive. Literally "dispose in portions," from Vulgar Latin "divisare", frequentative of Latin dividere, meaning "to divide".</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <owl:annotatedSource rdf:resource="#EMMO_03441eb3_d1fd_4906_b953_b83312d7589e"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso-astm:tr:52906:ed-1:v1:en:term:3.9</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">ISO/ASTM TR 52906:2022 Additive manufacturing
sintering: process of heating a powder metal compact to increase density and/or improve mechanical properties via solid state diffusion</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_86ca9b93_1183_4b65_81b8_c0fcd3bba5ad"/>
  <owl:annotatedTarget xml:lang="en">Artifact</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin arte ‘by or using art’ + factum ‘something made’.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"/>
  <owl:annotatedTarget xml:lang="en">Elementary</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin elementārius (“elementary”), from elementum (“one of the four elements of antiquity; fundamentals”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_aced32dd_1a13_49b0_8d8f_c79313942d19"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8586:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of a solid body, whereby the plastic state is essentially brought about by a bending stress.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5"/>
  <owl:annotatedTarget xml:lang="en">FunctionalIcon</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin functiō (“performance, execution”), from functus, perfect participle of fungor (“to perform, execute, discharge”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_2d2ecd97_067f_4d0e_950c_d746b7700a31"/>
  <owl:annotatedTarget xml:lang="en">Collection</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin collectio, from colligere ‘gather together’.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_f5655090_2266_41cb_b2e9_3b4569c45731"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN ISO 472/A1:2019-03</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Type of scratching behaviour where the scratching force and the (displacement) deflection of the scratching tip are constant over the scratching distance during the test.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_46dc0d51_b60f_49cd_8650_9aba7be3726c"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8580:2022-12</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verfestigen durch Umformen</owl:annotatedTarget>
</owl:Axiom>

<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#y"/>
          <swrl:propertyPredicate rdf:resource="#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:argument1 rdf:resource="urn:swrl:var#y"/>
              <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
              <swrl:propertyPredicate rdf:resource="#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
          <swrl:propertyPredicate rdf:resource="#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <rdfs:comment xml:lang="en">Implementing transitivity.</rdfs:comment>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_6fa330f7_3289_4228_81df_12ee8a9708ac"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 10210-3:2020-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process consisting of two steps: - first, the steel is heated in a quenching treatment to a temperature above Ac3 and then rapidly cooled in a liquid to produce a process-specific grain structure; - subsequently, the steel is heated to a specific temperature during tempering to set the desired property and cooled in air.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#VIMTerm"/>
  <owl:annotatedSource rdf:resource="#EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf"/>
  <owl:annotatedTarget xml:lang="en">measurand</owl:annotatedTarget>
  <note xml:lang="en">VIM defines measurand as a quantity intended to be measured. This is redundant in EMMO and correspond to Quantity.</note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_7432b843_cfd2_4345_a3d2_eaa539b27e61"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-3:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Free forming is pressure forming with tools that do not or only partially contain the shape of the workpiece and move against each other.</owl:annotatedTarget>
</owl:Axiom>

<rdf:Description>
  <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
</rdf:Description>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_410b5956_a06d_4370_b7df_b1bd2126fb4b"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-5:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Screwing (screwing on, screwing in, screwing tight) is joining by pressing on by means of a self-locking thread (from: DIN 8593 Part 3/09.85).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="#EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6"/>
  <owl:annotatedProperty rdf:resource="#definition"/>
  <owl:annotatedSource rdf:resource="#EMMO_aa987900_caf1_4ce2_82fa_6b1d6fbd2ead"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dxy ≡ ¬Oxy.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_7cd8a4ec_b219_498e_b696_028257163aa4"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO/TR 10809-1:2009, 0000_19</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heat treatment process that generally produces martensite in the matrix.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_a15cea10_9946_4d2b_95c5_cfc333fd2abb"/>
  <owl:annotatedTarget xml:lang="en">Particle</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin particula (“small part, particle”), diminutive of pars (“part, piece”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_ecf78412_f0ca_4368_9078_559ffe8935d3"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 13831:2007-12</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of vessel parts from a flat mould into a three-dimensional shape by means of a press and tools, whereby material is neither removed nor added</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_0cd58641_824c_4851_907f_f4c3be76630c"/>
  <owl:annotatedTarget xml:lang="en">Index</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin index (“a discoverer, informer, spy; of things, an indicator, the forefinger, a title, superscription”), from indicō (“point out, show”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://en.wiktionary.org/wiki/phase"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_668fbd5b_6f1b_405c_9c6b_d6067bd0595a"/>
  <owl:annotatedTarget xml:lang="en">PhaseOfMatter</owl:annotatedTarget>
  <etymology xml:lang="en">From Ancient Greek φάσις (phásis, “an appearance”), from φαίνω (phaínō, “to cause to appear”) [Wiktionary]</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedSource rdf:resource="#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
  <owl:annotatedTarget rdf:resource="#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
  <conceptualisation xml:lang="en">This axiom reflects the fact the the universe is causally self-connected. In fact, a  non causally connected universe would have been the sum of causally independend sub-universes, without any knowledge of others.
This axiom may be seen as Ockam's razor applied to causality.</conceptualisation>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_3e7add3d_e6ed_489a_a796_8e31fef9b490"/>
  <owl:annotatedTarget xml:lang="en">Data</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin data, nominative plural of datum (“that is given”), neuter past participle of dō (“I give”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_4f46c5ab_1c21_4639_90d5_3c4ebf3b156b"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-5:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nailing is joining by hammering or pressing nails (wire pins) as auxiliary parts into the solid material. Several parts are joined by pressing them together (from: DIN 8593 part 3/09.85).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://en.wiktionary.org/wiki/condense"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd"/>
  <owl:annotatedTarget xml:lang="en">CondensedMatter</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin condēnsō, con- (“with, together”) + dēnsō (“thicken”) [Wiktionary]</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_348d39f7_6a17_49d1_9860_9b33b69b51de"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.linfo.org/source_code.html</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">Source code (also referred to as source or code) is the version of software as it is originally written (i.e., typed into a computer) by a human in plain text (i.e., human readable alphanumeric characters).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_d8d2144e_5c8d_455d_a643_5caf4d8d9df8"/>
  <owl:annotatedTarget xml:lang="en">Language</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin lingua (“tongue, speech, language”), from Old Latin dingua (“tongue”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
  <owl:annotatedSource rdf:resource="#EMMO_c6e77b51_681b_4d04_b20d_a08f2b977470"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Global_Restrictions_on_Axioms_in_OWL_2_DL</rdfs:seeAlso>
  <owl:annotatedTarget xml:lang="en">Axiom not included in the theory because of OWL 2 DL global restrictions for decidability.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_7b79b2ac_3cf2_4d3b_8cdc_bcabb59d869e"/>
  <owl:annotatedTarget xml:lang="en">ElementaryParticle</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin elementārius (“elementary”), from elementum (“one of the four elements of antiquity; fundamentals”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_4c21fb86_fdcf_444e_b498_86fe656295af"/>
  <owl:annotatedTarget xml:lang="en">Plasma</owl:annotatedTarget>
  <etymology xml:lang="en">From Late Latin plasma (“mold”), from Ancient Greek πλάσμα (plásma, “something formed”) [Wiktionary]
The term has been introduced in physics by Irving Langmuir in 1928.</etymology>
</owl:Axiom>

<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:classPredicate rdf:resource="#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#x"/>
          <swrl:propertyPredicate rdf:resource="#EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <note xml:lang="en">Enforcing reflexivity of overlapping.</note>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_1c0b22a2_be82_4fa8_9e2b_a569a625d442"/>
  <owl:annotatedTarget xml:lang="en">Estimation</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin aestimatus (“to value, rate, esteem”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <owl:annotatedSource rdf:resource="#EMMO_2b524942_4e3e_403a_b4ab_2b53750f3d3b"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso:3252:ed-5:v1:en:term:3.3.55</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">ISO 3252:2019 Powder metallurgy
reaction sintering: process wherein at least two constituents of a powder mixture react during sintering</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_0277f24a_ea7f_4917_81b7_fb0406c8fc62"/>
  <owl:annotatedTarget xml:lang="en">Holistic</owl:annotatedTarget>
  <etymology xml:lang="en">Holism (from Greek ὅλος holos "all, whole, entire").</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_dc0874e8_36e1_44df_947d_0d7c81167a09"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-7:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(according to DIN 8200) Shot peening to generate residual compressive stresses in layers of the blasting material close to the surface in order to improve certain component properties, e.g. fatigue strength, corrosion resistance, wear resistance (from: DIN 8200:1982)</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_2b9cbfb5_dbd0_4a68_9c6f_acc41b40dd72"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EN 16603-11:2019-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">application of scientific knowledge, tools, techniques, crafts, systems or methods of organization in order to solve a problem or achieve an objective</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_dacfc7dc_5ddb_4f67_986b_dcd01d649d60"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN ISO 15156-3:2015-12</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heat to a temperature appropriate for the particular material, maintain at that temperature and then cool at an appropriate rate to reduce hardness, improve machinability or achieve desired properties.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_44f91d47_3faf_48e2_844c_d44bbe3e22f6"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8589-3:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Machining with a circular cutting movement, usually associated with a multi-toothed tool, and with a feed movement perpendicular or oblique to the axis of rotation of the tool, to produce any workpiece surface.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="#EMMO_2d2ecd97_067f_4d0e_950c_d746b7700a31"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onClass rdf:resource="#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"/>
      <owl:onProperty rdf:resource="#EMMO_6b7276a4_4b9d_440a_b577_0277539c0fc4"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    </owl:Restriction>
  </owl:annotatedTarget>
  <note xml:lang="en">Every collection has at least two item members, since a collection of one item is a self-connected entity (and then an item).</note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655"/>
  <owl:annotatedTarget xml:lang="en">CrystallineMaterial</owl:annotatedTarget>
  <etymology xml:lang="en">From Ancient Greek κρύσταλλος (krústallos, “clear ice”), from κρύος (krúos, “frost”) [Wiktionary]</etymology>
</owl:Axiom>

<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#y"/>
          <swrl:propertyPredicate rdf:resource="#EMMO_2bb50428_568d_46e8_b8bf_59a4c5656461"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:argument1 rdf:resource="urn:swrl:var#y"/>
              <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
              <swrl:propertyPredicate rdf:resource="#EMMO_36e69413_8c59_4799_946c_10b05d266e22"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
          <swrl:propertyPredicate rdf:resource="#EMMO_7821eeb8_5e44_452b_90e9_3db03bbef241"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <note xml:lang="en">Implements ProcessedFrom.</note>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#conceptualisation"/>
  <owl:annotatedSource rdf:resource="#EMMO_ee0466e4_780d_4236_8281_ace7ad3fc5d2"/>
  <owl:annotatedTarget xml:lang="en">A tessellation (or tiling) is the covering of a surface, often a plane, using one or more geometric shapes, called tiles, with no overlaps and no gaps.</owl:annotatedTarget>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Tessellation</wikipediaReference>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://en.wiktionary.org/wiki/compact"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_9ebb6e14_c656_4568_abfa_f7f193ea14ac"/>
  <owl:annotatedTarget xml:lang="en">CompactMaterial</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin compāctus, perfect passive participle of compingō (“join together”), from com- (“together”) + pangō (“fasten”) [Wiktionary]</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>
  <owl:annotatedSource rdf:resource="#EMMO_607ccc15_38aa_4a69_a70a_effa8015bf42"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-7:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengthening by rolling is the strengthening of component surfaces by mechanically generating compressive stresses in the component surface and consolidating the material.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_68ee441e_c89e_4391_93c3_e68fef59fe14"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8586:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of a solid body, whereby the plastic state is essentially brought about by a bending stress</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963"/>
  <owl:annotatedTarget xml:lang="en">Fusion</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin fusio, from fundere ‘pour, melt’.</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_01048432_3722_40a9_aa37_ea009da44272"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8584-2:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Draw forming by drawing a workpiece through a tool opening that is narrowed in the drawing direction.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"/>

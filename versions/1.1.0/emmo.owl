</owl:Class>

<owl:Class rdf:about="#EMMO_e2064298_2a27_4d4a_b5b3_de3c972d1867">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_9d1efd57_a270_4344_9a8d_dffcaecc7934"/>
  <rdfs:label xml:lang="en">Conductor</rdfs:label>
  <rdfs:comment xml:lang="en">Materials with high concentrations of mobile charge carriers (e.g., free electron gas) that respond to an electric field by establishing a continuous macroscopic current density governed by Ohm's law.</rdfs:comment>
  <core:prefLabel xml:lang="en">Conductor</core:prefLabel>
  <elucidation xml:lang="en">Materials with high concentrations of mobile charge carriers (e.g., free electron gas) that respond to an electric field by establishing a continuous macroscopic current density governed by Ohm's law.</elucidation>
</owl:Class>


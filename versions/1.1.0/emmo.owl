  <wikipediaReference rdf:resource="https://en.wikipedia.org/wiki/Suspension_(chemistry)"/>
  <rdfs:label xml:lang="en">Suspension</rdfs:label>
  <rdfs:comment xml:lang="en">An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase.</rdfs:comment>
  <rdfs:comment xml:lang="en">Suspensions show no significant effect on visible light.</rdfs:comment>
  <core:prefLabel xml:lang="en">Suspension</core:prefLabel>
  <OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalent To: SolidSolidSuspension or SolidLiquidSuspension or LiquidGasSuspension or LiquidLiquidSuspension or SolidGasSuspension or GasSolidSuspension or GasLiquidSuspension or LiquidSolidSuspension</OWLRL2DLAxioms>
  <elucidation xml:lang="en">An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase.</elucidation>
</owl:Class>


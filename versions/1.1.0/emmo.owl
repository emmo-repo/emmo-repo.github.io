<owl:Class rdf:about="#EMMO_3213514e-b1ba-506c-ae22-d4e3a688ddf3">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#EMMO_a585728e-36c8-5df4-9d95-aa128d2a0e7f"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">109</owl:hasValue>

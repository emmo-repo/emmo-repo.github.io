<owl:Class rdf:about="#EMMO_27367073_ed8a_481a_9b07_f836dfe31f7f">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom rdf:resource="#EMMO_eb77076b_a104_42ac_a065_798b2d2809ad"/>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="#EMMO_e1097637_70d2_4895_973f_2396f04fa204"/>

  <rdfs:label xml:lang="en">Fluid</rdfs:label>
  <rdfs:comment xml:lang="en">A continuum that has no fixed shape and yields easily under an applied shear stress, or external force.</rdfs:comment>
  <core:example xml:lang="en">Gas, liquid, plasma,</core:example>
  <core:prefLabel xml:lang="en">Fluid</core:prefLabel>
  <OWLRL2DLAxioms xml:lang="en">Equivalent To: Gas or Plasma or Liquid</OWLRL2DLAxioms>
  <elucidation xml:lang="en">A continuum that has no fixed shape and yields easily under an applied shear stress, or external force.</elucidation>
</owl:Class>

<owl:Class rdf:about="#EMMO_1d0064d2_d77e_4ec7_b74a_00f98616156f">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_8820f251_ad36_43f4_a693_c0e86a89cc1f"/>
  <rdfs:label xml:lang="en">FunctionalMaterial</rdfs:label>
  <rdfs:comment xml:lang="en">A functional material is any material that exhibits distinct, reproducible changes in its electronic, magnetic, optical, chemical, or thermal properties when exposed to an external field or environmental change.</rdfs:comment>
  <core:prefLabel xml:lang="en">FunctionalMaterial</core:prefLabel>
  <elucidation xml:lang="en">A functional material is any material that exhibits distinct, reproducible changes in its electronic, magnetic, optical, chemical, or thermal properties when exposed to an external field or environmental change.</elucidation>
  <note xml:lang="en">Materials categorised for what they do rather than what they hold up. They are designed to react to their environment, convert energy, or process information.</note>
</owl:Class>


  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits-abox#"/>
  <rdfs:label xml:lang="en">Abfarad</rdfs:label>
  <rdfs:comment xml:lang="en">An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to 10⁹ farads (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically abC/abV, and identically reciprocal abdaraf. 1 abF = 1 GF.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-13</rdfs:seeAlso>
  <core:prefLabel xml:lang="en">Abfarad</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1000000000.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to 10⁹ farads (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically abC/abV, and identically reciprocal abdaraf. 1 abF = 1 GF.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/FARAD_Ab</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GF</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abF</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Abfarad?oldid=407124018</wikipediaReference>
</owl:NamedIndividual>


<owl:NamedIndividual rdf:about="#MegaBitPerSecond">
  <rdf:type rdf:resource="#EMMO_515b5579_d526_4842_9e6f_ecc34db6f368"/>
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>

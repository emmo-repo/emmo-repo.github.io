  <term:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nomenclature</term:subject>
  <term:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Updated definition of glass-ceramics</term:title>
</dcmi:Text>


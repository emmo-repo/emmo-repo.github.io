  <rdf:type rdf:resource="#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e"/>
  <rdf:type rdf:resource="#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedunits-abox#"/>
  <EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 rdf:resource="#Watthour"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KiloWattHour</rdfs:label>
  <rdfs:comment xml:lang="en">The kilowatt hour, or kilowatt-hour, (symbol kW · h, kW h or kWh) is a unit of energy equal to 1000 watt hours or 3.6 megajoules. For constant power, energy in watt hours is the product of power in watts and time in hours. The kilowatt hour is most commonly known as a billing unit for energy delivered to consumers by electric utilities.

-- QUDT</rdfs:comment>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KiloWattHour</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3600000.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">The kilowatt hour, or kilowatt-hour, (symbol kW · h, kW h or kWh) is a unit of energy equal to 1000 watt hours or 3.6 megajoules. For constant power, energy in watt hours is the product of power in watts and time in hours. The kilowatt hour is most commonly known as a billing unit for energy delivered to consumers by electric utilities.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/KiloW-HR</qudtReference>

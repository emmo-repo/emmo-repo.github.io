<owl:NamedIndividual rdf:about="#Becquerel">
  <rdf:type rdf:resource="#EMMO_515b5579_d526_4842_9e6f_ecc34db6f368"/>
  <rdf:type rdf:resource="#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits-abox#"/>
  <rdfs:label xml:lang="en">Becquerel</rdfs:label>
  <rdfs:comment xml:lang="en">Radioactive decays per second.</rdfs:comment>
  <rdfs:comment xml:lang="en">SI unit for radioactive activity.</rdfs:comment>
  <core:prefLabel xml:lang="en">Becquerel</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BQL</sche:unitCode>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bq</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Becquerel</dbpediaReference>
  <definition xml:lang="en">Radioactive decays per second.</definition>
  <elucidation xml:lang="en">SI unit for radioactive activity.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.B00624</iupacReference>
  <note xml:lang="en">The SI derived unit of activity, usually meaning radioactivity. "Radioactivity" is caused when atoms disintegrate, ejecting energetic particles. One becquerel is the radiation caused by one disintegration per second; this is equivalent to about 27.0270 picocuries (pCi). The unit is named for a French physicist, Antoine-Henri Becquerel (1852-1908), the discoverer of radioactivity. Note: both the becquerel and the hertz are basically defined as one event per second, yet they measure different things. The hertz is used to measure the rates of events that happen periodically in a fixed and definite cycle. The becquerel is used to measure the rates of events that happen sporadically and unpredictably, not in a definite cycle.

-- QUDT</note>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/BQ</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bq</ucumCode>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Becquerel?oldid=493710036</wikipediaReference>
</owl:NamedIndividual>


  <EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Axioms to add to the OWL 2 RL version of the ontology to reach DL expressivity.</EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54">

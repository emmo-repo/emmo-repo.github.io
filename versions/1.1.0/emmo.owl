<owl:Class rdf:about="#EMMO_5117c5fe_f661_46f8_83c3_b48947f1532a">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_31ec09ba_1713_42cb_83c7_b38bf6f9ced2"/>
  <rdfs:subClassOf rdf:resource="#EMMO_3b1b64d1_60c9_4689_a300_eb9cd56e368b"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RestEnergy</rdfs:label>
  <rdfs:comment xml:lang="en">Product of the rest mass and the square of the speed of light in vacuum.</rdfs:comment>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RestEnergy</core:prefLabel>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-05</IEVReference>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-04-17</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-3</ISO80000Reference>
  <elucidation xml:lang="en">Product of the rest mass and the square of the speed of light in vacuum.</elucidation>
  <note xml:lang="en">E_0 = m_0 * c_0^2

where m_0 is the rest mass of that particle and c_0 is the speed of light in a vacuum.</note>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q11663629</wikidataReference>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Invariant_mass#Rest_energy</wikipediaReference>
</owl:Class>

<owl:Class rdf:about="#EMMO_6ef285fc_227a_411c_9d5d_894e3d747d00">

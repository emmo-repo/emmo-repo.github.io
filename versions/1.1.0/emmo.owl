<owl:Class rdf:about="#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/holistic#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b"/>
      <owl:someValuesFrom rdf:resource="#EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_eb50c9cb_9576_4a61_95ec_f81fb8218187"/>
  <rdfs:label xml:lang="en">Whole</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</rdfs:comment>
  <core:prefLabel xml:lang="en">Whole</core:prefLabel>
  <elucidation xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</elucidation>
  <note xml:lang="en">A whole is always defined using a criterion expressed through the classical transitive parthood relation.
This class is expected to host the definition of world objects as they appear in its wholeness, dependently on some of their parts and independently on the surroundings.</note>
  <note xml:lang="en">A whole is categorized as fundamental (or maximal) or redundant (non-maximal).</note>
</owl:Class>


  <rdfs:label xml:lang="en">SupersaturatedVapor</rdfs:label>
  <rdfs:comment xml:lang="en">A metastable saturated vapor carried past the saturation point without nucleating (cloud chambers, condensing nozzle flow, atmospheric supersaturation).</rdfs:comment>
  <core:prefLabel xml:lang="en">SupersaturatedVapor</core:prefLabel>
  <conceptualisation xml:lang="en">A metastable saturated vapor carried past the saturation point without nucleating (cloud chambers, condensing nozzle flow, atmospheric supersaturation).</conceptualisation>
</owl:Class>


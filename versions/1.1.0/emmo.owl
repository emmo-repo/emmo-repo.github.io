  <rdfs:subClassOf rdf:resource="#EMMO_43a4e80d_6ae9_45ed_8cfb_fd0a5339bf87"/>
  <rdfs:label xml:lang="en">Collapse</rdfs:label>
  <rdfs:comment xml:lang="en">A collapse is a fundamental interaction between m colliding particles that results in a single outgoing particle (inverse decay)  that is expressed as a complete bipartite directed graph K(m,1) with m&gt;1.</rdfs:comment>
  <rdfs:comment xml:lang="en">The class of fundamental systems where the number of input particles is reduced to one.</rdfs:comment>
  <core:example xml:lang="en">The Higgs boson production from two gluons, or a bottom and an anti-bottom quark.</core:example>
  <core:prefLabel xml:lang="en">Collapse</core:prefLabel>
  <conceptualisation xml:lang="en">A collapse is a fundamental interaction between m colliding particles that results in a single outgoing particle (inverse decay)  that is expressed as a complete bipartite directed graph K(m,1) with m&gt;1.</conceptualisation>
  <elucidation xml:lang="en">The class of fundamental systems where the number of input particles is reduced to one.</elucidation>
</owl:Class>


          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"/>
            <rdf:Description rdf:about="#EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
      <owl:onProperty rdf:resource="#EMMO_7afbed84_7593_4a23_bd88_9d9c6b04e8f6"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <elucidation xml:lang="en">This axiom underlines the monodimensional nature of a causal chain, as a sequence of quanta.</elucidation>
</owl:Axiom>


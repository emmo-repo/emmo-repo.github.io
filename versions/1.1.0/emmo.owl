  <rdfs:label xml:lang="en">SupercriticalGaseousState</rdfs:label>
  <rdfs:comment xml:lang="en">A gaseous state where no liquid forms can be obtained by compression. The liquid–vapor distinction has vanished.
This state can be categorised by pressure relative to critical pressure p𞁞</rdfs:comment>
  <core:altLabel xml:lang="en">Gas</core:altLabel>
  <core:prefLabel xml:lang="en">SupercriticalGaseousState</core:prefLabel>
  <conceptualisation xml:lang="en">A gaseous state where no liquid forms can be obtained by compression. The liquid–vapor distinction has vanished.
This state can be categorised by pressure relative to critical pressure p𞁞</conceptualisation>
</owl:Class>


  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">USPerm</rdfs:label>
  <rdfs:comment xml:lang="en">A perm is a unit of permeance or "water vapor transmission" given a certain differential in partial pressures on either side of a material or membrane. The U.S. perm is defined as 1 grain of water vapor per hour, per square foot, per inch of mercury.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">U.S. Perm</core:altLabel>
  <core:prefLabel xml:lang="en">USPerm</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.72135e-11</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">A perm is a unit of permeance or "water vapor transmission" given a certain differential in partial pressures on either side of a material or membrane. The U.S. perm is defined as 1 grain of water vapor per hour, per square foot, per inch of mercury.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PERM_US</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perm{US}</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Perm_(unit)</wikipediaReference>
</owl:NamedIndividual>


<owl:NamedIndividual rdf:about="#Year">
  <rdf:type rdf:resource="#EMMO_02e894c3_b793_4197_b120_3442e08f58d1"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>

<owl:Class rdf:about="#EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf>

<owl:NamedIndividual rdf:about="#Dalton">
  <rdf:type rdf:resource="#EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac"/>
  <rdf:type rdf:resource="#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits-abox#"/>
  <rdfs:label xml:lang="en">Dalton</rdfs:label>
  <rdfs:comment xml:lang="en">One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state.</rdfs:comment>
  <rdfs:comment xml:lang="en">The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a "non-SI unit whose values in SI units must be obtained experimentally".

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">AtomicMassUnit</core:altLabel>
  <core:prefLabel xml:lang="en">Dalton</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D43</sche:unitCode>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.660539e-27</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Da</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dbpedia.org/page/Unified_atomic_mass_unit</dbpediaReference>
  <definition xml:lang="en">One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state.</definition>
  <elucidation xml:lang="en">The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a "non-SI unit whose values in SI units must be obtained experimentally".

-- QUDT</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.D01514</iupacReference>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/vocab/unit/Da</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amu</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Atomic_mass_unit</wikipediaReference>
</owl:NamedIndividual>


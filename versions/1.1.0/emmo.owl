<owl:Class rdf:about="#EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60">
  <rdfs:isDefinedBy rdf:resource="https://goldbook.iupac.org/terms/view/C01172"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/statesofmatter#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_0b15f4ae_092e_4487_9100_3c44176c545c"/>
  <rdfs:subClassOf rdf:resource="#EMMO_0e030040_98a7_49b2_a871_dced1f3a6131"/>
  <wikipediaReference rdf:resource="https://en.wikipedia.org/wiki/Colloid"/>
  <rdfs:label xml:lang="en">Colloid</rdfs:label>
  <rdfs:comment xml:lang="en">A mixture in which one substance of microscopically dispersed insoluble or soluble particles (from 1 nm to 1 μm) is suspended throughout another substance and that does not settle, or would take a very long time to settle appreciably.</rdfs:comment>
  <core:altLabel xml:lang="en">ColloidalSystem</core:altLabel>
  <core:prefLabel xml:lang="en">Colloid</core:prefLabel>
  <elucidation xml:lang="en">A mixture in which one substance of microscopically dispersed insoluble or soluble particles (from 1 nm to 1 μm) is suspended throughout another substance and that does not settle, or would take a very long time to settle appreciably.</elucidation>
  <note xml:lang="en">Colloids are characterized by the occurring of the Tyndall effect on light.</note>
</owl:Class>

<owl:Class rdf:about="#EMMO_0a982eeb_e5ef_4828_93bc_53ece1b3f171">

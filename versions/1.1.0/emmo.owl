  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kW⋅h</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Kilowatt_hour?oldid=494927235</wikipediaReference>
</owl:NamedIndividual>


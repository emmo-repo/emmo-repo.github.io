<owl:Class rdf:about="#EMMO_a15cea10_9946_4d2b_95c5_cfc333fd2abb">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
  <rdfs:label xml:lang="en">PhysicalParticle</rdfs:label>
  <rdfs:comment xml:lang="en">A well defined physical entity, elementary or composite, usually treated as a singular unit, that is found at scales spanning from the elementary particles to molecules, as fundamental constituents of larger scale substances (as the etymology of "particle" suggests).</rdfs:comment>
  <rdfs:comment xml:lang="en">The union of hadron and lepton, or fermion and bosons.</rdfs:comment>
  <core:altLabel xml:lang="en">Particle</core:altLabel>
  <core:prefLabel xml:lang="en">PhysicalParticle</core:prefLabel>
  <definition xml:lang="en">The union of hadron and lepton, or fermion and bosons.</definition>
  <elucidation xml:lang="en">A well defined physical entity, elementary or composite, usually treated as a singular unit, that is found at scales spanning from the elementary particles to molecules, as fundamental constituents of larger scale substances (as the etymology of "particle" suggests).</elucidation>
  <note xml:lang="en">The scope of the physical particle definition goes from the elementary particles to molecules, as fundamental constituents of substances.</note>
</owl:Class>


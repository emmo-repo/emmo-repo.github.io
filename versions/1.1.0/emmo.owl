<owl:NamedIndividual rdf:about="#FaradPerMetre">
  <rdf:type rdf:resource="#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdf:type rdf:resource="#EMMO_5f89cb0c_3171_47ee_b2ab_027a07c34c4b"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#"/>
  <rdfs:label xml:lang="en">FaradPerMetre</rdfs:label>
  <rdfs:comment xml:lang="en">Farad Per Meter (F/m) is a unit in the category of Electric permittivity. It is also known as farad/meter. This unit is commonly used in the SI unit system. Farad Per Meter has a dimension of M-1L-3T4I2 where M is mass, L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Farad per Metre</core:altLabel>
  <core:prefLabel xml:lang="en">FaradPerMetre</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">Farad Per Meter (F/m) is a unit in the category of Electric permittivity. It is also known as farad/meter. This unit is commonly used in the SI unit system. Farad Per Meter has a dimension of M-1L-3T4I2 where M is mass, L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/FARAD-PER-M</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F.m-1</ucumCode>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F/m</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F/m</unitSymbol>
</owl:NamedIndividual>


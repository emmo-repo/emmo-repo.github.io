<owl:NamedIndividual rdf:about="#RadianPerMinute">
  <rdf:type rdf:resource="#EMMO_515b5579_d526_4842_9e6f_ecc34db6f368"/>
  <rdf:type rdf:resource="#EMMO_ac19c801_bead_4730_8b8c_50020eec45ec"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedunits-abox#"/>
  <rdfs:label xml:lang="en">RadianPerMinute</rdfs:label>
  <rdfs:comment xml:lang="en">Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where T is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Radian per Minute</core:altLabel>
  <core:prefLabel xml:lang="en">RadianPerMinute</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">60.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where T is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/RAD-PER-MIN</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rad.min-1</ucumCode>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rad/min</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rad/min</unitSymbol>
</owl:NamedIndividual>


<owl:Class rdf:about="#EMMO_0bb3b434_73aa_428f_b4e8_2a2468648e19">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:seeAlso rdf:resource="urn:isbn:9780471736967"/>
  <rdfs:subClassOf rdf:resource="#EMMO_cc5db5b4_0f90_41e8_bfd5_d5d627ae85cf"/>
  <rdfs:subClassOf rdf:resource="#EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655"/>
  <iupacReference rdf:resource="https://doi.org/10.1351/goldbook.12754"/>
  <rdfs:label xml:lang="en">SingleCrystal</rdfs:label>
  <rdfs:comment xml:lang="en">A crystalline state is a single crystal when the periodic and repeated arrangement of atoms is perfect or extends throughout the entirety of the specimen without interruption.</rdfs:comment>
  <rdfs:comment xml:lang="en">In a single crystal the periodic atomic lattice is continuous and unbroken across the entire specimen. There are no internal boundaries. Examples include silicon wafers used in microchips, or gem-quality diamond.</rdfs:comment>
  <core:altLabel xml:lang="en">CrystallineState</core:altLabel>
  <core:altLabel xml:lang="en">Monocrystalline</core:altLabel>
  <core:prefLabel xml:lang="en">SingleCrystal</core:prefLabel>
  <conceptualisation xml:lang="en">In a single crystal the periodic atomic lattice is continuous and unbroken across the entire specimen. There are no internal boundaries. Examples include silicon wafers used in microchips, or gem-quality diamond.</conceptualisation>
  <elucidation xml:lang="en">A crystalline state is a single crystal when the periodic and repeated arrangement of atoms is perfect or extends throughout the entirety of the specimen without interruption.</elucidation>
</owl:Class>

<owl:Class rdf:about="#EMMO_f96feb3f_4438_4e43_aa44_7458c4d87fc2">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>

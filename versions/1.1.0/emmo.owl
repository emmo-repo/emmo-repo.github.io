<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="#EMMO_2b9cbfb5_dbd0_4a68_9c6f_acc41b40dd72"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.collinsdictionary.com/it/dizionario/inglese/technology</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technology refers to methods, systems, and devices which are the result of scientific knowledge being used for practical purposes.</owl:annotatedTarget>
</owl:Axiom>


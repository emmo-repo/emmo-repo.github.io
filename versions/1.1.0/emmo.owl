<owl:Class rdf:about="#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569"/>
      <owl:someValuesFrom rdf:resource="#EMMO_1c2226a9_22f0_40c8_8928_5a01d398f96e"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064"/>
  <rdfs:subClassOf rdf:resource="#EMMO_af794e9d_dc7d_4756_83e1_2cd0e2ec864e"/>
  <rdfs:label xml:lang="en">MagneticDipoleMoment</rdfs:label>
  <rdfs:comment xml:lang="en">For an atom or nucleus, this energy is quantized and can be written as:

    W = g μ M B

where g is the appropriate g factor, μ is mostly the Bohr magneton or nuclear magneton, M is magnetic quantum number, and B is magnitude of the magnetic flux density.

-- ISO 80000</rdfs:comment>
  <rdfs:comment xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</rdfs:comment>
  <core:prefLabel xml:lang="en">MagneticDipoleMoment</core:prefLabel>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-55</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-9.1</ISO80000Reference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-30</ISO80000Reference>
  <elucidation xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://goldbook.iupac.org/terms/view/M03688</iupacReference>

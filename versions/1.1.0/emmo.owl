  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Joining process by softening the surfaces to be joined, either by heat or with a solvent (swelling welding, solvent welding), and pressing the softened surfaces together.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="#note"/>

  <term:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rigorous treatment of the molecular characteristics and behaviors of gases and liquids.</term:description>
  <term:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9780471400653</term:identifier>
  <term:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1964</term:issued>
  <term:language rdf:datatype="http://www.w3.org/2001/XMLSchema#string">en</term:language>
  <term:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wiley-Interscience</term:publisher>
  <term:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluid Dynamics</term:subject>
  <term:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kinetic Theory</term:subject>
  <term:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Interactions</term:subject>
  <term:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Statistical Mechanics</term:subject>
  <term:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Molecular Theory of Gases and Liquids</term:title>
</dcmi:Text>


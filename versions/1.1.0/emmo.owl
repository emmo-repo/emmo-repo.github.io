<owl:NamedIndividual rdf:about="#Coulomb">
  <rdf:type rdf:resource="#EMMO_ab79e92b_5377_454d_be06_d61b50db295a"/>
  <rdf:type rdf:resource="#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits-abox#"/>
  <rdfs:label xml:lang="en">Coulomb</rdfs:label>
  <rdfs:comment xml:lang="en">SI unit for electric charge.</rdfs:comment>
  <core:prefLabel xml:lang="en">Coulomb</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COU</sche:unitCode>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Coulomb</dbpediaReference>
  <elucidation xml:lang="en">SI unit for electric charge.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.C01365</iupacReference>
  <note xml:lang="en">The SI unit of electric charge. One coulomb is the amount of charge accumulated in one second by a current of one ampere. Electricity is actually a flow of charged particles, such as electrons, protons, or ions. The charge on one of these particles is a whole-number multiple of the charge e on a single electron, and one coulomb represents a charge of approximately 6.241 506 x 1018 e. The coulomb is named for a French physicist, Charles-Augustin de Coulomb (1736-1806), who was the first to measure accurately the forces exerted between electric charges.

-- QUDT</note>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/C</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C</ucumCode>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Coulomb?oldid=491815163</wikipediaReference>
</owl:NamedIndividual>


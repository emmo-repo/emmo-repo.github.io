<owl:ObjectProperty rdf:about="#EMMO_e62012fb_1b8c_45c7_b092_2178dcc455ae">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
  <rdfs:range rdf:resource="#EMMO_fe1b173e_b3ce_403d_9d90_230a334eebf9"/>
  <rdfs:subPropertyOf rdf:resource="#EMMO_cd24eb82_a11c_4a31_96ea_32f870c5580a"/>
  <rdfs:label xml:lang="en">hasUnintentionalAgent</rdfs:label>
  <rdfs:comment xml:lang="en">Relates an agency to an unintentional agent participant.</rdfs:comment>
  <core:altLabel xml:lang="en">performedWith</core:altLabel>

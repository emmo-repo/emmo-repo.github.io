  <rdfs:label xml:lang="en">ChargeNumber</rdfs:label>
  <rdfs:comment xml:lang="en">For a particle, electric charge q divided by elementary charge e.</rdfs:comment>
  <rdfs:comment xml:lang="en">The charge number of a particle may be presented as a superscript to the symbol of that particle, e.g. H+, He++, Al3+, Cl−, S=, N3−.</rdfs:comment>
  <rdfs:comment xml:lang="en">The charge number of an electrically charged particle can be positive or negative. The charge number of an electrically neutral particle is zero.</rdfs:comment>
  <core:altLabel xml:lang="en">IonizationNumber</core:altLabel>
  <core:prefLabel xml:lang="en">ChargeNumber</core:prefLabel>
  <IEVReference xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-05-17</IEVReference>
  <ISO80000Reference xml:lang="en">10-5.2</ISO80000Reference>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Charge_number</dbpediaReference>
  <elucidation xml:lang="en">For a particle, electric charge q divided by elementary charge e.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.C00993</iupacReference>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ChargeNumber</qudtReference>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q1800063</wikidataReference>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Charge_number</wikipediaReference>
</owl:Class>


  <core:altLabel xml:lang="en">measuredQuantityValue</core:altLabel>
  <core:altLabel xml:lang="en">measuredValue</core:altLabel>
  <VIMTerm xml:lang="en">VIM4: 2.11 measured value of a quantity</VIMTerm>
  <note xml:lang="en">In VIM, dataValue correspond to "measured value" which is defined as a "value of a quantity representing a measurement result".</note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EMMO_39cbed73_6e97_4ab2_bede_dc670e9469c9">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:subPropertyOf rdf:resource="#EMMO_b6292331_94af_4f00_976b_ea55960c2f1c"/>
  <rdfs:label xml:lang="en">uncertainty</rdfs:label>
  <rdfs:comment xml:lang="en">A parameter characterising the dispersion of a data value.</rdfs:comment>
  <core:altLabel xml:lang="en">measurementUncertainty</core:altLabel>
  <core:prefLabel xml:lang="en">uncertainty</core:prefLabel>
  <VIMTerm xml:lang="en">VIM4: 3.1 measurement uncertainty</VIMTerm>
  <elucidation xml:lang="en">A parameter characterising the dispersion of a data value.</elucidation>
  <note xml:lang="en">The uncertainty data property doesn't specify how the uncertainty is defined. For accuracy, use one of the specialised sub-properties.</note>
  <note xml:lang="en">VIM defined 'measurement uncertainty' as a "parameter characterising the dispersion of the values being attributed to a measurand, based on the information used".</note>
</owl:DatatypeProperty>


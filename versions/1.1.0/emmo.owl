<owl:Class rdf:about="#EMMO_57d977ab_0036_4779_b59a_e47620afdb9c">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_0f3e0646_4f06_4588_9779_6a4f05c5a8d6"/>
  <owl:disjointWith rdf:resource="#EMMO_801395f8_948e_4637_ac3b_5fcd587d72ca"/>
  <rdfs:label xml:lang="en">CompositePhysicalObject</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The class of physical objects possessing a structure that is larger than a single composite particle, for which its bosonic or fermionic nature is undetermined.</rdfs:comment>
  <rdfs:comment xml:lang="en">A composite physical object is made of bonded objects (i.e. characterised by their quantum states using a Schrodinger equation approach) that are connected together by elementary particles travelling between them. These elemenentary particles are real particles, describing the existance of a classical field (e.g. Coulomb potential between charged particles).</rdfs:comment>
  <core:prefLabel xml:lang="en">CompositePhysicalObject</core:prefLabel>
  <conceptualisation xml:lang="en">A composite physical object is made of bonded objects (i.e. characterised by their quantum states using a Schrodinger equation approach) that are connected together by elementary particles travelling between them. These elemenentary particles are real particles, describing the existance of a classical field (e.g. Coulomb potential between charged particles).</conceptualisation>
  <elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The class of physical objects possessing a structure that is larger than a single composite particle, for which its bosonic or fermionic nature is undetermined.</elucidation>
</owl:Class>


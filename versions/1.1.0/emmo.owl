  <rdfs:subClassOf rdf:resource="#EMMO_4312cae4_03ba_457e_b35d_0671a7db350c"/>
  <rdfs:label xml:lang="en">CentreOfMass</rdfs:label>
  <rdfs:comment xml:lang="en">In non-relativistic physics, the centre of mass doesn’t depend on the chosen reference frame.</rdfs:comment>
  <rdfs:comment xml:lang="en">The unique point where the weighted relative position of the distributed mass of an Item sums to zero. Equivalently, it is the point where if a force is applied to the Item, causes the Item to move in direction of force without rotation.</rdfs:comment>
  <core:prefLabel xml:lang="en">CentreOfMass</core:prefLabel>
  <elucidation xml:lang="en">The unique point where the weighted relative position of the distributed mass of an Item sums to zero. Equivalently, it is the point where if a force is applied to the Item, causes the Item to move in direction of force without rotation.</elucidation>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Center_of_mass</wikipediaReference>
</owl:Class>


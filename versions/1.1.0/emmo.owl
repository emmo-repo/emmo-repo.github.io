<owl:NamedIndividual rdf:about="#AmpereTurnPerMetre">
  <rdf:type rdf:resource="#EMMO_08b308d4_31cd_4779_a784_aa92fc730f39"/>
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_e6b83139_ba92_4fbd_a8b2_c8dde55844a1"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits-abox#"/>
  <rdfs:label xml:lang="en">AmpereTurnPerMetre</rdfs:label>
  <rdfs:comment xml:lang="en">The  `Ampere Turn per Metre` is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566 371 millioersteds) in CGS units. The ampere per meter is also the SI unit of "magnetization" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Ampere Turn per Metre</core:altLabel>
  <core:prefLabel xml:lang="en">AmpereTurnPerMetre</core:prefLabel>
  <elucidation xml:lang="en">The  `Ampere Turn per Metre` is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566 371 millioersteds) in CGS units. The ampere per meter is also the SI unit of "magnetization" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/AT-PER-M</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At/m</unitSymbol>
</owl:NamedIndividual>


      </owl:onProperty>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_ed4af7ae_63a2_497e_bb88_2309619ea405"/>
  <rdfs:label xml:lang="en">AtomicMass</rdfs:label>
  <rdfs:comment xml:lang="en">Since the nucleus account for nearly all of the total mass of atoms  (with the electrons and nuclear binding energy making minor contributions), the atomic mass measured in Da has nearly the same value as the mass number.</rdfs:comment>
  <rdfs:comment xml:lang="en">The atomic mass is often expressed as an average of the commonly found isotopes.</rdfs:comment>
  <rdfs:comment xml:lang="en">The mass of an atom in the ground state.</rdfs:comment>
  <core:prefLabel xml:lang="en">AtomicMass</core:prefLabel>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-4.1</ISO80000Reference>
  <definition xml:lang="en">The mass of an atom in the ground state.</definition>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.A00496</iupacReference>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Atomic_mass</wikipediaReference>
</owl:Class>


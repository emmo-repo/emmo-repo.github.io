    <owl:Restriction>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"/>
            <rdf:Description rdf:about="#EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
      <owl:onProperty rdf:resource="#EMMO_7afbed84_7593_4a23_bd88_9d9c6b04e8f6"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_52b8a39b_e5ff_46d3_b972_65bc43077a07"/>
  <rdfs:subClassOf rdf:resource="#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
  <rdfs:label xml:lang="en">CausalPath</rdfs:label>
  <rdfs:comment xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</rdfs:comment>
  <rdfs:comment xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</rdfs:comment>
  <core:altLabel xml:lang="en">CausalChain</core:altLabel>
  <core:altLabel xml:lang="en">Elementary</core:altLabel>
  <core:example xml:lang="en">An electron moving in time interacting with other particles.</core:example>
  <core:prefLabel xml:lang="en">CausalPath</core:prefLabel>
  <OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: MultiParticlePath, ElementaryParticle</OWLRL2DLAxioms>
  <conceptualisation xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</conceptualisation>
  <elucidation xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</elucidation>
  <note xml:lang="en">A causal path is a concept almost equivalent to the concept of elementary particle in physics.</note>
</owl:Class>


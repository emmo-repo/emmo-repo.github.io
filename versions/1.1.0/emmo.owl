<owl:Class rdf:about="#EMMO_b7229683_d2c5_4225_8e5f_7693744fd5a2">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_a18a3e9b_7e3d_44bf_9640_c8634e770ba8"/>
  <rdfs:subClassOf rdf:resource="#EMMO_be76ad52_2e29_4202_be6f_0a15eb9c1817"/>
  <rdfs:label xml:lang="en">StaticFrictionCoefficient</rdfs:label>
  <rdfs:comment xml:lang="en">Proportionality factor between the maximum magnitude of the tangential component of the static friction force and the magnitude of the normal component of the contact force between two bodies at relative rest with respect to each other.</rdfs:comment>
  <core:altLabel xml:lang="en">CoefficientOfStaticFriction</core:altLabel>
  <core:altLabel xml:lang="en">StaticFrictionFactor</core:altLabel>
  <core:prefLabel xml:lang="en">StaticFrictionCoefficient</core:prefLabel>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-33</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-23.1</ISO80000Reference>
  <elucidation xml:lang="en">Proportionality factor between the maximum magnitude of the tangential component of the static friction force and the magnitude of the normal component of the contact force between two bodies at relative rest with respect to each other.</elucidation>
  <note xml:lang="en">When it is not necessary to distinguish between dynamic friction factor and static friction factor, the name friction factor may be used for both.</note>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q73695673</wikidataReference>
</owl:Class>


  <rdfs:label xml:lang="en">AngularDisplacement</rdfs:label>
  <rdfs:comment xml:lang="en">The angle through which a body rotates around an axis of rotation.</rdfs:comment>
  <core:altLabel xml:lang="en">Angular displacement may be signed, indicating the sense of rotation (e.g., clockwise); it may also be greater (in absolute value) than a full turn.</core:altLabel>
  <core:altLabel xml:lang="en">Rotation</core:altLabel>
  <core:prefLabel xml:lang="en">AngularDisplacement</core:prefLabel>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=102-05-22</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-14</ISO80000Reference>
  <elucidation xml:lang="en">The angle through which a body rotates around an axis of rotation.</elucidation>
  <note xml:lang="en">Angular displacement may also be defined as number of turns (not necessarily an integer number).</note>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q76435127</wikidataReference>
</owl:Class>


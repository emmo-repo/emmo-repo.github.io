<owl:NamedIndividual rdf:about="#SquareMetrePerSecond">
  <rdf:type rdf:resource="#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdf:type rdf:resource="#EMMO_b33cc5b5_a9dc_4082_b497_14d1654c5591"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#"/>
  <rdfs:label xml:lang="en">SquareMetrePerSecond</rdfs:label>
  <rdfs:comment xml:lang="en">Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as "metres per second times metres", i.e. the momentum of an object with respect to a position.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Square Metre per Second</core:altLabel>
  <core:prefLabel xml:lang="en">SquareMetrePerSecond</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as "metres per second times metres", i.e. the momentum of an object with respect to a position.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/M2-PER-SEC</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">m2.s-1</ucumCode>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">m2/s</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">m²/s</unitSymbol>
</owl:NamedIndividual>


<owl:Class rdf:about="#EMMO_4f2d1fcc_e20c_4479_9ad7_7a0480dd3e44">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
  <rdfs:label xml:lang="en">AnalogicalIcon</rdfs:label>
  <rdfs:comment xml:lang="en">An icon that represents the internal logical structure of the object.</rdfs:comment>
  <core:example xml:lang="en">A physics equation is replicating the mechanisms internal to the object.</core:example>
  <core:example xml:lang="en">Electrical diagram is diagrammatic and resemblance</core:example>
  <core:example xml:lang="en">MODA and CHADA are diagrammatic representation of a simulation or a characterisation workflow.</core:example>
  <core:prefLabel xml:lang="en">AnalogicalIcon</core:prefLabel>
  <elucidation xml:lang="en">An icon that represents the internal logical structure of the object.</elucidation>
  <note xml:lang="en">An icon that focus on HOW the object works.</note>
  <note xml:lang="en">The subclass of icon inspired by Peirceian category (b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy (with the same logic) the relations in something (e.g. math formula, geometric flowchart).</note>
</owl:Class>


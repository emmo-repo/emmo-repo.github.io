<owl:AnnotationProperty rdf:about="#EMMO_2856bbc2_96e1_485b_b5f8_2fdfcb0c9b92">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:label xml:lang="en">inchiKey</rdfs:label>
  <rdfs:comment xml:lang="en">A hash of the full International Chemical Identifier (InChi) for a chemical substance.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://inchi.info/inchikey_overview_en.html</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <core:changeNote xml:lang="en">Replaced by emmo:inchiKey</core:changeNote>
  <core:prefLabel xml:lang="en">inchiKey</core:prefLabel>
  <elucidation xml:lang="en">A hash of the full International Chemical Identifier (InChi) for a chemical substance.</elucidation>
  <note xml:lang="en">The InChiKey is a hash of the full InChi identifier using the SHA-256 algorithm, designed to allow for easy web searches of chemical compounds.</note>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#inchiKey">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:label xml:lang="en">inchiKey</rdfs:label>
  <rdfs:comment xml:lang="en">A hash of the full International Chemical Identifier (InChi) for a chemical substance.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://inchi.info/inchikey_overview_en.html</rdfs:seeAlso>
  <core:prefLabel xml:lang="en">inchiKey</core:prefLabel>
  <elucidation xml:lang="en">A hash of the full International Chemical Identifier (InChi) for a chemical substance.</elucidation>
  <note xml:lang="en">The InChiKey is a hash of the full InChi identifier using the SHA-256 algorithm, designed to allow for easy web searches of chemical compounds.</note>
</owl:AnnotationProperty>


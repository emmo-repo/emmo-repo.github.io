<owl:Class rdf:about="#EMMO_51645022_3a21_4fa9_a9ce_a795eebbeca7">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_64963ed6_39c9_4258_85e0_6466c4b5420c"/>
  <rdfs:label xml:lang="en">Command</rdfs:label>
  <rdfs:comment xml:lang="en">An instruction to a computer system to perform a given task.</rdfs:comment>
  <core:example xml:lang="en">From a bash shell would e.g. `ls` be a command. Another example of a shell command would be `/path/to/executable arg1 arg2`.</core:example>
  <core:prefLabel xml:lang="en">Command</core:prefLabel>
  <note xml:lang="en">A command must be interpretable by the computer system.</note>
  <note xml:lang="en">Commands are typically performed from a shell or a shell script, but not limited to them.</note>
</owl:Class>

<owl:Class rdf:about="#EMMO_4bc29b0f_8fcc_4026_a291_f9774a66d9b8">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>

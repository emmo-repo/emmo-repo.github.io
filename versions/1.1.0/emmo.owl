<owl:NamedIndividual rdf:about="#InchOfMercury">
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_53bd0c90_41c3_46e2_8779_cd2a80f7e18b"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">InchOfMercury</rdfs:label>
  <rdfs:comment xml:lang="en">Inches of mercury, (inHg) is a unit of measurement for pressure. It is still widely used for barometric pressure in weather reports, refrigeration and aviation in the United States, but is seldom used elsewhere. It is defined as the pressure exerted by a column of mercury of 1 inch in height at 32 °F at the standard acceleration of gravity. 1 inHg = 3,386.389 pascals at 0 °C.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Inch of Mercury</core:altLabel>
  <core:prefLabel xml:lang="en">InchOfMercury</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3386.389</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">Inches of mercury, (inHg) is a unit of measurement for pressure. It is still widely used for barometric pressure in weather reports, refrigeration and aviation in the United States, but is seldom used elsewhere. It is defined as the pressure exerted by a column of mercury of 1 inch in height at 32 °F at the standard acceleration of gravity. 1 inHg = 3,386.389 pascals at 0 °C.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/IN_HG</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[in_i'Hg]</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inHg</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Inch_of_mercury?oldid=486634645</wikipediaReference>
</owl:NamedIndividual>


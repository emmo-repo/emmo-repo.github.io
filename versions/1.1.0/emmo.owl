  <rdfs:label xml:lang="en">dataValue</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The owl:dataProperty that provides a serialisation of an EMMO data entity.</rdfs:comment>
  <core:altLabel xml:lang="en">hasDataValue</core:altLabel>
  <core:prefLabel xml:lang="en">dataValue</core:prefLabel>
  <elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The owl:dataProperty that provides a serialisation of an EMMO data entity.</elucidation>
  <note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the superproperty of all data properties used to serialise a fundamental data type in the EMMO Data perspective. An entity can have only one data value expressing its serialisation (e.g. a Real entity cannot have two different real values).</note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EMMO_bba7f0f0_3707_42b9_b3fa_fd04610ef147">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>

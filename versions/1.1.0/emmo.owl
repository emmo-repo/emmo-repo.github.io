  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso:15531:-1:ed-1:v1:en:term:3.6.22</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">ISO 15531-1:2004
manufacturing: function or act of converting or transforming material from raw material or semi-finished state to a state of further completion</owl:annotatedTarget>
</owl:Axiom>


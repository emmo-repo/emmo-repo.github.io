<owl:Class rdf:about="#EMMO_a6f34396_1b31_4f42_abc6_cce491336bf6">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/statesofmatter#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_ce2b356f_ca4d_4d38_8a6e_0fdccc61a1b5"/>
  <rdfs:label xml:lang="en">IdealGas</rdfs:label>
  <rdfs:comment xml:lang="en">A gas where the PV=nRT relation holds, with compressibility factor Z=1. Since no gas really fits whis model, an ideal gas is intended to be a substance for which this model is a reasonable apporoximation.</rdfs:comment>
  <core:prefLabel xml:lang="en">IdealGas</core:prefLabel>
  <conceptualisation xml:lang="en">A gas where the PV=nRT relation holds, with compressibility factor Z=1. Since no gas really fits whis model, an ideal gas is intended to be a substance for which this model is a reasonable apporoximation.</conceptualisation>
  <note xml:lang="en">Strictly speaking, an ideal gas is a model, not a thermodynamic region.</note>
</owl:Class>


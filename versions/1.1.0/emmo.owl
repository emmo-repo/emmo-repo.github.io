<owl:Class rdf:about="#EMMO_ce2b356f_ca4d_4d38_8a6e_0fdccc61a1b5">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/statesofmatter#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_f5dba4d2_41dd_4591_a9e2_d35f8aee99e8"/>
  <rdfs:label xml:lang="en">Gas</rdfs:label>
  <rdfs:comment xml:lang="en">A proper (or true) gas is defined when T and p fall between T&gt;T𞁞 and p&lt;p𞁞. This is the region of permanent gases.</rdfs:comment>
  <core:altLabel xml:lang="en">ProperGas</core:altLabel>
  <core:altLabel xml:lang="en">TrueGas</core:altLabel>
  <core:prefLabel xml:lang="en">Gas</core:prefLabel>
  <conceptualisation xml:lang="en">A proper (or true) gas is defined when T and p fall between T&gt;T𞁞 and p&lt;p𞁞. This is the region of permanent gases.</conceptualisation>
  <note xml:lang="en">The historical permanent gases (He, H₂, N₂, O₂) are simply those whose T𞁞lies below ambient, so they resisted liquefaction until cryogenic cooling below T𞁞.</note>
</owl:Class>


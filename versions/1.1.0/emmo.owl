<owl:NamedIndividual rdf:about="#PlanckPower">
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdf:type rdf:resource="#EMMO_c8d084ad_f88e_4596_8e4d_982c6655ce6f"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">PlanckPower</rdfs:label>
  <rdfs:comment xml:lang="en">The Planck energy divided by the Planck time is the Planck power Pₚ , equal to about 3.62831 × 10⁵² W. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of 1 × 10⁴⁵ W, less than one ten-millionth of the Planck power.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Planck Power</core:altLabel>
  <core:prefLabel xml:lang="en">PlanckPower</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.62831e+52</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">The Planck energy divided by the Planck time is the Planck power Pₚ , equal to about 3.62831 × 10⁵² W. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of 1 × 10⁴⁵ W, less than one ten-millionth of the Planck power.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PlanckPower</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pₚ</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Planck_power?oldid=493642483</wikipediaReference>
</owl:NamedIndividual>


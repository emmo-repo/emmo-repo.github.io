<owl:NamedIndividual rdf:about="#Phot">
  <rdf:type rdf:resource="#EMMO_4000d06d_8594_4263_ba72_5d9440b66c5e"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_f0404eb3_433e_48af_a50f_67f1a03f5f0c"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/specialunits-abox#"/>
  <rdfs:label xml:lang="en">Phot</rdfs:label>
  <rdfs:comment xml:lang="en">A phot (ph) is a photometric unit of illuminance, or luminous flux through an area. It is not an SI unit, but rather is associated with the older centimetre gram second system of units.  Metric dimensions: illuminance = luminous intensity × solid angle / length.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:prefLabel xml:lang="en">Phot</core:prefLabel>

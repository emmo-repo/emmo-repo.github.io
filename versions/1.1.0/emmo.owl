<owl:Class rdf:about="#EMMO_e56ee3eb_7609_4ae1_8bed_51974f0960a6">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#EMMO_dc57d998_23db_4d8e_b2cd_f346b195b846"/>
      <owl:someValuesFrom rdf:resource="#EMMO_f9bc8b52_85e9_4b53_b969_dd7724d5b8e4"/>
    </owl:Restriction>

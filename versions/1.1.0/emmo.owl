  <rdfs:label xml:lang="en">CondensedMatter</rdfs:label>
  <rdfs:comment xml:lang="en">Matter in liquid or solid physical state.</rdfs:comment>
  <rdfs:comment xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with "condensed" phases of matter: systems of many constituents with strong interactions between them.</rdfs:comment>
  <core:altLabel xml:lang="en">CondensedState</core:altLabel>
  <core:prefLabel xml:lang="en">CondensedMatter</core:prefLabel>
  <OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalent To: Liquid or Solid</OWLRL2DLAxioms>
  <conceptualisation xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with "condensed" phases of matter: systems of many constituents with strong interactions between them.</conceptualisation>
  <elucidation xml:lang="en">Matter in liquid or solid physical state.</elucidation>
</owl:Class>


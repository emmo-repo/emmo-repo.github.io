  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#"/>
  <rdfs:label xml:lang="en">CoulombPerMole</rdfs:label>
  <rdfs:comment xml:lang="en"> (C/mol) is a unit in the category of Molar electric charge. It is also known as coulombs/mol. Coulomb Per Mol has a dimension of TN{-1}I where T is time, N is amount of substance, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Coulomb per Mole</core:altLabel>
  <core:prefLabel xml:lang="en">CoulombPerMole</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en"> (C/mol) is a unit in the category of Molar electric charge. It is also known as coulombs/mol. Coulomb Per Mol has a dimension of TN{-1}I where T is time, N is amount of substance, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/C-PER-MOL</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C.mol-1</ucumCode>

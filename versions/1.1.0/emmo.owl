<owl:NamedIndividual rdf:about="#AmpereTurn">
  <rdf:type rdf:resource="#EMMO_08b308d4_31cd_4779_a784_aa92fc730f39"/>
  <rdf:type rdf:resource="#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>

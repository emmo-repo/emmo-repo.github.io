<owl:NamedIndividual rdf:about="#MicroFarad">
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_9ff3bf8e_2168_406e_8251_1d158fc948ae"/>
  <rdf:type rdf:resource="#EMMO_b14d9be5_f81e_469b_abca_379c2e83feab"/>
  <rdf:type rdf:resource="#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/prefixedsiunits-abox#"/>
  <EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 rdf:resource="#Farad"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MicroFarad</rdfs:label>
  <rdfs:comment xml:lang="en">The "microfarad" (symbolized μ F) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of 1 μ F or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used.

-- QUDT</rdfs:comment>
  <core:altLabel xml:lang="en">microfarad</core:altLabel>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MicroFarad</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1e-06</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">The "microfarad" (symbolized μ F) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of 1 μ F or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/MicroFARAD</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uF</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">µF</unitSymbol>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VoltPerSecond">
  <rdf:type rdf:resource="#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdf:type rdf:resource="#EMMO_6837b106_7220_4ec6_b7c9_d549d6163672"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits-abox#"/>
  <rdfs:label xml:lang="en">VoltPerSecond</rdfs:label>
  <rdfs:comment xml:lang="en">'Volt per Second' is a unit of magnetic flux equaling one weber. This is the flux passing through a conducting loop and reduced to zero at a uniform rate in one second inducing an electric potential of one volt in the loop.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.thefreedictionary.com/Webers</rdfs:seeAlso>
  <core:altLabel xml:lang="en">Volt per second</core:altLabel>
  <core:prefLabel xml:lang="en">VoltPerSecond</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">'Volt per Second' is a unit of magnetic flux equaling one weber. This is the flux passing through a conducting loop and reduced to zero at a uniform rate in one second inducing an electric potential of one volt in the loop.


  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits-abox#"/>
  <rdfs:label xml:lang="en">AmpereTurn</rdfs:label>
  <rdfs:comment xml:lang="en">The `ampere-turn` was the MKS unit of magnetomotive force (MMF), represented by a direct current of one ampere flowing in a single-turn loop in a vacuum. "Turns" refers to the winding number of an electrical conductor comprising an inductor. The ampere-turn was replaced by the SI unit, ampere.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Ampere Turn</core:altLabel>
  <core:prefLabel xml:lang="en">AmpereTurn</core:prefLabel>
  <elucidation xml:lang="en">The `ampere-turn` was the MKS unit of magnetomotive force (MMF), represented by a direct current of one ampere flowing in a single-turn loop in a vacuum. "Turns" refers to the winding number of an electrical conductor comprising an inductor. The ampere-turn was replaced by the SI unit, ampere.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/AT</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AT</unitSymbol>
</owl:NamedIndividual>


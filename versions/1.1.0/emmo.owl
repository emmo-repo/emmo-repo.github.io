  <rdfs:label xml:lang="en">CompositeBoson</rdfs:label>
  <rdfs:comment xml:lang="en">A non-elementary particle (bonded) of a fundamental bosonic type (integer spin).</rdfs:comment>
  <core:example xml:lang="en">Examples of composite particles with integer spin:
spin 0: H1 and He4 in ground state, pion
spin 1: H1 and He4 in first excited state, meson
spin 2: O15 in ground state.</core:example>
  <core:prefLabel xml:lang="en">CompositeBoson</core:prefLabel>
  <elucidation xml:lang="en">A non-elementary particle (bonded) of a fundamental bosonic type (integer spin).</elucidation>
</owl:Class>


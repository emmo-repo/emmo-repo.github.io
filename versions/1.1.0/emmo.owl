<owl:Class rdf:about="#EMMO_4c1f58cd_6e2c_48fb_8098_1cbb762abb05">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="urn:isbn:9780471736967"/>
  <rdfs:subClassOf rdf:resource="#EMMO_4db521a3_f80f_436b_b9c7_e4b52b1383ea"/>
  <rdfs:label xml:lang="en">MetallicMaterial</rdfs:label>
  <rdfs:comment xml:lang="en">Inorganic substance, consisting of one or more metallic elements, and often small amount of nonmetallic elements.</rdfs:comment>
  <core:example xml:lang="en">Aluminum</core:example>
  <core:example xml:lang="en">Platinum</core:example>
  <core:example xml:lang="en">Steel</core:example>
  <core:example xml:lang="en">Titanium</core:example>
  <core:prefLabel xml:lang="en">MetallicMaterial</core:prefLabel>
  <elucidation xml:lang="en">Inorganic substance, consisting of one or more metallic elements, and often small amount of nonmetallic elements.</elucidation>
  <note xml:lang="en">Metallic materials are known for their shiny luster, excellent electrical/thermal conductivity, malleability (shapable by hammering), and ductility (can be drawn into wires), due to metallic bonding (shared electrons); they often form alloys (like steel from iron/carbon) to enhance these properties for diverse applications.</note>
</owl:Class>


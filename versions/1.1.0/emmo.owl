<owl:NamedIndividual rdf:about="#Statmho">
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_86ffe1bb_d457_4948_9e39_35f363b9a9fe"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label xml:lang="en">Statmho</rdfs:label>
  <rdfs:comment xml:lang="en">"StatMHO" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One statmho is the conductance between two points in a conductor when a constant potential difference of 1 statvolt applied between the points produces in the conductor a current of 1 statampere, the conductor not being the source of any electromotive force, approximately 1.1126 × 10⁻¹² mho.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.sizes.com/units/statmho.htm</rdfs:seeAlso>
  <core:prefLabel xml:lang="en">Statmho</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.1126e-12</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">"StatMHO" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One statmho is the conductance between two points in a conductor when a constant potential difference of 1 statvolt applied between the points produces in the conductor a current of 1 statampere, the conductor not being the source of any electromotive force, approximately 1.1126 × 10⁻¹² mho.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/MHO_Stat</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stat℧</unitSymbol>
</owl:NamedIndividual>


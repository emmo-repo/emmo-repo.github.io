<owl:NamedIndividual rdf:about="#Gray">
  <rdf:type rdf:resource="#EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88"/>
  <rdf:type rdf:resource="#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits-abox#"/>
  <rdfs:label xml:lang="en">Gray</rdfs:label>
  <rdfs:comment xml:lang="en">SI unit for absorbed dose.</rdfs:comment>
  <core:prefLabel xml:lang="en">Gray</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A95</sche:unitCode>
  <EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gy</EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8>
  <dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Grey</dbpediaReference>
  <elucidation xml:lang="en">SI unit for absorbed dose.</elucidation>
  <iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.G02696</iupacReference>
  <note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT</note>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/GRAY</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gy</ucumCode>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">//en.wikipedia.org/wiki/Grey?oldid=494774160</wikipediaReference>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PerWeber">

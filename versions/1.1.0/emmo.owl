<owl:Class rdf:about="#EMMO_0527413c_b286_4e9c_b2d0_03fb2a038dee">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#EMMO_cd9a3a58_dabc_4c46_9ea4_03ca000b2022"/>
      <owl:someValuesFrom rdf:resource="#EMMO_b21a56ed_f969_4612_a6ec_cb7766f7f31d"/>
    </owl:Restriction>
  </rdfs:subClassOf>

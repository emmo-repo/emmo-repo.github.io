<owl:Class rdf:about="#EMMO_602397bd_e302_42a6_be33_fe67ea81933a">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="#EMMO_79751276_b2d0_4e2f_bbd4_99d412f43d55"/>
  <rdfs:label xml:lang="en">Intensive</rdfs:label>
  <rdfs:comment xml:lang="en">A quantity whose magnitude is independent of the size of the system.</rdfs:comment>
  <rdfs:comment xml:lang="en">Note that not all physical quantities can be categorised as being either intensive or extensive. For example the square root of the mass.</rdfs:comment>
  <core:example xml:lang="en">Temperature
Density
Pressure
ChemicalPotential</core:example>
  <core:prefLabel xml:lang="en">Intensive</core:prefLabel>
  <elucidation xml:lang="en">A quantity whose magnitude is independent of the size of the system.</elucidation>
</owl:Class>

<owl:Class rdf:about="#EMMO_c7d004db_59fa_5ae3_adb1_e75736aa721a">

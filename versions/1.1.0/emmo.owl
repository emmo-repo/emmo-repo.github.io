</owl:Class>

<owl:Class rdf:about="#EMMO_94010cbc_c2a6_4cb9_b29a_83aa99d2ff70">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/statesofmatter#"/>
  <rdfs:seeAlso rdf:resource="urn:isbn:9780195129991"/>
  <rdfs:subClassOf rdf:resource="#EMMO_560d833a_6184_410c_859a_05d982712fd7"/>
  <rdfs:label xml:lang="en">LiquidAerosol</rdfs:label>
  <rdfs:comment xml:lang="en">A liquid aerosol is a two-phase system: tiny droplets of liquid suspended in a gas. The substance in the droplets is still in its condensed liquid phase, just finely divided. These droplets are large enough (typically ~0.1–100 µm) to scatter light, which is why aerosols are visible.</rdfs:comment>
  <rdfs:comment xml:lang="en">An aerosol composed of liquid droplets in air or another gas.</rdfs:comment>
  <core:example xml:lang="en">Fog</core:example>
  <core:example xml:lang="en">Mist</core:example>
  <core:example xml:lang="en">Steam</core:example>
  <core:prefLabel xml:lang="en">LiquidAerosol</core:prefLabel>
  <conceptualisation xml:lang="en">A liquid aerosol is a two-phase system: tiny droplets of liquid suspended in a gas. The substance in the droplets is still in its condensed liquid phase, just finely divided. These droplets are large enough (typically ~0.1–100 µm) to scatter light, which is why aerosols are visible.</conceptualisation>
  <elucidation xml:lang="en">An aerosol composed of liquid droplets in air or another gas.</elucidation>
</owl:Class>


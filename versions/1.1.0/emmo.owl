<owl:NamedIndividual rdf:about="#FootPerSecond">
  <rdf:type rdf:resource="#EMMO_4f5c7c54_1c63_4d17_b12b_ea0792c2b187"/>
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits-abox#"/>
  <rdfs:label xml:lang="en">FootPerSecond</rdfs:label>
  <rdfs:comment xml:lang="en">`foot per second` (plural `feet per second`) is a unit of both speed (scalar) and velocity (vector quantity, which includes direction). It expresses the distance in feet (ft) traveled or displaced, divided by the time in seconds (s, or sec). The corresponding unit in the International System of Units (SI) is the `metre per second`. Abbreviations include ft/s, ft/sec and fps, and the rarely used scientific notation ft s.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Foot per Second</core:altLabel>
  <core:prefLabel xml:lang="en">FootPerSecond</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3048</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">`foot per second` (plural `feet per second`) is a unit of both speed (scalar) and velocity (vector quantity, which includes direction). It expresses the distance in feet (ft) traveled or displaced, divided by the time in seconds (s, or sec). The corresponding unit in the International System of Units (SI) is the `metre per second`. Abbreviations include ft/s, ft/sec and fps, and the rarely used scientific notation ft s.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/FT-PER-SEC</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[ft_i].s-1</ucumCode>

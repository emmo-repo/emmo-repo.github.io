<owl:DatatypeProperty rdf:about="#EMMO_593ce968_e1ec_4101_822a_1739ef13fb2b">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:subPropertyOf rdf:resource="#EMMO_ea67144c_56fd_4312_a4f4_af78edd5eacc"/>
  <rdfs:label xml:lang="en">meanQuantityValue</rdfs:label>
  <rdfs:comment xml:lang="en">The probabilistic expected value of an EMMO data entity.</rdfs:comment>
  <core:altLabel xml:lang="en">expectationValue</core:altLabel>
  <core:altLabel xml:lang="en">expectedValue</core:altLabel>
  <core:altLabel xml:lang="en">meanValue</core:altLabel>
  <core:prefLabel xml:lang="en">meanQuantityValue</core:prefLabel>
  <elucidation xml:lang="en">The probabilistic expected value of an EMMO data entity.</elucidation>
  <note xml:lang="en">The expectation value (or expected value) is the theoretical long-run average outcome of a random variable over many trials, calculated as the sum of all possible values, each weighted by its probability of occurrence. It acts as a probability-weighted mean, representing the center of a probability distribution, denoted as 'E[X]' or 'µ'.</note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EMMO_2594a687_b888_4878_b51b_63563ce7e6d3">

  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">\"</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Minute_of_arc#Symbols.2C_abbreviations_and_subdivisions</wikipediaReference>
</owl:NamedIndividual>


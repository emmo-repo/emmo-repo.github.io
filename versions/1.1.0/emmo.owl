<owl:NamedIndividual rdf:about="#StatvoltPerCentiMetre">
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
  <rdf:type rdf:resource="#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e"/>
  <rdf:type rdf:resource="#EMMO_ebf9a5c6_ca80_45d4_a991_24a1bf4b6720"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits-abox#"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StatvoltPerCentiMetre</rdfs:label>
  <rdfs:comment xml:lang="en">One statvolt per centimetre is equal in magnitude to one gauss. For example, an electric field of one statvolt/cm has the same energy density as a magnetic field of one gauss. Likewise, a plane wave propagating in a vacuum has perpendicular electric and magnetic fields such that for every gauss of magnetic field intensity there is one statvolt/cm of electric field intensity.
The abvolt is another option for a unit of voltage in the cgs system.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Statvolt per Centimetre</core:altLabel>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StatvoltPerCentiMetre</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">29979.25</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">One statvolt per centimetre is equal in magnitude to one gauss. For example, an electric field of one statvolt/cm has the same energy density as a magnetic field of one gauss. Likewise, a plane wave propagating in a vacuum has perpendicular electric and magnetic fields such that for every gauss of magnetic field intensity there is one statvolt/cm of electric field intensity.
The abvolt is another option for a unit of voltage in the cgs system.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/V_Stat-PER-CentiM</qudtReference>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statV/cm</unitSymbol>
  <wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Statvolt</wikipediaReference>
</owl:NamedIndividual>


<owl:NamedIndividual rdf:about="#MicroMolePerSquareMetrePerSecond">
  <rdf:type rdf:resource="#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdf:type rdf:resource="#EMMO_9ff3bf8e_2168_406e_8251_1d158fc948ae"/>
  <rdf:type rdf:resource="#EMMO_a94aec97_71ff_4574_b111_a52d77d2c230"/>
  <rdf:type rdf:resource="#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/noncoherentsiunits-abox#"/>
  <EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 rdf:resource="#MolePerSquareMetrePerSecond"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MicroMolePerSquareMetrePerSecond</rdfs:label>
  <rdfs:comment xml:lang="en">One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822.

-- QUDT</rdfs:comment>
  <core:altLabel xml:lang="en">Micromoles per square metre per second</core:altLabel>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MicroMolePerSquareMetrePerSecond</core:prefLabel>
  <EMMO_8189b42e_0995_423a_a26c_51168b27c3cf rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1e-06</EMMO_8189b42e_0995_423a_a26c_51168b27c3cf>
  <EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd>
  <elucidation xml:lang="en">One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822.

-- QUDT</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/MicroMOL-PER-M2-SEC</qudtReference>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">umol.m-2.s-1</ucumCode>
  <ucumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">umol/m2/s</ucumCode>
  <unitSymbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string">µmol/(m²⋅s)</unitSymbol>
</owl:NamedIndividual>


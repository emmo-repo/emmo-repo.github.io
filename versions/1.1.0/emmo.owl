<owl:NamedIndividual rdf:about="#PascalSecondPerMetre">
  <rdf:type rdf:resource="#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdf:type rdf:resource="#EMMO_e35d4936_b2e3_4cd6_a437_f1c864b3d450"/>

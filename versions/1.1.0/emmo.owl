  <rdfs:comment xml:lang="en">Quotient of the mass of water in a three-dimensional domain, irrespective of the form of aggregation, by the volume of the domain.</rdfs:comment>
  <rdfs:comment xml:lang="en">The mass concentration of water at saturation is denoted wsat.</rdfs:comment>
  <core:prefLabel xml:lang="en">MassConcentrationOfWater</core:prefLabel>
  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-59</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-27</ISO80000Reference>
  <elucidation xml:lang="en">Quotient of the mass of water in a three-dimensional domain, irrespective of the form of aggregation, by the volume of the domain.</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MassConcentrationOfWater</qudtReference>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q76378758</wikidataReference>
</owl:Class>


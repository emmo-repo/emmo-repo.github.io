  <IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-12-37</IEVReference>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-28</ISO80000Reference>
  <elucidation xml:lang="en">Scalar or tensor quantity the product of which by the magnetic constant μ0 and by the magnetic field strength H is equal to the magnetic polarization J.</elucidation>
  <qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/unit/SUSCEPTIBILITY_MAG.html</qudtReference>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q691463</wikidataReference>
</owl:Class>


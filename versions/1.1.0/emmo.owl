</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
  <owl:annotatedTarget xml:lang="en">CausalStructure</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin causa (“reason, sake, cause”), and from Latin struere (“arrange, assemble, build”).</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"/>
  <owl:annotatedTarget xml:lang="en">Item</owl:annotatedTarget>
  <etymology xml:lang="en">From Latin item, "likewise, just so, moreover".</etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>

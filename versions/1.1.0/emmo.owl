      <owl:someValuesFrom rdf:resource="#EMMO_1b52ee70_121e_4d8d_8419_3f97cd0bd89c"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d"/>
  <rdfs:label xml:lang="en">Determination</rdfs:label>
  <rdfs:comment xml:lang="en">A 'Semiosis' that involves an 'Observer' that perceives another 'Physical' (the 'Object') through a specific perception mechanism and produces a 'Property' (the 'Sign') that stands for the result of that particular perception according to a well defined conventional procedure.</rdfs:comment>
  <core:altLabel xml:lang="en">Characterisation</core:altLabel>
  <core:example xml:lang="en">Assigning the word "red" as sign for an object provides an information to all other interpreters about the outcome of a specific observation procedure according to the determiner.</core:example>
  <core:prefLabel xml:lang="en">Determination</core:prefLabel>
  <OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: Estimation or Observation</OWLRL2DLAxioms>
  <elucidation xml:lang="en">A 'Semiosis' that involves an 'Observer' that perceives another 'Physical' (the 'Object') through a specific perception mechanism and produces a 'Property' (the 'Sign') that stands for the result of that particular perception according to a well defined conventional procedure.</elucidation>
</owl:Class>


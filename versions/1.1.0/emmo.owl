  <rdfs:label xml:lang="en">GaugePressure</rdfs:label>
  <rdfs:comment xml:lang="en">The pressure measured relative to the ambient atmospheric pressure.</rdfs:comment>
  <core:prefLabel xml:lang="en">GaugePressure</core:prefLabel>
  <ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-14.2</ISO80000Reference>
  <elucidation xml:lang="en">The pressure measured relative to the ambient atmospheric pressure.</elucidation>
  <note xml:lang="en">Gauge pressure can be measured using a diaphragm sensor, where one side of the diaphragm is exposed to the pressure media that is to be measured, while the other side is exposed to the ambient atmospheric pressure.</note>
  <wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q109594211</wikidataReference>

emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 a owl:AnnotationProperty ;
    rdfs:label "unitSymbol"@en ;
    rdfs:domain emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:comment ;
    owl:deprecated true ;
    skos:prefLabel "unitSymbol"@en ;
    emmo:elucidation "The standard symbol for a unit."@en ;
    emmo:note "A unit symbol may be a symbolic construct (e.g. km) or a symbol (e.g. m)."@en .

emmo:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf a owl:DatatypeProperty ;
    rdfs:label "hasSIConversionMultiplier"@en ;
    rdfs:domain emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 ;
    rdfs:range xsd:double ;
    skos:prefLabel "hasSIConversionMultiplier"@en ;
    emmo:elucidation "Number to multiply a SI coherent unit with when converting to a given non-SI coherent unit."@en ;
    emmo:note """Conversion formula:

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset"""@en .

emmo:EMMO_868ae137_4d25_493e_b270_21ea3d94849e rdfs:label "NonPrefixedUnit"@en .

emmo:EMMO_985bec21_989f_4b9e_a4b3_735d88099c3c rdfs:label "Metrological"@en .

emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd a owl:DatatypeProperty ;
    rdfs:label "hasSIConversionOffset"@en ;
    rdfs:domain emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 ;
    rdfs:range xsd:double ;
    skos:prefLabel "hasSIConversionOffset"@en ;
    emmo:elucidation "Number to add to a SI coherent unit when converting to a given non-SI coherent unit."@en ;
    emmo:note """Conversion formula:

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset"""@en .


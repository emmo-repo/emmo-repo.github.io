emmo:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac a owl:Class ;
    rdfs:label "SIAcceptedUnit"@en ;
    rdfs:comment "This is a list of units that are not defined as part of the International System of Units (SI), but are otherwise mentioned in the SI brouchure, because either the General Conference on Weights and Measures (CGPM) accepts their use as being multiples or submultiples of SI-units, they have important contemporary application worldwide, or are otherwise commonly encountered worldwide."@en ;
    rdfs:subClassOf emmo:EMMO_3ee80521_3c23_4dd1_935d_9d522614a3e2,
        emmo:EMMO_e8b5f7de_4fd9_41d7_b988_87b512fe0180 ;
    skos:prefLabel "SIAcceptedUnit"@en ;
    emmo:elucidation "Non-SI units mentioned in the SI."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/Non-SI_units_mentioned_in_the_SI"^^xsd:string .

emmo:EMMO_93170bc8_d3b2_45bd_8cad_20aad08462ef a owl:Class ;
    rdfs:label "SIAcceptedPrefixedUnit"@en ;
    rdfs:subClassOf emmo:EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e,
        emmo:EMMO_e8b5f7de_4fd9_41d7_b988_87b512fe0180 ;
    skos:prefLabel "SIAcceptedPrefixedUnit"@en ;
    emmo:elucidation "Non-SI prefixed units that have been accepted by SI to be used together with the SI system."@en .

emmo:EMMO_ac19c801_bead_4730_8b8c_50020eec45ec a owl:Class ;
    rdfs:label "SIAcceptedDerivedUnit"@en ;
    rdfs:subClassOf emmo:EMMO_08b308d4_31cd_4779_a784_aa92fc730f39,
        emmo:EMMO_e8b5f7de_4fd9_41d7_b988_87b512fe0180 ;
    skos:prefLabel "SIAcceptedDerivedUnit"@en ;
    emmo:elucidation "Defived units that are accepted to be used with SI."@en .

emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 rdfs:label "MeasurementUnit"@en .

emmo:EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e rdfs:label "PrefixedUnit"@en .

emmo:EMMO_e8b5f7de_4fd9_41d7_b988_87b512fe0180 a owl:Class ;
    rdfs:label "SIAccepted"@en ;
    rdfs:subClassOf emmo:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 ;
    skos:prefLabel "SIAccepted"@en ;
    emmo:OWLRL2DLAxioms "disjointUnionOf: SIAcceptedUnit, SIAcceptedPrefixedUnit, SIAcceptedDerivedUnit"^^xsd:string ;
    emmo:elucidation "Non-SI unit that has been accepted by SI to be used together with the SI system."@en .


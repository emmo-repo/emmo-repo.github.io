<https://doi.org/10.1016/j.jnoncrysol.2018.01.033> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:bibliographicCitation "Journal of Non-Crystalline Solids, Vol. 501, 2018, pp. 3-10"^^xsd:string ;
    dcterms:creator "Arun K. Varshneya"^^xsd:string,
        "Joachim Deubener"^^xsd:string,
        "Marie Allix"^^xsd:string,
        "Matthew J. Davis"^^xsd:string ;
    dcterms:description "A consensus paper providing an updated, rigorous scientific definition and nomenclature guidelines for glass-ceramic materials."^^xsd:string ;
    dcterms:identifier "10.1016/j.jnoncrysol.2018.01.033"^^xsd:string ;
    dcterms:isPartOf [ a dcmitype:Text ;
            dcterms:title "Journal of Non-Crystalline Solids"^^xsd:string ] ;
    dcterms:issued "2018"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Elsevier"^^xsd:string ;
    dcterms:subject "Amorphous Materials"^^xsd:string,
        "Crystallization"^^xsd:string,
        "Glass-ceramics"^^xsd:string,
        "Material Definition"^^xsd:string,
        "Nomenclature"^^xsd:string ;
    dcterms:title "Updated definition of glass-ceramics"^^xsd:string .

emmo:EMMO_29a15bcd_e219_4afc_9f82_9d3fceb666cd a owl:Class ;
    rdfs:label "Powder"@en ;
    rdfs:isDefinedBy <urn:isbn:9780387986562> ;
    rdfs:subClassOf emmo:EMMO_48fc6f16_0f04_4e86_a9fc_fcfc14c5ef4b ;
    skos:prefLabel "Powder"@en ;
    emmo:elucidation "A powder is a granular material composed of many very fine dry solid particles that may flow freely when shaken or tilted."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/Powder"@en .

emmo:EMMO_48fc6f16_0f04_4e86_a9fc_fcfc14c5ef4b a owl:Class ;
    rdfs:label "GranularMaterial"@en ;
    rdfs:seeAlso <urn:isbn:9780387986562> ;
    rdfs:subClassOf emmo:EMMO_9ec16158_9118_4886_be97_4310f02f7571 ;
    skos:prefLabel "GranularMaterial"@en ;
    emmo:elucidation "A granular material is a conglomeration of discrete solid, macroscopic particles that are  large enough to avoid thermal motion fluctuations, and characterized by a loss of energy whenever the particles interact."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Granular_material> .

emmo:EMMO_4c1f58cd_6e2c_48fb_8098_1cbb762abb05 a owl:Class ;
    rdfs:label "MetallicMaterial"@en ;
    rdfs:isDefinedBy <urn:isbn:9780471736967> ;
    rdfs:subClassOf emmo:EMMO_4db521a3_f80f_436b_b9c7_e4b52b1383ea ;
    skos:example "Aluminum"@en,
        "Platinum"@en,
        "Steel"@en,
        "Titanium"@en ;
    skos:prefLabel "MetallicMaterial"@en ;
    emmo:elucidation "Inorganic substance, consisting of one or more metallic elements, and often small amount of nonmetallic elements."@en ;
    emmo:note "Metallic materials are known for their shiny luster, excellent electrical/thermal conductivity, malleability (shapable by hammering), and ductility (can be drawn into wires), due to metallic bonding (shared electrons); they often form alloys (like steel from iron/carbon) to enhance these properties for diverse applications."@en .

emmo:EMMO_66281f4c_ce3b_46e0_bd24_b5cdcce93094 a owl:Class ;
    rdfs:label "AmorphousMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_4e9fd152_147b_4564_8999_089608f41aff,
        emmo:EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54 ;
    skos:prefLabel "AmorphousMaterial"@en ;
    emmo:conceptualisation "While the strict definition of amorphous state includes gases and plasmas, in these states are usually not considered materials in matearial science. Restricting amorphous state only to condensed matter, is the way in which we define the class of amorphous materials."@en ;
    emmo:elucidation "An amorphous state which is also condensed matter."@en .

emmo:EMMO_97537021_9bab_4c94_9b76_c21e24a673eb a owl:Class ;
    rdfs:label "AdaptiveMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_1d0064d2_d77e_4ec7_b74a_00f98616156f ;
    skos:prefLabel "AdaptiveMaterial"@en ;
    emmo:elucidation "Functional materials capable of macroscopic geometric or structural reconfiguration in response to environmental triggers."@en .

emmo:EMMO_97f0c898_3659_4873_974f_2e950dfb8afd a owl:Class ;
    rdfs:label "HighAlloySteel"@en ;
    rdfs:subClassOf emmo:EMMO_0784ef07_72ca_4803_9807_127bfd66a6b2 ;
    skos:prefLabel "HighAlloySteel"@en .


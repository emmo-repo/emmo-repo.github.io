    skos:prefLabel "BrittleMaterial"@en ;
    emmo:elucidation "Materials that fracture with little to no prior plastic deformation, propagating cracks rapidly along atomic planes or grain boundaries once a critical stress intensity is reached."@en .

emmo:EMMO_14a2556f_f8fe_488d_bf18_cb216b130fe3 a owl:Class ;
    rdfs:label "Superconductor"@en ;

emmo:EMMO_1002691c_900f_4fe2_8fa4_fd7f02a16805 a owl:Class ;
    rdfs:label "ThermalAndThermoelectricMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_1d0064d2_d77e_4ec7_b74a_00f98616156f ;
    skos:prefLabel "ThermalAndThermoelectricMaterial"@en ;
    emmo:elucidation "Materials designed to manage heat flow, store thermal energy, or directly exploit temperature differentials."@en .

emmo:EMMO_2f4e930e_1eee_4826_8cc0_e5d2444e4400 a owl:Class ;
    rdfs:label "DielectricMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_9d1efd57_a270_4344_9a8d_dffcaecc7934 ;
    skos:prefLabel "DielectricMaterial"@en ;
    emmo:elucidation "Insulating materials with bound charges and wide bandgaps that respond to an external electric field via localized electrostatic polarization rather than long-range conduction."@en .

emmo:EMMO_39348191_08fd_4bb6_9b1e_012d5b2f1ff6 a owl:Class ;
    rdfs:label "MaterialByClassicalMaterialsScience"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf emmo:EMMO_4207e895_8b83_4318_996a_72cfb32acd94 ;
    skos:prefLabel "MaterialByClassicalMaterialsScience"@en ;
    emmo:OWLRL2DLAxioms "Equivalent To: AmorphousMaterial or CrystallineMaterial"^^xsd:string,
        "Equivalent To: MetallicMaterial or CeramicMaterial or CompositeMaterial or PolymericMaterial"^^xsd:string ;
    emmo:elucidation "The class for materials categorised according to classical materials science, focusing on amorphous/crystalline nature, and main type categories (i.e., ceramic, composite, metallic and polymeric)."@en .

emmo:EMMO_5a765b4a_d3e6_483c_a02e_af6ceedb50bd a owl:Class ;
    rdfs:label "ChemicalAndBiochemicalMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_1d0064d2_d77e_4ec7_b74a_00f98616156f ;
    skos:prefLabel "ChemicalAndBiochemicalMaterial"@en ;
    emmo:elucidation "Materials that drive chemical transformations or respond dynamically to specific molecular and biochemical environments."@en .

emmo:EMMO_621bbbf3_d357_4ea7_b235_bc6a9ad3366a a owl:Class ;
    rdfs:label "FerrousAlloy"@en ;
    rdfs:subClassOf emmo:EMMO_00ed0f82_f20e_4749_9780_380f43398466 ;
    skos:prefLabel "FerrousAlloy"@en ;
    emmo:elucidation "A metal alloy in which iron is the primary constituent."@en .

emmo:EMMO_76cfad65_2147_44d6_86da_dc89c27c1782 a owl:Class ;
    rdfs:label "PolyCrystallineMaterial"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf emmo:EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655 ;
    skos:prefLabel "PolyCrystallineMaterial"@en ;
    emmo:conceptualisation """From a strict thermodynamic and physical standpoint, a polycrystalline material is in a crystalline state. The word "state" often implies a single, uniform condition, and a polycrystal is full of messy, mismatched grain boundaries. However, in materials science and condensed matter physics, the "state" of a material is defined by its atomic structure and thermodynamic phase, not by its macro-scale uniformity.
Because the vast majority of the matter possesses long-range translational order, the bulk material exhibits the thermodynamic properties of the crystalline state (such as a sharp, distinct melting point, rather than the gradual softening seen in amorphous states like glass)."""@en ;
    emmo:elucidation "A material composed of a collection of many small individual crystalline units called grains."@en ;
    emmo:note """A polyscrystalline state is a mosaic of tiny single crystals. Inside any single grain, the atoms are perfectly ordered. However, each grain is tilted or rotated at a different angle relative to its neighbors. Where these mismatching orientations meet, they form irregular atomic interfaces known as grain boundaries. Most engineered metals, alloys, and ceramics are polycrystalline.
Inside a polycrystal, more than 99% of the atoms sit precisely on a periodic, highly ordered crystalline lattice. They have undergone a distinct phase transition (solidification/crystallization) into a crystalline state. The only atoms not in a perfect lattice are the thin, few-atom-wide walls at the grain boundaries."""@en .

emmo:EMMO_8820f251_ad36_43f4_a693_c0e86a89cc1f a owl:Class ;

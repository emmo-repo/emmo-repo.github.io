    skos:prefLabel "ElectricalAndElectronicMaterial"@en ;
    emmo:elucidation "Materials that manipulate the behavior of electrons, holes, or mobile ions to control electrical currents or store electrical energy."@en .

emmo:EMMO_e6edf47f_a32b_4699_992a_cf6104157f25 a owl:Class ;

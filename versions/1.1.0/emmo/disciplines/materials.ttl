    skos:prefLabel "Superconductor"@en ;
    emmo:elucidation "Materials that exhibit zero electrical resistance and the expulsion of magnetic fields (the Meissner effect) when cooled below a critical temperature."@en .

emmo:EMMO_1553efd3_9c89_4ef6_84c6_89ae943561cd a owl:Class ;
    rdfs:label "FerrimagneticMaterial"@en ;

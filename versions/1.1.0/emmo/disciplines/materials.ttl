    skos:prefLabel "StainlessSteel"@en ;
    emmo:elucidation "Steel with chromium as predominant alloy with a concentration of at least 11 wt%, characterised by high corrosion resistance."@en .

emmo:EMMO_9f5d5e6f_d17b_4f38_96a7_0883c2cd1a9d a owl:Class ;
    rdfs:label "ElectricalAndElectronicMaterial"@en ;

        "Structural Materials"^^xsd:string ;
    dcterms:title "Engineering Materials 1: An Introduction to Properties, Applications, and Design"@en .

emmo:EMMO_1ef0d75a_92c1_466e_9ad9_4bff50a54695 a owl:Class ;
    rdfs:label "OpticalAndOptoelectronicMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_1d0064d2_d77e_4ec7_b74a_00f98616156f ;
    skos:prefLabel "OpticalAndOptoelectronicMaterial"@en ;
    emmo:elucidation "Materials that interact directly with photons, modulating light transmission or converting light into electrical energy and vice versa.\"@en ."@en .

emmo:EMMO_6ef285fc_227a_411c_9d5d_894e3d747d00 a owl:Class ;

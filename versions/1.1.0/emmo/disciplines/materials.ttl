emmo:EMMO_0bb3b434_73aa_428f_b4e8_2a2468648e19 a owl:Class ;
    rdfs:label "SingleCrystal"@en ;
    rdfs:seeAlso <urn:isbn:9780471736967> ;
    rdfs:subClassOf emmo:EMMO_cc5db5b4_0f90_41e8_bfd5_d5d627ae85cf,
        emmo:EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655 ;
    skos:altLabel "CrystallineState"@en,
        "Monocrystalline"@en ;
    skos:prefLabel "SingleCrystal"@en ;
    emmo:conceptualisation "In a single crystal the periodic atomic lattice is continuous and unbroken across the entire specimen. There are no internal boundaries. Examples include silicon wafers used in microchips, or gem-quality diamond."@en ;
    emmo:elucidation "A crystalline state is a single crystal when the periodic and repeated arrangement of atoms is perfect or extends throughout the entirety of the specimen without interruption."@en ;
    emmo:iupacReference <https://doi.org/10.1351/goldbook.12754> .


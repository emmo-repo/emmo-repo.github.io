emmo:EMMO_ec613a57_0c55_42cf_ba62_2f6b6576eb2e a owl:Class ;
    rdfs:label "MaterialByIsotropy"@en ;
    rdfs:subClassOf emmo:EMMO_4207e895_8b83_4318_996a_72cfb32acd94 ;
    skos:prefLabel "MaterialByIsotropy"@en ;
    emmo:conceptualisation "A material is property-isotropic with respect to a given property if that property has the same value regardless of the direction in which you measure it. Isotropy is always property-specific: a material can be isotropic in one property and anisotropic in another simultaneously."@en ;
    emmo:elucidation "The class for materials categorised according to the isotropicity of their properties."@en .

emmo:EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54 a owl:Class ;
    rdfs:label "MaterialByStructure"@en ;
    rdfs:seeAlso <urn:isbn:9780080966656>,
        <urn:isbn:9780471736967> ;
    rdfs:subClassOf emmo:EMMO_39348191_08fd_4bb6_9b1e_012d5b2f1ff6 ;
    skos:prefLabel "MaterialByStructure"@en ;
    emmo:elucidation "The superclass for all materials that are categorised according to their periodicity/crystalline structure"@en ;
    emmo:note "The distinction between amorphous and crystalline is about structural isotropy. Property isotropy is not necessarly related to structural isotropy (e.g., an amorphous material can express some anisotropic property under external conditions such a stress, flow, fields)."@en .


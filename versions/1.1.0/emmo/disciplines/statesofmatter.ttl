@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix emmo: <https://w3id.org/emmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:alternative a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:edition a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:subject a owl:AnnotationProperty .

xsd:gYear a rdfs:Datatype .

emmo:EMMO_11a7a5f9_fcbd_45d0_b95f_8f0014becc31 a owl:Class ;
    rdfs:label "SupersaturatedVapor"@en ;
    rdfs:subClassOf emmo:EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c ;
    skos:prefLabel "SupersaturatedVapor"@en ;
    emmo:conceptualisation "A metastable saturated vapor carried past the saturation point without nucleating (cloud chambers, condensing nozzle flow, atmospheric supersaturation)."@en .

emmo:EMMO_12a9a254_9791_4a00_b045_f397bc3ab2bc a owl:Class ;
    rdfs:label "GasMixture"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 emmo:EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c ) ] ;
    skos:prefLabel "GasMixture"@en ;
    emmo:elucidation "A mixture that behave macroscopically as a gas, even if it is composed of multi-phase/multi-state components."@en ;
    emmo:note "Usually the gas-like behavior is retained when the ratio between non-gaseous and gaseous components volumes is very small."@en .

emmo:EMMO_3995e22d_5720_4dcf_ba3b_d0ce03f514c6 a owl:Class ;
    rdfs:label "Gel"@en ;
    rdfs:seeAlso <https://www.britannica.com/science/gel> ;
    rdfs:subClassOf emmo:EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:prefLabel "Gel"@en ;
    emmo:elucidation "A soft, solid or solid-like colloid consisting of two or more components, one of which is a liquid, present in substantial quantity."@en .

emmo:EMMO_40e18c93_a1b5_49ff_b06a_d9d932d1fb65 a owl:Class ;
    rdfs:label "Emulsion"@en ;
    rdfs:isDefinedBy <https://goldbook.iupac.org/terms/view/E02065> ;
    rdfs:subClassOf emmo:EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:example "Mayonnaise"@en,
        "Milk"@en ;
    skos:prefLabel "Emulsion"@en ;
    emmo:elucidation "An emulsion is a mixture of two or more liquids that are normally immiscible (a liquid-liquid heterogeneous mixture)."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Emulsion> .

emmo:EMMO_498aad49_f8d4_40a4_a9eb_efd563a0115f a owl:Class ;
    rdfs:label "Spray"@en ;
    rdfs:isDefinedBy <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_e0edfb9e_9a96_4fae_b942_831ffe27b84a ;
    skos:prefLabel "Spray"@en ;
    emmo:elucidation "A suspension of liquid droplets dispersed in a gas through an atomization process."@en .

emmo:EMMO_58ea1de4_ad55_4448_8430_4e29d7386ce7 a owl:Class ;
    rdfs:label "SuperheatedVapor"@en ;
    rdfs:subClassOf emmo:EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c ;
    skos:prefLabel "SuperheatedVapor"@en ;
    emmo:conceptualisation "A single gas phase displaced from saturation (higher T, or lower P at fixed T), but still below T𞁞."@en .

emmo:EMMO_5a2af26d_99de_4e5e_b1cd_514be71420c3 a owl:Class ;
    rdfs:label "Smoke"@en ;
    rdfs:isDefinedBy <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_96c8d72f_b436_44e2_9f7f_085c24094292 ;
    skos:prefLabel "Smoke"@en ;
    emmo:elucidation "Smoke is a solid aerosol made of particles emitted when a material undergoes combustion or pyrolysis."@en .

emmo:EMMO_5add9885_dc98_4fa5_8482_fdf9ba5e3889 a owl:Class ;
    rdfs:label "SolidSol"@en ;
    rdfs:subClassOf emmo:EMMO_31557fae_b039_491c_bcbb_0ccb8711d5a6,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:prefLabel "SolidSol"@en ;
    emmo:elucidation "A type of sol in the form of one solid dispersed in another continuous solid."@en .

emmo:EMMO_5be9c137_325a_43d8_b7cd_ea93e7721c2d a owl:Class ;
    rdfs:label "GasSolution"@en ;
    rdfs:seeAlso <urn:isbn:9780471400653>,
        <urn:isbn:9780521408448> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 emmo:EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe ) ] ;
    skos:altLabel "GasMixture"@en ;
    skos:example "Air"@en ;
    skos:prefLabel "GasSolution"@en ;
    emmo:elucidation "A gaseous solution made of more than one component type."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Solution_(chemistry)#Gaseous_mixtures> .

emmo:EMMO_5cb107ba_7daa_46dd_8f9f_da22a6eac676 a owl:Class ;
    rdfs:subClassOf emmo:EMMO_4b3e2374_52a1_4420_8e3f_3ae6b9bf7dff ;
    skos:prefLabel "AqueousSolution"@en ;
    emmo:elucidation "A liquid solution in which the solvent is water."@en .

emmo:EMMO_5e77f00d_5c0a_44e7_baf1_2c2a4cb5b3ae a owl:Class ;
    rdfs:label "SolidSolution"@en ;
    rdfs:subClassOf emmo:EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:prefLabel "SolidSolution"@en ;
    emmo:elucidation "A solid solution made of two or more component substances."@en .

emmo:EMMO_5fbc8aca_e9c7_4e19_b4f5_32cbf8128104 a owl:Class ;
    rdfs:label "Hydrosol"@en ;
    rdfs:subClassOf emmo:EMMO_4354ac74_7425_43ab_92e4_6dc19d1afee9 ;
    skos:prefLabel "Hydrosol"@en ;
    emmo:elucidation "A liquid sol when the dispersion medium is water"@en .

emmo:EMMO_660a4964_0333_4663_bc66_e93ef59b0679 a owl:Class ;
    rdfs:seeAlso <https://doi.org/10.2777/417118> ;
    rdfs:subClassOf emmo:EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352 ;
    owl:disjointWith emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ;
    skos:example "carbon nanotube"@en,
        "nanoparticle"@en,
        "quantum dot"@en ;
    skos:prefLabel "MesoscopicSubstance"@en ;
    emmo:conceptualisation "Mesoscopic substances typically exist on a length scale between atoms and molecules and macroscopic (bulk) substances. They are typically in the range of some nanometers to about a micrometer and often exhibit unique physical properties due to their size and shape. Due to their nature of  they show no clear homonegenity in properties, and cannot be qualified as solid or liquid, but still have some criteria (e.g., structural, shape) that can be used to define them."@en ;
    emmo:elucidation "A matter that is not a particulate matter and that does not fullfill the criteria of being a continuum substance."@en .

emmo:EMMO_77e2e601_5ecb_450b_b563_92f096997832 a owl:Class ;
    rdfs:label "SolidMixture"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 emmo:EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c ) ] ;
    skos:prefLabel "SolidMixture"@en ;
    emmo:elucidation "A physical combination of two or more solid substances that retain their individual chemical identities and properties."@en ;
    emmo:note "A key characteristics of solid mixtures is that it is not chemically bonded."@en .

emmo:EMMO_9bed5d66_805a_4b3a_9153_beaf67143848 a owl:Class ;
    rdfs:label "SolidFoam"@en ;
    rdfs:subClassOf emmo:EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:example "Aerogel"@en ;
    skos:prefLabel "SolidFoam"@en ;
    emmo:elucidation "A foam of trapped gas in a solid."@en .

emmo:EMMO_a6f34396_1b31_4f42_abc6_cce491336bf6 a owl:Class ;
    rdfs:label "IdealGas"@en ;
    rdfs:subClassOf emmo:EMMO_ce2b356f_ca4d_4d38_8a6e_0fdccc61a1b5 ;
    skos:prefLabel "IdealGas"@en ;
    emmo:conceptualisation "A gas where the PV=nRT relation holds, with compressibility factor Z=1. Since no gas really fits whis model, an ideal gas is intended to be a substance for which this model is a reasonable apporoximation."@en ;
    emmo:note "Strictly speaking, an ideal gas is a model, not a thermodynamic region."@en .

emmo:EMMO_a71e5554_b7c6_4d18_b032_096f0f55c116 a owl:Class ;
    rdfs:label "Alcosol"@en ;
    rdfs:subClassOf emmo:EMMO_4354ac74_7425_43ab_92e4_6dc19d1afee9 ;
    skos:prefLabel "Alcosol"@en ;
    emmo:elucidation "A liquid sol when the dispersion medium is alcohol"@en .

emmo:EMMO_c74d40bb_83a9_46a0_b248_6647e945ba7c a owl:Class ;
    rdfs:label "SupercriticalFluid"@en ;
    rdfs:subClassOf emmo:EMMO_f5dba4d2_41dd_4591_a9e2_d35f8aee99e8 ;
    skos:prefLabel "SupercriticalFluid"@en ;
    emmo:conceptualisation "A gas with T>T𞁞 and p>p𞁞, single phase with liquid-like density and solvating power but gas-like diffusivity and zero surface tension. Continuously connected to both liquid and gas (you can circle the critical point without ever crossing a phase boundary)."@en .

emmo:EMMO_d69d2e95_b22f_499a_a552_17fde0d778fc a owl:Class ;
    rdfs:label "LiquidFoam"@en ;
    rdfs:subClassOf emmo:EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:prefLabel "LiquidFoam"@en ;
    emmo:elucidation "A foam of trapped gas in a liquid."@en .

emmo:EMMO_e0ebfc72_220f_4d9c_9a12_0e170116b7d3 a owl:Class ;
    rdfs:label "DrySaturatedVapor"@en ;
    rdfs:subClassOf emmo:EMMO_73024d1d_8db0_4d2f_9fb1_0cd1f754d9d9 ;
    skos:prefLabel "DrySaturatedVapor"@en ;
    emmo:conceptualisation "A saturated vapor with x = 1 (no wet phases)"@en .

emmo:EMMO_e4281979_2b07_4a43_a772_4903fb3696fe a owl:Class ;
    rdfs:label "Dust"@en ;
    rdfs:isDefinedBy <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_d4f37e32_16ae_4cc6_b4cd_fd896b2449c4 ;
    skos:prefLabel "Dust"@en ;
    emmo:elucidation "A suspension of fine particles in the atmosphere."@en .

emmo:EMMO_fa47c0b4_c31c_4996_97f0_d68e19916f14 a owl:Class ;
    rdfs:label "WetVapor"@en ;
    rdfs:subClassOf emmo:EMMO_73024d1d_8db0_4d2f_9fb1_0cd1f754d9d9,
        emmo:EMMO_94010cbc_c2a6_4cb9_b29a_83aa99d2ff70 ;
    skos:prefLabel "WetVapor"@en ;
    emmo:conceptualisation "Wet vapor is a two-phase mixture of saturated vapor + entrained liquid droplets (0<x<1). The region identifies the steam-quality of the vapor."@en .

emmo:EMMO_fc1d3f1c_b1bf_4e95_bbf6_1b8fdef710d2 a owl:Class ;
    rdfs:label "RealGas"@en ;
    rdfs:subClassOf emmo:EMMO_ce2b356f_ca4d_4d38_8a6e_0fdccc61a1b5 ;
    skos:prefLabel "RealGas"@en ;
    emmo:conceptualisation "A gas for which ideal assumptions cannot be made. An important role i played by finite intermolecular interaction and co-volume, Z≠1, virial expansion, van der Waals, Redlich–Kwong, Peng–Robinson, etc."@en .

<https://w3id.org/emmo/disciplines/statesofmatter> a owl:Ontology ;
    dcterms:abstract "The states of matter module categorises different states of matter according to modern applied physical sciences."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8869-3718>,
        <https://orcid.org/0009-0008-8009-5009> ;
    dcterms:creator <https://orcid.org/0000-0002-1560-809X>,
        <https://orcid.org/0000-0002-4181-2852>,
        <https://orcid.org/0000-0003-3805-8761> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "States of Matter"@en ;
    rdfs:comment "The EMMO requires HermiT reasoner plugin in order to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.0.4/reference/physicalistic> ;
    owl:versionIRI <https://w3id.org/emmo/1.0.4/disciplines/statesofmatter> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    emmo:contact "emmo@emmc.eu"^^xsd:string .

emmo:EMMO_0e6378df_1ce8_4321_b00c_ee9beea60a67 a owl:Class ;
    rdfs:subClassOf emmo:EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c ;
    skos:prefLabel "PhaseHomogeneousMixture"@en ;
    emmo:elucidation "A single phase mixture."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Mixture#Homogeneous_and_heterogeneous_mixtures> .

emmo:EMMO_2dd512a1_5187_47cc_b0b8_141214e22b59 a owl:Class ;
    rdfs:label "SolidSolidSuspension"@en ;
    rdfs:subClassOf emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:example "Granite, sand, dried concrete."@en ;
    skos:prefLabel "SolidSolidSuspension"@en ;
    emmo:elucidation "A coarse dispersion of solid in a solid continuum phase."@en .

emmo:EMMO_33e0ac8b_a318_4285_b1de_e95347784632 a owl:Class ;
    rdfs:label "SolidLiquidSuspension"@en ;
    rdfs:subClassOf emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:prefLabel "SolidLiquidSuspension"@en ;
    emmo:elucidation "A coarse dispersion of liquid in a solid continuum phase."@en .

emmo:EMMO_42185fe7_122c_4e0c_a3cd_659d3e21c389 a owl:Class ;
    rdfs:subClassOf emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:example "Sparkling water"@en ;
    skos:prefLabel "LiquidGasSuspension"@en ;
    emmo:elucidation "A coarse dispersion of gas in a liquid continuum phase."@en .

emmo:EMMO_47fe2379_be21_48d1_9ede_402f0faf494b a owl:Class ;
    rdfs:label "LiquidLiquidSuspension"@en ;
    rdfs:subClassOf emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:prefLabel "LiquidLiquidSuspension"@en ;
    emmo:elucidation "A coarse dispersion of liquid in a liquid continuum phase."@en .

emmo:EMMO_4b3e2374_52a1_4420_8e3f_3ae6b9bf7dff a owl:Class ;
    rdfs:subClassOf emmo:EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:example "An alcoholic beverage with ethanol dissolved in water (e.g., beer)."@en ;
    skos:prefLabel "LiquidSolution"@en ;
    emmo:elucidation "A liquid solution made of two or more component substances."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Solution_(chemistry)#Liquid_solutions> .

emmo:EMMO_94010cbc_c2a6_4cb9_b29a_83aa99d2ff70 a owl:Class ;
    rdfs:label "LiquidAerosol"@en ;
    rdfs:seeAlso <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_560d833a_6184_410c_859a_05d982712fd7 ;
    skos:example "Fog"@en,
        "Mist"@en,
        "Steam"@en ;
    skos:prefLabel "LiquidAerosol"@en ;
    emmo:conceptualisation "A liquid aerosol is a two-phase system: tiny droplets of liquid suspended in a gas. The substance in the droplets is still in its condensed liquid phase, just finely divided. These droplets are large enough (typically ~0.1–100 µm) to scatter light, which is why aerosols are visible."@en ;
    emmo:elucidation "An aerosol composed of liquid droplets in air or another gas."@en .

emmo:EMMO_96c8d72f_b436_44e2_9f7f_085c24094292 a owl:Class ;
    rdfs:label "SolidAerosol"@en ;
    rdfs:seeAlso <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_560d833a_6184_410c_859a_05d982712fd7 ;
    skos:prefLabel "SolidAerosol"@en ;
    emmo:elucidation "An aerosol composed of fine solid particles in air or another gas."@en .

emmo:EMMO_c457b6b9_5e73_4853_ae08_d776c12b8058 a owl:Class ;
    rdfs:label "SolidGasSuspension"@en ;
    rdfs:subClassOf emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd,
        emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:prefLabel "SolidGasSuspension"@en ;
    emmo:elucidation "A coarse dispersion of gas in a solid continuum phase."@en .

emmo:EMMO_e9e02156_651f_41c8_9efb_d5da0d4ce5e2 a owl:Class ;
    rdfs:label "LiquidSolidSuspension"@en ;
    rdfs:subClassOf emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:example "Mud"@en ;
    skos:prefLabel "LiquidSolidSuspension"@en ;
    emmo:elucidation "A coarse dispersion of solids in a liquid continuum phase."@en .

<urn:isbn:9780521405980> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:creator "Eliot Fried"^^xsd:string,
        "Lallit Anand"^^xsd:string,
        "Morton E. Gurtin"^^xsd:string ;
    dcterms:description "A unified treatment of continuum mechanics and thermodynamics emphasizing the universal status of basic balances and the entropy imbalance."^^xsd:string ;
    dcterms:identifier "ISBN-13. 9780521405980"^^xsd:string ;
    dcterms:issued "2010"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Cambridge University Press"^^xsd:string ;
    dcterms:subject "Continuum mechanics"^^xsd:string,
        "Plasticity"^^xsd:string,
        "Solid mechanics"^^xsd:string,
        "Thermodynamics"^^xsd:string ;
    dcterms:title "The Mechanics and Thermodynamics of Continua"^^xsd:string .

<https://doi.org/10.2777/417118> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:contributor "Anne F. de Baas"^^xsd:string ;
    dcterms:creator "European Commission. Directorate-General for Research and Innovation"^^xsd:string ;
    dcterms:description "The sixth edition of the Review of Materials Modelling, illustrating how advanced materials and nanotechnology simulation tools drive industrial efficiency and design within the Horizon 2020 framework."^^xsd:string ;
    dcterms:edition "Sixth version"^^xsd:string ;
    dcterms:identifier "10.2777/417118"^^xsd:string,
        "978-92-79-63185-6"^^xsd:string ;
    dcterms:issued "2017"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Publications Office of the European Union"^^xsd:string ;
    dcterms:subject "Computational materials science"^^xsd:string,
        "European Union projects"^^xsd:string,
        "H2020 LEIT-NMBP programme"^^xsd:string,
        "Materials modelling"^^xsd:string,
        "Nanotechnology"^^xsd:string,
        "Research and innovation policy"^^xsd:string ;
    dcterms:title "What makes a material function? – Let me compute the ways – Modelling in H2020 LEIT-NMBP programme materials and nanotechnology projects – Sixth version"^^xsd:string .

emmo:EMMO_0e030040_98a7_49b2_a871_dced1f3a6131 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty emmo:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
            owl:someValuesFrom emmo:EMMO_668fbd5b_6f1b_405c_9c6b_d6067bd0595a ],
        emmo:EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c ;
    skos:prefLabel "PhaseHeterogeneousMixture"@en ;
    emmo:elucidation "A mixture in which more than one phases of matter cohexists."@en ;
    emmo:note """Phase heterogeneous mixture may share the same state of matter.

For example, immiscibile liquid phases (e.g. oil and water) constitute a mixture whose phases are clearly separated but share the same state of matter."""@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Mixture#Homogeneous_and_heterogeneous_mixtures> .

emmo:EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018 a owl:Class ;
    rdfs:label "Foam"@en ;
    rdfs:subClassOf emmo:EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60 ;
    skos:prefLabel "Foam"@en ;
    emmo:elucidation "A colloid formed by trapping pockets of gas in a liquid or solid."@en .

emmo:EMMO_31557fae_b039_491c_bcbb_0ccb8711d5a6 a owl:Class ;
    rdfs:label "Sol"@en ;
    rdfs:seeAlso <https://www.britannica.com/science/sol-colloid> ;
    rdfs:subClassOf emmo:EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60 ;
    skos:example "Fluid paint"@en,
        "Mud"@en ;
    skos:prefLabel "Sol"@en ;
    emmo:elucidation "A colloid in which small particles (1 nm to 100 nm) are suspended in a continuum phase."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Sol_(colloid)> .

emmo:EMMO_4354ac74_7425_43ab_92e4_6dc19d1afee9 a owl:Class ;
    rdfs:label "LiquidSol"@en ;
    rdfs:subClassOf emmo:EMMO_31557fae_b039_491c_bcbb_0ccb8711d5a6,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:example "Blood"@en ;
    skos:prefLabel "LiquidSol"@en ;
    emmo:elucidation "A type of sol in the form of one solid dispersed in liquid."@en .

emmo:EMMO_4c21fb86_fdcf_444e_b498_86fe656295af a owl:Class ;
    rdfs:label "Plasma"@en ;
    rdfs:subClassOf emmo:EMMO_4e9fd152_147b_4564_8999_089608f41aff,
        emmo:EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8,
        emmo:EMMO_fc9222ed_14af_419b_b9df_b6a8a04e9d38 ;
    skos:prefLabel "Plasma"@en ;
    emmo:conceptualisation """The gaseous state grades into plasma once a non-negligible fraction of particles ionizes. Unlike vapor to liquid, this is generally a continuous ionization crossover, governed by Saha equilibrium under LTE, rather than a first-order phase transition with a sharp coexistence curve and latent heat.
That's precisely why "fourth state of matter" is a loose pedagogical label rather than a thermodynamically rigorous one: there's no Tc​-analogue, no discontinuity in the order parameter, just a smooth rise in ionization degree."""@en ;
    emmo:elucidation "A fluid in which a gas is ionized to a level where its electrical conductivity allows long-range electric and magnetic fields to dominate its behaviour."@en .

emmo:EMMO_560d833a_6184_410c_859a_05d982712fd7 a owl:Class ;
    rdfs:label "Aerosol"@en ;
    rdfs:isDefinedBy <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1,
        emmo:EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60 ;
    skos:example "Vapor"@en ;
    skos:prefLabel "Aerosol"@en ;
    emmo:elucidation "A colloid composed of fine solid particles or liquid droplets in air or another gas."@en .

emmo:EMMO_73024d1d_8db0_4d2f_9fb1_0cd1f754d9d9 a owl:Class ;
    rdfs:label "SaturatedVapor"@en ;
    rdfs:subClassOf emmo:EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c ;
    skos:prefLabel "SaturatedVapor"@en ;
    emmo:conceptualisation "A saturated vapor sits on the coexistence (saturation) curve, in equilibrium with its liquid at the dew point."@en .

emmo:EMMO_ce2b356f_ca4d_4d38_8a6e_0fdccc61a1b5 a owl:Class ;
    rdfs:label "Gas"@en ;
    rdfs:subClassOf emmo:EMMO_f5dba4d2_41dd_4591_a9e2_d35f8aee99e8 ;
    skos:altLabel "ProperGas"@en,
        "TrueGas"@en ;
    skos:prefLabel "Gas"@en ;
    emmo:conceptualisation "A proper (or true) gas is defined when T and p fall between T>T𞁞 and p<p𞁞. This is the region of permanent gases."@en ;
    emmo:note "The historical permanent gases (He, H₂, N₂, O₂) are simply those whose T𞁞lies below ambient, so they resisted liquefaction until cryogenic cooling below T𞁞."@en .

emmo:EMMO_d4f37e32_16ae_4cc6_b4cd_fd896b2449c4 a owl:Class ;
    rdfs:label "GasSolidSuspension"@en ;
    rdfs:seeAlso <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1,
        emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd ;
    skos:example "Dust, sand storm."@en ;
    skos:prefLabel "GasSolidSuspension"@en ;
    emmo:elucidation "A coarse dispersion of solid in a gas continuum phase."@en .

emmo:EMMO_e0edfb9e_9a96_4fae_b942_831ffe27b84a a owl:Class ;
    rdfs:label "GasLiquidSuspension"@en ;
    rdfs:seeAlso <urn:isbn:9780195129991> ;
    rdfs:subClassOf emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1,
        emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd ;
    skos:example "Rain, spray."@en ;
    skos:prefLabel "GasLiquidSuspension"@en ;
    emmo:elucidation "A coarse dispersion of liquid in a gas continuum phase."@en .

emmo:EMMO_f5dba4d2_41dd_4591_a9e2_d35f8aee99e8 a owl:Class ;
    rdfs:label "SupercriticalGaseousState"@en ;
    rdfs:subClassOf emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 ;
    skos:altLabel "Gas"@en ;
    skos:prefLabel "SupercriticalGaseousState"@en ;
    emmo:conceptualisation """A gaseous state where no liquid forms can be obtained by compression. The liquid–vapor distinction has vanished.
This state can be categorised by pressure relative to critical pressure p𞁞"""@en .

<urn:isbn:9780521408448> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:alternative "An Account of the Kinetic Theory of Viscosity, Thermal Conduction and Diffusion in Gases"^^xsd:string ;
    dcterms:creator "Sydney Chapman"^^xsd:string,
        "T. G. Cowling"^^xsd:string ;
    dcterms:identifier "ISBN-10. 052140844X"^^xsd:string,
        "ISBN-13. 978-0521408448"^^xsd:string ;
    dcterms:issued "1991"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Addison-Wesley"^^xsd:string ;
    dcterms:subject "Diffusion"^^xsd:string,
        "Kinetic theory of gases"^^xsd:string,
        "Thermal conduction"^^xsd:string,
        "Viscosity"^^xsd:string ;
    dcterms:title "The Mathematical Theory of Non-uniform Gases"^^xsd:string .

emmo:EMMO_0b15f4ae_092e_4487_9100_3c44176c545c a owl:Class ;
    rdfs:subClassOf emmo:EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c ;
    skos:prefLabel "Dispersion"@en ;
    emmo:OWLRL2DLAxioms "Equivalent To: Solution or Suspension or Colloid"@en ;
    emmo:elucidation "A material in which distributed particles of one phase are dispersed in a different continuous phase."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Dispersion_(chemistry)> .

emmo:EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe a owl:Class ;
    rdfs:seeAlso <https://doi.org/10.1351/goldbook.S05746> ;
    rdfs:subClassOf emmo:EMMO_0b15f4ae_092e_4487_9100_3c44176c545c,
        emmo:EMMO_0e6378df_1ce8_4321_b00c_ee9beea60a67 ;
    skos:prefLabel "Solution"@en ;
    emmo:elucidation "A solution is a homogeneous mixture composed of two or more substances, when for convenience one (or more) substance, which is called the solvent, is treated differently from the other substances, which are called solutes."@en ;
    emmo:note "IUPAC Goldbook definition is restricted to liquid or solid solutions. Here we extend the concept also to gas."@en,
        "Solutions are characterized by the occurrence of Rayleigh scattering on light,"@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Solution_(chemistry)> .

emmo:EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c a owl:Class ;
    rdfs:label "Vapor"@en ;
    rdfs:subClassOf emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 ;
    skos:altLabel "SubcriticalGaseousState"@en ;
    skos:prefLabel "Vapor"@en ;
    emmo:conceptualisation "Vapor is defined as the gas-phase form of a substance that is below its critical temperature T𞁞, meaning it can be condensed to liquid by pressure alone (condensability). It is a single, homogeneous phase. Vapos are typically invisible."@en ;
    emmo:elucidation "A gas made of a substance below its critical temperature"@en .

emmo:EMMO_4e9fd152_147b_4564_8999_089608f41aff a owl:Class ;
    rdfs:isDefinedBy <https://doi.org/10.1351/goldbook.12743> ;
    rdfs:subClassOf emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
    skos:altLabel "AmorphousNetwork"@en ;
    skos:prefLabel "AmorphousState"@en ;
    emmo:conceptualisation "Amorphous substances are characterized by the absence of regular long-range order within their atomic networks, distinguishing them from highly ordered crystalline lattices. This structural disorder prevents the formation of regular macroscopic geometric facets. Thermodynamically and physically, this manifests as a lack of a distinct melting point, irregular fracture behavior, diffuse X-ray diffraction patterns, and isotropic mechanical, optical, and electrical properties."@en ;
    emmo:elucidation "State of matter characterised by the absence of long-range molecular order."@en ;
    emmo:iupacReference <https://doi.org/10.1351/goldbook.12743> ;
    emmo:note "If you look at the fundamental IUPAC (International Union of Pure and Applied Chemistry) definition, \"amorphous\" simply means a material lacks long-range translational order. Under this pure structural definition, liquids, gases, plasmas, and supercritical fluids are all amorphous states of matter. They have no crystalline lattice, no unit cells, and no repeating 3D patterns. If you take an X-ray diffraction scan of a liquid, you get the exact same broad, featureless \"amorphous halo\" that you get from a piece of solid glass. Therefore, structural physicists routinely refer to liquids as amorphous networks."@en,
        "In the absence of stress, the structure and properties of the amorphous state are generally isotropic at a large-enough scale, as in liquids, but they can readily develop functional/property anisotropy under the right conditions."@en,
        "One of the most common technique to define if a substance is lacking of a regular structure (amorphous) is to look at its x-ray diffraction pattern. A diffuse and poorly defined pattern is typical of an amorphous structure, while a regular reproducible pattern is typical of a crystalline structure."@en,
        "Some degree of local order about 1 nm  in length may exist in the amorphous state."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Amorphous_solid> .

emmo:EMMO_668fbd5b_6f1b_405c_9c6b_d6067bd0595a a owl:Class ;
    rdfs:label "PhaseOfMatter"@en ;
    rdfs:subClassOf emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ;
    skos:altLabel "Phase"@en ;
    skos:example "One State, Multiple Solid Phases: Ice isn't just one phase. Under extreme pressures, solid ice can arrange itself into more than 15 different crystalline structures (Ice I, Ice II, Ice VII, etc.). Each of these structures is a different phase, even though they are all in the same solid state."@en ;
    skos:prefLabel "PhaseOfMatter"@en ;
    emmo:elucidation "A chemically uniform, physically distinct, and mechanically separable region of matter, throughout which all physical properties of a material are essentially uniform."@en ;
    emmo:note """In the physical sciences, a phase is a region of space (a thermodynamic system), throughout which all physical properties of a material are essentially uniform. Examples of physical properties include density, index of refraction, magnetization and chemical composition. A simple description is that a phase is a region of material that is chemically uniform, physically distinct, and (often) mechanically separable. In a system consisting of ice and water in a glass jar, the ice cubes are one phase, the water is a second phase, and the humid air is a third phase over the ice and water. The glass of the jar is another separate phase.

The term phase is sometimes used as a synonym for state of matter, but there can be several immiscible phases of the same state of matter. Also, the term phase is sometimes used to refer to a set of equilibrium states demarcated in terms of state variables such as pressure and temperature by a phase boundary on a phase diagram. Because phase boundaries relate to changes in the organization of matter, such as a change from liquid to solid or a more subtle change from one crystal structure to another, this latter usage is similar to the use of "phase" as a synonym for state of matter. However, the state of matter and phase diagram usages are not commensurate with the formal definition given above and the intended meaning must be determined in part from the context in which the term is used."""@en .

emmo:EMMO_fc9222ed_14af_419b_b9df_b6a8a04e9d38 a owl:Class ;
    rdfs:label "UncondensedMatter"@en ;
    rdfs:subClassOf emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
    skos:altLabel "UncondensedState"@en ;
    skos:prefLabel "UncondensedMatter"@en ;
    emmo:OWLRL2DLAxioms "Equivalent To: Gas or Plasma"^^xsd:string ;
    emmo:elucidation "Matter in gas or plasma physical state."@en .

emmo:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd a owl:Class ;
    rdfs:subClassOf emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
    owl:disjointWith emmo:EMMO_fc9222ed_14af_419b_b9df_b6a8a04e9d38 ;
    skos:altLabel "CondensedState"@en ;
    skos:prefLabel "CondensedMatter"@en ;
    emmo:OWLRL2DLAxioms "Equivalent To: Liquid or Solid"^^xsd:string ;
    emmo:conceptualisation "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
    emmo:elucidation "Matter in liquid or solid physical state."@en .

emmo:EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8 a owl:Class ;
    rdfs:seeAlso <urn:isbn:9780471400653> ;
    rdfs:subClassOf emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2,
        emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
    owl:disjointWith emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
    skos:example "Gas, liquid, plasma,"@en ;
    skos:prefLabel "Fluid"@en ;
    emmo:OWLRL2DLAxioms "Equivalent To: Gas or Plasma or Liquid"@en ;
    emmo:elucidation "A continuum that has no fixed shape and yields easily under an applied shear stress, or external force."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Fluid> .

<urn:isbn:9780471400653> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:creator "Charles F. Curtiss"^^xsd:string,
        "Joseph O. Hirschfelder"^^xsd:string,
        "R. Byron Bird"^^xsd:string ;
    dcterms:description "A rigorous treatment of the molecular characteristics and behaviors of gases and liquids."^^xsd:string ;
    dcterms:identifier "9780471400653"^^xsd:string ;
    dcterms:issued "1964"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Wiley-Interscience"^^xsd:string ;
    dcterms:subject "Fluid Dynamics"^^xsd:string,
        "Kinetic Theory"^^xsd:string,
        "Molecular Interactions"^^xsd:string,
        "Statistical Mechanics"^^xsd:string ;
    dcterms:title "The Molecular Theory of Gases and Liquids"^^xsd:string .

dcmitype:Text a owl:Class .

emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 a owl:Class ;
    rdfs:subClassOf emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ;
    skos:prefLabel "StateOfMatter"@en ;
    emmo:OWLRL2DLAxioms "Disjoint Union Of: CondensedMatter, UncondensedMatter"^^xsd:string,
        "Disjoint Union Of: Gas, Plasma, Liquid, Solid"^^xsd:string ;
    emmo:elucidation "A superclass made as the disjoint union of all the form under which matter can exist."@en ;
    emmo:note "Besides the classical four state, IUPAC Goldbook introduces another categorisation dimension with the distinction between amorphous and crystalline state. A substance can then be the combination of these different categorisation schemes, such as liquid crystal or amorphous solid. However, between crystalline and amorphous states there may be intermediate state called semicrystalline materials where amorphous and crystalline phases are mixed."@en,
        "Besides the classical four states,we have also the categorisation widely used in material science between condensed (liquid and solid) and uncondensed (gas and plasma) matter."@en,
        "In physics, a state of matter is one of the distinct forms in which matter can exist. Four states of matter are observable in everyday life: solid, liquid, gas, and plasma."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/State_of_matter"@en .

emmo:EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60 a owl:Class ;
    rdfs:label "Colloid"@en ;
    rdfs:isDefinedBy <https://goldbook.iupac.org/terms/view/C01172> ;
    rdfs:subClassOf emmo:EMMO_0b15f4ae_092e_4487_9100_3c44176c545c,
        emmo:EMMO_0e030040_98a7_49b2_a871_dced1f3a6131 ;
    skos:altLabel "ColloidalSystem"@en ;
    skos:prefLabel "Colloid"@en ;
    emmo:elucidation "A mixture in which one substance of microscopically dispersed insoluble or soluble particles (from 1 nm to 1 μm) is suspended throughout another substance and that does not settle, or would take a very long time to settle appreciably."@en ;
    emmo:note "Colloids are characterized by the occurring of the Tyndall effect on light."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Colloid> .

emmo:EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c a owl:Class ;
    rdfs:isDefinedBy <https://goldbook.iupac.org/terms/view/M03949> ;
    rdfs:subClassOf emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ;
    skos:prefLabel "Mixture"@en ;
    emmo:elucidation "A continuum substance made up of two or more different substances which are physically (not chemically) combined called constituents."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Mixture#> .

emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 a owl:Class ;
    rdfs:seeAlso <https://doi.org/10.2777/417118>,
        <urn:isbn:9780521405980> ;
    rdfs:subClassOf emmo:EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352 ;
    skos:example "A single continuum individual can be the whole fluid in a pipe."@en ;
    skos:prefLabel "ContinuumSubstance"@en ;
    emmo:conceptualisation """Continuum is usually an assumption made relative to a specific entity and scale of observation. We can define a continuum substance as a substance for which continuum mechanics (i.e., solid or fluid mechanics) can be used as a model for the description and prediction of its behaviour.
Paramount to this definition is the applicability of the continuum assumption, that is usually made by comparing the scale of the constituents' phenomena (e.g., mean free path of a molecule in a gas) and the scale of the macro-entity (e.g., the container of the gas)."""@en ;
    emmo:elucidation "A substance that is made of sufficiently large number of smaller parts such that it is the bearer of qualities that can exist only by the fact that it is a sum of parts."@en ;
    emmo:note "A continuum is the bearer of properties that are generated by the interactions of its fundamental parts, such as viscosity and thermal or electrical conductivity. In fact, viscosity or electrical conductivity are properties of the macro-entity (e.g., solid, fluid), and not of the constituents (e.g., atoms or molecules)."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Continuum_mechanics> .

emmo:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd a owl:Class ;
    rdfs:comment "Suspensions show no significant effect on visible light."@en ;
    rdfs:subClassOf emmo:EMMO_0b15f4ae_092e_4487_9100_3c44176c545c,
        emmo:EMMO_0e030040_98a7_49b2_a871_dced1f3a6131,
        emmo:EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
    skos:prefLabel "Suspension"@en ;
    emmo:OWLRL2DLAxioms "Equivalent To: SolidSolidSuspension or SolidLiquidSuspension or LiquidGasSuspension or LiquidLiquidSuspension or SolidGasSuspension or GasSolidSuspension or GasLiquidSuspension or LiquidSolidSuspension"^^xsd:string ;
    emmo:elucidation "An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Suspension_(chemistry)> .

emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba a owl:Class ;
    rdfs:seeAlso <urn:isbn:9780471400653> ;
    rdfs:subClassOf emmo:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd,
        emmo:EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8 ;
    skos:prefLabel "Liquid"@en ;
    emmo:elucidation "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure."@en .

<urn:isbn:9780195129991> a dcmitype:Text,
        owl:NamedIndividual ;
    dcterms:creator "Sheldon K. Friedlander"^^xsd:string ;
    dcterms:description "A classic text focusing on the physical and chemical principles governing the behavior of ambient and engineered aerosols."^^xsd:string ;
    dcterms:edition "2nd Edition"^^xsd:string ;
    dcterms:identifier "9780195129991"^^xsd:string ;
    dcterms:issued "2000"^^xsd:gYear ;
    dcterms:language "en"^^xsd:string ;
    dcterms:publisher "Oxford University Press"^^xsd:string ;
    dcterms:subject "Aerosol dynamics"^^xsd:string,
        "Air pollution control"^^xsd:string,
        "Fluid mechanics"^^xsd:string,
        "Particle technology"^^xsd:string ;
    dcterms:title "Smoke, Dust, and Haze: Fundamentals of Aerosol Dynamics"^^xsd:string .

emmo:EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 a owl:Class ;
    rdfs:label "GaseousState"@en ;
    rdfs:seeAlso <urn:isbn:9780471400653>,
        <urn:isbn:9780521408448> ;
    rdfs:subClassOf emmo:EMMO_4e9fd152_147b_4564_8999_089608f41aff,
        emmo:EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8,
        emmo:EMMO_fc9222ed_14af_419b_b9df_b6a8a04e9d38 ;
    skos:altLabel "Gas"@en ;
    skos:prefLabel "GaseousState"@en ;
    emmo:OWLRL2DLAxioms "Disjoint Union Of: SupercriticalGaseousState, Vapor"@en ;
    emmo:conceptualisation """A gas is a state of matter in which particles (e.g., atoms or molecules) have enough kinetic energy to overcome the intermolecular forces binding them together, so they move freely and independently, filling whatever container holds them. Unlike a liquid, a gas has no definite volume and is readily compressible.
A gaseous state can be categorised univocally whether the substance sits below or above critical temperature T𞁞​, because that alone determines whether a liquid–vapor phase boundary exists. Below T𞁞​ the gaseous phase is condensable by isothermal compression; at and above T𞁞 no amount of pressure produces a distinct liquid.
A gas differs from a plasma in that its particles remain electrically neutral and un-ionized; once a significant fraction of particles ionize, the system becomes a plasma, which responds to electromagnetic fields collectively."""@en ;
    emmo:elucidation "A gaseous state is a compressible fluid, a state of matter that has no fixed shape and no fixed volume."@en ;
    emmo:note "\"Vapor\" and \"gas\" are often used interchangeably in casual speech, but in the strict sense they are different branches of the tree, divided by T𞁞. A vapor can be liquefied by pressure alone; a gas cannot. This is why \"water vapor\" is correct (water's Tc​ = 647 K is far above ambient) while room-temperature N₂ or O₂ is properly a gas."@en ;
    emmo:wikipediaReference <https://en.wikipedia.org/wiki/Gas> .

emmo:EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 a owl:Class ;
    rdfs:label "Solid"@en ;
    rdfs:subClassOf emmo:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd,
        emmo:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ;
    skos:prefLabel "Solid"@en ;
    emmo:elucidation "A continuum characterized by structural rigidity and resistance to changes of shape or volume, that retains its shape and density when not confined."@en .

[] a owl:Axiom ;
    rdfs:seeAlso <https://en.wiktionary.org/wiki/condense> ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource emmo:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ;
    owl:annotatedTarget "CondensedMatter"@en ;
    emmo:etymology "From Latin condēnsō, con- (“with, together”) + dēnsō (“thicken”) [Wiktionary]"@en .

[] a owl:Axiom ;
    owl:annotatedProperty emmo:conceptualisation ;
    owl:annotatedSource emmo:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ;
    owl:annotatedTarget "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
    emmo:wikipediaReference "https://en.wikipedia.org/wiki/Condensed_matter_physics"@en .


  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Continuous or stepwise pressure forming with one or more rotating tools (rollers), without or with additional tools, e.g. plugs or mandrels, rods, guide tools</owl:annotatedTarget>
</owl:Axiom>

<owl:Restriction>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_51f93d8c_57fa_4314_a68d_8d69c2609c97"/>

  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oxy ≡ ∃z(Pzx ∧ Pzy)</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>

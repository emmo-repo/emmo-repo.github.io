  <owl:annotatedTarget xml:lang="en">Holistic</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">Holism (from Greek ὅλος holos "all, whole, entire").</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_0277f24a_ea7f_4917_81b7_fb0406c8fc62"/>
  <owl:annotatedTarget xml:lang="en">Wholistic</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From the word 'holistic' with the 'w-' prefix, due to the affinity with the existing word 'whole', that share the same meaning of 'holos'.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>


  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin manu factum ("made by hand").</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6"/>
  <owl:annotatedTarget xml:lang="en">A part is always distinct xor redundant.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0"/>
  <owl:annotatedTarget xml:lang="en">Redundant(x) ≡ ∃φ[φ(x) ∧ ∃yRP⟨φ⟩(y, x)]</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd"/>
  <owl:annotatedTarget xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with "condensed" phases of matter: systems of many constituents with strong interactions between them.</owl:annotatedTarget>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Condensed_matter_physics</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Axiom>


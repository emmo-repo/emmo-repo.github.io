<owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_26c4132f-08aa-5391-aa39-121ce088e762">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_d357e0dd_3497_4590_af6f_7954db7fecf7"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_eb77076b_a104_42ac_a065_798b2d2809ad"/>

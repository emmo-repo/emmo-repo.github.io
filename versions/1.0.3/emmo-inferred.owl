  <rdfs:comment rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">Implementation of equality based on mereology.</rdfs:comment>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>

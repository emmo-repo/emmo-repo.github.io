<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_bafc17b5_9be4_4823_8bbe_ab4e90b6738c"/>
  <owl:annotatedTarget xml:lang="en">IntentionalAgency</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin agēns (present participle of agere (“to act”))</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_dc0874e8_36e1_44df_947d_0d7c81167a09"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-7:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(according to DIN 8200) Shot peening to generate residual compressive stresses in layers of the blasting material close to the surface in order to improve certain component properties, e.g. fatigue strength, corrosion resistance, wear resistance (from: DIN 8200:1982)</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>

<owl:Class rdf:about="https://w3id.org/emmo#PascalSecondPerMetre">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e35d4936_b2e3_4cd6_a437_f1c864b3d450"/>
  <rdfs:label xml:lang="en">PascalSecondPerMetre</rdfs:label>
  <rdfs:comment xml:lang="en">Pascal Second Per Meter (Pa-s/m) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of ML²T⁻¹ where M is mass, L is length, and T is time. It essentially the same as the corresponding standard SI unit kg/m2· s.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--specific_acoustic_impedance--pascal_second_per_meter.cfm</rdfs:seeAlso>
  <core:altLabel xml:lang="en">Pascal Second Per Metre</core:altLabel>
  <core:prefLabel xml:lang="en">PascalSecondPerMetre</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PA-SEC-PER-M</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa.s.m-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa⋅s/m</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Pascal Second Per Meter (Pa-s/m) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of ML²T⁻¹ where M is mass, L is length, and T is time. It essentially the same as the corresponding standard SI unit kg/m2· s.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


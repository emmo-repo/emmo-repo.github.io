  <rdfs:label xml:lang="en">Declarer</rdfs:label>
  <rdfs:comment xml:lang="en">An interpreter who establish the connection between an conventional sign and an object according to a specific convention.</rdfs:comment>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scientist that assigns a quantity to a physical objects without actually measuring it but taking it for granted due to its previous experience (e.g. considering an electron charge as 1.6027663e-19 C, assigning a molecular mass to a gas only by the fact of a name on the bottle).</core:example>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Someone who assigns a name to an object.</core:example>
  <core:prefLabel xml:lang="en">Declarer</core:prefLabel>

  <rdfs:label xml:lang="en">GaugeBoson</rdfs:label>
  <rdfs:comment xml:lang="en">A bosonic elementary particle that mediates interactions among elementary fermions, and thus acts as a force carrier.</rdfs:comment>
  <core:prefLabel xml:lang="en">GaugeBoson</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A bosonic elementary particle that mediates interactions among elementary fermions, and thus acts as a force carrier.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">All known gauge bosons have a spin of 1 and are hence also vector bosons.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Gauge bosons can carry any of the four fundamental interactions of nature.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Gauge_boson</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Class>


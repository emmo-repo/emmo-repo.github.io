  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c2f5ee66_579c_44c6_a2e9_fa2eaa9fa4da"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReadsPerKiloBase</rdfs:label>
  <rdfs:comment xml:lang="en">RPK (Reads Per Kilobases) are obtained by dividing read counts by gene lengths (expressed in kilo-nucleotides).


<owl:Class rdf:about="https://w3id.org/emmo#EMMO_0f19d84e_05b4_47c9_a5de_bb2a913d211b">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_b295158f_fda4_4124_ab58_d9ea4ccfca5a"/>
  <rdfs:label xml:lang="en">ParticlesSystem</rdfs:label>
  <rdfs:comment xml:lang="en">A particles system is a system made of causal paths that are not interacting between each others, or possibly merge and fork.</rdfs:comment>
  <core:altLabel xml:lang="en">NonInteractingSystem</core:altLabel>
  <core:example xml:lang="en">A W boson that travels through time and space and decays in a quark and anti-quark, and their evolution after their generation.</core:example>
  <core:prefLabel xml:lang="en">ParticlesSystem</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A particles system is a system made of causal paths that are not interacting between each others, or possibly merge and fork.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A particle system is a combination of elementary particles that may include also decays and/or annihilations, without any space-like interaction between elementary particles.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#EMMO_b295158f_fda4_4124_ab58_d9ea4ccfca5a">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
  <rdfs:label xml:lang="en">GenericPhysicalSystem</rdfs:label>
  <rdfs:comment xml:lang="en">A causal system possessing bonding that can not be represented by a simple Feynman diagram.</rdfs:comment>
  <rdfs:comment xml:lang="en">A generic physical system is everything which is more complex than a scattering interaction, or a decay/annihilation event, which are represented by a single Feynman diagram.</rdfs:comment>
  <core:prefLabel xml:lang="en">GenericPhysicalSystem</core:prefLabel>
  <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A generic physical system is everything which is more complex than a scattering interaction, or a decay/annihilation event, which are represented by a single Feynman diagram.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
  <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: InteractingSystem, ParticlesSystem</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A causal system possessing bonding that can not be represented by a simple Feynman diagram.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


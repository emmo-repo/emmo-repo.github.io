  <rdfs:label xml:lang="en">hasSpatialPart</rdfs:label>
  <rdfs:comment xml:lang="en">A proper part of a whole, whose parts always cover the full temporal extension of the whole within a spatial interval.</rdfs:comment>
  <core:prefLabel xml:lang="en">hasSpatialPart</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A proper part of a whole, whose parts always cover the full temporal extension of the whole within a spatial interval.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In EMMO FOL this is a defined property. In OWL temporal relations are primitive.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The part is connected with the rest item or members with hasContact relations only (no hasNext).</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6">

<owl:AnnotationProperty rdf:about="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <rdfs:label xml:lang="en">definition</rdfs:label>
  <rdfs:comment xml:lang="en">Precise and univocal description of an ontological entity in the framework of an axiomatic system.</rdfs:comment>
  <core:prefLabel xml:lang="en">definition</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Precise and univocal description of an ontological entity in the framework of an axiomatic system.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A definition univocally determines a OWL entity using necessary and sufficient conditions referring to other OWL entities.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:AnnotationProperty>


  <rdfs:label xml:lang="en">ElectricCharge</rdfs:label>
  <rdfs:comment xml:lang="en">The physical property of matter that causes it to experience a force when placed in an electromagnetic field.</rdfs:comment>
  <core:altLabel xml:lang="en">Charge</core:altLabel>
  <core:prefLabel xml:lang="en">ElectricCharge</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/ElectricCharge</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q1111</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-2</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The physical property of matter that causes it to experience a force when placed in an electromagnetic field.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>

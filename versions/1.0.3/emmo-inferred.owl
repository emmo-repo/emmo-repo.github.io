  <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Charge_number</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 xml:lang="en">10-5.2</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">For a particle, electric charge q divided by elementary charge e.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>

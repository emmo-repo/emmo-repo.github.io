  <rdfs:comment xml:lang="en">A semiotic relation that connects a description to a declared semiotic objec in a declaration process.</rdfs:comment>
  <core:prefLabel xml:lang="en">isDescriptionFor</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A semiotic relation that connects a description to a declared semiotic objec in a declaration process.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_55375713_8f92_473b_a688_b7fcc14f7797">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>

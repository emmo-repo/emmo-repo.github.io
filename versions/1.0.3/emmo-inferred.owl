  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mN.m</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mN⋅m</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">0.001-fold of the product of the SI derived unit newton and the SI base unit metre

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


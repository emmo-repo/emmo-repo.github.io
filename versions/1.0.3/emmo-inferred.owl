<owl:Class rdf:about="https://w3id.org/emmo#Statmho">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.1126e-12</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_86ffe1bb_d457_4948_9e39_35f363b9a9fe"/>
  <rdfs:label xml:lang="en">Statmho</rdfs:label>
  <rdfs:comment xml:lang="en">"StatMHO" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One statmho is the conductance between two points in a conductor when a constant potential difference of 1 statvolt applied between the points produces in the conductor a current of 1 statampere, the conductor not being the source of any electromotive force, approximately 1.1126 × 10⁻¹² mho.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.sizes.com/units/statmho.htm</rdfs:seeAlso>
  <core:prefLabel xml:lang="en">Statmho</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/MHO_Stat</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stat℧</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">"StatMHO" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One statmho is the conductance between two points in a conductor when a constant potential difference of 1 statvolt applied between the points produces in the conductor a current of 1 statampere, the conductor not being the source of any electromotive force, approximately 1.1126 × 10⁻¹² mho.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


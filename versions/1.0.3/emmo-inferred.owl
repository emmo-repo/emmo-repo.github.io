  <rdfs:label xml:lang="en">Emulsion</rdfs:label>
  <rdfs:comment xml:lang="en">An emulsion is a mixture of two or more liquids that are normally immiscible (a liquid-liquid heterogeneous mixture).</rdfs:comment>
  <core:example xml:lang="en">Mayonnaise, milk.</core:example>
  <core:prefLabel xml:lang="en">Emulsion</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An emulsion is a mixture of two or more liquids that are normally immiscible (a liquid-liquid heterogeneous mixture).</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


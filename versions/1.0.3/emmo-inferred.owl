  <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=395-01-15</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
  <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-04-18</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>

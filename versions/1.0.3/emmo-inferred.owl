</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_b1c64830_45c7_499d_9a72_68f517d57823">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_86ca9b93_1183_4b65_81b8_c0fcd3bba5ad"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>

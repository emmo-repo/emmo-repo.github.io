  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
  <rdfs:label xml:lang="en">Hartree</rdfs:label>
  <rdfs:comment xml:lang="en">The `Hartree` (symbol: E_h or Ha), also known as the `Hartree Energy`, is the atomic unit of energy. The hartree energy is equal to the absolute value of the electric potential energy of the hydrogen atom in its ground state. The energy of the electron in an H-atom in its ground state is -E_H, where E_H= 2 R_∞ · hc₀. The 2006 CODATA recommended value was E_H = 4.35974394(22) × 10⁻¹⁸ J = 27.21138386(68) eV.
Definition:
E_H = e²/(4π ε₀ a₀)
where, e is the elementary charge, ε₀ is the electric constant, and a₀ is the Bohr radius.'

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:prefLabel xml:lang="en">Hartree</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/E_h</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The `Hartree` (symbol: E_h or Ha), also known as the `Hartree Energy`, is the atomic unit of energy. The hartree energy is equal to the absolute value of the electric potential energy of the hydrogen atom in its ground state. The energy of the electron in an H-atom in its ground state is -E_H, where E_H= 2 R_∞ · hc₀. The 2006 CODATA recommended value was E_H = 4.35974394(22) × 10⁻¹⁸ J = 27.21138386(68) eV.
Definition:
E_H = e²/(4π ε₀ a₀)
where, e is the elementary charge, ε₀ is the electric constant, and a₀ is the Bohr radius.'

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Hartree?oldid=489318053</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Class>


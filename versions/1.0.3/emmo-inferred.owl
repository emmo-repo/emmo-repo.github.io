<owl:Class rdf:about="https://w3id.org/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf>

  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">This axiom underlines the monodimensional nature of a causal chain, as a sequence of quanta.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_6fba4018_24bd_450c_abc3_354e2c7809c9"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8584-1:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of a solid body, whereby the plastic state is essentially brought about by a combined tensile and compressive stress.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental(x) ≡ ∃φ[φ(x) ∧ ¬∃yRP⟨φ⟩(y, x)]</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_5c15f8c4_d2de_47a0_acdd_470b8dda979b"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://datatracker.ietf.org/doc/rfc3987/</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">An Internationalized Resource Identifier (IRI) is a compact sequence of characters that identifies an abstract or physical resource. It is similar to URI, but greatly extends the allowed character set from ASCII to the Universal Character Set (Unicode/ISO 10646)..</owl:annotatedTarget>
</owl:Axiom>


</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#EMMO_c130614a_2985_476d_a7ed_8a137847703c">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/agency"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_cd24eb82_a11c_4a31_96ea_32f870c5580a"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_bafc17b5_9be4_4823_8bbe_ab4e90b6738c"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_2480b72b_db8d_460f_9a5f_c2912f979046"/>
  <rdfs:label xml:lang="en">IntentionalAgent</rdfs:label>
  <rdfs:comment xml:lang="en">An agent that is driven by the intention to reach a defined objective in driving a process.</rdfs:comment>
  <core:prefLabel xml:lang="en">IntentionalAgent</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An agent that is driven by the intention to reach a defined objective in driving a process.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Intentionality is not limited to human agents, but in general to all agents that have the capacity to decide to act in driving a process according to a motivation.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#EMMO_f68858dd_64f4_4877_b7fb_70d04fbe5bab">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_e3850f08_8e79_454b_9d83_c517cab42857"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_846b637b_7b12_47a1_9430_0274b2f588ac"/>
  <rdfs:label xml:lang="en">ConstitutiveProcess</rdfs:label>
  <rdfs:comment xml:lang="en">A process which is a spatial part of an object.</rdfs:comment>
  <core:example xml:lang="en">Blood circulation in a human body.</core:example>
  <core:prefLabel xml:lang="en">ConstitutiveProcess</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A process which is a spatial part of an object.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A constitutive process is a process that is holistically relevant for the definition of the whole.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#EMMO_846b637b_7b12_47a1_9430_0274b2f588ac">

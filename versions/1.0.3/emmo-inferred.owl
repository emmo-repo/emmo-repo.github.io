<owl:AnnotationProperty rdf:about="https://w3id.org/emmo#EMMO_2856bbc2_96e1_485b_b5f8_2fdfcb0c9b92">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:label xml:lang="en">inchiKey</rdfs:label>
  <rdfs:comment xml:lang="en">A hash of the full International Chemical Identifier (InChi) for a chemical substance.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://inchi.info/inchikey_overview_en.html</rdfs:seeAlso>
  <core:prefLabel xml:lang="en">inchiKey</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A hash of the full International Chemical Identifier (InChi) for a chemical substance.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The InChiKey is a hash of the full InChi identifier using the SHA-256 algorithm, designed to allow for easy web searches of chemical compounds.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <rdfs:label xml:lang="en">elucidation</rdfs:label>
  <rdfs:comment xml:lang="en">Short enlightening explanation aimed to facilitate the user in drawing the connection (interpretation) between a OWL entity and the real world object(s) for which it stands.</rdfs:comment>
  <core:prefLabel xml:lang="en">elucidation</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Short enlightening explanation aimed to facilitate the user in drawing the connection (interpretation) between a OWL entity and the real world object(s) for which it stands.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">An elucidation should address the real world entities using the concepts introduced by the conceptualisation annotation.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:AnnotationProperty>


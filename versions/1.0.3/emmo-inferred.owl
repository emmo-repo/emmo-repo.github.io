  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Center_of_mass</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>

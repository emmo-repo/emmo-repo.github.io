  <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#Name"/>
</owl:Restriction>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591"/>
  <owl:annotatedTarget xml:lang="en">A part is always distinct xor redundant.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd"/>

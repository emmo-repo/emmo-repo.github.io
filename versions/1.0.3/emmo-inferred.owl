<owl:Class rdf:about="https://w3id.org/emmo#EMMO_4bc29b0f_8fcc_4026_a291_f9774a66d9b8">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_29afdf54_90ae_4c98_8845_fa9ea3f143a8"/>
  <rdfs:label xml:lang="en">MathematicalFunction</rdfs:label>
  <rdfs:comment xml:lang="en">A function defined using functional notation.</rdfs:comment>
  <rdfs:comment xml:lang="en">A mathematical relation that relates each element in the domain (X) to exactly one element in the range (Y).</rdfs:comment>

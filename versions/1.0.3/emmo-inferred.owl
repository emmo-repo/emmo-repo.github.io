      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1e-40</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9141801c_c539_4c72_b423_8c74ff6b8f05"/>
  <rdfs:label xml:lang="en">CubicAngstrom</rdfs:label>
  <rdfs:comment xml:lang="en">A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m²/V and can be converted to Ångström³ by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m³ to Ångström³ through the SI base 10 conversion (multiplying by 10⁻³⁰).

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Cubic Angstrom</core:altLabel>
  <core:altLabel xml:lang="en">Cubic Ångström</core:altLabel>
  <core:altLabel xml:lang="en">CubicÅngström</core:altLabel>
  <core:prefLabel xml:lang="en">CubicAngstrom</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/ANGSTROM3</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Å³</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m²/V and can be converted to Ångström³ by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m³ to Ångström³ through the SI base 10 conversion (multiplying by 10⁻³⁰).

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


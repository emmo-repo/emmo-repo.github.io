<owl:Class rdf:about="https://w3id.org/emmo#KelvinPerWatt">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_cff9f930_f3f7_43c6_9228_28bf3e1ec706"/>
  <rdfs:label xml:lang="en">KelvinPerWatt</rdfs:label>
  <rdfs:comment xml:lang="en">Thermal resistance is a heat property and a measure of a temperature difference by which an object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal conductance. Absolute thermal resistance is the temperature difference across a structure when a unit of heat energy flows through it in unit time. It is the reciprocal of thermal conductance. The SI units of thermal resistance are kelvins per watt or the equivalent degrees Celsius per watt (the two are the same since as intervals).

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Kelvin per Watt</core:altLabel>
  <core:prefLabel xml:lang="en">KelvinPerWatt</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/K-PER-W</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K.W-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K/W</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K/W</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Thermal resistance is a heat property and a measure of a temperature difference by which an object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal conductance. Absolute thermal resistance is the temperature difference across a structure when a unit of heat energy flows through it in unit time. It is the reciprocal of thermal conductance. The SI units of thermal resistance are kelvins per watt or the equivalent degrees Celsius per watt (the two are the same since as intervals).

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


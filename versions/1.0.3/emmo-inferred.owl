  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso:8887:-1:ed-1:v1:en:term:3.1.5</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">ISO 8887-1:2017
manufacturing: production of components</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:hasValue rdf:resource="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f"/>
        </rdf:Description>
      </owl:onProperty>
    </owl:Restriction>
  </owl:annotatedTarget>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">All EMMO individuals are part of the most comprehensive entity which is the universe.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_22744495_4f32_4a17_b189_259c644268f9"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8587:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of a solid body, whereby the plastic state is essentially brought about by shear stress.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_eff42cb3_208e_4768_9a39_f8b6b3c3d7a2"/>
  <owl:annotatedTarget xml:lang="en">Computation</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin con- +‎ putō (“I reckon”).</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_2b9cbfb5_dbd0_4a68_9c6f_acc41b40dd72"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EN 16603-11:2019-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">application of scientific knowledge, tools, techniques, crafts, systems or methods of organization in order to solve a problem or achieve an objective</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_6ab555fd_5803_4f03_82e8_127c01aabfea"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8593-0:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The permanent joining or other bringing together of two or more workpieces of a geometric shape or of similar workpieces with shapeless material. In each case, the cohesion is created locally and increased as a whole.</owl:annotatedTarget>
</owl:Axiom>


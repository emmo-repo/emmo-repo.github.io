  <rdfs:label xml:lang="en">hasJunctionPart</rdfs:label>
  <rdfs:comment xml:lang="en">The part is connected with the rest item or members with both hasNext (or its inverse) and hasContact relations.</rdfs:comment>
  <core:altLabel xml:lang="en">hasSpatioTemporalPart</core:altLabel>
  <core:prefLabel xml:lang="en">hasJunctionPart</core:prefLabel>

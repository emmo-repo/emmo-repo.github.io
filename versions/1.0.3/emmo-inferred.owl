  <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-32</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-5.2</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Quantity characterizing the relative variation of volume V with pressure p at constant entropy.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The coherent SI unit of isentropic compressibility is pascal to the power minus one, 1/Pa.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>


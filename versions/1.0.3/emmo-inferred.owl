  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_24dda193_ada8_433b_bb74_6ca4a0b89a20"/>
  <rdfs:label xml:lang="en">Hyperon</rdfs:label>
  <rdfs:comment xml:lang="en">A baryon containing one or more strange quarks, but no charm, bottom, or top quark.</rdfs:comment>
  <core:prefLabel xml:lang="en">Hyperon</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A baryon containing one or more strange quarks, but no charm, bottom, or top quark.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This form of matter may exist in a stable form within the core of some neutron stars.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Hyperon</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Class>


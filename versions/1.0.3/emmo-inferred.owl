<rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
  <rdfs:comment xml:lang="en">EMMO applies the naming convension to its sub-properties of rdfs:seeAlso that their label must end with one of the following terms:
  - 'Match': resolvable URLs to corresponding entity in another ontology
  - 'Entry': resolvable URLs to a human readable resource describing the subject
  - 'Ref': non-resolvable reference to a human readable resource describing the subject</rdfs:comment>
  <rdfs:comment xml:lang="en">Indicate a resource that might provide additional information about the subject resource.</rdfs:comment>
</rdf:Description>

<rdfs:Datatype rdf:about="https://w3id.org/emmo#EMMO_799c067b_083f_4365_9452_1f1433b03676">
  <core:example xml:lang="en">"3 cm"</core:example>
  <core:example xml:lang="en">A more complete example showing how to specify the value of a physical quantity in turtle using this datatype:

    height1 a emmo:Height ;
        hasSIQuantityValue "3 cm"^^emmo:SIQuantityDatatype .</core:example>
  <core:prefLabel xml:lang="en">SIQuantityDatatype</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A datatype for a specifying a physcial quantity as a string consisting of a numerical, a separator and an SI unit.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The unit should be a valid, possible prefixed, derived SI unit.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</rdfs:Datatype>


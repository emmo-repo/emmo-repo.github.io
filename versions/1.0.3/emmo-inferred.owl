  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 23952:2020(en), 3.4.143</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a physical artifact, real or virtual, intended for subsequent transformation within some manufacturing operation</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>

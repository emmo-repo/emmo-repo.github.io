  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:label xml:lang="en">Gray</rdfs:label>
  <rdfs:comment xml:lang="en">SI unit for absorbed dose.</rdfs:comment>
  <core:prefLabel xml:lang="en">Gray</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A95</sche:unitCode>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/GRAY</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gy</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Grey</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">SI unit for absorbed dose.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">//en.wikipedia.org/wiki/Grey?oldid=494774160</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
  <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.G02696</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
</owl:Class>


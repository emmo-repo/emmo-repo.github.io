</owl:Restriction>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8"/>
  <owl:annotatedTarget xml:lang="en">Equipment</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From French équipement, from équiper ‘equip’.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_38b579de_4331_40e0_803d_09efa298e726"/>
  <owl:annotatedTarget xml:lang="en">PhysicalObject</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin physica "study of nature" (and Ancient Greek φυσικός, “natural”), and Medieval Latin obiectum (“object”, literally “thrown against”).</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>


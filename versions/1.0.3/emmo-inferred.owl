      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1275ac79_7280_4d99_ab61_3d98e00c053e"/>
  <rdfs:label xml:lang="en">JoulePerCubicMetreKelvin</rdfs:label>
  <rdfs:comment xml:lang="en">`Joule per Cubic Meter Kelvin` is a unit for 'Volumetric Heat Capacity' expressed as J/(m³ K).

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">Joule per Cubic Metre Kelvin</core:altLabel>
  <core:prefLabel xml:lang="en">JoulePerCubicMetreKelvin</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/J-PER-M3-K</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J.m-3.K-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J/(m³⋅K)</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">`Joule per Cubic Meter Kelvin` is a unit for 'Volumetric Heat Capacity' expressed as J/(m³ K).


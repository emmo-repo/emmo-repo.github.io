  <rdfs:label xml:lang="en">RadianPerSecond</rdfs:label>
  <rdfs:comment xml:lang="en">"Radian per Second" is the SI unit of rotational speed (angular velocity), and, also the unit of angular frequency. The radian per second is defined as the change in the orientation of an object, in radians, every second.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">radian per second</core:altLabel>
  <core:prefLabel xml:lang="en">RadianPerSecond</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/RAD-PER-SEC</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>

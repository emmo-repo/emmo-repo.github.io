<owl:Class rdf:about="https://w3id.org/emmo#EMMO_0a3f04a6_ba3a_49d9_99da_08b0e26f51f0">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel-full#"/>

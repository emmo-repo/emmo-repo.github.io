<owl:Class rdf:about="https://w3id.org/emmo#EMMO_be8592a7_68d1_4a06_ad23_82f2b56ef926">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c66ad523_3937_485e_91bb_ad488ddb373f"/>
  <rdfs:label xml:lang="en">DiscreteData</rdfs:label>
  <rdfs:comment xml:lang="en">Data whose variations are decoded according to a discrete schema.</rdfs:comment>
  <core:example xml:lang="en">A text is a collection of discrete symbols. A compact disc is designed to host discrete states in the form of pits and lands.</core:example>
  <core:prefLabel xml:lang="en">DiscreteData</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Data whose variations are decoded according to a discrete schema.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A discrete schema may be based on a continuum material basis that is filtered according to its variations. For example, a continuous voltage based signal can be considered 1 or 0 according to some threshold.
Discrete does not mean that the material basis is discrete, but that the data are encoded according to such step-based rules.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>


<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_479db031_b344_4488_9efa_4bc12c6c1765"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://de.wikipedia.org/wiki/Werkst%C3%BCck</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In manufacturing, a workpiece is a single, delimited part of largely solid material that is processed in some form (e.g. stone ).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_3e7add3d_e6ed_489a_a796_8e31fef9b490"/>
  <owl:annotatedTarget xml:lang="en">Data</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin data, nominative plural of datum (“that is given”), neuter past participle of dō (“I give”).</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_348d39f7_6a17_49d1_9860_9b33b69b51de"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.linfo.org/source_code.html</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">Source code (also referred to as source or code) is the version of software as it is originally written (i.e., typed into a computer) by a human in plain text (i.e., human readable alphanumeric characters).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_607ccc15_38aa_4a69_a70a_effa8015bf42"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-7:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengthening by rolling is the strengthening of component surfaces by mechanically generating compressive stresses in the component surface and consolidating the material.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
  <owl:annotatedTarget xml:lang="en">EMMO</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">EMMO is the acronym of Elementary Multiperspective Material Ontology.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"/>
  <owl:annotatedTarget xml:lang="en">Item</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin item, "likewise, just so, moreover".</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"/>

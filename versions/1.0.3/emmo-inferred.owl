<owl:Class rdf:about="https://w3id.org/emmo#EMMO_ea7ef02a_589c_4971_908d_dee6688eebda">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_04cc9451_5306_45d0_8554_22cee4d6e785"/>
  <rdfs:label xml:lang="en">MutualInductance</rdfs:label>
  <rdfs:comment xml:lang="en">Given an electric current in a thin conducting loop and the linked flux caused by that electric current in another loop, the mutual inductance of the two loops is the linked flux divided by the electric current.</rdfs:comment>
  <core:prefLabel xml:lang="en">MutualInductance</core:prefLabel>
  <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q78101401</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
  <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-12-36</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-41.2</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Given an electric current in a thin conducting loop and the linked flux caused by that electric current in another loop, the mutual inductance of the two loops is the linked flux divided by the electric current.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.M04076</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
</owl:Class>


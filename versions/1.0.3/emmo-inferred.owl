  <rdfs:seeAlso xml:lang="en">https://en.wiktionary.org/wiki/Wiktionary</rdfs:seeAlso>
  <owl:annotatedTarget xml:lang="en">Definitions are usually taken from Wiktionary.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_214e9a99_58de_40e2_86cf_fa6aa1d180a8"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8585-3:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widening is tensile forming to increase the circumference of a hollow body. A distinction is made between: Widening, bulging.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_8681074a_e225_4e38_b586_e85b0f43ce38"/>
  <owl:annotatedTarget xml:lang="en">Software</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From soft +‎ -ware, by contrast with hardware (“the computer itself”). Coined by Paul Niquette in 1953.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_0c7ad550_00ae_45ff_a4e2_58d6a61f48eb"/>
  <owl:annotatedTarget xml:lang="en">A supply chain is a system of organizations, people, activities, information, and resources involved in supplying a product or service to a consumer.</owl:annotatedTarget>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Supply_chain</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Axiom>


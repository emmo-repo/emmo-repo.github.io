  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.bipm.org/documents/20126/2071204/JCGM_200_2012.pdf</rdfs:seeAlso>
  <core:example xml:lang="en">quantity value (term in VIM that corresponds to Quantity in EMMO)</core:example>
  <core:prefLabel xml:lang="en">VIMTerm</core:prefLabel>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The term in the International vocabulary of metrology (VIM) (JCGM 200:2008) that corresponds to the annotated term in EMMO.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:AnnotationProperty>


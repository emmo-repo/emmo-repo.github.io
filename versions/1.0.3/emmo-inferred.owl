  <rdfs:label xml:lang="en">AngularDisplacement</rdfs:label>
  <rdfs:comment xml:lang="en">The angle through which a body rotates around an axis of rotation.</rdfs:comment>
  <core:altLabel xml:lang="en">Angular displacement may be signed, indicating the sense of rotation (e.g., clockwise); it may also be greater (in absolute value) than a full turn.</core:altLabel>
  <core:altLabel xml:lang="en">Rotation</core:altLabel>
  <core:prefLabel xml:lang="en">AngularDisplacement</core:prefLabel>
  <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q76435127</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
  <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=102-05-22</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-14</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The angle through which a body rotates around an axis of rotation.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Angular displacement may also be defined as number of turns (not necessarily an integer number).</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>


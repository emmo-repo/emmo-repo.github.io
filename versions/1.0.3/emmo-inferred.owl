<owl:Class rdf:about="https://w3id.org/emmo#EMMO_a3c78d6f_ae49_47c8_a634_9b6d86b79382">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_3f15d200_c97b_42c8_8ac0_d81d150361e2"/>

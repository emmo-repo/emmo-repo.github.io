  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8c537c06_8e1d_4a3b_a251_1c89bb2c4790"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_8c537c06_8e1d_4a3b_a251_1c89bb2c4790"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">Replica</rdfs:label>
  <rdfs:comment xml:lang="en">An icon that not only resembles the object, but also can express some of the object's functions.</rdfs:comment>
  <core:example xml:lang="en">A small scale replica of a plane tested in a wind gallery shares the same functionality in terms of aerodynamic behaviour of the bigger one.</core:example>
  <core:example xml:lang="en">Pinocchio is a functional icon of a boy since it imitates the external behaviour without having the internal biological structure of a human being (it is made of magic wood...).</core:example>
  <core:prefLabel xml:lang="en">Replica</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An icon that not only resembles the object, but also can express some of the object's functions.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#EMMO_066937f0_ea5c_4b06_8739_53f66d5ef89e">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>

    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_53bd0c90_41c3_46e2_8779_cd2a80f7e18b"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
  <rdfs:label xml:lang="en">Pascal</rdfs:label>
  <rdfs:comment xml:lang="en">SI unit for pressure.</rdfs:comment>
  <core:prefLabel xml:lang="en">Pascal</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAL</sche:unitCode>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PA</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dbpedia.org/resource/Pascal</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">SI unit for pressure.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one newton per square meter or one "kilogram per meter per second per second." The unit is named for Blaise Pascal (1623-1662), French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude.

-- QUDT</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Pascal?oldid=492989202</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
  <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.P04442</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
</owl:Class>


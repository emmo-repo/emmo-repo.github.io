  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-41.1</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>

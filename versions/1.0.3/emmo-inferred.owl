  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8f3a9f9f_6f56_49dc_b39e_1aee57ffdc58"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_a3a701ed_6f7d_4a10_9aee_dfa1961fc7b7"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MilliGramPerCubicMetrePerSecond</rdfs:label>

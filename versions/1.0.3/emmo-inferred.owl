  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ban</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A ban is a logarithmic unit which measures information or entropy, based on base 10 logarithms and powers of 10, rather than the powers of 2 and base 2 logarithms which define the bit. One ban is approximately 3.32 (log₂ 10) bits.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Ban?oldid=472969907</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>

  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_b3600e73_3e05_479d_9714_c041c3acf5cc"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FemtoMetre</rdfs:label>
  <rdfs:comment xml:lang="en">The `femtometre` is an SI unit of length equal to 10⁻¹⁵ meter. This distance can also be called `fermi` and was so named in honour of Enrico Fermi. It is often encountered in nuclear physics as a characteristic of this scale. The symbol for the fermi is also fm.

-- QUDT</rdfs:comment>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FemtoMetre</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/FemtoM</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fm</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fm</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The `femtometre` is an SI unit of length equal to 10⁻¹⁵ meter. This distance can also be called `fermi` and was so named in honour of Enrico Fermi. It is often encountered in nuclear physics as a characteristic of this scale. The symbol for the fermi is also fm.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


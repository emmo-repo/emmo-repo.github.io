  <owl:annotatedTarget xml:lang="en">TangibleProduct</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From late Latin tangibilis, from tangere ‘to touch’.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>


  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdfs:label xml:lang="en">Acre</rdfs:label>
  <rdfs:comment xml:lang="en">The acre is a unit of area in a number of different systems, including the imperial and U.S. customary systems. Its international symbol is ac. The most commonly used acres today are the international acre and, in the United States, the survey acre. The most common use of the acre is to measure tracts of land. One international acre is equal to 4046.8564224 square metres.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:prefLabel xml:lang="en">Acre</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/AC</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>

  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_cbcf8fe6_6da6_49e0_ab4d_00f737ea9689"/>

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_2eb10b5b_900b_44d7_af85_4de9a3729474">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/persholistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591"/>

  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Dimensionless scalar value which describes the ratio of the force of friction between two bodies and the force pressing them together; depends on the materials used, ranges from near zero to greater than one.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.F02530</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>

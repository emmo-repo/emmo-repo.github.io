  <rdfs:label xml:lang="en">hasDistinctPart</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]</rdfs:comment>
  <rdfs:comment xml:lang="en">The superproperty of all object property relations between an entity and one of its proper parts that belongs to different taxonomical branch.</rdfs:comment>
  <core:example xml:lang="en">A molecule is a distinct part of a fluid.</core:example>
  <core:prefLabel xml:lang="en">hasDistinctPart</core:prefLabel>
  <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The superproperty of all object property relations between an entity and one of its proper parts that belongs to different taxonomical branch.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A part is always distinct xor redundant.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:ObjectProperty>


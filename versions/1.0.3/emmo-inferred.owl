  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_7efab93d_c8fe_49c7_ba8e_d21d13b38c85"/>
  <rdfs:label xml:lang="en">hasTemporalTile</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that establishes for the whole a univocal tessellation in temporal parts forming the tessellation.</rdfs:comment>
  <core:altLabel xml:lang="en">hasTemporalDirectPart</core:altLabel>
  <core:prefLabel xml:lang="en">hasTemporalTile</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that establishes for the whole a univocal tessellation in temporal parts forming the tessellation.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#EMMO_55354438_7000_4284_b1b9_59d60c2261b9">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#76413949_896c_4363_a955_de4722c6e149"/>
  <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#EMMO_c37d451b_e245_439f_bd94_9050e04ec9f7"/>
  <rdfs:label xml:lang="en">hasPortionPart</rdfs:label>
  <rdfs:comment xml:lang="en">A proper part relation with domain restricted to items.</rdfs:comment>
  <core:prefLabel xml:lang="en">hasPortionPart</core:prefLabel>
  <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">A proper part relation with domain restricted to items.</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A part of an item is always non-maximal, meaning that is causally connected with the rest.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#EMMO_571a8adb_f38f_4122_8754_044ea2490cd0">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598"/>
  <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_7821eeb8_5e44_452b_90e9_3db03bbef241"/>
  <rdfs:label xml:lang="en">processedTo</rdfs:label>
  <rdfs:comment xml:lang="en">An indirect causal relation that relates the input of a process to its output.</rdfs:comment>
  <core:altLabel xml:lang="en">isProcessedTo</core:altLabel>
  <core:prefLabel xml:lang="en">processedTo</core:prefLabel>

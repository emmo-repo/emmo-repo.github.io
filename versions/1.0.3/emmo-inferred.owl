      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_846b637b_7b12_47a1_9430_0274b2f588ac"/>
  <rdfs:label xml:lang="en">Behaviour</rdfs:label>

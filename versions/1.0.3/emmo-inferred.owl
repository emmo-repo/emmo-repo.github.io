    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_da27d905_beb6_44ea_a330_a2dd9c17b263"/>

  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88"/>
  <rdfs:label xml:lang="en">Btu_Th_Per_Lb</rdfs:label>
  <rdfs:comment xml:lang="en">'Btu_th / lbm', British Thermal Unit (therm.) Per Pound Mass, is a unit in the category of Thermal heat capacity. It is also known as Btu per pound, Btu/pound, Btu/lb. This unit is commonly used in the UK unit system. British Thermal Unit (therm.) Per Pound Mass (Btu (therm.)/lbm) has a dimension of L²T⁻² where L is length, and T is time. It can be converted to the corresponding standard SI unit J/kg by multiplying its value by a factor of 2324.443861.

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--thermal_heat_capacity--british_thermal_unit_therm_per_pound_mass.cfm</rdfs:seeAlso>
  <core:altLabel xml:lang="en">British Thermal Unit (TH) Per Pound</core:altLabel>
  <core:prefLabel xml:lang="en">Btu_Th_Per_Lb</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/BTU_TH-PER-LB</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_th].[lb_av]-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_th]/[lb_av]</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">btu{th}/lb</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">'Btu_th / lbm', British Thermal Unit (therm.) Per Pound Mass, is a unit in the category of Thermal heat capacity. It is also known as Btu per pound, Btu/pound, Btu/lb. This unit is commonly used in the UK unit system. British Thermal Unit (therm.) Per Pound Mass (Btu (therm.)/lbm) has a dimension of L²T⁻² where L is length, and T is time. It can be converted to the corresponding standard SI unit J/kg by multiplying its value by a factor of 2324.443861.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


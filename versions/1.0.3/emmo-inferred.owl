  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_2d2ecd97_067f_4d0e_950c_d746b7700a31"/>

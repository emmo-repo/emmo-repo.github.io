  <rdfs:label xml:lang="en">Suspension</rdfs:label>
  <rdfs:comment xml:lang="en">An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase.</rdfs:comment>
  <rdfs:comment xml:lang="en">Suspensions show no significant effect on light.</rdfs:comment>
  <core:prefLabel xml:lang="en">Suspension</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


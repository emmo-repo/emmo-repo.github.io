  <rdfs:label xml:lang="en">SecondSquareFoot</rdfs:label>
  <rdfs:comment xml:lang="en">"Second Square Foot" is an Imperial unit for  'Area Time' expressed as s-ft².

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>

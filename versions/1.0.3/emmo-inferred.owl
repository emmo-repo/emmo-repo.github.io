  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Relates a substance to one of its chemical species.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_51f426a6_af4a_4e91_a392_2b0bb635e2d5">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_7efd64d1_05a1_49cd_a7f0_783ca050d4f3"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b"/>
  <rdfs:label xml:lang="en">hasChemicalComposition</rdfs:label>
  <rdfs:comment xml:lang="en">Relates a substance to chemical composition.</rdfs:comment>
  <core:example xml:lang="en">This relation can be used to relate a material to a chemical composition quantity of one of its chemical species. For example, the amount of aluminium in substance subst:alloy1 can be expressed as:

```turtle
subst:alloy1 a emmo:Substance ;
    emmo:hasChemicalComposition [
        a emmo:SingleComponentComposition ;
        emmo:hasSpeciesPart [ a emmo:AluminiumSymbol ] ;
        emmo:hasQuantityPart [
            a emmo:MassFraction ;
            hasSIQuantityValue "98.1 wt%"^^emmo:SIQuantityDatatype
        ]
    ] .
```</core:example>
  <core:prefLabel xml:lang="en">hasChemicalComposition</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Relates a substance to chemical composition.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This property is often used to relate a substance directly to SingleComponentComposition indifiduals for each of its components.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:ObjectProperty>


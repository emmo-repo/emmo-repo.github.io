      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.660539e-27</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a"/>
  <rdfs:label xml:lang="en">Dalton</rdfs:label>
  <rdfs:comment xml:lang="en">One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state.</rdfs:comment>
  <rdfs:comment xml:lang="en">The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a "non-SI unit whose values in SI units must be obtained experimentally".

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:altLabel xml:lang="en">AtomicMassUnit</core:altLabel>
  <core:prefLabel xml:lang="en">Dalton</core:prefLabel>
  <sche:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D43</sche:unitCode>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/vocab/unit/Da</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dbpedia.org/page/Unified_atomic_mass_unit</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
  <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state.</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amu</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a "non-SI unit whose values in SI units must be obtained experimentally".

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Atomic_mass_unit</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
  <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.D01514</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
</owl:Class>


  <rdfs:label xml:lang="en">isPartOf</rdfs:label>
  <rdfs:comment xml:lang="en">Reflexivity: Pxx
Transitivity: (Pxy ∧ Pyz) → Pxz
Antisymmetry: (Pxy ∧ Pyx) → x=y.</rdfs:comment>
  <rdfs:comment xml:lang="en">The inverse relation of hasPart.</rdfs:comment>
  <core:prefLabel xml:lang="en">isPartOf</core:prefLabel>
  <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">Reflexivity: Pxx
Transitivity: (Pxy ∧ Pyz) → Pxz
Antisymmetry: (Pxy ∧ Pyx) → x=y.</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The inverse relation of hasPart.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:ObjectProperty>


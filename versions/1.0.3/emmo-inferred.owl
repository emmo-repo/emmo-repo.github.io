<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
  <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">This axiom reflects the fact the the universe is causally self-connected. In fact, a  non causally connected universe would have been the sum of causally independend sub-universes, without any knowledge of others.
This axiom may be seen as Ockam's razor applied to causality.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
</owl:Axiom>

<owl:Restriction>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_aa972cc9_5d9e_47a2_abc5_00243d6b3917"/>
  <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_b6292331_94af_4f00_976b_ea55960c2f1c"/>
  <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
</owl:Restriction>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3"/>
  <owl:annotatedTarget xml:lang="en">Role</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From French rôle, from obsolete French roule ‘roll’, referring originally to the roll of paper on which the actor's part was written.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_7cd8a4ec_b219_498e_b696_028257163aa4"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO/TR 10809-1:2009, 0000_19</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heat treatment process that generally produces martensite in the matrix.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_c74da218_9147_4f03_92d1_8894abca55f3"/>
  <owl:annotatedTarget xml:lang="en">Graphical</owl:annotatedTarget>
  <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From the Ancient Greek γραφή (graphḗ) which means drawing, painting, writing, a writing, description, and from γράφω (gráphō) which means scratch, carve.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The term graphical is used in etymological sense, comprising both writings and visual arts.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Axiom>


  <rdfs:seeAlso xml:lang="en">https://www.iso.org/obp/ui/#iso:std:iso:80000:-1:ed-1:v1:en</rdfs:seeAlso>
  <core:example xml:lang="en">3-1.1  (ISO80000 reference to length)</core:example>
  <core:prefLabel xml:lang="en">ISO80000Reference</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Corresponding item number in ISO 80 000.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:AnnotationProperty>


  <owl:annotatedTarget xml:lang="en">A path is a string of characters used to uniquely identify a location in a directory structure according to a particular convention.</owl:annotatedTarget>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Path_(computing)#Universal_Naming_Convention</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Axiom>


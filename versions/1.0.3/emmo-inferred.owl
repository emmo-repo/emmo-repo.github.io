  <rdfs:label xml:lang="en">SpecialUnit</rdfs:label>
  <rdfs:comment xml:lang="en">A unit symbol that stands for a derived unit.</rdfs:comment>
  <rdfs:comment xml:lang="en">Special units are semiotic shortcuts to more complex composed symbolic objects.</rdfs:comment>
  <core:example xml:lang="en">Pa stands for N/m2
J stands for N m</core:example>

  <core:prefLabel xml:lang="en">PositionVector</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/vocab/quantitykind/PositionVector</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q192388</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
  <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=102-03-15</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
  <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Position_(geometry)</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-1.10</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Vector quantity from the origin of a coordinate system to a point in space.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In the usual geometrical three-dimensional space, position vectors are quantities of the dimension length.

-- IEC</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Position vectors are so-called bounded vectors, i.e. their magnitude and direction depend on the particular coordinate system used.

-- ISO 80000-3</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Position_(geometry)</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Class>


  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3"/>

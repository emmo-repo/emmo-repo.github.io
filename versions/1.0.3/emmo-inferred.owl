<owl:Class rdf:about="https://w3id.org/emmo#EMMO_8ef46550_7bf2_4ef9_8334_ca3d63fb69b1">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c995ae70_3b84_4ebb_bcfc_69e6a281bb88"/>
  <rdfs:label xml:lang="en">ElectricCurrentPhasor</rdfs:label>
  <rdfs:comment xml:lang="en">A representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value.</rdfs:comment>
  <core:prefLabel xml:lang="en">ElectricCurrentPhasor</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectricCurrentPhasor</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q78514596</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
  <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-49</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they can often reduce a differential equation problem to an algebraic one.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
</owl:Class>


  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_b14d9be5_f81e_469b_abca_379c2e83feab"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MicroFarad</rdfs:label>
  <rdfs:comment xml:lang="en">The "microfarad" (symbolized μ F) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of 1 μ F or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used.

-- QUDT</rdfs:comment>
  <core:altLabel xml:lang="en">microfarad</core:altLabel>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MicroFarad</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/MicroFARAD</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uF</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">µF</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The "microfarad" (symbolized μ F) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of 1 μ F or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#EMMO_57d977ab_0036_4779_b59a_e47620afdb9c">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_0f3e0646_4f06_4588_9779_6a4f05c5a8d6"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#EMMO_801395f8_948e_4637_ac3b_5fcd587d72ca"/>
  <rdfs:label xml:lang="en">CompositePhysicalObject</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The class of physical objects possessing a structure that is larger than a single composite particle, for which its bosonic or fermionic nature is undetermined.</rdfs:comment>
  <rdfs:comment xml:lang="en">A composite physical object is made of bonded objects (i.e. characterised by their quantum states using a Schrodinger equation approach) that are connected together by elementary particles travelling between them. These elemenentary particles are real particles, describing the existance of a classical field (e.g. Coulomb potential between charged particles).</rdfs:comment>
  <core:prefLabel xml:lang="en">CompositePhysicalObject</core:prefLabel>
  <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A composite physical object is made of bonded objects (i.e. characterised by their quantum states using a Schrodinger equation approach) that are connected together by elementary particles travelling between them. These elemenentary particles are real particles, describing the existance of a classical field (e.g. Coulomb potential between charged particles).</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The class of physical objects possessing a structure that is larger than a single composite particle, for which its bosonic or fermionic nature is undetermined.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:Class>


  <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This owl:ObjectProperty is, like its super property, a mere collector of direct parthoods that manifest a spatiotemporal meaningful shape.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>

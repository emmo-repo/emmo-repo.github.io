  <rdfs:label xml:lang="en">hasHeterogenousPart</rdfs:label>
  <rdfs:comment xml:lang="en">The part is not connected with the rest item or members with hasNext (or its inverse) only or hasContact relations only.</rdfs:comment>
  <core:prefLabel xml:lang="en">hasHeterogenousPart</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The part is not connected with the rest item or members with hasNext (or its inverse) only or hasContact relations only.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:ObjectProperty>


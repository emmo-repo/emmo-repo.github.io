  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_11501e0a_4442_4bd0_8483_7ea6dc8ba444"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_2a28c0dd_89b1_47ac_b81f_fccc56f39617"/>
  <rdfs:label xml:lang="en">follows</rdfs:label>

  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
  <rdfs:label xml:lang="en">Erg</rdfs:label>
  <rdfs:comment xml:lang="en">An erg is the unit of energy and mechanical work in the centimetre-gram-second (CGS) system of units, symbol 'erg'. Its name is derived from the Greek ergon, meaning 'work'. An erg is the amount of work done by a force of one dyne exerted for a distance of one centimeter. In the CGS base units, it is equal to one gram centimeter-squared per second-squared (g · cm²/s²). It is thus equal to 10⁻⁷ joules or 100 nanojoules in SI units. 1 erg = 10⁻⁷ J = 100 nJ,  1 erg = 624.15 GeV = 6.2415 × 10¹¹ eV, 1 erg = 1 dyne· cm = 1 g · cm²/s².

-- QUDT</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
  <core:prefLabel xml:lang="en">Erg</core:prefLabel>
  <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/ERG</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">erg</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
  <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">erg</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An erg is the unit of energy and mechanical work in the centimetre-gram-second (CGS) system of units, symbol 'erg'. Its name is derived from the Greek ergon, meaning 'work'. An erg is the amount of work done by a force of one dyne exerted for a distance of one centimeter. In the CGS base units, it is equal to one gram centimeter-squared per second-squared (g · cm²/s²). It is thus equal to 10⁻⁷ joules or 100 nanojoules in SI units. 1 erg = 10⁻⁷ J = 100 nJ,  1 erg = 624.15 GeV = 6.2415 × 10¹¹ eV, 1 erg = 1 dyne· cm = 1 g · cm²/s².

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Erg?oldid=490293432</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
</owl:Class>


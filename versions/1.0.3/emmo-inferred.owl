  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f53f45f2_c354_417c_a904_a2606ad584d7"/>

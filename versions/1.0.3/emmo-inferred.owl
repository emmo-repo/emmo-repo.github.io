  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
  <rdfs:label xml:lang="en">CaloriePerGramDegreeCelsius</rdfs:label>
  <rdfs:comment xml:lang="en">`Calorie per Gram Degree Celsius` is a unit for 'Specific Heat Capacity' expressed as kcal/(gm-degC).

-- QUDT</rdfs:comment>

emmo:EMMO_b295158f_fda4_4124_ab58_d9ea4ccfca5a rdfs:label "GenericPhysicalSystem"@en .

emmo:EMMO_b32fe85d_2f7b_4972_9dd7_7cf20d4bba59 rdfs:label "PhysicalParticleByBond"@en .

emmo:EMMO_b418c9ac_be7c_42d1_862c_64f655ced6c5 a owl:Class ;
    rdfs:label "ArtificialMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_ddb62e5b_9a1f_4d10_8cd8_32655301bfc9 ;
    skos:prefLabel "ArtificialMaterial"@en .

emmo:EMMO_c5e9e390_8836_4440_b4fd_c906fdd4f438 a owl:Class ;
    rdfs:label "CeramicMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_4db521a3_f80f_436b_b9c7_e4b52b1383ea ;
    skos:altLabel "Ceramic"@en ;
    skos:prefLabel "CeramicMaterial"@en ;
    emmo:elucidation "An inorganic non-metallic solid made from elements (metals, non-metals, semi-metals like silicon) combined into compounds (oxides, carbides, nitrides) that are typically hard, strong, brittle, corrosion-resistant, and good insulators."@en ;
    emmo:note "Ceramic materials are hardened by intense heat and typically used from pottery and tiles to advanced electronics and aerospace parts."@en .

emmo:EMMO_d69d2e95_b22f_499a_a552_17fde0d778fc a owl:Class ;
    rdfs:label "LiquidFoam"@en ;
    rdfs:subClassOf emmo:EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018,
        emmo:EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
    skos:prefLabel "LiquidFoam"@en ;
    emmo:elucidation "A foam of trapped gas in a liquid."@en .

emmo:EMMO_d8a7aac9_984a_4254_ab3b_7d8b1c061149 a owl:Class ;
    rdfs:label "MaterialByForceResponse"@en ;
    rdfs:subClassOf emmo:EMMO_4207e895_8b83_4318_996a_72cfb32acd94 ;
    skos:prefLabel "MaterialByForceResponse"@en .

emmo:EMMO_e4281979_2b07_4a43_a772_4903fb3696fe a owl:Class ;
    rdfs:label "Dust"@en ;
    rdfs:subClassOf emmo:EMMO_d4f37e32_16ae_4cc6_b4cd_fd896b2449c4 ;
    skos:prefLabel "Dust"@en ;
    emmo:elucidation "A suspension of fine particles in the atmosphere."@en .

emmo:EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac rdfs:label "CausalSystem"@en .

emmo:EMMO_f678173d_f036_4df1_a86b_2894560be617 a owl:Class ;
    rdfs:label "CompositeMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_4db521a3_f80f_436b_b9c7_e4b52b1383ea ;
    skos:altLabel "Composite"@en ;
    skos:prefLabel "CompositeMaterial"@en ;
    emmo:elucidation "A material that contains two or more constituent materials."@en .

emmo:EMMO_fb27e6d6_159e_48a6_9c29_76dc31d8a860 a owl:Class ;
    rdfs:label "PolymericMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_4db521a3_f80f_436b_b9c7_e4b52b1383ea ;
    skos:prefLabel "PolymericMaterial"@en ;
    emmo:elucidation "A substance made of macromolecules formed by linking many smaller, repeating chemical units called monomers into long chains or networks, resulting in unique properties like toughness, elasticity, or flexibility, found in both natural forms (like DNA, protein) and synthetic plastics, rubbers, and fibers."@en .

<https://w3id.org/emmo/disciplines/materials> a owl:Ontology ;
    dcterms:abstract "The materials module populates the physicalistic perspective with materials subclasses categorised according to modern applied physical sciences."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-7815-6636> ;
    dcterms:creator <https://orcid.org/0000-0002-1560-809X>,
        <https://orcid.org/0000-0002-4181-2852>,
        <https://orcid.org/0000-0003-0514-9229>,
        <https://orcid.org/0000-0003-3805-8761>,
        <https://orcid.org/0000-0003-4065-9742> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "Materials"@en ;
    rdfs:comment "The EMMO requires HermiT reasoner plugin in order to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.0.4/reference/physicalistic> ;
    owl:versionIRI <https://w3id.org/emmo/1.0.4/disciplines/materials> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    emmo:contact "emmo@emmc.eu"^^xsd:string .


    owl:versionIRI <https://w3id.org/emmo/1.0.4/hume/disciplines/units/coherentsiunits> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    ns1:contact "emmo@emmc.eu"^^xsd:string .


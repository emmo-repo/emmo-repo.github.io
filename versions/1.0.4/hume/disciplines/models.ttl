@prefix : <https://w3id.org/emmo/hume/disciplines/models#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#> .
@prefix ns2: <https://w3id.org/emmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:DataBasedSimulationSoftware a owl:Class ;
    rdfs:label "DataBasedSimulationSoftware"@en ;
    rdfs:subClassOf ns2:SimulationSoftware ;
    skos:prefLabel "DataBasedSimulationSoftware"@en ;
    ns2:elucidation "A computational application that uses existing data to predict the behaviour of a system without providing a identifiable analogy with the original object."@en .

ns2:DataProcessing a owl:Class ;
    rdfs:label "DataProcessing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasParticipant ;
            owl:someValuesFrom ns2:DataProcessingSoftware ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasInput ;
            owl:someValuesFrom ns2:DiscreteData ],
        [ a owl:Restriction ;
            owl:onProperty ns2:hasOutput ;
            owl:someValuesFrom ns2:DiscreteData ],
        ns2:Computation ;
    skos:prefLabel "DataProcessing"@en ;
    ns2:elucidation "A computation that provides a data output following the elaboration of some input data, using a data processing application."@en .

ns2:DigitalData rdfs:label "DigitalData"@en .

ns2:EmpiricalSimulationSoftware a owl:Class ;
    rdfs:label "EmpiricalSimulationSoftware"@en ;
    rdfs:subClassOf ns2:SimulationSoftware ;
    skos:prefLabel "EmpiricalSimulationSoftware"@en ;
    ns2:elucidation "A computational application that uses an empiric equation to predict the behaviour of a system without relying on the knowledge of the actual physical phenomena occurring in the object."@en .

ns2:Experiment a owl:Class ;
    rdfs:label "Experiment"@en ;
    rdfs:subClassOf ns2:Observation,
        ns2:Process ;
    skos:prefLabel "Experiment"@en ;
    ns2:elucidation "An experiment is a process that is intended to replicate a physical phenomenon in a controlled environment."@en .

ns2:Guess a owl:Class ;
    rdfs:label "Guess"@en ;
    rdfs:subClassOf ns2:Estimated,
        ns2:Subjective,
        ns2:Theory ;
    skos:prefLabel "Guess"@en ;
    ns2:elucidation "A guess is a theory, estimated and subjective, since its premises are subjective."@en .

ns2:Hypothesis a owl:Class ;
    rdfs:label "Hypothesis"@en ;
    rdfs:subClassOf ns2:Estimated,
        ns2:Objective,
        ns2:Theory ;
    skos:prefLabel "Hypothesis"@en ;
    ns2:elucidation "A hypothesis is a theory, estimated and objective, since its estimated premises are objective."@en .

ns2:Index skos:altLabel "Signal"@en .

ns2:LinkedModelsSimulation a owl:Class ;
    rdfs:label "LinkedModelsSimulation"@en ;
    rdfs:subClassOf ns2:MultiSimulation ;
    skos:prefLabel "LinkedModelsSimulation"@en ;
    ns2:elucidation "A chain of linked physics based model simulations, where equations are solved sequentially."@en .

ns2:MaterialLaw a owl:Class ;
    rdfs:label "MaterialLaw"@en ;
    rdfs:subClassOf ns2:NaturalLaw ;
    skos:prefLabel "MaterialLaw"@en ;
    ns2:elucidation "A law that provides a connection between a material property and other properties of the object."@en .

ns2:MaterialRelationComputation a owl:Class ;
    rdfs:label "MaterialRelationComputation"@en ;
    rdfs:subClassOf ns2:PhysicsMathematicalComputation ;
    skos:prefLabel "MaterialRelationComputation"@en .

ns2:PhysicalBasedSimulationSoftware a owl:Class ;
    rdfs:label "PhysicalBasedSimulationSoftware"@en ;
    rdfs:subClassOf ns2:SimulationSoftware ;
    skos:prefLabel "PhysicalBasedSimulationSoftware"@en ;
    ns2:elucidation "A computational application that uses a physical model to predict the behaviour of a system, providing a identifiable analogy with the original object."@en .

ns2:PhysicalLaw a owl:Class ;
    rdfs:label "PhysicalLaw"@en ;
    rdfs:subClassOf ns2:NaturalLaw ;
    skos:prefLabel "PhysicalLaw"@en ;
    ns2:elucidation "A law that provides a connection between a property of the object and other properties, capturing a fundamental physical phenomena."@en .

ns2:PhysicsEquationSolution a owl:Class ;
    rdfs:label "PhysicsEquationSolution"@en ;
    rdfs:comment """This must be a mathematical function v(t), x(t).
A dataset as solution is a conventional sign."""@en ;
    rdfs:subClassOf ns2:Mathematical ;
    skos:example "A parabolic function is a prediction of the trajectory of a falling object in a gravitational field. While it has predictive capabilities it lacks of an analogical character, since it does not show the law behind that trajectory."@en ;
    skos:prefLabel "PhysicsEquationSolution"@en ;
    ns2:elucidation "A function solution of a physics equation that provides a methods for the prediction of some quantitiative properties of an object."@en .

ns2:Replica a owl:Class ;
    rdfs:label "Replica"@en ;
    rdfs:subClassOf ns2:Icon ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:ResemblanceIcon ns2:FunctionalIcon ) ] ;
    skos:example "A small scale replica of a plane tested in a wind gallery shares the same functionality in terms of aerodynamic behaviour of the bigger one."@en,
        "Pinocchio is a functional icon of a boy since it imitates the external behaviour without having the internal biological structure of a human being (it is made of magic wood...)."@en ;
    skos:prefLabel "Replica"@en ;
    ns2:elucidation "An icon that not only resembles the object, but also can express some of the object's functions."@en .

ns2:StandaloneModelSimulation a owl:Class ;
    rdfs:label "StandaloneModelSimulation"@en ;
    rdfs:subClassOf ns2:PhysicsBasedSimulation ;
    skos:prefLabel "StandaloneModelSimulation"@en ;
    ns2:elucidation "A standalone simulation, where a single physics equation is solved."@en .

ns2:Theorisation a owl:Class ;
    rdfs:label "Theorisation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:isParticipatedBy ;
            owl:someValuesFrom ns2:Theory ],
        ns2:Determination ;
    skos:altLabel "Theorization"@en ;
    skos:prefLabel "Theorisation"@en ;
    ns2:elucidation "The 'semiosis' process of interpreting a 'physical' and provide a complec sign, 'theory' that stands for it and explain it to another interpreter."@en .

ns2:hasModel a owl:ObjectProperty ;
    rdfs:label "hasModel"@en ;
    ns1:python_name "hasModel"@en ;
    rdfs:range ns2:MathematicalModel ;
    rdfs:subPropertyOf ns2:hasIcon ;
    skos:altLabel "hasMathematicalModel"@en ;
    skos:prefLabel "hasModel"@en ;
    ns2:elucidation "A semiotic relation that connects a recognised semiotic object to a mathematical model in a cognition process."@en ;
    ns2:note """This relation can e.g. be used to relate a computation to the mathematical model that is evaluated by the computation.

Another use is to relate a dataset to the mathematical model used to calculate the dataset."""@en .

ns2:hasSimulatedObject a owl:ObjectProperty ;
    rdfs:label "hasSimulatedObject"@en ;
    ns1:python_name "hasSimulatedObject"@en ;
    rdfs:domain ns2:Simulation ;
    rdfs:subPropertyOf ns2:hasReferent ;
    skos:prefLabel "hasSimulatedObject"@en ;
    ns2:elucidation "Relates a simulation to the object or system that is simulated."@en .

ns2:isComputedBy a owl:ObjectProperty ;
    rdfs:label "isComputedBy"@en ;
    ns1:python_name "isComputedBy"@en ;
    rdfs:subPropertyOf ns2:isParticipatedBy ;
    owl:inverseOf ns2:computes ;
    skos:prefLabel "isComputedBy"@en .

: a owl:Ontology ;
    dcterms:abstract "The models module defines models as semiotic signs that stands for an object by resembling or imitating it, in shape or by sharing a similar logical structure."@en ;
    dcterms:creator <https://orcid.org/AdhamHashibon>,
        <https://orcid.org/EmanueleGhedini>,
        <https://orcid.org/GeorgSchmitz>,
        <https://orcid.org/GerhardGoldbeck>,
        <https://orcid.org/JesperFriis> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    dcterms:publisher <https://emmc.eu> ;
    dcterms:title "Models"@en ;
    rdfs:comment "The EMMO requires HermiT reasoner plugin in order to visualize all inferences and class hierarchy (ctrl+R hotkey in Protege)."@en ;
    owl:imports <https://w3id.org/emmo/1.0.4/disciplines/computerscience>,
        <https://w3id.org/emmo/1.0.4/disciplines/math>,
        <https://w3id.org/emmo/1.0.4/disciplines/metrology>,
        <https://w3id.org/emmo/1.0.4/perspectives/persistence>,
        <https://w3id.org/emmo/1.0.4/reference/data>,
        <https://w3id.org/emmo/1.0.4/reference/workflow> ;
    owl:versionIRI <https://w3id.org/emmo/1.0.4/hume/disciplines/models> ;
    owl:versionInfo "1.0.4"^^xsd:string ;
    ns2:contact "emmo@emmc.eu"^^xsd:string .

ns2:AtomisticModel a owl:Class ;
    rdfs:label "AtomisticModel"@en ;
    rdfs:subClassOf ns2:MaterialsModel ;
    skos:prefLabel "AtomisticModel"@en ;
    ns2:elucidation "A physics-based model based on a physics equation describing the behaviour of atoms."@en .

ns2:ContinuumModel a owl:Class ;
    rdfs:label "ContinuumModel"@en ;
    rdfs:subClassOf ns2:MaterialsModel ;
    skos:prefLabel "ContinuumModel"@en ;
    ns2:elucidation "A physics-based model based on a physics equation describing the behaviour of continuum volume."@en .

ns2:DataProcessingSoftware a owl:Class ;
    rdfs:label "DataProcessingSoftware"@en ;
    rdfs:subClassOf ns2:ApplicationProgram ;
    skos:altLabel "DataProcessingApplication"@en ;
    skos:prefLabel "DataProcessingSoftware"@en ;
    ns2:elucidation "An application program aimed for data processing."@en .

ns2:ElectronicModel a owl:Class ;
    rdfs:label "ElectronicModel"@en ;
    rdfs:subClassOf ns2:MaterialsModel ;
    skos:example """Density functional theory.
Hartree-Fock."""@en ;
    skos:prefLabel "ElectronicModel"@en ;
    ns2:elucidation "A physics-based model based on a physics equation describing the behaviour of electrons."@en .

ns2:IterativeCoupledModelsSimulation a owl:Class ;
    rdfs:label "IterativeCoupledModelsSimulation"@en ;
    rdfs:subClassOf ns2:Coupled ;
    skos:prefLabel "IterativeCoupledModelsSimulation"@en ;
    ns2:elucidation "A chain of linked physics based model simulations solved iteratively, where equations are segregated."@en .

ns2:MaterialRelation a owl:Class ;
    rdfs:label "MaterialRelation"@en ;
    rdfs:comment "A material_relation can e.g. return a predefined number, return a database query, be an equation that depends on other physics_quantities."@en ;
    rdfs:subClassOf ns2:Equation ;
    skos:example """The Lennard-Jones potential.
A force field.
An Hamiltonian."""@en ;
    skos:prefLabel "MaterialRelation"@en ;
    ns2:elucidation "An 'equation' that stands for a physical assumption specific to a material, and provides an expression for a 'physics_quantity' (the dependent variable) as function of other variables, physics_quantity or data (independent variables)."@en .

ns2:MesoscopicModel a owl:Class ;
    rdfs:label "MesoscopicModel"@en ;
    rdfs:subClassOf ns2:MaterialsModel ;
    skos:prefLabel "MesoscopicModel"@en ;
    ns2:elucidation "A physics-based model based on a physics equation describing the behaviour of mesoscopic entities, i.e. a set of bounded atoms like a molecule, bead or nanoparticle."@en .

ns2:PhysicsEquation a owl:Class ;
    rdfs:label "PhysicsEquation"@en ;
    rdfs:subClassOf ns2:Equation,
        ns2:PhysicsBasedModel ;
    skos:example """The Newton's equation of motion.
The Schrödinger equation.
The Navier-Stokes equation."""@en ;
    skos:prefLabel "PhysicsEquation"@en ;
    ns2:elucidation "An 'equation' that stands for a 'physical_law' by mathematically defining the relations between physics_quantities."@en .

ns2:PhysicsMathematicalComputation a owl:Class ;
    rdfs:label "PhysicsMathematicalComputation"@en ;
    rdfs:subClassOf ns2:Computation,
        ns2:FunctionalIcon ;
    skos:prefLabel "PhysicsMathematicalComputation"@en ;
    ns2:elucidation "A functional icon that imitates the behaviour of the object through mathematical evaluations of some mathematical construct."@en ;
    ns2:note "The equation that describes the velocity of a uniform accelerated body v = v0 + a*t is a functional icon. In general every analitical solution of a mathematical model can be considered an icon. A functional icon expresses its similarity with the object when is part of a process the makes it imitate the behavior of the object. In the case of v = v0 + a*t, plotting the velocity over time or listing their values at certain instants is when the icon expresses it functionality."@en .

ns2:ScientificTheory a owl:Class ;
    rdfs:label "ScientificTheory"@en ;
    rdfs:subClassOf ns2:Objective,
        ns2:Observed,
        ns2:Theory ;
    skos:prefLabel "ScientificTheory"@en ;
    ns2:elucidation "A scientific theory is a description, objective and observed, produced with scientific methodology."@en .

ns2:Software rdfs:label "Software"@en .

ns2:TightlyCoupledModelsSimulation a owl:Class ;
    rdfs:label "TightlyCoupledModelsSimulation"@en ;
    rdfs:subClassOf ns2:Coupled ;
    skos:example "Solving within the same linear system the discretised form of the pressure and momentum equation for a fluid, using the ideal gas law as material relation for connecting pressure to density."@en ;
    skos:prefLabel "TightlyCoupledModelsSimulation"@en ;
    ns2:elucidation "A simulation in which more than one model are solved together with a coupled method."@en .

ns2:computes a owl:ObjectProperty ;
    rdfs:label "computes"@en ;
    ns1:python_name "computes"@en ;
    rdfs:comment "Relates a software to a computation that is performed with this software."@en ;
    rdfs:domain ns2:Software ;
    rdfs:range ns2:Computation ;
    rdfs:subPropertyOf ns2:participatesTo ;
    skos:prefLabel "computes"@en .

ns2:ApplicationProgram rdfs:label "ApplicationProgram"@en .

ns2:Coupled a owl:Class ;
    rdfs:label "Coupled"@en ;
    rdfs:subClassOf ns2:MultiSimulation ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns2:IterativeCoupledModelsSimulation ns2:TightlyCoupledModelsSimulation ) ] ;
    skos:prefLabel "Coupled"@en .

ns2:MathematicalModel a owl:Class ;
    rdfs:label "MathematicalModel"@en ;
    rdfs:comment """A mathematical model can be defined as a description of a system using mathematical concepts and language to facilitate proper explanation of a system or to study the effects of different components and to make predictions on patterns of behaviour.

Abramowitz and Stegun, 1968"""@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:AnalogicalIcon ns2:Mathematical ) ] ;
    skos:prefLabel "MathematicalModel"@en ;
    ns2:elucidation "An analogical icon expressed in mathematical language."@en .

ns2:MultiSimulation a owl:Class ;
    rdfs:label "MultiSimulation"@en ;
    rdfs:subClassOf ns2:PhysicsBasedSimulation ;
    skos:prefLabel "MultiSimulation"@en ;
    ns2:elucidation "A physics based simulation with multiple physics based models."@en .

ns2:NaturalLaw a owl:Class ;
    rdfs:label "NaturalLaw"@en ;
    rdfs:subClassOf ns2:ScientificTheory ;
    skos:prefLabel "NaturalLaw"@en ;
    ns2:elucidation "A scientific theory that focuses on a specific phenomena, for which a single statement (not necessariliy in mathematical form) can be expressed."@en .

ns2:Simulation a owl:Class ;
    rdfs:label "Simulation"@en ;
    rdfs:subClassOf ns2:Computation,
        ns2:Estimation ;
    skos:altLabel "Modelling"@en ;
    skos:example "I calculate the electrical conductivity of an Ar-He plasma with the Chapman-Enskog method and use the value as property for it."@en ;
    skos:prefLabel "Simulation"@en ;
    ns2:elucidation "A estimation of a property using a functional icon."@en .

ns2:FunctionalIcon skos:example "A guinea pig."@en .

ns2:PhysicsBasedModel a owl:Class ;
    rdfs:label "PhysicsBasedModel"@en ;
    rdfs:isDefinedBy "CEN Workshop Agreement – CWA 17284 “Materials modelling – terminology, classification and metadata”"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasSpatialPart ;
            owl:someValuesFrom ns2:PhysicsEquation ],
        ns2:MathematicalModel ;
    skos:prefLabel "PhysicsBasedModel"@en ;
    ns2:elucidation "A mathematical entity based on a fundamental physics theory which defines the relations between physics quantities of an entity."@en .

ns2:PhysicsBasedSimulation a owl:Class ;
    rdfs:label "PhysicsBasedSimulation"@en ;
    rdfs:isDefinedBy "CEN Workshop Agreement – CWA 17284 “Materials modelling – terminology, classification and metadata”"@en ;
    rdfs:subClassOf ns2:Simulation ;
    skos:prefLabel "PhysicsBasedSimulation"@en ;
    ns2:elucidation "A simulation that relies on physics based models, according to the Review of Materials Modelling and CWA 17284:2018."@en .

ns2:SimulationSoftware a owl:Class ;
    rdfs:label "SimulationSoftware"@en ;
    rdfs:subClassOf ns2:ApplicationProgram,
        ns2:FunctionalIcon ;
    skos:altLabel "SimulationApplication"@en ;
    skos:example "An application program that predicts the pressure drop of a fluid in a pipe segment is aimed to functionally reproduce the outcome of a measurement of pressure before and after the segment."@en ;
    skos:prefLabel "SimulationSoftware"@en ;
    ns2:elucidation "An application program aimed to functionally reproduce an object."@en .

ns2:MaterialsModel a owl:Class ;
    rdfs:label "MaterialsModel"@en ;
    rdfs:seeAlso "https://op.europa.eu/en/publication-detail/-/publication/ec1455c3-d7ca-11e6-ad7c-01aa75ed71a1"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:hasSpatialPart ;
            owl:someValuesFrom ns2:MaterialRelation ],
        ns2:PhysicsBasedModel ;
    owl:disjointUnionOf ( ns2:ContinuumModel ns2:MesoscopicModel ns2:ElectronicModel ns2:AtomisticModel ) ;
    skos:prefLabel "MaterialsModel"@en ;
    ns2:elucidation "A solvable set of one Physics Equation and one or more Materials Relations."@en .

ns2:Theory a owl:Class ;
    rdfs:label "Theory"@en ;
    rdfs:comment """The 'theory' is e.g. a proposition, a book or a paper whose sub-symbols suggest in the mind of the interpreter an interpretant structure that can represent a 'physical'.

It is not an 'icon' (like a math equation), because it has no common resemblance or logical structure with the 'physical'.

In Peirce semiotics: legisign-symbol-argument"""@en ;
    rdfs:subClassOf ns2:Description ;
    skos:prefLabel "Theory"@en ;
    ns2:elucidation "A 'conventional' that stand for a 'physical'."@en .

ns2:Computation a owl:Class ;
    rdfs:label "Computation"@en ;
    rdfs:subClassOf ns2:Procedure ;
    skos:example """A mathematician that calculates 2+2.
A computation machine that calculate the average value of a dataset."""@en ;
    skos:prefLabel "Computation"@en ;
    ns2:elucidation "A procedure that deals with quantitative symbols (i.e. symbols associated with a quantitative oriented language)."@en .

[] a owl:Axiom ;
    owl:annotatedProperty skos:prefLabel ;
    owl:annotatedSource ns2:Computation ;
    owl:annotatedTarget "Computation"@en ;
    ns2:etymology "From Latin con- +‎ putō (“I reckon”)."@en .

[] a owl:Axiom ;
    rdfs:seeAlso "https://www.cencenelec.eu/media/CEN-CENELEC/CWAs/RI/cwa17284_2018.pdf"^^xsd:anyURI ;
    owl:annotatedProperty rdfs:isDefinedBy ;
    owl:annotatedSource ns2:PhysicsBasedModel ;
    owl:annotatedTarget "CEN Workshop Agreement – CWA 17284 “Materials modelling – terminology, classification and metadata”"@en .

[] a owl:Axiom ;
    rdfs:seeAlso "https://www.cencenelec.eu/media/CEN-CENELEC/CWAs/RI/cwa17284_2018.pdf"^^xsd:anyURI ;
    owl:annotatedProperty rdfs:isDefinedBy ;
    owl:annotatedSource ns2:PhysicsBasedSimulation ;
    owl:annotatedTarget "CEN Workshop Agreement – CWA 17284 “Materials modelling – terminology, classification and metadata”"@en .


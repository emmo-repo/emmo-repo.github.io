    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIDimensionalUnit"/>
  <rdfs:label xml:lang="en">MassPerVolumeTimeUnit</rdfs:label>
  <rdfs:comment xml:lang="en">The class of units with dimensionality 'MassPerVolumeTime'.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8f3a9f9f_6f56_49dc_b39e_1aee57ffdc58</core:exactMatch>
  <core:prefLabel xml:lang="en">MassPerVolumeTimeUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">The class of units with dimensionality 'MassPerVolumeTime'.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SpatioTemporalTileByPosition">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SpatioTemporalTile"/>
  <rdfs:label xml:lang="en">SpatioTemporalTileByPosition</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for tiles categorized accordingly to their location within a tessellation in terms of causal source, sink or intermediary.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5e38e44b_a0d1_4afc_a876_95095c0a589f</core:exactMatch>
  <core:prefLabel xml:lang="en">SpatioTemporalTileByPosition</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for tiles categorized accordingly to their location within a tessellation in terms of causal source, sink or intermediary.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DerivedUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeasurementUnit"/>
  <rdfs:label xml:lang="en">DerivedUnit</rdfs:label>
  <rdfs:comment xml:lang="en">Derived units are defined as a numerical factor times the products of powers of the base units corresponding to the relations defining the derived quantities in terms of the base quantities.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_08b308d4_31cd_4779_a784_aa92fc730f39</core:exactMatch>
  <core:prefLabel xml:lang="en">DerivedUnit</core:prefLabel>
  <emmo:VIMTerm xml:lang="en">derived unit</emmo:VIMTerm>
  <emmo:elucidation xml:lang="en">Derived units are defined as a numerical factor times the products of powers of the base units corresponding to the relations defining the derived quantities in terms of the base quantities.</emmo:elucidation>
  <emmo:note xml:lang="en">A measurement unit for a derived quantity.
-- VIM</emmo:note>
  <emmo:note xml:lang="en">When the numerical factor of this product is one, the derived units are called coherent derived units.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#NonLeakageProbability">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Probability"/>
  <rdfs:label xml:lang="en">NonLeakageProbability</rdfs:label>
  <rdfs:comment xml:lang="en">Probability that a neutron will not escape from the reactor during the slowing-down process or while it diffuses as a thermal neutron.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9140f0d2_fa24_4050_85d9_17d7d2e9e1df</core:exactMatch>
  <core:prefLabel xml:lang="en">NonLeakageProbability</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-77</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Probability that a neutron will not escape from the reactor during the slowing-down process or while it diffuses as a thermal neutron.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Non-LeakageProbability</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q99415566</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Probability">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#RatioQuantity"/>
  <rdfs:label xml:lang="en">Probability</rdfs:label>
  <rdfs:comment xml:lang="en">Probability is a dimensionless quantity that can attain values between 0 and 1; zero denotes the impossible event and 1 denotes a certain event.</rdfs:comment>
  <rdfs:comment xml:lang="en">The propability for a certain outcome, is the ratio between the number of events leading to the given outcome and the total number of events.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0a88be81_343d_4388_92c1_09228ff95ada</core:exactMatch>
  <core:prefLabel xml:lang="en">Probability</core:prefLabel>
  <emmo:elucidation xml:lang="en">Probability is a dimensionless quantity that can attain values between 0 and 1; zero denotes the impossible event and 1 denotes a certain event.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.P04855</emmo:iupacReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ConstitutiveProcess">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasConstitutiveProcess"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Object"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ProcessByContext"/>
  <rdfs:label xml:lang="en">ConstitutiveProcess</rdfs:label>
  <rdfs:comment xml:lang="en">A process which is a spatial part of an object.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f68858dd_64f4_4877_b7fb_70d04fbe5bab</core:exactMatch>
  <core:example xml:lang="en">Blood circulation in a human body.</core:example>
  <core:prefLabel xml:lang="en">ConstitutiveProcess</core:prefLabel>
  <emmo:elucidation xml:lang="en">A process which is a spatial part of an object.</emmo:elucidation>
  <emmo:note xml:lang="en">A constitutive process is a process that is holistically relevant for the definition of the whole.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Liquid">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatter"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Fluid"/>
  <rdfs:label xml:lang="en">Liquid</rdfs:label>
  <rdfs:comment xml:lang="en">A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba</core:exactMatch>
  <core:prefLabel xml:lang="en">Liquid</core:prefLabel>
  <emmo:elucidation xml:lang="en">A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure.</emmo:elucidation>
</owl:Class>


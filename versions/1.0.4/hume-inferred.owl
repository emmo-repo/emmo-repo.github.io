  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Mass"/>
  <rdfs:label xml:lang="en">MassDefect</rdfs:label>
  <rdfs:comment xml:lang="en">Sum of the product of the proton number and the hydrogen atomic mass, and the neutron rest mass, minus the rest mass of the atom.</rdfs:comment>

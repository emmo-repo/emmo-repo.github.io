  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MagneticQuantumNumber</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-13.4</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Atomic quantum number related to the z component lz, jz or sz, of the orbital, total, or spin angular momentum.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MagneticQuantumNumber</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q2009727</emmo:wikidataReference>
</owl:Class>


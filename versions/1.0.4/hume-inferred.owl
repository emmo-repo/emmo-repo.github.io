<owl:Class rdf:about="https://w3id.org/emmo#FreeForming">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CompressiveForming"/>
  <rdfs:label xml:lang="en">FreeForming</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Free forming is pressure forming with tools that do not or only partially contain the shape of the workpiece and move against each other.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non la metterei</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Printing forms with tools that do not or only partially contain the shape of the workpiece and move against each other. The workpiece shape is created by free or fixed relative movement between the tool and the workpiece (kinematic shape generation).</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7432b843_cfd2_4345_a3d2_eaa539b27e61</core:exactMatch>
  <core:prefLabel xml:lang="en">FreeForming</core:prefLabel>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#NonConvergent">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Nuclear"/>
  <rdfs:label xml:lang="en">NonConvergent</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have a proper parts of the same type φ of the whole, and so that for every two distinct φ proper parts one is not part of the other.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7f92ac53_3a89_41a4_af5c_a8ad320a7936</core:exactMatch>
  <core:prefLabel xml:lang="en">NonConvergent</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for all classes of entities that have a proper parts of the same type φ of the whole, and so that for every two distinct φ proper parts one is not part of the other.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/NonConvergent.png</emmo:illustration>
</owl:Class>


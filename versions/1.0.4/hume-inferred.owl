<owl:Class rdf:about="https://w3id.org/emmo#LuminousIntensity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#LuminousIntensityUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQBaseQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#LightAndRadiationQuantity"/>
  <rdfs:label xml:lang="en">LuminousIntensity</rdfs:label>
  <rdfs:comment xml:lang="en">A measure of the wavelength-weighted power emitted by a light source in a particular direction per unit solid angle. It is based on the luminosity function, which is a standardized model of the sensitivity of the human eye.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_50bf79a6_a48b_424d_9d2c_813bd631231a</core:exactMatch>
  <core:prefLabel xml:lang="en">LuminousIntensity</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7-14</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">A measure of the wavelength-weighted power emitted by a light source in a particular direction per unit solid angle. It is based on the luminosity function, which is a standardized model of the sensitivity of the human eye.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/LuminousIntensity</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ISQBaseQuantity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#BaseQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#InternationalSystemOfQuantity"/>
  <rdfs:label xml:lang="en">ISQBaseQuantity</rdfs:label>

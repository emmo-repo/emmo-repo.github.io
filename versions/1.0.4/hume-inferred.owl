  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_88470739_03d3_4c47_a03e_b30a1288d50c</core:exactMatch>
  <core:prefLabel xml:lang="en">MathematicalFormula</core:prefLabel>
  <emmo:elucidation xml:lang="en">A mathematical string that express a relation between the elements in one set X to elements in another set Y.</emmo:elucidation>
</owl:Class>


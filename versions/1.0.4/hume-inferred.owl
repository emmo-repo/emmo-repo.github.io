  <core:prefLabel xml:lang="en">SecondPolarMomentOfArea</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-30</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-21.2</emmo:ISO80000Reference>

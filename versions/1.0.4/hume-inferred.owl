<owl:Class rdf:about="https://w3id.org/emmo#EmpiricalSimulationSoftware">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SimulationSoftware"/>
  <rdfs:label xml:lang="en">EmpiricalSimulationSoftware</rdfs:label>
  <rdfs:comment xml:lang="en">A computational application that uses an empiric equation to predict the behaviour of a system without relying on the knowledge of the actual physical phenomena occurring in the object.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_67c70dcd_2adf_4e6c_b3f8_f33dd1512487</core:exactMatch>
  <core:prefLabel xml:lang="en">EmpiricalSimulationSoftware</core:prefLabel>
  <emmo:elucidation xml:lang="en">A computational application that uses an empiric equation to predict the behaviour of a system without relying on the knowledge of the actual physical phenomena occurring in the object.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SpatioTemporalTileByConnection">

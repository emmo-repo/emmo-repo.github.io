  <rdfs:label xml:lang="en">Exposure</rdfs:label>
  <rdfs:comment xml:lang="en">Absolute value of the electric charge of ions produced in dry air by X- or gamma radiation per mass of air.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_d2b37868_7b74_469b_ae26_0a7153c23222</core:exactMatch>
  <core:prefLabel xml:lang="en">Exposure</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=395-01-32</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-88</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Absolute value of the electric charge of ions produced in dry air by X- or gamma radiation per mass of air.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Exposure</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q336938</emmo:wikidataReference>
</owl:Class>


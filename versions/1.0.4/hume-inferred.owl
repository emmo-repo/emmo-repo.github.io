<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasPortionPart">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Item"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasPiece"/>
  <rdfs:label xml:lang="en">hasPortionPart</rdfs:label>
  <rdfs:comment xml:lang="en">A proper part relation with domain restricted to items.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_55354438_7000_4284_b1b9_59d60c2261b9</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasPortionPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasPortionPart</core:prefLabel>
  <emmo:definition xml:lang="en">A proper part relation with domain restricted to items.</emmo:definition>
  <emmo:note xml:lang="en">A part of an item is always non-maximal, meaning that is causally connected with the rest.</emmo:note>
</owl:AsymmetricProperty>


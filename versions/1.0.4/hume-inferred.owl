  <rdfs:comment xml:lang="en">Non-SI units mentioned in the SI.</rdfs:comment>
  <rdfs:comment xml:lang="en">This is a list of units that are not defined as part of the International System of Units (SI), but are otherwise mentioned in the SI brouchure, because either the General Conference on Weights and Measures (CGPM) accepts their use as being multiples or submultiples of SI-units, they have important contemporary application worldwide, or are otherwise commonly encountered worldwide.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac</core:exactMatch>
  <core:prefLabel xml:lang="en">SIAcceptedUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">Non-SI units mentioned in the SI.</emmo:elucidation>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Non-SI_units_mentioned_in_the_SI</emmo:wikipediaReference>
</owl:Class>


  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-79</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Duration required for the neutron fluence rate in a reactor to change by the factor e when the fluence rate is rising or falling exponentially.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ReactorTimeConstant</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q99518950</emmo:wikidataReference>
</owl:Class>


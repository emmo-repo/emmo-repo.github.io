<owl:Class rdf:about="https://w3id.org/emmo#RelativeMassFractionOfVapour">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#RatioQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ThermodynamicalQuantity"/>
  <rdfs:label xml:lang="en">RelativeMassFractionOfVapour</rdfs:label>
  <rdfs:comment xml:lang="en">Quotient of mass concentration of water vapour and mass concentration at its saturation

ψ = r/rsat

where r is mass ratio of water vapour to dry gas and rsat is the mass ratio of water vapour to dry gas at saturation of the same temperature.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_a45dc074_c5ed_4aad_a4e7_141a02fe1d73</core:exactMatch>
  <core:prefLabel xml:lang="en">RelativeMassFractionOfVapour</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-35</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quotient of mass concentration of water vapour and mass concentration at its saturation

ψ = r/rsat

where r is mass ratio of water vapour to dry gas and rsat is the mass ratio of water vapour to dry gas at saturation of the same temperature.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#RatioQuantity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDimensionlessQuantity"/>
  <rdfs:label xml:lang="en">RatioQuantity</rdfs:label>
  <rdfs:comment xml:lang="en">Quantities defined as ratios `Q=A/B` having equal dimensions in numerator and denominator are dimensionless quantities but still have a physical dimension defined as dim(A)/dim(B).

Johansson, Ingvar (2010). "Metrological thinking needs the notions of parametric quantities, units and dimensions". Metrologia. 47 (3): 219–230. doi:10.1088/0026-1394/47/3/012. ISSN 0026-1394.</rdfs:comment>
  <rdfs:comment xml:lang="en">The class of quantities that are the ratio of two quantities with the same physical dimensionality.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://iopscience.iop.org/article/10.1088/0026-1394/47/3/012</rdfs:seeAlso>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_faab3f84_e475_4a46_af9c_7d249f0b9aef</core:exactMatch>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refractive index,
volume fraction,
fine structure constant</core:example>
  <core:prefLabel xml:lang="en">RatioQuantity</core:prefLabel>
  <emmo:elucidation xml:lang="en">The class of quantities that are the ratio of two quantities with the same physical dimensionality.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/DimensionlessRatio</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#BooleanData">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/symbolic#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SymbolicData"/>
  <rdfs:label xml:lang="en">BooleanData</rdfs:label>
  <rdfs:comment xml:lang="en">A data representing a boolean number.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/datatypes.html#boolean</rdfs:seeAlso>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_54dc83cb_06e1_4739_9e45_bc09cead7f48</core:exactMatch>
  <core:prefLabel xml:lang="en">BooleanData</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: hasDataValue some xsd:boolean</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A data representing a boolean number.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SymbolicData">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/symbolic#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Symbolic"/>
  <rdfs:label xml:lang="en">SymbolicData</rdfs:label>
  <rdfs:comment xml:lang="en">A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data.</rdfs:comment>
  <rdfs:comment xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes</rdfs:seeAlso>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/rdf11-concepts/</rdfs:seeAlso>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps</rdfs:seeAlso>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.w3schools.com/xml/schema_dtypes_numeric.asp</rdfs:seeAlso>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LiteralData</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172</core:exactMatch>
  <core:prefLabel xml:lang="en">SymbolicData</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: ArrayData, ScalarData</emmo:OWLRL2DLAxioms>
  <emmo:conceptualisation xml:lang="en">A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ElectronAffinity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatterPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Energy"/>
  <rdfs:label xml:lang="en">ElectronAffinity</rdfs:label>
  <rdfs:comment xml:lang="en">energy difference between an electron at rest at infinity and an electron at the lowest level of the conduction band in an insulator or semiconductor</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3cae45cc_3b57_469c_a695_713735886f31</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectronAffinity</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-06-22</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-25</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">energy difference between an electron at rest at infinity and an electron at the lowest level of the conduction band in an insulator or semiconductor</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectronAffinity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q105846486</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Energy">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EnergyUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Extensive"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">Energy</rdfs:label>
  <rdfs:comment xml:lang="en">A property of objects which can be transferred to other objects or converted into different forms.</rdfs:comment>
  <rdfs:comment xml:lang="en">Energy is often defined as "ability of a system to perform work", but it might be misleading since is not necessarily available to do work.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_31ec09ba_1713_42cb_83c7_b38bf6f9ced2</core:exactMatch>
  <core:prefLabel xml:lang="en">Energy</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-20-1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">A property of objects which can be transferred to other objects or converted into different forms.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E02101</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/Energy</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#TungstenAtom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

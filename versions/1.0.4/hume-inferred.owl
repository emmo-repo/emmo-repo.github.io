  <rdfs:range rdf:resource="https://w3id.org/emmo#MetricPrefix"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasSpatialTile"/>
  <rdfs:label xml:lang="en">hasMetricPrefix</rdfs:label>
  <rdfs:comment xml:lang="en">Relates a prefixed unit to its metric prefix part.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4be0acad_af05_426f_aa6d_fe7531072564</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasMetricPrefix</core:exactMatch>
  <core:prefLabel xml:lang="en">hasMetricPrefix</core:prefLabel>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasChemicalComposition">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Substance"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#ChemicalComposition"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasConvention"/>
  <rdfs:label xml:lang="en">hasChemicalComposition</rdfs:label>
  <rdfs:comment xml:lang="en">Relates a substance to chemical composition.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_51f426a6_af4a_4e91_a392_2b0bb635e2d5</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasChemicalComposition</core:exactMatch>
  <core:example xml:lang="en">This relation can be used to relate a material to a chemical composition quantity of one of its chemical species. For example, the amount of aluminium in substance subst:alloy1 can be expressed as:

```turtle
subst:alloy1 a emmo:Substance ;
    emmo:hasChemicalComposition [
        a emmo:SingleComponentComposition ;
        emmo:hasSpeciesPart [ a emmo:AluminiumSymbol ] ;
        emmo:hasQuantityPart [
            a emmo:MassFraction ;
            hasSIQuantityValue "98.1 wt%"^^emmo:SIQuantityDatatype
        ]
    ] .
```</core:example>
  <core:prefLabel xml:lang="en">hasChemicalComposition</core:prefLabel>
  <emmo:elucidation xml:lang="en">Relates a substance to chemical composition.</emmo:elucidation>
  <emmo:note xml:lang="en">This property is often used to relate a substance directly to SingleComponentComposition indifiduals for each of its components.</emmo:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasSubProcess">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#SubProcess"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasNonTemporalPart"/>
  <rdfs:label xml:lang="en">hasSubProcess</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between a process and one of its process parts.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_d43af210_f854_4432_a891_ce3022e3b558</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasSubProcess</core:exactMatch>
  <core:prefLabel xml:lang="en">hasSubProcess</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a process and one of its process parts.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasNonTemporalPart">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#CausalSystem"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasPortionPart"/>
  <rdfs:label xml:lang="en">hasNonTemporalPart</rdfs:label>
  <rdfs:comment xml:lang="en">The part is connected with the rest item or members with a combination of hasNext (or its inverse) or hasContact relations.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9a50a0ae_841a_46fe_8b23_3df319b60611</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasNonTemporalPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasNonTemporalPart</core:prefLabel>
  <emmo:elucidation xml:lang="en">The part is connected with the rest item or members with a combination of hasNext (or its inverse) or hasContact relations.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasStage">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Stage"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasTemporalPart"/>
  <rdfs:label xml:lang="en">hasStage</rdfs:label>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f22abf74_4538_4f50_ab85_09908cdda707</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasStage</core:exactMatch>
  <core:prefLabel xml:lang="en">hasStage</core:prefLabel>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasTemporalPart">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#CausalStructure"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasPortionPart"/>
  <owl:inverseOf rdf:resource="https://w3id.org/emmo#isTemporalPartOf"/>
  <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#hasNonTemporalPart"/>
  <rdfs:label xml:lang="en">hasTemporalPart</rdfs:label>
  <rdfs:comment xml:lang="en">A relation that identify a proper item part of the whole, whose parts always cover the full spatial extension of the whole within a time interval.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7afbed84_7593_4a23_bd88_9d9c6b04e8f6</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasTemporalPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasTemporalPart</core:prefLabel>
  <emmo:elucidation xml:lang="en">A relation that identify a proper item part of the whole, whose parts always cover the full spatial extension of the whole within a time interval.</emmo:elucidation>
  <emmo:note xml:lang="en">A temporal part of an item cannot both cause and be caused by any other proper part of the item.
A temporal part is not constraint to be causally self-connected, i.e. it can be either an item or a collection. We therefore introduce two subproperties in order to distinguish between both cases.</emmo:note>
  <emmo:note xml:lang="en">In EMMO FOL this is a defined property. In OWL temporal relations are primitive.</emmo:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasAgent">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Agency"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Agent"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasParticipant"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasRole"/>
  <rdfs:label xml:lang="en">hasAgent</rdfs:label>
  <rdfs:comment xml:lang="en">The relation within a process and an agent participant.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_cd24eb82_a11c_4a31_96ea_32f870c5580a</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasAgent</core:exactMatch>
  <core:prefLabel xml:lang="en">hasAgent</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation within a process and an agent participant.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#properOverlaps">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isOvercrossedBy"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#overcrosses"/>
  <rdfs:label xml:lang="en">properOverlaps</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between two entities that overlaps and neither of them is a part of the other.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b3c8ba10_6bee_45e7_9416_e9019aa9f023</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#properOverlaps</core:exactMatch>
  <core:prefLabel xml:lang="en">properOverlaps</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between two entities that overlaps and neither of them is a part of the other.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#isOvercrossedBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#overcrosses"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#overlaps"/>
  <rdfs:label xml:lang="en">isOvercrossedBy</rdfs:label>
  <rdfs:comment xml:lang="en">The inverse relation for overcrosses.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_e4f66254_7312_4de5_a86a_6e0808baaaab</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#isOvercrossedBy</core:exactMatch>
  <core:prefLabel xml:lang="en">isOvercrossedBy</core:prefLabel>
  <emmo:elucidation xml:lang="en">The inverse relation for overcrosses.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#overcrosses">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#overlaps"/>
  <owl:inverseOf rdf:resource="https://w3id.org/emmo#isOvercrossedBy"/>
  <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#isPartOf"/>
  <rdfs:label xml:lang="en">overcrosses</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OX(x, y) ≡ O(x, y) ∧ ¬P(x,y)</rdfs:comment>
  <rdfs:comment xml:lang="en">The relation between an entity that overlaps another without being its part.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9cb984ca_48ad_4864_b09e_50d3fff19420</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#overcrosses</core:exactMatch>
  <core:prefLabel xml:lang="en">overcrosses</core:prefLabel>
  <emmo:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OX(x, y) ≡ O(x, y) ∧ ¬P(x,y)</emmo:definition>
  <emmo:elucidation xml:lang="en">The relation between an entity that overlaps another without being its part.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasVariable">

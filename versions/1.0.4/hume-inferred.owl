          <swrl:propertyPredicate rdf:resource="https://w3id.org/emmo#alongsideWith"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <rdfs:comment xml:lang="en">Implementing Transitivity.</rdfs:comment>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>

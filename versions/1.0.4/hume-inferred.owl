<owl:Class rdf:about="https://w3id.org/emmo#ProgrammingLanguage">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ConstructionLanguage"/>
  <rdfs:label xml:lang="en">ProgrammingLanguage</rdfs:label>
  <rdfs:comment xml:lang="en">A language object that follows syntactic rules of a programming language.</rdfs:comment>
  <core:altLabel xml:lang="en">Code</core:altLabel>
  <core:altLabel xml:lang="en">SoftwareCode</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9ffffb55_3496_4307_82b8_a0d78fe1fcd8</core:exactMatch>
  <core:prefLabel xml:lang="en">ProgrammingLanguage</core:prefLabel>
  <emmo:elucidation xml:lang="en">A language object that follows syntactic rules of a programming language.</emmo:elucidation>
  <emmo:note xml:lang="en">A programming language object can also be a fragment (e.g. a C function) not suitable for exectution.</emmo:note>
  <emmo:note xml:lang="en">Entities are not necessarily digital data, but can be code fragments printed on paper.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MetrologicalSymbol">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:complementOf rdf:resource="https://w3id.org/emmo#Metrological"/>
        </owl:Class>
      </owl:allValuesFrom>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasProperPart"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Metrological"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Symbol"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/emmo#Metrological"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#Symbol"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">MetrologicalSymbol</rdfs:label>
  <rdfs:comment xml:lang="en">A symbol that stands for a concept in the language of the meterological domain of ISO 80000.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_50a3552e_859a_4ff7_946d_76d537cabce6</core:exactMatch>
  <core:prefLabel xml:lang="en">MetrologicalSymbol</core:prefLabel>
  <emmo:elucidation xml:lang="en">A symbol that stands for a concept in the language of the meterological domain of ISO 80000.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#NonPrefixedUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeasurementUnitByPrefix"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#PrefixedUnit"/>
  <rdfs:label xml:lang="en">NonPrefixedUnit</rdfs:label>
  <rdfs:comment xml:lang="en">A measurement unit symbol that do not have a metric prefix as a direct spatial part.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e</core:exactMatch>
  <core:prefLabel xml:lang="en">NonPrefixedUnit</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: DerivedUnit or UnitSymbol</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A measurement unit symbol that do not have a metric prefix as a direct spatial part.</emmo:elucidation>
</owl:Class>


  <rdfs:comment xml:lang="en">Measure of the relative volume change of a fluid or solid as a response to a pressure change.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0de3878e_7928_4ab6_bc6d_cf590b2d0e5b</core:exactMatch>

  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_c6f8d962_2239_4a9e_a9ac_63c01b84de09</core:exactMatch>
  <core:prefLabel xml:lang="en">CouplingFactor</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-12-41</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-42.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Ratio of the absolute value of the mutual permeance related to two circuit elements  to the geometric average of their self-permeances.</emmo:elucidation>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q78101715</emmo:wikidataReference>
</owl:Class>


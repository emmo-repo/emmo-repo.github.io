  <core:prefLabel xml:lang="en">MetricSubMultipleUnit</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disjointUnionOf: PicoPrefixedUnit, DeciPrefixedUnit, FemtoPrefixedUnit, ZeptoPrefixedUnit, AttoPrefixedUnit, MicroPrefixedUnit, MilliPrefixedUnit, CentiPrefixedUnit, NanoPrefixedUnit, YoctoPrefixedUnit</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">Measurement unit obtained by dividing a given measurement unit by an integer SI prefix greater than one.</emmo:elucidation>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#MetallicMaterial">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialByType"/>
  <rdfs:label xml:lang="en">MetallicMaterial</rdfs:label>
  <rdfs:comment xml:lang="en">Inorganic substance, consisting of one or more metallic elements.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4c1f58cd_6e2c_48fb_8098_1cbb762abb05</core:exactMatch>
  <core:prefLabel xml:lang="en">MetallicMaterial</core:prefLabel>
  <emmo:elucidation xml:lang="en">Inorganic substance, consisting of one or more metallic elements.</emmo:elucidation>
  <emmo:note xml:lang="en">Metallic materials are known for their shiny luster, excellent electrical/thermal conductivity, malleability (shapable by hammering), and ductility (can be drawn into wires), due to metallic bonding (shared electrons); they often form alloys (like steel from iron/carbon) to enhance these properties for diverse applications.</emmo:note>
</owl:Class>


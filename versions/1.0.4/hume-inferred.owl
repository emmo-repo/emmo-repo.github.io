  <emmo:elucidation xml:lang="en">Sum of all cross sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target entity.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/TotalCrossSection</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98206553</emmo:wikidataReference>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#Magnetization">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#MagneticFieldStrengthUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">Magnetization</rdfs:label>
  <rdfs:comment xml:lang="en">At a given point within a domain of quasi-infinitesimal volume V, vector quantity equal to the magnetic area moment m of the substance contained within the domain divided by the volume V.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b23e7251_a488_4732_8268_027ad76d7e37</core:exactMatch>
  <core:prefLabel xml:lang="en">Magnetization</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-52</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-24</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">At a given point within a domain of quasi-infinitesimal volume V, vector quantity equal to the magnetic area moment m of the substance contained within the domain divided by the volume V.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Magnetization</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q856711</emmo:wikidataReference>
</owl:Class>


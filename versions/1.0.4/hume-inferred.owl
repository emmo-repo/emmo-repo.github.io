<owl:Class rdf:about="https://w3id.org/emmo#CondensedMatterPhysicsQuantity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISO80000Categorised"/>

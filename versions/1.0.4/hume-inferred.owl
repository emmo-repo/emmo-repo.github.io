  <emmo:elucidation xml:lang="en">Relates an agency to an unintentional agent participant.</emmo:elucidation>
  <emmo:note xml:lang="en">Note the domain is not UnintentionalAgency, since there exists an intentional agent that drives the process.</emmo:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasInterval">

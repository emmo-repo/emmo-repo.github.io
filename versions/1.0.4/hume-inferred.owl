  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SeparateManufacturing"/>
  <rdfs:label xml:lang="en">Cleaning</rdfs:label>

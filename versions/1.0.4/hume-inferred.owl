  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#affects</core:exactMatch>
  <core:prefLabel xml:lang="en">affects</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a process P that through overlaps an object O.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://raw.githubusercontent.com/emmo-repo/EMMO/master/doc/figs/affects.png</emmo:illustration>
</owl:AsymmetricProperty>


  <emmo:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dxy ≡ ¬Oxy.</emmo:definition>
  <emmo:elucidation xml:lang="en">The relation between individuals representing non-overlapping entities (i.e. that have no parts in common).</emmo:elucidation>
</owl:ObjectProperty>


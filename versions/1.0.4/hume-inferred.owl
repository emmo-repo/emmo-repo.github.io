  <core:prefLabel xml:lang="en">DegreeOfDissociation</core:prefLabel>
  <emmo:IEVReference xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-01-09</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-43</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Ratio of the number of dissociation events to the maximum number of theoretically possible dissociation events.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.D01566</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/DegreeOfDissociation</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q907334</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MassEnergyTransferCoefficient">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#AreaPerMassUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">MassEnergyTransferCoefficient</rdfs:label>
  <rdfs:comment xml:lang="en">For ionizing uncharged particles of a given type and energy, the differential quotient of Rtr with respect to l. Where Rtr is the mean energy that is transferred to kinetic energy of charged particles by interactions of the uncharged particles of incident radiant energy R in traversing a distance  l in the material of density rho, divided by rho and R</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b642d14c_0ba3_43c0_aa90_d0df922486c0</core:exactMatch>
  <core:prefLabel xml:lang="en">MassEnergyTransferCoefficient</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-04-32</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-87</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">For ionizing uncharged particles of a given type and energy, the differential quotient of Rtr with respect to l. Where Rtr is the mean energy that is transferred to kinetic energy of charged particles by interactions of the uncharged particles of incident radiant energy R in traversing a distance  l in the material of density rho, divided by rho and R</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MassEnergyTransferCoefficient</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q99714619</emmo:wikidataReference>
</owl:Class>


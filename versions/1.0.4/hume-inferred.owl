<owl:Class rdf:about="https://w3id.org/emmo#IsentropicCompressibility">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Compressibility"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ThermodynamicalQuantity"/>
  <rdfs:label xml:lang="en">IsentropicCompressibility</rdfs:label>
  <rdfs:comment xml:lang="en">Quantity characterizing the relative variation of volume V with pressure p at constant entropy.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_1044e509_e204_433a_8130_8d4579ada59f</core:exactMatch>
  <core:prefLabel xml:lang="en">IsentropicCompressibility</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-32</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-5.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quantity characterizing the relative variation of volume V with pressure p at constant entropy.</emmo:elucidation>
  <emmo:note xml:lang="en">The coherent SI unit of isentropic compressibility is pascal to the power minus one, 1/Pa.</emmo:note>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/IsentropicCompressibility</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q2990695</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Compressibility">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>

  <rdfs:label xml:lang="en">ElectricFieldStrength</rdfs:label>
  <rdfs:comment xml:lang="en">Vector field quantity E which exerts on any charged particle at rest a force F equal to the product of E and the electric charge Q of the particle.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f53bafb6_b17d_4eb9_ad58_9d209f70dbfd</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricFieldStrength</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-18</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-10</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Vector field quantity E which exerts on any charged particle at rest a force F equal to the product of E and the electric charge Q of the particle.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectricFieldStrength</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q20989</emmo:wikidataReference>
</owl:Class>


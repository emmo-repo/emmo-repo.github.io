<owl:Class rdf:about="https://w3id.org/emmo#HyperfineTransitionFrequencyOfCs">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Frequency"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIExactConstant"/>
  <rdfs:label xml:lang="en">HyperfineTransitionFrequencyOfCs</rdfs:label>
  <rdfs:comment xml:lang="en">The frequency standard in the SI system in which the photon absorption by transitions between the two hyperfine ground states of caesium-133 atoms are used to control the output frequency.

It defines the base unit second in the SI system.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f96feb3f_4438_4e43_aa44_7458c4d87fc2</core:exactMatch>
  <core:prefLabel xml:lang="en">HyperfineTransitionFrequencyOfCs</core:prefLabel>
  <emmo:elucidation xml:lang="en">The frequency standard in the SI system in which the photon absorption by transitions between the two hyperfine ground states of caesium-133 atoms are used to control the output frequency.

It defines the base unit second in the SI system.</emmo:elucidation>
</owl:Class>


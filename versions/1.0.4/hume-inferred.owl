  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-30</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">The mass that it seems to have when responding to forces, or the mass that it seems to have when interacting with other identical particles in a thermal distribution.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/EffectiveMass</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q1064434</emmo:wikidataReference>
</owl:Class>


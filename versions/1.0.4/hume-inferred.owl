</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Tempering">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#HeatTreatment"/>
  <rdfs:label xml:lang="en">Tempering</rdfs:label>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuenchingAndTempering</core:altLabel>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vergüten</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_6fa330f7_3289_4228_81df_12ee8a9708ac</core:exactMatch>
  <core:prefLabel xml:lang="en">Tempering</core:prefLabel>
  <emmo:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process consisting of two steps: - first, the steel is heated in a quenching treatment to a temperature above Ac3 and then rapidly cooled in a liquid to produce a process-specific grain structure; - subsequently, the steel is heated to a specific temperature during tempering to set the desired property and cooled in air.</emmo:note>
</owl:Class>


  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">TotalMassStoppingPower</rdfs:label>
  <rdfs:comment xml:lang="en">Quotient of the total linear stopping power S and the mass density ρ of the material.</rdfs:comment>
  <core:altLabel xml:lang="en">MassStoppingPower</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0f1b1f8b_0323_4840_899c_fd6860763155</core:exactMatch>
  <core:prefLabel xml:lang="en">TotalMassStoppingPower</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-12-52</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-55</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quotient of the total linear stopping power S and the mass density ρ of the material.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/TotalMassStoppingPower</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98642795</emmo:wikidataReference>
</owl:Class>


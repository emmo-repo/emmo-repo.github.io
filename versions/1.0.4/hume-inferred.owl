<owl:Class rdf:about="https://w3id.org/emmo#MeasuredConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicalConstant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#ExactConstant"/>
  <rdfs:label xml:lang="en">MeasuredConstant</rdfs:label>
  <rdfs:comment xml:lang="en">For a given unit system, measured constants are physical constants that are not used to define the unit system. Hence, these constants have to be measured and will therefore be associated with an uncertainty.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3f15d200_c97b_42c8_8ac0_d81d150361e2</core:exactMatch>
  <core:prefLabel xml:lang="en">MeasuredConstant</core:prefLabel>
  <emmo:elucidation xml:lang="en">For a given unit system, measured constants are physical constants that are not used to define the unit system. Hence, these constants have to be measured and will therefore be associated with an uncertainty.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#PhysicalConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicalQuantity"/>
  <rdfs:label xml:lang="en">PhysicalConstant</rdfs:label>
  <rdfs:comment xml:lang="en">Physical constants are categorised into "exact" and measured constants.

With "exact" constants, we refer to physical constants that have an exact numerical value after the revision of the SI system that was enforsed May 2019.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b953f2b1_c8d1_4dd9_b630_d3ef6580c2bb</core:exactMatch>
  <core:prefLabel xml:lang="en">PhysicalConstant</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: MeasuredConstant, ExactConstant</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">Physical constants are categorised into "exact" and measured constants.

With "exact" constants, we refer to physical constants that have an exact numerical value after the revision of the SI system that was enforsed May 2019.</emmo:elucidation>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/List_of_physical_constants</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ExactConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicalConstant"/>
  <rdfs:label xml:lang="en">ExactConstant</rdfs:label>
  <rdfs:comment xml:lang="en">Physical constant used to define a unit system. Hence, when expressed in that unit system they have an exact value with no associated uncertainty.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_89762966_8076_4f7c_b745_f718d653e8e2</core:exactMatch>
  <core:prefLabel xml:lang="en">ExactConstant</core:prefLabel>
  <emmo:elucidation xml:lang="en">Physical constant used to define a unit system. Hence, when expressed in that unit system they have an exact value with no associated uncertainty.</emmo:elucidation>
</owl:Class>


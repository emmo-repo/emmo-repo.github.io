  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5a4790e5-b11b-5a0c-80e4-81515c27a560</core:exactMatch>
  <core:prefLabel xml:lang="en">HydrogenAtom</core:prefLabel>
  <emmo:elucidation xml:lang="en">Atom subclass for hydrogen.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#CausalPath">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/emmo#CausalPath"/>
            <rdf:Description rdf:about="https://w3id.org/emmo#Quantum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasTemporalPart"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CausalParticle"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CausalStructure"/>
  <rdfs:label xml:lang="en">CausalPath</rdfs:label>
  <rdfs:comment xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</rdfs:comment>
  <rdfs:comment xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</rdfs:comment>
  <core:altLabel xml:lang="en">CausalChain</core:altLabel>
  <core:altLabel xml:lang="en">Elementary</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</core:exactMatch>
  <core:example xml:lang="en">An electron moving in time interacting with other particles.</core:example>
  <core:prefLabel xml:lang="en">CausalPath</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: MultiParticlePath, ElementaryParticle</emmo:OWLRL2DLAxioms>
  <emmo:conceptualisation xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</emmo:elucidation>
  <emmo:note xml:lang="en">A causal path is a concept almost equivalent to the concept of elementary particle in physics.</emmo:note>
</owl:Class>


  <core:prefLabel xml:lang="en">TungstenAtom</core:prefLabel>
  <emmo:elucidation xml:lang="en">Atom subclass for tungsten.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DimensionlessUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasDimensionString"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T0 L0 M0 I0 Θ0 N0 J0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeasurementUnitByDimensionality"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#DimensionalUnit"/>
  <rdfs:label xml:lang="en">DimensionlessUnit</rdfs:label>
  <rdfs:comment xml:lang="en">The subclass of measurement units with no physical dimension.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3227b821_26a5_4c7c_9c01_5c24483e0bd0</core:exactMatch>
  <core:example xml:lang="en">Refractive index
Plane angle
Number of apples</core:example>
  <core:prefLabel xml:lang="en">DimensionlessUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">The subclass of measurement units with no physical dimension.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/vocab/unit/UNITLESS</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MeasurementUnitByDimensionality">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeasurementUnit"/>
  <rdfs:label xml:lang="en">MeasurementUnitByDimensionality</rdfs:label>
  <rdfs:comment xml:lang="en">Categorisation of measurement units by their physical dimensionality.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_611e4040_9a3e_4a1a_9fa2_7b1012269401</core:exactMatch>
  <core:prefLabel xml:lang="en">MeasurementUnitByDimensionality</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: DimensionalUnit or DimensionlessUnit</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">Categorisation of measurement units by their physical dimensionality.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DimensionalUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeasurementUnitByDimensionality"/>
  <rdfs:label xml:lang="en">DimensionalUnit</rdfs:label>
  <rdfs:comment xml:lang="en">A subclass of measurement unit focusing on the physical dimensionality that is carried by the unit.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_cbdea88b_fef1_4c7c_b69f_ae1f0f241c4a</core:exactMatch>
  <core:prefLabel xml:lang="en">DimensionalUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">A subclass of measurement unit focusing on the physical dimensionality that is carried by the unit.</emmo:elucidation>
  <emmo:note xml:lang="en">The current version of EMMO does not provide explicit classes for physical dimensions. Rather it embraces the fact that the physical dimensionality of a physical quantity is carried by its measurement unit.

The role of dimensional unit and its subclasses is to express the physical dimensionality that is carried by the unit.

Since the dimensionality of a physical quantity can be written as the product of powers of the physical dimensions of the base quantities in the selected system of quantities, the physical dimensionality of a measurement unit is uniquely determined by the exponents. For a dimensional unit, at least one of these exponents must be non-zero (making it disjoint from dimensionless units).</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Mobility">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricMobilityUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">Mobility</rdfs:label>
  <rdfs:comment xml:lang="en">Quotient of average drift speed imparted to a charged particle in a medium by an electric field, and the electric field strength.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9b8f36cd_4312_4bc3_a99c_420c00f41550</core:exactMatch>
  <core:prefLabel xml:lang="en">Mobility</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-06-36</emmo:IEVReference>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-02-77</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-61</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quotient of average drift speed imparted to a charged particle in a medium by an electric field, and the electric field strength.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.M03955</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Mobility</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q900648</emmo:wikidataReference>
</owl:Class>


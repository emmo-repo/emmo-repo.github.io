  <core:prefLabel xml:lang="en">MicroPrefixedUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">Superclass for all units prefixed with "micro" (1e-6).</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MetricSubMultipleUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MetricPrefixedUnit"/>
  <rdfs:label xml:lang="en">MetricSubMultipleUnit</rdfs:label>
  <rdfs:comment xml:lang="en">Measurement unit obtained by dividing a given measurement unit by an integer SI prefix greater than one.</rdfs:comment>

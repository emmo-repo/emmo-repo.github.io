<owl:Class rdf:about="https://w3id.org/emmo#InteractingSystem">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#GenericPhysicalSystem"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#ParticlesSystem"/>
  <rdfs:label xml:lang="en">InteractingSystem</rdfs:label>
  <rdfs:comment xml:lang="en">A causally bonded system is a system in which there are at least two causal paths that are interacting.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_09f0ac34_c349_46b5_acf0_0edeae52cca1</core:exactMatch>
  <core:prefLabel xml:lang="en">InteractingSystem</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: PhysicalObject, PhysicalPhenomenon</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A causally bonded system is a system in which there are at least two causal paths that are interacting.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#GenericPhysicalSystem">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CausalSystem"/>
  <rdfs:label xml:lang="en">GenericPhysicalSystem</rdfs:label>
  <rdfs:comment xml:lang="en">A causal system possessing bonding that can not be represented by a simple Feynman diagram.</rdfs:comment>
  <rdfs:comment xml:lang="en">A generic physical system is everything which is more complex than a scattering interaction, or a decay/annihilation event, which are represented by a single Feynman diagram.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b295158f_fda4_4124_ab58_d9ea4ccfca5a</core:exactMatch>
  <core:prefLabel xml:lang="en">GenericPhysicalSystem</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: InteractingSystem, ParticlesSystem</emmo:OWLRL2DLAxioms>
  <emmo:conceptualisation xml:lang="en">A generic physical system is everything which is more complex than a scattering interaction, or a decay/annihilation event, which are represented by a single Feynman diagram.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">A causal system possessing bonding that can not be represented by a simple Feynman diagram.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ParticlesSystem">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#GenericPhysicalSystem"/>
  <rdfs:label xml:lang="en">ParticlesSystem</rdfs:label>
  <rdfs:comment xml:lang="en">A particles system is a system made of causal paths that are not interacting between each others, or possibly merge and fork.</rdfs:comment>
  <core:altLabel xml:lang="en">NonInteractingSystem</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0f19d84e_05b4_47c9_a5de_bb2a913d211b</core:exactMatch>
  <core:example xml:lang="en">A W boson that travels through time and space and decays in a quark and anti-quark, and their evolution after their generation.</core:example>
  <core:prefLabel xml:lang="en">ParticlesSystem</core:prefLabel>
  <emmo:elucidation xml:lang="en">A particles system is a system made of causal paths that are not interacting between each others, or possibly merge and fork.</emmo:elucidation>
  <emmo:note xml:lang="en">A particle system is a combination of elementary particles that may include also decays and/or annihilations, without any space-like interaction between elementary particles.</emmo:note>
</owl:Class>


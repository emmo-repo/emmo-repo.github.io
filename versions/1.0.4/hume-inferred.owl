<owl:Class rdf:about="https://w3id.org/emmo#IonAtom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#StandaloneAtom"/>
  <rdfs:label xml:lang="en">IonAtom</rdfs:label>
  <rdfs:comment xml:lang="en">A standalone atom with an unbalanced number of electrons with respect to its atomic number.</rdfs:comment>
  <rdfs:comment xml:lang="en">The ion_atom is the basic part of a pure ionic bonded compound i.e. without eclectron sharing,</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_db03061b_db31_4132_a47a_6a634846578b</core:exactMatch>
  <core:prefLabel xml:lang="en">IonAtom</core:prefLabel>
  <emmo:elucidation xml:lang="en">A standalone atom with an unbalanced number of electrons with respect to its atomic number.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#StandaloneAtom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Atom"/>
  <rdfs:label xml:lang="en">StandaloneAtom</rdfs:label>
  <rdfs:comment xml:lang="en">A standalone atom can be bonded with other atoms by intermolecular forces (i.e. dipole–dipole, London dispersion force, hydrogen bonding), since this bonds does not involve electron sharing.</rdfs:comment>
  <rdfs:comment xml:lang="en">An atom that does not share electrons with other atoms.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_2fd3f574_5e93_47fe_afca_ed80b0a21ab4</core:exactMatch>
  <core:prefLabel xml:lang="en">StandaloneAtom</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: NeutralAtom, IonAtom</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">An atom that does not share electrons with other atoms.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SolidFoam">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Foam"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SolidMixture"/>
  <rdfs:label xml:lang="en">SolidFoam</rdfs:label>
  <rdfs:comment xml:lang="en">A foam of trapped gas in a solid.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9bed5d66_805a_4b3a_9153_beaf67143848</core:exactMatch>
  <core:example xml:lang="en">Aerogel</core:example>
  <core:prefLabel xml:lang="en">SolidFoam</core:prefLabel>
  <emmo:elucidation xml:lang="en">A foam of trapped gas in a solid.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Foam">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Colloid"/>
  <rdfs:label xml:lang="en">Foam</rdfs:label>
  <rdfs:comment xml:lang="en">A colloid formed by trapping pockets of gas in a liquid or solid.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018</core:exactMatch>
  <core:prefLabel xml:lang="en">Foam</core:prefLabel>
  <emmo:elucidation xml:lang="en">A colloid formed by trapping pockets of gas in a liquid or solid.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SolidMixture">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Mixture"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Solid"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/emmo#Solid"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#Mixture"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">SolidMixture</rdfs:label>
  <core:elucidation xml:lang="en">A physical combination of two or more solid substances that retain their individual chemical properties and are not chemically bonded.</core:elucidation>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_77e2e601_5ecb_450b_b563_92f096997832</core:exactMatch>
  <core:prefLabel xml:lang="en">SolidMixture</core:prefLabel>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ThermalUtilizationFactor">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDimensionlessQuantity"/>
  <rdfs:label xml:lang="en">ThermalUtilizationFactor</rdfs:label>
  <rdfs:comment xml:lang="en">In an infinite medium, the quotient of the number of thermal neutrons absorbed in a fissionable nuclide or in a nuclear fuel, as specified, and the total number of thermal neutrons absorbed.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3657c87f_ee9a_41fd_9dd0_97fb524dba1a</core:exactMatch>
  <core:prefLabel xml:lang="en">ThermalUtilizationFactor</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-76</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">In an infinite medium, the quotient of the number of thermal neutrons absorbed in a fissionable nuclide or in a nuclear fuel, as specified, and the total number of thermal neutrons absorbed.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ThermalUtilizationFactor</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q99197650</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MagneticVectorPotential">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#MagneticPotentialUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">MagneticVectorPotential</rdfs:label>
  <rdfs:comment xml:lang="en">Vector potential of the magnetic flux density.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_1d77524b_ff3f_4e9a_90a4_be3d0bd88855</core:exactMatch>
  <core:prefLabel xml:lang="en">MagneticVectorPotential</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-23</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-32</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Vector potential of the magnetic flux density.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MagneticVectorPotential</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q2299100</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#AmericiumAtom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasAtomicNumber"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasIUPAC2016AtomicMass"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">243.06138</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Atom"/>
  <rdfs:label xml:lang="en">AmericiumAtom</rdfs:label>
  <rdfs:comment xml:lang="en">Atom subclass for americium.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f90da1f3-eb4c-54c4-b5d9-cf00fef180a1</core:exactMatch>
  <core:prefLabel xml:lang="en">AmericiumAtom</core:prefLabel>
  <emmo:elucidation xml:lang="en">Atom subclass for americium.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Atom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasSpatialPart"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Nucleus"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasSpatialPart"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Electron"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MolecularEntity"/>
  <rdfs:label xml:lang="en">Atom</rdfs:label>
  <rdfs:comment xml:lang="en">A standalone atom has direct part one 'nucleus' and one 'electron_cloud'.

An O 'atom' within an O₂ 'molecule' is an 'e-bonded_atom'.

In this material branch, H atom is a particular case, with respect to higher atomic number atoms, since as soon as it shares its electron it has no nucleus entangled electron cloud.

We cannot say that H₂ molecule has direct part two H atoms, but has direct part two H nucleus.</rdfs:comment>
  <core:altLabel xml:lang="en">ChemicalElement</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_eb77076b_a104_42ac_a065_798b2d2809ad</core:exactMatch>
  <core:prefLabel xml:lang="en">Atom</core:prefLabel>
  <emmo:elucidation xml:lang="en">A standalone atom has direct part one 'nucleus' and one 'electron_cloud'.

An O 'atom' within an O₂ 'molecule' is an 'e-bonded_atom'.

In this material branch, H atom is a particular case, with respect to higher atomic number atoms, since as soon as it shares its electron it has no nucleus entangled electron cloud.

We cannot say that H₂ molecule has direct part two H atoms, but has direct part two H nucleus.</emmo:elucidation>
  <emmo:note xml:lang="en">An 'atom' is a 'nucleus' surrounded by an 'electron_cloud', i.e. a quantum system made of one or more bounded electrons.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Activity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Rate"/>
  <rdfs:label xml:lang="en">Activity</rdfs:label>
  <rdfs:comment xml:lang="en">Number dN of spontaneous nuclear transitions or nuclear disintegrations for a radionuclide of amount N produced during a short time interval dt, divided by this time interval.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_c20dd550_7241_4ca4_b5b1_0d300ab03b6c</core:exactMatch>
  <core:prefLabel xml:lang="en">Activity</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=395-01-05</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-27</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Number dN of spontaneous nuclear transitions or nuclear disintegrations for a radionuclide of amount N produced during a short time interval dt, divided by this time interval.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://goldbook.iupac.org/terms/view/A00114</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Activity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q317949</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DeepDrawing">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#TensileForming"/>
  <rdfs:label xml:lang="en">DeepDrawing</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of vessel parts from a flat mould into a three-dimensional shape by means of a press and tools, whereby material is neither removed nor added</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiefziehen</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ecf78412_f0ca_4368_9078_559ffe8935d3</core:exactMatch>
  <core:prefLabel xml:lang="en">DeepDrawing</core:prefLabel>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ChemicalComposition">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ChemicalSymbolicConstruct"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SpatioTemporalTessellation"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/emmo#TotalComposition"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#SingleComponentComposition"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#PartialComposition"/>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">ChemicalComposition</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A language construct that provides information about the consitutents of a substance and their fractions or amounts.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7efd64d1_05a1_49cd_a7f0_783ca050d4f3</core:exactMatch>
  <core:prefLabel xml:lang="en">ChemicalComposition</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A language construct that provides information about the consitutents of a substance and their fractions or amounts.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#NonEncodedContrast">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/contrast#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Contrast"/>
  <rdfs:label xml:lang="en">NonEncodedContrast</rdfs:label>
  <rdfs:comment xml:lang="en">Contrast that occurs naturally without an encoding agent producing it.</rdfs:comment>
  <core:altLabel xml:lang="en">EnvironmentalData</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5a10e288_c6a5_409a_a16a_98a2fb8be4f3</core:exactMatch>
  <core:example xml:lang="en">A cloud in the sky. The radiative spectrum of a star.</core:example>
  <core:prefLabel xml:lang="en">NonEncodedContrast</core:prefLabel>
  <emmo:elucidation xml:lang="en">Contrast that occurs naturally without an encoding agent producing it.</emmo:elucidation>
  <emmo:note xml:lang="en">A non encoded contrast (e.g. a temperature variation) can be represented by data that describes (e.g. the string "today it's warmer than yesterday") or quantifies (e.g. Monday 28 °C, Tuesday 30 °C) it through a semiotic process.</emmo:note>
  <emmo:note xml:lang="en">This is a really broad class that gathers all physical phenomena in which a contrast occurs naturally, such as cloud patterns, tree rings, stains.
It doesn't mean that such contrasts cannot be used to deduce something: in fact they can be seen as indexes (in semiotic sense) of a causally connected phenomena. Simply, there is no agent behind that contrast with the intention to transmit data.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Contrast">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/symbolic#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Perspective"/>
  <rdfs:label xml:lang="en">Contrast</rdfs:label>
  <rdfs:comment xml:lang="en">A perspective in which entities are represented according to the variation of their properties.</rdfs:comment>
  <rdfs:seeAlso xml:lang="en">Luciano Floridi, "Information - A very Short Introduction", Oxford University Press., (2010) ISBN 978-0199551378</rdfs:seeAlso>
  <core:altLabel xml:lang="en">Dedomena</core:altLabel>
  <core:altLabel xml:lang="en">Pattern</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660</core:exactMatch>
  <core:prefLabel xml:lang="en">Contrast</core:prefLabel>
  <emmo:elucidation xml:lang="en">A perspective in which entities are represented according to the variation of their properties.</emmo:elucidation>
  <emmo:note xml:lang="en">A contrast is a causal object whose variations (non-uniformity) can be recognised and eventually interpreted.
A contrast can be of different physical types (e.g., matter, wave, atomic excited states).
How the variations are recognised and eventually decoded depends on the interpreting rules that characterise that type of contrast.
Variations are pure physical variations and do not necessarily possess semantic meaning.</emmo:note>
  <emmo:note xml:lang="en">The covering axiom that defines the contrast class discriminates within all the possible causal objects between encoded contrast (data) or non encoded contrast.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SubProcess">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasSubProcess"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Process"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ProcessByContext"/>
  <rdfs:label xml:lang="en">SubProcess</rdfs:label>
  <rdfs:comment xml:lang="en">A process which is a spatial part of another process.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_49804605_c0fe_4538_abda_f70ba1dc8a5d</core:exactMatch>
  <core:example xml:lang="en">Breathing is a subprocess of living for a human being.</core:example>
  <core:prefLabel xml:lang="en">SubProcess</core:prefLabel>
  <emmo:elucidation xml:lang="en">A process which is a spatial part of another process.</emmo:elucidation>
  <emmo:note xml:lang="en">In the EMMO the relation of participation to a process falls under mereotopology.

Since topological connection means causality, then the only way for a real world object to participate to a process is to be a part of it.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Naming">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasInterpreter"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Namer"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Declaration"/>
  <rdfs:label xml:lang="en">Naming</rdfs:label>
  <rdfs:comment xml:lang="en">A declaration that provides a sign for an object that is independent from any assignment rule.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_e999f9e0_7d63_4564_9028_07246580a267</core:exactMatch>
  <core:example xml:lang="en">A unique id attached to an entity.</core:example>
  <core:prefLabel xml:lang="en">Naming</core:prefLabel>
  <emmo:elucidation xml:lang="en">A declaration that provides a sign for an object that is independent from any assignment rule.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Declaration">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasInterpreter"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Declarer"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasSign"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Conventional"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SemiosisByReferent"/>
  <rdfs:label xml:lang="en">Declaration</rdfs:label>
  <rdfs:comment xml:lang="en">A semiotic process that assigns a sign based on conventions.</rdfs:comment>
  <core:altLabel xml:lang="en">ConventionalSemiosis</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d</core:exactMatch>
  <core:prefLabel xml:lang="en">Declaration</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: Determination or Naming</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A semiotic process that assigns a sign based on conventions.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Tortuosity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#RatioQuantity"/>
  <rdfs:label xml:lang="en">Tortuosity</rdfs:label>
  <rdfs:comment xml:lang="en">Parameter for diffusion and fluid flow in porous media.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_c413d96f_c57b_4c70_9ac1_312db6c009a8</core:exactMatch>
  <core:prefLabel xml:lang="en">Tortuosity</core:prefLabel>
  <emmo:elucidation xml:lang="en">Parameter for diffusion and fluid flow in porous media.</emmo:elucidation>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q2301683</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ContinuumModel">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialsModel"/>
  <rdfs:label xml:lang="en">ContinuumModel</rdfs:label>
  <rdfs:comment xml:lang="en">A physics-based model based on a physics equation describing the behaviour of continuum volume.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4456a5d2_16a6_4ee1_9a8e_5c75956b28ea</core:exactMatch>
  <core:prefLabel xml:lang="en">ContinuumModel</core:prefLabel>
  <emmo:elucidation xml:lang="en">A physics-based model based on a physics equation describing the behaviour of continuum volume.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MaterialsModel">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasSpatialPart"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#MaterialRelation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicsBasedModel"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/emmo#ContinuumModel"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/emmo#MesoscopicModel"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/emmo#ElectronicModel"/>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first rdf:resource="https://w3id.org/emmo#AtomisticModel"/>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdfs:label xml:lang="en">MaterialsModel</rdfs:label>
  <rdfs:comment xml:lang="en">A solvable set of one Physics Equation and one or more Materials Relations.</rdfs:comment>
  <rdfs:seeAlso xml:lang="en">https://op.europa.eu/en/publication-detail/-/publication/ec1455c3-d7ca-11e6-ad7c-01aa75ed71a1</rdfs:seeAlso>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_90f18cf0_1225_4c64_b5f8_f65cd7f992c5</core:exactMatch>
  <core:prefLabel xml:lang="en">MaterialsModel</core:prefLabel>
  <emmo:elucidation xml:lang="en">A solvable set of one Physics Equation and one or more Materials Relations.</emmo:elucidation>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#ActiniumAtom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasIUPAC2016AtomicMass"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">227.02775</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasAtomicNumber"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">89</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>

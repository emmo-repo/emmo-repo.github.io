  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Multiplex"/>
  <rdfs:label xml:lang="en">Nuclear</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have a proper parts of the same type of the whole that is part of all the other proper parts of the same type.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8f449738_cedb_436c_bdec_1c8e78bdb644</core:exactMatch>
  <core:prefLabel xml:lang="en">Nuclear</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for all classes of entities that have a proper parts of the same type of the whole that is part of all the other proper parts of the same type.</emmo:elucidation>
</owl:Class>


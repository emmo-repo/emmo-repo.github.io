  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4db96fb7_e9e0_466d_942b_f6f17bfdc145</core:exactMatch>
  <core:prefLabel xml:lang="en">DigitalData</core:prefLabel>
  <emmo:elucidation xml:lang="en">Discrete data that are decoded as a sequence of 1/0, or true/false, or on/off.</emmo:elucidation>
</owl:Class>


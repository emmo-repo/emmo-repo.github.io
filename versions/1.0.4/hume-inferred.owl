  <rdfs:label xml:lang="en">definition</rdfs:label>
  <rdfs:comment xml:lang="en">Precise and univocal description of an ontological entity in the framework of an axiomatic system.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#definition</core:exactMatch>
  <core:prefLabel xml:lang="en">definition</core:prefLabel>
  <emmo:elucidation xml:lang="en">Precise and univocal description of an ontological entity in the framework of an axiomatic system.</emmo:elucidation>
  <emmo:note xml:lang="en">A definition univocally determines a OWL entity using necessary and sufficient conditions referring to other OWL entities.</emmo:note>
</owl:AnnotationProperty>


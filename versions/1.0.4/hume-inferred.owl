  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_af7b627d_6528_4fdb_97df_ba4579c4bb5d</core:exactMatch>
  <core:example xml:lang="en">HTML</core:example>
  <core:prefLabel xml:lang="en">MarkupLanguage</core:prefLabel>
  <emmo:elucidation xml:lang="en">A grammar for annotating a document in a way that is syntactically distinguishable from the text.</emmo:elucidation>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Markup_language</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#JosephsonConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricCurrentPerEnergyUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIExactConstant"/>
  <rdfs:label xml:lang="en">JosephsonConstant</rdfs:label>
  <rdfs:comment xml:lang="en">Inverse of the magnetic flux quantum.</rdfs:comment>
  <rdfs:comment xml:lang="en">The DBpedia definition (http://dbpedia.org/page/Magnetic_flux_quantum) is outdated as May 20, 2019. It is now an exact quantity.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ba380bc6_2bfd_4f11_94c7_b3cbaafd1631</core:exactMatch>
  <core:prefLabel xml:lang="en">JosephsonConstant</core:prefLabel>
  <emmo:elucidation xml:lang="en">Inverse of the magnetic flux quantum.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/constant/JosephsonConstant</emmo:qudtReference>
</owl:Class>


  <core:prefLabel xml:lang="en">RadialDistance</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-01-26</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-1.9</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Distance, where one point is located on an axis or within a closed non self-intersecting curve or surface.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/RadialDistance</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q1578234</emmo:wikidataReference>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#AngularDisplacement">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDimensionlessQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SpaceAndTimeQuantity"/>
  <rdfs:label xml:lang="en">AngularDisplacement</rdfs:label>
  <rdfs:comment xml:lang="en">The angle through which a body rotates around an axis of rotation.</rdfs:comment>
  <core:altLabel xml:lang="en">Angular displacement may be signed, indicating the sense of rotation (e.g., clockwise); it may also be greater (in absolute value) than a full turn.</core:altLabel>
  <core:altLabel xml:lang="en">Rotation</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_16d72037_3243_4018_ac6c_0015f661d3c3</core:exactMatch>
  <core:prefLabel xml:lang="en">AngularDisplacement</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=102-05-22</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-14</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">The angle through which a body rotates around an axis of rotation.</emmo:elucidation>
  <emmo:note xml:lang="en">Angular displacement may also be defined as number of turns (not necessarily an integer number).</emmo:note>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q76435127</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#AnalogData">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/data#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#DataByDiscretness"/>
  <rdfs:label xml:lang="en">AnalogData</rdfs:label>
  <rdfs:comment xml:lang="en">Data that are decoded retaining its continuous variations characteristic.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0d1c0018_42e2_4506_bc3d_f53c117c1ad3</core:exactMatch>
  <core:example xml:lang="en">A vynil contain continuous information about the recorded sound.</core:example>
  <core:prefLabel xml:lang="en">AnalogData</core:prefLabel>
  <emmo:elucidation xml:lang="en">Data that are decoded retaining its continuous variations characteristic.</emmo:elucidation>
  <emmo:note xml:lang="en">The fact that there may be a finite granularity in the variations of the material basis (e.g. the smallest peak in a vynil that can be recognized by the piezo-electric transducer) does not prevent a data to be analog. It means only that the focus on such data encoding is on a scale that makes such variations negligible, making them practically a continuum.</emmo:note>
</owl:Class>


  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_fd4a6307_f9f7_4b54_b044_caa04e620232</core:exactMatch>
  <core:prefLabel xml:lang="en">LowerCriticalMagneticFluxDensity</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-36.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">For type II superconductors, the threshold magnetic flux density for magnetic flux entering the superconductor.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/LowerCriticalMagneticFluxDensity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q106127355</emmo:wikidataReference>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#RestEnergy">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Energy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RestEnergy</rdfs:label>
  <rdfs:comment xml:lang="en">Product of the rest mass and the square of the speed of light in vacuum.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5117c5fe_f661_46f8_83c3_b48947f1532a</core:exactMatch>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RestEnergy</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-05</emmo:IEVReference>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-04-17</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-3</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Product of the rest mass and the square of the speed of light in vacuum.</emmo:elucidation>
  <emmo:note xml:lang="en">E_0 = m_0 * c_0^2

where m_0 is the rest mass of that particle and c_0 is the speed of light in a vacuum.</emmo:note>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q11663629</emmo:wikidataReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Invariant_mass#Rest_energy</emmo:wikipediaReference>
</owl:Class>


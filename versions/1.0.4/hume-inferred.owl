    <rdf:Description rdf:about="https://w3id.org/emmo#Time"/>
    <rdf:Description rdf:about="https://w3id.org/emmo#Mass"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#note"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#ThermalCutting"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-4:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal ablation is the separation of material particles in solid, liquid or gaseous state by heat processes as well as the removal of these material particles by mechanical or electromagnetic forces (from: DIN</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#note"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#isCauseOf"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doi:10.3233/FAIA231120</rdfs:seeAlso>
  <owl:annotatedTarget xml:lang="en">The OWL 2 DL version of the EMMO introduces this object property as primitive causal relation. It refers to the macro causality relation mC(x,y), defined in the EMMO FOL version.
While the EMMO FOL introduces the quantum causality relation C(x,y) as primitive, the OWL 2 DL version of the EMMO substantially simplifies the theory, neglecting these lower level relations that are well above DL expressivity.
For this reason the EMMO OWL 2 DL will only deal with macro causality relations, sacrificing the full FOL theory expressivity for the sake of simplicity.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Software"/>
  <owl:annotatedTarget xml:lang="en">Software</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From soft +‎ -ware, by contrast with hardware (“the computer itself”). Coined by Paul Niquette in 1953.</emmo:etymology>
</owl:Axiom>

<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:classPredicate rdf:resource="https://w3id.org/emmo#EMMO"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#x"/>
          <swrl:propertyPredicate rdf:resource="https://w3id.org/emmo#isNotCauseOf"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <emmo:note xml:lang="en">Enforcing the fact that an entity cannot cause itself.</emmo:note>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#TechnologyProcess"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EN 16603-11:2019-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">application of scientific knowledge, tools, techniques, crafts, systems or methods of organization in order to solve a problem or achieve an objective</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#elucidation"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Variable"/>
  <owl:annotatedTarget xml:lang="en">A variable is a symbolic object that stands for any other mathematical object, such as  number, a vector, a matrix, a function, the argument of a function, a set, an element of a set.</owl:annotatedTarget>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Variable_(mathematics)</emmo:wikipediaReference>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#PhysicsBasedSimulation"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cencenelec.eu/media/CEN-CENELEC/CWAs/RI/cwa17284_2018.pdf</rdfs:seeAlso>
  <owl:annotatedTarget xml:lang="en">CEN Workshop Agreement – CWA 17284 “Materials modelling – terminology, classification and metadata”</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#mereological"/>
  <owl:annotatedTarget xml:lang="en">mereological</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">Coined by Stanisław Leśniewski in 1927, from Ancient Greek μέρος (méros, “part”) +‎ -logy (“study, discussion, science”).
https://en.wiktionary.org/wiki/mereology</emmo:etymology>
</owl:Axiom>


  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-35.3</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Sum of canonical partition function Z (NA,NB,…) for the given number of particles A, B, ... multiplied by absolute activities of particles A, B, ...</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/GrandCanonicalPartitionFunction</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q96176022</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Molality">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#AmountPerMassUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicoChemicalQuantity"/>
  <rdfs:label xml:lang="en">Molality</rdfs:label>
  <rdfs:comment xml:lang="en">quotient of the amount of substance nB of solute B by the mass m of the solvent: bB = nB / m.</rdfs:comment>
  <core:altLabel xml:lang="en">AmountPerMass</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ead7c629_824a_410f_afec_579f08894c78</core:exactMatch>
  <core:prefLabel xml:lang="en">Molality</core:prefLabel>
  <emmo:IEVReference xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-01-19</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-15</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">quotient of the amount of substance nB of solute B by the mass m of the solvent: bB = nB / m.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.M03970</emmo:iupacReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q172623</emmo:wikidataReference>
</owl:Class>


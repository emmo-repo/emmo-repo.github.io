<owl:NamedIndividual rdf:about="https://w3id.org/emmo#universe">
  <rdf:type rdf:resource="https://w3id.org/emmo#CausalSystem"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:label xml:lang="en">universe</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u ≡ σx⟨P(x, x)⟩</rdfs:comment>
  <rdfs:comment xml:lang="en">The universe is considered as a causally self-connected object, encompassing all other objects. For this reason is unique.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918</core:exactMatch>
  <core:prefLabel xml:lang="en">universe</core:prefLabel>
  <emmo:conceptualisation xml:lang="en">The universe is considered as a causally self-connected object, encompassing all other objects. For this reason is unique.</emmo:conceptualisation>
  <emmo:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u ≡ σx⟨P(x, x)⟩</emmo:definition>
</owl:NamedIndividual>


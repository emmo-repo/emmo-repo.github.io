  <core:prefLabel xml:lang="en">Simulation</core:prefLabel>
  <emmo:elucidation xml:lang="en">A estimation of a property using a functional icon.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Estimation">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasInterpreter"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Estimator"/>
    </owl:Restriction>
  </rdfs:subClassOf>

<owl:Class rdf:about="https://w3id.org/emmo#ElectricFieldStrength">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricFieldStrengthUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>

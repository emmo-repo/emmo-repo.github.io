  <core:prefLabel xml:lang="en">ActivityDensity</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=395-01-09</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-29</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Activity per unit volume of the sample.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ActivityConcentration</emmo:qudtReference>

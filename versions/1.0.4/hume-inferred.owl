  <emmo:etymology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Latin digitus (“finger”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#isProperPartOf"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#definition"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Quantum"/>
  <owl:annotatedTarget xml:lang="en">Q(x) ≡ ¬∃y(PP(y,x))</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#TechnologyProcess"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Technology</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technology is the application of knowledge for achieving practical goals in a reproducible way.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>

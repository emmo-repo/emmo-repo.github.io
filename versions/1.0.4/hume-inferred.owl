  <rdfs:label xml:lang="en">hasReferent</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between a semiotic process and the referent i.e., the object of the semiotic process.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8fb6d667_f2af_482d_97a9_ec97cd81274d</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasReferent</core:exactMatch>
  <core:prefLabel xml:lang="en">hasReferent</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a semiotic process and the referent i.e., the object of the semiotic process.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasUnintentionalAgent">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#UnintentionalAgent"/>

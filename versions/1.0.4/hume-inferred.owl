    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/emmo#Symbol"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#MeasurementUnit"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">UnitSymbol</rdfs:label>
  <rdfs:comment xml:lang="en">A symbol that stands for a single unit.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_216f448e_cdbc_4aeb_a529_7a5fe7fc38bb</core:exactMatch>
  <core:example xml:lang="en">Some examples are "Pa", "m" and "J".</core:example>
  <core:prefLabel xml:lang="en">UnitSymbol</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: SpecialUnit, BaseUnit</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A symbol that stands for a single unit.</emmo:elucidation>
</owl:Class>


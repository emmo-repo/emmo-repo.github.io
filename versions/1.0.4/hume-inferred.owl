  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-27.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">In a metal, highest occupied energy level at zero thermodynamic temperature, where energy level means the energy of an electron in the interior of a substance.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.F02340</emmo:iupacReference>

<owl:Class rdf:about="https://w3id.org/emmo#MesoscopicSubstance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Substance"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#ContinuumSubstance"/>
  <rdfs:label xml:lang="en">MesoscopicSubstance</rdfs:label>
  <rdfs:comment xml:lang="en">A matter that is not a particulate matter and that does not fullfill the criteria of being a continuum substance.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_660a4964_0333_4663_bc66_e93ef59b0679</core:exactMatch>
  <core:example xml:lang="en">nanoparticle,
quantum dot,
carbon nanotupe</core:example>
  <core:prefLabel xml:lang="en">MesoscopicSubstance</core:prefLabel>
  <emmo:elucidation xml:lang="en">A matter that is not a particulate matter and that does not fullfill the criteria of being a continuum substance.</emmo:elucidation>
  <emmo:note xml:lang="en">Mesoscopic substances typically exist on a length scale between atoms and molecules and macroscopic (bulk) substances. They are typically in the range of some nanometers to about a micrometer and often exhibit unique physical properties due to their size and shape.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Luminance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#LuminanceUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">Luminance</rdfs:label>
  <rdfs:comment xml:lang="en">A photometric measure of the luminous intensity per unit area of light travelling in a given direction.</rdfs:comment>
  <rdfs:comment xml:lang="en">Measured in cd/m². Not to confuse with Illuminance, which is measured in lux (cd sr/m²).</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_97589322_710c_4af4_9431_1e5027f2be42</core:exactMatch>
  <core:prefLabel xml:lang="en">Luminance</core:prefLabel>
  <emmo:elucidation xml:lang="en">A photometric measure of the luminous intensity per unit area of light travelling in a given direction.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.L03640</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/Luminance</emmo:qudtReference>
</owl:Class>


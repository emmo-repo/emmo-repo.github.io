  <rdfs:comment xml:lang="en">Relates a dataset to its datum.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b19aacfc_5f73_4c33_9456_469c1e89a53e</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasDatum</core:exactMatch>

  <rdfs:range rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasOutput"/>
  <rdfs:label xml:lang="en">hasProcessOutput</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between a process P1 that proper overlaps a process P2, where the non-overlapping part of P2 is caused by P1.</rdfs:comment>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Drilling"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8589-2:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">machining with a circular cutting movement in which the axis of rotation of the tool and the axis of the internal surface to be produced are identical and the feed movement is in the direction of this axis. The axis of rotation of the cutting movement maintains its position relative to the workpiece independently of the feed movement (axis of rotation workpiece-bound).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Computation"/>
  <owl:annotatedTarget xml:lang="en">Computation</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin con- +‎ putō (“I reckon”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#DeepDrawing"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 13831:2007-12</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of vessel parts from a flat mould into a three-dimensional shape by means of a press and tools, whereby material is neither removed nor added</owl:annotatedTarget>
</owl:Axiom>


</rdf:RDF>

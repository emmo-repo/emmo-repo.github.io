  <rdfs:label xml:lang="en">hasMeasuredObject</rdfs:label>
  <rdfs:comment xml:lang="en">Relates a measurement to the measured object (referent).</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ae081613_1d3a_49af_ba03_7195fcc9ebba</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasMeasuredObject</core:exactMatch>
  <core:prefLabel xml:lang="en">hasMeasuredObject</core:prefLabel>
  <emmo:elucidation xml:lang="en">Relates a measurement to the measured object (referent).</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasReferent">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Semiosis"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

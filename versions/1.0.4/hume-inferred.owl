<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Collection"/>
  <owl:annotatedTarget xml:lang="en">Collection</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin collectio, from colligere ‘gather together’.</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Device"/>
  <owl:annotatedTarget xml:lang="en">Device</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Old French "deviser", meaning: arrange, plan, contrive. Literally "dispose in portions," from Vulgar Latin "divisare", frequentative of Latin dividere, meaning "to divide".</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#hasRedundantPart"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#note"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#hasDistinctPart"/>
  <owl:annotatedTarget xml:lang="en">A part is always distinct xor redundant.</owl:annotatedTarget>
</owl:Axiom>


  <emmo:elucidation xml:lang="en">The class of units with dimensionality 'ElectricResistivity'.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#AtomicMass">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom rdf:resource="https://w3id.org/emmo#Atom"/>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasProperty"/>
        </rdf:Description>
      </owl:onProperty>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Mass"/>
  <rdfs:label xml:lang="en">AtomicMass</rdfs:label>
  <rdfs:comment xml:lang="en">Since the nucleus account for nearly all of the total mass of atoms  (with the electrons and nuclear binding energy making minor contributions), the atomic mass measured in Da has nearly the same value as the mass number.</rdfs:comment>
  <rdfs:comment xml:lang="en">The atomic mass is often expressed as an average of the commonly found isotopes.</rdfs:comment>
  <rdfs:comment xml:lang="en">The mass of an atom in the ground state.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_27367073_ed8a_481a_9b07_f836dfe31f7f</core:exactMatch>
  <core:prefLabel xml:lang="en">AtomicMass</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-4.1</emmo:ISO80000Reference>
  <emmo:definition xml:lang="en">The mass of an atom in the ground state.</emmo:definition>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.A00496</emmo:iupacReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Atomic_mass</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Array3D">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>

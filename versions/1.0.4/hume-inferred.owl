<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Role"/>
  <owl:annotatedTarget xml:lang="en">Part</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin partire, partiri ‘divide, share’.</emmo:etymology>
  <emmo:note xml:lang="en">The term 'part' is here intended not only in mereological sense but also as role. For example. the term part is used to define the role played by an actor, specifying not only a mereological participation of the actor to an act, but also a specific role for that actor.</emmo:note>
</owl:Axiom>


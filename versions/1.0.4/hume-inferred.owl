  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_64963ed6_39c9_4258_85e0_6466c4b5420c</core:exactMatch>
  <core:prefLabel xml:lang="en">Workflow</core:prefLabel>
  <emmo:elucidation xml:lang="en">A procedure that has at least two procedures (tasks) as proper parts.</emmo:elucidation>
</owl:Class>


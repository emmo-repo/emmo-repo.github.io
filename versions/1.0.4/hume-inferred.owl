  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_643d99dd_fae6_4121_a76f_47f486a4480b</core:exactMatch>
  <core:prefLabel xml:lang="en">ChemicalNomenclature</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A language object following a specific nomenclature rules for defining univocal names of chemical compounds.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MeanFreePathOfElectrons">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatterPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeanFreePath"/>
  <rdfs:label xml:lang="en">MeanFreePathOfElectrons</rdfs:label>
  <rdfs:comment xml:lang="en">Average distance that electrons travel between two successive interactions.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8e08b6d4_da0f_4722_a69a_301f2246546c</core:exactMatch>
  <core:prefLabel xml:lang="en">MeanFreePathOfElectrons</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-15.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Average distance that electrons travel between two successive interactions.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectronMeanFreePath</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q105672307</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MeanFreePath">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PathLength"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicoChemicalQuantity"/>
  <rdfs:label xml:lang="en">MeanFreePath</rdfs:label>
  <rdfs:comment xml:lang="en">The mean free path may thus be specified either for all interactions, i.e. total mean free path, or for particular types of interaction such as scattering, capture, or ionization.</rdfs:comment>
  <rdfs:comment xml:lang="en">in a given medium, average distance that particles of a specified type travel between successive interactions of a specified type.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_adc5aa0d_9add_4c8a_aa81_b5798a654ca9</core:exactMatch>
  <core:prefLabel xml:lang="en">MeanFreePath</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-06-37</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-38</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">in a given medium, average distance that particles of a specified type travel between successive interactions of a specified type.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.M03778</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MeanFreePath</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q756307</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#TokenData">

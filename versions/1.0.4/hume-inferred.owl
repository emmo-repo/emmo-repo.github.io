<owl:Class rdf:about="https://w3id.org/emmo#ElectricImpedance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectricResistance"/>
  <rdfs:label xml:lang="en">ElectricImpedance</rdfs:label>
  <rdfs:comment xml:lang="en">Measure of the opposition that a circuit presents to a current when a voltage is applied.</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Impedance</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_79a02de5_b884_4eab_bc18_f67997d597a2</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricImpedance</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-12-43</emmo:IEVReference>
  <emmo:ISO80000Reference xml:lang="en">6-51.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Measure of the opposition that a circuit presents to a current when a voltage is applied.</emmo:elucidation>

  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasDimensionString"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T0 L+2 M0 I+1 Θ0 N0 J0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIDimensionalUnit"/>
  <rdfs:label xml:lang="en">ElectricCurrentAreaUnit</rdfs:label>

<owl:Class rdf:about="https://w3id.org/emmo#StaticFrictionCoefficient">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CoefficientOfFriction"/>
  <rdfs:label xml:lang="en">StaticFrictionCoefficient</rdfs:label>
  <rdfs:comment xml:lang="en">Proportionality factor between the maximum magnitude of the tangential component of the static friction force and the magnitude of the normal component of the contact force between two bodies at relative rest with respect to each other.</rdfs:comment>
  <core:altLabel xml:lang="en">CoefficientOfStaticFriction</core:altLabel>
  <core:altLabel xml:lang="en">StaticFrictionFactor</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b7229683_d2c5_4225_8e5f_7693744fd5a2</core:exactMatch>
  <core:prefLabel xml:lang="en">StaticFrictionCoefficient</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-33</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-23.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Proportionality factor between the maximum magnitude of the tangential component of the static friction force and the magnitude of the normal component of the contact force between two bodies at relative rest with respect to each other.</emmo:elucidation>
  <emmo:note xml:lang="en">When it is not necessary to distinguish between dynamic friction factor and static friction factor, the name friction factor may be used for both.</emmo:note>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q73695673</emmo:wikidataReference>
</owl:Class>


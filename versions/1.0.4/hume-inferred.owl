  <core:prefLabel xml:lang="en">Baryon</core:prefLabel>
  <emmo:elucidation xml:lang="en">Subatomic particle which contains an odd number of valence quarks, at least 3.</emmo:elucidation>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Baryon</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Hadron">

  <rdfs:label xml:lang="en">OWLRL2DLAxioms</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#OWLRL2DLAxioms</core:exactMatch>
  <core:prefLabel xml:lang="en">OWLRL2DLAxioms</core:prefLabel>
  <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Axioms to add to the OWL 2 RL version of the ontology to reach DL expressivity.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
</owl:AnnotationProperty>


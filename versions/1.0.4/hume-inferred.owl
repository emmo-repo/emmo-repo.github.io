  <emmo:elucidation xml:lang="en">Arithmetic average of (electric field strength multiplied by electric flux density) and (magnetic field strength multiplied by magnetic flux density).</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q77989624</emmo:wikidataReference>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#NominalProperty">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Objective"/>
  <rdfs:label xml:lang="en">NominalProperty</rdfs:label>
  <rdfs:comment xml:lang="en">"Property of a phenomenon, body, or substance, where the property has no magnitude."

"A nominal property has a value, which can be expressed in words, by alphanumerical codes, or by other means."

International vocabulary of metrology (VIM)</rdfs:comment>
  <rdfs:comment xml:lang="en">An 'ObjectiveProperty' that cannot be quantified.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_909415d1_7c43_4d5e_bbeb_7e1910159f66</core:exactMatch>
  <core:example xml:lang="en">CFC is a 'sign' that stands for the fact that the morphology of atoms composing the microstructure of an entity is predominantly Cubic Face Centered

A color is a nominal property.

Sex of a human being.</core:example>
  <core:prefLabel xml:lang="en">NominalProperty</core:prefLabel>
  <emmo:VIMTerm xml:lang="en">nominal property</emmo:VIMTerm>
  <emmo:elucidation xml:lang="en">An 'ObjectiveProperty' that cannot be quantified.</emmo:elucidation>
</owl:Class>


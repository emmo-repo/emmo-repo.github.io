  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-20</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Measure of the relative volume change of a fluid or solid as a response to a pressure change.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Compressibility</emmo:qudtReference>

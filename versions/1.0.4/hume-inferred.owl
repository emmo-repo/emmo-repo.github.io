  <rdfs:label xml:lang="en">Plus</rdfs:label>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8de14a59_660b_454f_aff8_76a07ce185f4</core:exactMatch>
  <core:prefLabel xml:lang="en">Plus</core:prefLabel>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#Yocto">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#numberValue"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1e-24</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#unitSymbolValue"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">y</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#DoubleData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#LanguageData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NCNameData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NMTOKENData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SISubMultiplePrefix"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#UnitSymbol"/>
  <rdfs:label xml:lang="en">Yocto</rdfs:label>
  <rdfs:comment xml:lang="en">SI prefix who's value is 1e-24.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7abfbbc4_ce7b_4611_b731_1b5b8bd2bbc0</core:exactMatch>
  <core:prefLabel xml:lang="en">Yocto</core:prefLabel>
  <emmo:elucidation xml:lang="en">SI prefix who's value is 1e-24.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DoubleData">

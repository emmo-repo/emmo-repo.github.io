<owl:Class rdf:about="https://w3id.org/emmo#SurfaceTension">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ForcePerLengthUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MechanicalQuantity"/>
  <rdfs:label xml:lang="en">SurfaceTension</rdfs:label>
  <rdfs:comment xml:lang="en">The tendency of liquid surfaces at rest to shrink into the minimum surface area possible.</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-26</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8864793d_0f36_4fa3_b54a_90d0234f976a</core:exactMatch>
  <core:prefLabel xml:lang="en">SurfaceTension</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-42</emmo:IEVReference>
  <emmo:elucidation xml:lang="en">The tendency of liquid surfaces at rest to shrink into the minimum surface area possible.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.S06192</emmo:iupacReference>
  <emmo:note xml:lang="en">Surface tension is a contractive tendency of the surface of a liquid that allows it to resist an external force.

-- QUDT</emmo:note>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/SurfaceTension</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q170749</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SlowingDownArea">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Area"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:label xml:lang="en">SlowingDownArea</rdfs:label>
  <rdfs:comment xml:lang="en">In an infinite homogenous medium, one-sixth of the mean square of the distance between the neutron source and the point where a neutron reaches a given energy.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_6d7158f3_7d96_498f_9cf3_31f4798f31c6</core:exactMatch>
  <core:prefLabel xml:lang="en">SlowingDownArea</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-72.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">In an infinite homogenous medium, one-sixth of the mean square of the distance between the neutron source and the point where a neutron reaches a given energy.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/Slowing-DownArea</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98950918</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#CelsiusTemperature">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#TemperatureUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Intensive"/>
  <rdfs:label xml:lang="en">CelsiusTemperature</rdfs:label>
  <rdfs:comment xml:lang="en">An objective comparative measure of hot or cold.

Temperature is a relative quantity that can be used to express temperature differences. Unlike ThermodynamicTemperature, it cannot express absolute temperatures.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_66bc9029_f473_45ff_bab9_c3509ff37a22</core:exactMatch>
  <core:prefLabel xml:lang="en">CelsiusTemperature</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">An objective comparative measure of hot or cold.

Temperature is a relative quantity that can be used to express temperature differences. Unlike ThermodynamicTemperature, it cannot express absolute temperatures.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.T06261</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/CelciusTemperature</emmo:qudtReference>
</owl:Class>


  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-10.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Coefficient of heat transfer when heat exchange takes place between a body at thermodynamic temperature Ts and its surroundings that are at a reference temperature Tr.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/SurfaceCoefficientOfHeatTransfer</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q74770365</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#StructuralFormula">

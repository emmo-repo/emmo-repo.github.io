  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/symbolic#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#IntegerData"/>
  <rdfs:label xml:lang="en">NonNegativeIntegerData</rdfs:label>
  <rdfs:comment xml:lang="en">A data representing an integer number &gt;= 0.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/xmlschema11-2/#nonNegativeInteger</rdfs:seeAlso>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_42eee73b_e4d2_4a0f_b468_3d2ce0475af6</core:exactMatch>
  <core:prefLabel xml:lang="en">NonNegativeIntegerData</core:prefLabel>

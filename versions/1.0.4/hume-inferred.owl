<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasMetricPrefix">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#PrefixedUnit"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>

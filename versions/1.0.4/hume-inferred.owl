<owl:Class rdf:about="https://w3id.org/emmo#Index">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasSign"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Deduction"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SignByReferent"/>
  <rdfs:label xml:lang="en">Index</rdfs:label>
  <rdfs:comment xml:lang="en">A 'Sign' that stands for an 'Object' due to causal continguity.</rdfs:comment>
  <core:altLabel xml:lang="en">Signal</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0cd58641_824c_4851_907f_f4c3be76630c</core:exactMatch>
  <core:example xml:lang="en">Smoke stands for a combustion process (a fire).
My facial expression stands for my emotional status.</core:example>
  <core:prefLabel xml:lang="en">Index</core:prefLabel>
  <emmo:elucidation xml:lang="en">A 'Sign' that stands for an 'Object' due to causal continguity.</emmo:elucidation>
</owl:Class>


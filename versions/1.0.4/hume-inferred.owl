<owl:Class rdf:about="https://w3id.org/emmo#HeatCapacity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EntropyUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ThermodynamicalQuantity"/>
  <rdfs:label xml:lang="en">HeatCapacity</rdfs:label>
  <rdfs:comment xml:lang="en">Examples of condition might be constant volume or constant pressure for a gas.</rdfs:comment>
  <rdfs:comment xml:lang="en">Quantity C = dQ/dT, when the thermodynamic temperature of a system is increased by dT as a result of the addition of a amount of heat dQ, under given condition.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_802c167d_b792_4cb8_a315_35797345c0e3</core:exactMatch>
  <core:prefLabel xml:lang="en">HeatCapacity</core:prefLabel>

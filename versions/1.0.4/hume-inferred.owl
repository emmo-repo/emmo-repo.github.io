<owl:Class rdf:about="https://w3id.org/emmo#ComputerScience">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Language"/>
  <rdfs:label xml:lang="en">ComputerScience</rdfs:label>
  <rdfs:comment xml:lang="en">A well-formed formula that follows the syntactic rules of computer science.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b45fbdc6_2519_4885_aa49_c56b394c3910</core:exactMatch>
  <core:prefLabel xml:lang="en">ComputerScience</core:prefLabel>
  <emmo:elucidation xml:lang="en">A well-formed formula that follows the syntactic rules of computer science.</emmo:elucidation>
  <emmo:note xml:lang="en">A well-formed formula in computer science may be or not be interpreted by a computer. For example pseudo-code is only intended for human consumption.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Suspension">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Dispersion"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhaseHeterogeneousMixture"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#StateOfMatter"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/emmo#SolidSolidSuspension"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/emmo#SolidLiquidSuspension"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/emmo#LiquidGasSuspension"/>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first rdf:resource="https://w3id.org/emmo#LiquidLiquidSuspension"/>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first rdf:resource="https://w3id.org/emmo#SolidGasSuspension"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first rdf:resource="https://w3id.org/emmo#GasSolidSuspension"/>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first rdf:resource="https://w3id.org/emmo#GasLiquidSuspension"/>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:first rdf:resource="https://w3id.org/emmo#LiquidSolidSuspension"/>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdfs:label xml:lang="en">Suspension</rdfs:label>
  <rdfs:comment xml:lang="en">An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase.</rdfs:comment>
  <rdfs:comment xml:lang="en">Suspensions show no significant effect on light.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd</core:exactMatch>
  <core:prefLabel xml:lang="en">Suspension</core:prefLabel>
  <emmo:elucidation xml:lang="en">An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase.</emmo:elucidation>
</owl:Class>


  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isIncomingOverlappedBy"/>
  <rdfs:label xml:lang="en">isJoinedBy</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between an object O that proper overlaps an item I, where the non-overlapping part of I causes O.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_86726b7c_b208_4690_893e_0cc798fac974</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#isJoinedBy</core:exactMatch>
  <core:prefLabel xml:lang="en">isJoinedBy</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between an object O that proper overlaps an item I, where the non-overlapping part of I causes O.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://raw.githubusercontent.com/emmo-repo/EMMO/master/doc/figs/isJoinedBy.png</emmo:illustration>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#influences">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#joins"/>
  <rdfs:label xml:lang="en">influences</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between a process P that proper overlaps an object O, where the non overlapping part of P is cause of O.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3c51ea74_43a4_42d5_953b_fcb43f359c73</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#influences</core:exactMatch>
  <core:prefLabel xml:lang="en">influences</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a process P that proper overlaps an object O, where the non overlapping part of P is cause of O.</emmo:elucidation>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasProperPart">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasPart"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#overcrosses"/>
  <rdfs:label xml:lang="en">hasProperPart</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between an entity and one of its parts, when both entities are distinct.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9380ab64_0363_4804_b13f_3a8a94119a76</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasProperPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasProperPart</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between an entity and one of its parts, when both entities are distinct.</emmo:elucidation>
  <emmo:note xml:lang="en">The proper part relation has the following pair-covering sub-relations:
- hasMembers xor hasPiece
- hasPortionPart xor hasGatheredPart
. hasItemPart xor hasScatteredPart</emmo:note>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasProcessOutput">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

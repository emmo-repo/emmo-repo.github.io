  <emmo:elucidation xml:lang="en">Relates a dataset to its datum.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasMember">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Collection"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasProperPart"/>
  <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#hasPiece"/>
  <rdfs:label xml:lang="en">hasMember</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relation between individuals representing a collection and one or more of its members.</rdfs:comment>
  <rdfs:comment xml:lang="en">A proper part which is not connected with the rest of the whole.</rdfs:comment>
  <core:altLabel xml:lang="en">hasMaximalPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_33fd15ab_7662_4cc6_8bf6_988422efc631</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasMember</core:exactMatch>
  <core:prefLabel xml:lang="en">hasMember</core:prefLabel>
  <emmo:definition xml:lang="en">A proper part which is not connected with the rest of the whole.</emmo:definition>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relation between individuals representing a collection and one or more of its members.</emmo:elucidation>
  <emmo:note xml:lang="en">A maximal part is a proper part that is not connected with the rest of the whole.</emmo:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasTask">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Workflow"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Task"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasRole"/>
  <rdfs:label xml:lang="en">hasTask</rdfs:label>
  <rdfs:comment xml:lang="en">The holistic relation connecting a workflow with one of its tasks.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_70da982d_1810_4b01_9630_a28e216ecd9a</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasTask</core:exactMatch>
  <core:prefLabel xml:lang="en">hasTask</core:prefLabel>
  <emmo:conceptualisation xml:lang="en">The holistic relation connecting a workflow with one of its tasks.</emmo:conceptualisation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasRole">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Whole"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/holistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Role"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasQualifiedRole"/>
  <rdfs:label xml:lang="en">hasRole</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between the whole and a proper part of the whole that scale down to the point which it lose the characteristics of the whole and become something else.</rdfs:comment>
  <core:altLabel xml:lang="en">hasHolisticPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasRole</core:exactMatch>
  <core:example xml:lang="en">An holistic part of water fluid is a water molecule.</core:example>
  <core:prefLabel xml:lang="en">hasRole</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between the whole and a proper part of the whole that scale down to the point which it lose the characteristics of the whole and become something else.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasStatus">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Status"/>

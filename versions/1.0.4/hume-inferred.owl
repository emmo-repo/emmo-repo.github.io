<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasPortion">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Object"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Redundant"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/persholistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Object"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasRedundantPart"/>
  <rdfs:label xml:lang="en">hasPortion</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between a object whole and its spatial part of the same type.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b1daa610_64c6_4935_94b8_a19db586a2f6</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasPortion</core:exactMatch>
  <core:example xml:lang="en">A volume of 1 cc of milk within a 1 litre can be considered still milk as a whole. If you scale down to a cluster of molecules, than the milk cannot be considered a fluid no more (and then no more a milk).</core:example>
  <core:prefLabel xml:lang="en">hasPortion</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a object whole and its spatial part of the same type.</emmo:elucidation>
</owl:ObjectProperty>


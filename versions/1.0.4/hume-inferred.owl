<owl:Class rdf:about="https://w3id.org/emmo#MeanLinearRange">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Length"/>
  <rdfs:label xml:lang="en">MeanLinearRange</rdfs:label>
  <rdfs:comment xml:lang="en">Mean total rectified path length travelled by a particle in the course of slowing down to rest in a given material averaged over a group of particles having the same initial energy.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_d64a491b_d160_4adf_bba1_1a3f0624f0ea</core:exactMatch>
  <core:prefLabel xml:lang="en">MeanLinearRange</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-56</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Mean total rectified path length travelled by a particle in the course of slowing down to rest in a given material averaged over a group of particles having the same initial energy.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.M03782</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MeanLinearRange</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98681589</emmo:wikidataReference>
</owl:Class>


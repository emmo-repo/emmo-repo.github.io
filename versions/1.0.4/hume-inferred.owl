<owl:Class rdf:about="https://w3id.org/emmo#ElectricCurrentPhasor">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectricCurrent"/>
  <rdfs:label xml:lang="en">ElectricCurrentPhasor</rdfs:label>
  <rdfs:comment xml:lang="en">A representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8ef46550_7bf2_4ef9_8334_ca3d63fb69b1</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricCurrentPhasor</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-49</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">A representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value.</emmo:elucidation>
  <emmo:note xml:lang="en">A phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they can often reduce a differential equation problem to an algebraic one.</emmo:note>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectricCurrentPhasor</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q78514596</emmo:wikidataReference>
</owl:Class>


  <emmo:elucidation xml:lang="en">Energy imparted to matter by ionizing radiation in a suitable small element of volume divided by the mass of that element of volume.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.A00031</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/AbsorbedDose</emmo:qudtReference>

  <emmo:etymology xml:lang="en">1940s: named after S.N. Bose.</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Graphical"/>

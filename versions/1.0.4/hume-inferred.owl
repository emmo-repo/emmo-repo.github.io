  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_52fa9c76_fc42_4eca_a5c1_6095a1c9caab</core:exactMatch>
  <core:prefLabel xml:lang="en">DoubleData</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: hasDataValue some xsd:double</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A symbolic data representing a 64-bit floating point numbers incl. ±Inf, ±0, NaN.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SISubMultiplePrefix">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

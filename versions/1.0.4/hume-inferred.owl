  <core:prefLabel xml:lang="en">Solid</core:prefLabel>
  <emmo:elucidation xml:lang="en">A continuum characterized by structural rigidity and resistance to changes of shape or volume, that retains its shape and density when not confined.</emmo:elucidation>
</owl:Class>


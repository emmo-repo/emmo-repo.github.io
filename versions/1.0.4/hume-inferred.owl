  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#symbolValue"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ne</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ChemicalElement"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Conventional"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Information"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#LanguageData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NCNameData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NMTOKENData"/>
  <rdfs:label xml:lang="en">NeonSymbol</rdfs:label>
  <rdfs:comment xml:lang="en">The symbol that stands for the neon atom.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_2e96348b-f8d1-5877-a5c5-b6863c5ebcf2</core:exactMatch>
  <core:prefLabel xml:lang="en">NeonSymbol</core:prefLabel>
  <emmo:elucidation xml:lang="en">The symbol that stands for the neon atom.</emmo:elucidation>
</owl:Class>


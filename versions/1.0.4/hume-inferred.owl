  <emmo:elucidation xml:lang="en">A semiotic relation connecting an icon to a interpreter (cogniser) in a cognition process.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#isCogniserFor">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Estimation"/>
  <owl:annotatedTarget xml:lang="en">Estimation</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin aestimatus (“to value, rate, esteem”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Property"/>
  <owl:annotatedTarget xml:lang="en">Property</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin proprietas (“a peculiarity, one's peculiar nature or quality, right or fact of possession, property”), from proprius (“special, particular, one's own”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#GravitySintering"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso:3252:ed-5:v1:en:term:3.3.33</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">ISO 3252:2019 Powder metallurgy
loose-powder sintering, gravity sintering: sintering of uncompacted powder</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#elucidation"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#SupplyChain"/>
  <owl:annotatedTarget xml:lang="en">A supply chain is a system of organizations, people, activities, information, and resources involved in supplying a product or service to a consumer.</owl:annotatedTarget>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Supply_chain</emmo:wikipediaReference>
</owl:Axiom>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="https://w3id.org/emmo#LuminousIntensity"/>

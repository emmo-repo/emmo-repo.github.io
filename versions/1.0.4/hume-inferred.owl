  <core:example xml:lang="en">x
k</core:example>
  <core:prefLabel xml:lang="en">Variable</core:prefLabel>
  <emmo:elucidation xml:lang="en">A variable is a symbolic object that stands for any other mathematical object, such as  number, a vector, a matrix, a function, the argument of a function, a set, an element of a set.</emmo:elucidation>
</owl:Class>


  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_95d706e4_8b16_48a1_8dfd_40ccd4df1c12</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasQuantityPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasQuantityPart</core:prefLabel>
  <emmo:note xml:lang="en">Relates a symbolic construct to one of its quantity parts.</emmo:note>

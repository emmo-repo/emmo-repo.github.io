  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-15</emmo:ISO80000Reference>
  <emmo:dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Heat_capacity</emmo:dbpediaReference>
  <emmo:elucidation xml:lang="en">Quantity C = dQ/dT, when the thermodynamic temperature of a system is increased by dT as a result of the addition of a amount of heat dQ, under given condition.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.H02753</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/HeatCapacity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q179388</emmo:wikidataReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Heat_capacity</emmo:wikipediaReference>
</owl:Class>


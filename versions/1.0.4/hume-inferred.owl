  <rdfs:label xml:lang="en">Simulation</rdfs:label>
  <rdfs:comment xml:lang="en">A estimation of a property using a functional icon.</rdfs:comment>
  <core:altLabel xml:lang="en">Modelling</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9335cf09_431f_4613_9dab_ce4ceaca965b</core:exactMatch>

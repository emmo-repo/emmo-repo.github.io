<owl:Class rdf:about="https://w3id.org/emmo#LinearIonization">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ReciprocalLength"/>
  <rdfs:label xml:lang="en">LinearIonization</rdfs:label>
  <rdfs:comment xml:lang="en">Differential quotient of q with respect to l, where q is the average total charge of all positive ions produced by an ionizing charged particle over a path l, divided by the elementary charge.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8c151a67_f04a_4435_b7d1_1738e6d952ee</core:exactMatch>
  <core:prefLabel xml:lang="en">LinearIonization</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=395-03-115</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-58</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Differential quotient of q with respect to l, where q is the average total charge of all positive ions produced by an ionizing charged particle over a path l, divided by the elementary charge.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/LinearIonization</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98690755</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MentalAgent">

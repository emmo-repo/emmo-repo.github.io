  <emmo:elucidation xml:lang="en">The value of magnetic permeability in a classical vacuum.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/constant/ElectromagneticPermeabilityOfVacuum</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ReactorTimeConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Duration"/>

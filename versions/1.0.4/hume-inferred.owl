  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-29</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Vector quantity equal to the product of the magnetization M and the magnetic constant μ0.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MagneticPolarization</emmo:qudtReference>

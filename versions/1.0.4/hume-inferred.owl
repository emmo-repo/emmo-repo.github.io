<owl:Class rdf:about="https://w3id.org/emmo#RybergConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MeasuredConstant"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Wavenumber"/>
  <rdfs:label xml:lang="en">RybergConstant</rdfs:label>
  <rdfs:comment xml:lang="en">The Rydberg constant represents the limiting value of the highest wavenumber (the inverse wavelength) of any photon that can be emitted from the hydrogen atom, or, alternatively, the wavenumber of the lowest-energy photon capable of ionizing the hydrogen atom from its ground state.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_a3c78d6f_ae49_47c8_a634_9b6d86b79382</core:exactMatch>
  <core:prefLabel xml:lang="en">RybergConstant</core:prefLabel>
  <emmo:elucidation xml:lang="en">The Rydberg constant represents the limiting value of the highest wavenumber (the inverse wavelength) of any photon that can be emitted from the hydrogen atom, or, alternatively, the wavenumber of the lowest-energy photon capable of ionizing the hydrogen atom from its ground state.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.R05430</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/constant/RydbergConstant</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Hyperon">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/physicalistic#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom rdf:resource="https://w3id.org/emmo#ElementaryQuark"/>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasProperPart"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Baryon"/>
  <rdfs:label xml:lang="en">Hyperon</rdfs:label>
  <rdfs:comment xml:lang="en">A baryon containing one or more strange quarks, but no charm, bottom, or top quark.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f87e79eb_f549_4a06_9c27_a3d1412444c6</core:exactMatch>
  <core:prefLabel xml:lang="en">Hyperon</core:prefLabel>
  <emmo:elucidation xml:lang="en">A baryon containing one or more strange quarks, but no charm, bottom, or top quark.</emmo:elucidation>
  <emmo:note xml:lang="en">This form of matter may exist in a stable form within the core of some neutron stars.</emmo:note>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Hyperon</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MassFractionUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/sidimensionalunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#FractionUnit"/>
  <rdfs:label xml:lang="en">MassFractionUnit</rdfs:label>
  <rdfs:comment xml:lang="en">Unit for quantities of dimension one that are the fraction of two masses.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_18448443_dcf1_49b8_a321_cf46e2c393e1</core:exactMatch>
  <core:example xml:lang="en">Unit for mass fraction.</core:example>
  <core:prefLabel xml:lang="en">MassFractionUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">Unit for quantities of dimension one that are the fraction of two masses.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Verifying">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PartialSemiosis"/>
  <rdfs:label xml:lang="en">Verifying</rdfs:label>
  <rdfs:comment xml:lang="en">A semiosis where an interpretant, already present in the internal representational space of the interpreter, is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_2b44fb2a_ada8_46af_a961_6e534a61416d</core:exactMatch>
  <core:prefLabel xml:lang="en">Verifying</core:prefLabel>
  <emmo:elucidation xml:lang="en">A semiosis where an interpretant, already present in the internal representational space of the interpreter, is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#CollectiveAgency">
  <rdfs:isDefinedBy rdf:resource="https://plato.stanford.edu/entries/agency/#OthKinAgeMenShaColRelArt"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasAgent"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#CollectiveAgent"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#IntentionalAgencyByKind"/>
  <rdfs:label xml:lang="en">CollectiveAgency</rdfs:label>
  <rdfs:comment xml:lang="en">Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8aba9715_d542_4a79_a778_6115d2b4febd</core:exactMatch>
  <core:prefLabel xml:lang="en">CollectiveAgency</core:prefLabel>
  <emmo:elucidation xml:lang="en">Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group.</emmo:elucidation>
  <emmo:note xml:lang="en">The group acting collectively is intended to be represented as an item, meaning that all members of the group should have had at least one causal interaction with another member. The collective action in fact is taken in accordance with certain principles or procedures that constitute and organize the group itself that requires implicitly a causal interaction between members.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ElectricPotentialPerAreaUnit">

<owl:Class rdf:about="https://w3id.org/emmo#Component">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/persholistic#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasComponent"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#HolisticSystem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Constituent"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Role"/>
  <rdfs:label xml:lang="en">Component</rdfs:label>
  <rdfs:comment xml:lang="en">A constituent of a system.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817</core:exactMatch>
  <core:prefLabel xml:lang="en">Component</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SubClassOf:  inverse (hasConstituent) some HolisticSystem</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A constituent of a system.</emmo:elucidation>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#ThermalDiffusionRatio">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDimensionlessQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicoChemicalQuantity"/>
  <rdfs:label xml:lang="en">ThermalDiffusionRatio</rdfs:label>
  <rdfs:comment xml:lang="en">In a steady-state of a binary mixture in which thermal diffusion occurs; proportionality factor between gradient of the amount-of-subsstance fraction of the heavier substance B, and negative gradient of the local thermodynamic temperature divided by that temperature.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_e84be61e_6f6f_43e2_b91d_86898a5dc7c4</core:exactMatch>
  <core:prefLabel xml:lang="en">ThermalDiffusionRatio</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-40.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">In a steady-state of a binary mixture in which thermal diffusion occurs; proportionality factor between gradient of the amount-of-subsstance fraction of the heavier substance B, and negative gradient of the local thermodynamic temperature divided by that temperature.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ThermalDiffusionRatio</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q96249433</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#CentreOfMass">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PositionVector"/>
  <rdfs:label xml:lang="en">CentreOfMass</rdfs:label>
  <rdfs:comment xml:lang="en">In non-relativistic physics, the centre of mass doesn’t depend on the chosen reference frame.</rdfs:comment>
  <rdfs:comment xml:lang="en">The unique point where the weighted relative position of the distributed mass of an Item sums to zero. Equivalently, it is the point where if a force is applied to the Item, causes the Item to move in direction of force without rotation.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9d8f708a_f291_4d72_80ec_362c6e6bbca6</core:exactMatch>
  <core:prefLabel xml:lang="en">CentreOfMass</core:prefLabel>
  <emmo:elucidation xml:lang="en">The unique point where the weighted relative position of the distributed mass of an Item sums to zero. Equivalently, it is the point where if a force is applied to the Item, causes the Item to move in direction of force without rotation.</emmo:elucidation>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Center_of_mass</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#PositionVector">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#LengthUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Information"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SpaceAndTimeQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Vector"/>
  <rdfs:label xml:lang="en">PositionVector</rdfs:label>
  <rdfs:comment xml:lang="en">Vector quantity from the origin of a coordinate system to a point in space.</rdfs:comment>
  <core:altLabel xml:lang="en">Position</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4312cae4_03ba_457e_b35d_0671a7db350c</core:exactMatch>
  <core:prefLabel xml:lang="en">PositionVector</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=102-03-15</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-1.10</emmo:ISO80000Reference>
  <emmo:dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Position_(geometry)</emmo:dbpediaReference>
  <emmo:elucidation xml:lang="en">Vector quantity from the origin of a coordinate system to a point in space.</emmo:elucidation>
  <emmo:note xml:lang="en">In the usual geometrical three-dimensional space, position vectors are quantities of the dimension length.

-- IEC</emmo:note>
  <emmo:note xml:lang="en">Position vectors are so-called bounded vectors, i.e. their magnitude and direction depend on the particular coordinate system used.

-- ISO 80000-3</emmo:note>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/vocab/quantitykind/PositionVector</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q192388</emmo:wikidataReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Position_(geometry)</emmo:wikipediaReference>
</owl:Class>


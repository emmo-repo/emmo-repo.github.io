  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ec2472ae_cf4a_46a5_8555_1556f5a6c3c5</core:exactMatch>
  <core:prefLabel xml:lang="en">EMMORelation</core:prefLabel>

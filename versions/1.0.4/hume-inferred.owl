<owl:Class rdf:about="https://w3id.org/emmo#ChemicalNomenclature">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ChemicalSpecies"/>
  <rdfs:label xml:lang="en">ChemicalNomenclature</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chemical numenclature should not be confused with the chemical formula.</rdfs:comment>

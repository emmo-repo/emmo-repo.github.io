<owl:Class rdf:about="https://w3id.org/emmo#Frequency">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#FrequencyUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SpaceAndTimeQuantity"/>
  <rdfs:label xml:lang="en">Frequency</rdfs:label>
  <rdfs:comment xml:lang="en">Number of periods per time interval.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_852b4ab8_fc29_4749_a8c7_b92d4fca7d5a</core:exactMatch>
  <core:prefLabel xml:lang="en">Frequency</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=103-06-02</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-15.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Number of periods per time interval.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.FT07383</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/Frequency</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q11652</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DebyeAngularWavenumber">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AngularWavenumber"/>
  <rdfs:label xml:lang="en">DebyeAngularWavenumber</rdfs:label>
  <rdfs:comment xml:lang="en">Cut-off angular wavenumber in the Debye model of the vibrational spectrum of a solid.</rdfs:comment>
  <core:altLabel xml:lang="en">DebyeAngluarRepetency</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_76acb5d8_5ab8_484b_8354_7f7612f39c17</core:exactMatch>
  <core:hiddenLabel xml:lang="en">DebyeAngularWaveNumber</core:hiddenLabel>
  <core:prefLabel xml:lang="en">DebyeAngularWavenumber</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-9.3</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Cut-off angular wavenumber in the Debye model of the vibrational spectrum of a solid.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/DebyeAngularWavenumber</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q105554370</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ProcedureUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MetrologicalReference"/>
  <rdfs:label xml:lang="en">ProcedureUnit</rdfs:label>
  <rdfs:comment xml:lang="en">A reference unit provided by a measurement procedure.</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MeasurementProcedure</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_c9c8f824_9127_4f93_bc21_69fe78a7f6f2</core:exactMatch>
  <core:example xml:lang="en">Rockwell C hardness of a given sample (150 kg load): 43.5HRC(150 kg)</core:example>
  <core:prefLabel xml:lang="en">ProcedureUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">A reference unit provided by a measurement procedure.</emmo:elucidation>
  <emmo:note xml:lang="en">Procedure units and measurement units are disjoint.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Minimal">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Fundamental"/>
  <rdfs:label xml:lang="en">Minimal</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0914449c_ef24_4372_b669_9cdd13b59fed</core:exactMatch>
  <core:prefLabel xml:lang="en">Minimal</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Minimal.png</emmo:illustration>
  <emmo:note xml:lang="en">A minimal class M (subclass of Minimal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and x is proper part of a larger φ entity.</emmo:note>
</owl:Class>


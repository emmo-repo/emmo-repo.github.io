  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NCNameData"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NMTOKENData"/>
  <rdfs:label xml:lang="en">ThalliumSymbol</rdfs:label>
  <rdfs:comment xml:lang="en">The symbol that stands for the thallium atom.</rdfs:comment>

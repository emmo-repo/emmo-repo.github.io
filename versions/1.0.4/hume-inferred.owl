<owl:Class rdf:about="https://w3id.org/emmo#Maximal">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Fundamental"/>
  <rdfs:label xml:lang="en">Maximal</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole are not proper part of an entity of that type.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b4494d69_6393_4eb4_8346_7fedd4df0bc5</core:exactMatch>
  <core:prefLabel xml:lang="en">Maximal</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole are not proper part of an entity of that type.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Maximal.png</emmo:illustration>
  <emmo:note xml:lang="en">A maximal class M (subclass of Maximal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and if you add something to x, then x is no more a φ.</emmo:note>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#SystemResource">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">

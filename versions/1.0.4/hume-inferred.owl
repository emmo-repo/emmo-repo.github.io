<owl:Class rdf:about="https://w3id.org/emmo#SurfaceCoefficientOfHeatTransfer">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CoefficientOfHeatTransfer"/>
  <rdfs:label xml:lang="en">SurfaceCoefficientOfHeatTransfer</rdfs:label>
  <rdfs:comment xml:lang="en">Coefficient of heat transfer when heat exchange takes place between a body at thermodynamic temperature Ts and its surroundings that are at a reference temperature Tr.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0b3295fa_f4bf_4f83_a603_9d98c03da5bb</core:exactMatch>

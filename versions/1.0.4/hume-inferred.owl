<owl:Class rdf:about="https://w3id.org/emmo#ElectricPotential">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricPotentialUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Extensive"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">ElectricPotential</rdfs:label>
  <rdfs:comment xml:lang="en">Energy required to move a unit charge through an electric field from a reference point.</rdfs:comment>
  <rdfs:comment xml:lang="en">The electric potential is not unique, since any constant scalar field quantity can be added to it without changing its gradient.</rdfs:comment>
  <core:altLabel xml:lang="en">ElectroStaticPotential</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4f2d3939_91b1_4001_b8ab_7d19074bf845</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricPotential</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-25</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-11.1</emmo:ISO80000Reference>
  <emmo:dbpediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Electric_potential</emmo:dbpediaReference>
  <emmo:elucidation xml:lang="en">Energy required to move a unit charge through an electric field from a reference point.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E01935</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/ElectricPotential</emmo:qudtReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Electric_potential</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Estimated">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CodedByObservation"/>
  <rdfs:label xml:lang="en">Estimated</rdfs:label>
  <rdfs:comment xml:lang="en">A coded that is assigned from an estimation.</rdfs:comment>

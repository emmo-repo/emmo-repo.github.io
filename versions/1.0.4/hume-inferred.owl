<owl:Class rdf:about="https://w3id.org/emmo#Convergent">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Nuclear"/>
  <rdfs:label xml:lang="en">Convergent</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have a proper parts of the same type φ of the whole, and so that for every two distinct φ proper parts one is part of the other.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b501a8ed_ae15_4288_9d92_1026463e95cb</core:exactMatch>
  <core:prefLabel xml:lang="en">Convergent</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for all classes of entities that have a proper parts of the same type φ of the whole, and so that for every two distinct φ proper parts one is part of the other.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Convergent.png</emmo:illustration>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Nuclear">

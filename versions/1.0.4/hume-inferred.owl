  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: hasDataValue some owl:real</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">A data representing a real number.</emmo:elucidation>
</owl:Class>


  <core:prefLabel xml:lang="en">Hadron</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: Baryon or Meson</emmo:OWLRL2DLAxioms>

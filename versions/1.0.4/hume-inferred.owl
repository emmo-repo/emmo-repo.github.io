<owl:Class rdf:about="https://w3id.org/emmo#StoichiometricNumberOfSubstance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicoChemicalQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PureNumberQuantity"/>
  <rdfs:label xml:lang="en">StoichiometricNumberOfSubstance</rdfs:label>
  <rdfs:comment xml:lang="en">For substance B, an integer number or a simple fraction, being negative for a reactant and positive for a product, occurring in the expression for a chemical reaction.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_cbba91a7_d639_461f_ae23_d021751029e4</core:exactMatch>
  <core:example xml:lang="en">The factors 1/2 and 3/2 in the chemical reaction formula below are stoicheiometric mumbers of substance.

    (1/2)N2 + (3/2)H2 = NH3</core:example>
  <core:prefLabel xml:lang="en">StoichiometricNumberOfSubstance</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-01-22</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-29</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">For substance B, an integer number or a simple fraction, being negative for a reactant and positive for a product, occurring in the expression for a chemical reaction.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.S06025</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/StoichiometricNumber</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q95443720</emmo:wikidataReference>
</owl:Class>


</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#DirectionAndEnergyDistributionOfCrossSection">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#SquareTimePerMassUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">DirectionAndEnergyDistributionOfCrossSection</rdfs:label>
  <rdfs:comment xml:lang="en">Partial differential quotient of the cross section of a process with respect to the solid angle around a given direction and the energy of a particle scattered in that direction.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0e0ee94d_70be_4b7e_afcc_320e62a94974</core:exactMatch>
  <core:prefLabel xml:lang="en">DirectionAndEnergyDistributionOfCrossSection</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-41</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Partial differential quotient of the cross section of a process with respect to the solid angle around a given direction and the energy of a particle scattered in that direction.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/SpectralAngularCrossSection</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98269571</emmo:wikidataReference>
</owl:Class>


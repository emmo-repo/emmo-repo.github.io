  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-14.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Measure for how the polarization of a material is affected by the application of an external electric field.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.P04507</emmo:iupacReference>

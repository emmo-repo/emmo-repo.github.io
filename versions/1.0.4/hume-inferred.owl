  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasBeginTask</core:exactMatch>
  <core:prefLabel xml:lang="en">hasBeginTask</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation identifying the tasks of a workflow that are not causally temporally dependent by other parts of the workflow.</emmo:elucidation>
</owl:ObjectProperty>


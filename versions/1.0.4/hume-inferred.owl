  <core:prefLabel xml:lang="en">SISubMultiplePrefix</core:prefLabel>
  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disjointUnionOf: Centi, Pico, Milli, Zepto, Quecto, Micro, Yocto, Femto, Deci, Nano, Atto, Ronto</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">SI prefix who's value is 1/N where N is a positive integer larger than 1.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#UnitSymbol">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MetrologicalSymbol"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#NonPrefixedUnit"/>

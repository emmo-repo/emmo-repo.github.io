<owl:Class rdf:about="https://w3id.org/emmo#MagneticPolarisation">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MagneticFluxDensity"/>
  <rdfs:label xml:lang="en">MagneticPolarisation</rdfs:label>
  <rdfs:comment xml:lang="en">Vector quantity equal to the product of the magnetization M and the magnetic constant μ0.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_74a096dd_cc83_4c7e_b704_0541620ff18d</core:exactMatch>

  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-20</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quotient of the Planck constant and the product of the mass of the particle and the speed of light in vacuum.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/constant/ComptonWavelength</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q1145377</emmo:wikidataReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Compton_wavelength</emmo:wikipediaReference>
</owl:Class>


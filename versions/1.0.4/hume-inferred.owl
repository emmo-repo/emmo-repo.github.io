<owl:Class rdf:about="https://w3id.org/emmo#MaterialRelation">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Equation"/>
  <rdfs:label xml:lang="en">MaterialRelation</rdfs:label>
  <rdfs:comment xml:lang="en">A material_relation can e.g. return a predefined number, return a database query, be an equation that depends on other physics_quantities.</rdfs:comment>
  <rdfs:comment xml:lang="en">An 'equation' that stands for a physical assumption specific to a material, and provides an expression for a 'physics_quantity' (the dependent variable) as function of other variables, physics_quantity or data (independent variables).</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_e5438930_04e7_4d42_ade5_3700d4a52ab7</core:exactMatch>
  <core:example xml:lang="en">The Lennard-Jones potential.
A force field.
An Hamiltonian.</core:example>
  <core:prefLabel xml:lang="en">MaterialRelation</core:prefLabel>
  <emmo:elucidation xml:lang="en">An 'equation' that stands for a physical assumption specific to a material, and provides an expression for a 'physics_quantity' (the dependent variable) as function of other variables, physics_quantity or data (independent variables).</emmo:elucidation>
</owl:Class>


  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso:55000:ed-1:v2:en:term:3.1.13</rdfs:isDefinedBy>

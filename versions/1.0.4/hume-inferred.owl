<owl:Class rdf:about="https://w3id.org/emmo#PalladiumSymbol">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#symbolValue"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pd</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>

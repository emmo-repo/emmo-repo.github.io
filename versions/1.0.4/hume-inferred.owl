  <core:prefLabel xml:lang="en">MentalAgent</core:prefLabel>
  <emmo:elucidation xml:lang="en">A biological agent possessing an intentional mental state.</emmo:elucidation>
  <emmo:note xml:lang="en">A mental agent is typically attributed to a human but not nessesary.</emmo:note>
</owl:Class>


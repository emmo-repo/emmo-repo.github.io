<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasParticipant">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Participant"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasNonTemporalPart"/>
  <rdfs:label xml:lang="en">hasParticipant</rdfs:label>
  <rdfs:comment xml:lang="en">Participation is a parthood relation: you must be part of the process to contribute to it. A participant whose 4D extension is totally contained within the process.

Participation is not under direct parthood since a process is not strictly related to reductionism, but it's a way to categorise temporal regions by the interpreters.</rdfs:comment>
  <rdfs:comment xml:lang="en">The relation between a process and an object participating to it, i.e. that is relevant to the process itself.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasParticipant</core:exactMatch>
  <core:prefLabel xml:lang="en">hasParticipant</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a process and an object participating to it, i.e. that is relevant to the process itself.</emmo:elucidation>
</owl:ObjectProperty>


</owl:Restriction>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#ResemblanceIcon"/>
  <owl:annotatedTarget xml:lang="en">ResemblanceIcon</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Old French sambler, sembler, from Late Latin similāre, present active infinitive of similō, from Latin similis, from Proto-Italic *semalis, from Proto-Indo-European *sem- (“together, one”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#TensileForming"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8584-1:2003-09</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forming of a solid body, whereby the plastic state is essentially brought about by a combined tensile and compressive stress.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#hasRedundantPart"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#definition"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Redundant"/>
  <owl:annotatedTarget xml:lang="en">Redundant(x) ≡ ∃φ[φ(x) ∧ ∃yRP⟨φ⟩(y, x)]</owl:annotatedTarget>
</owl:Axiom>


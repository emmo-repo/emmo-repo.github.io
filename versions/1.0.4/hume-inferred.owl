  <emmo:etymology xml:lang="en">From the Ancient Greek γραφή (graphḗ) which means drawing, painting, writing, a writing, description, and from γράφω (gráphō) which means scratch, carve.</emmo:etymology>
  <emmo:note xml:lang="en">The term graphical is used in etymological sense, comprising both writings and visual arts.</emmo:note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#note"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Tempering"/>

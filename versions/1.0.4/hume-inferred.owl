<owl:Class rdf:about="https://w3id.org/emmo#IonicStrength">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#AmountPerMassUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PhysicoChemicalQuantity"/>
  <rdfs:label xml:lang="en">IonicStrength</rdfs:label>
  <rdfs:comment xml:lang="en">Charge number is a quantity of dimension one defined in ChargeNumber.</rdfs:comment>
  <rdfs:comment xml:lang="en">For all types of ions in a solution, half the sum of the products of their molality b_i and the square of their charge number z_i.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_7243633d_96ff_426d_ae44_8a2504e682da</core:exactMatch>
  <core:prefLabel xml:lang="en">IonicStrength</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-01-24</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-42</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">For all types of ions in a solution, half the sum of the products of their molality b_i and the square of their charge number z_i.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.I03180</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/IonicStrength</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q898396</emmo:wikidataReference>
</owl:Class>


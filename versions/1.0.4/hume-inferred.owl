<owl:Class rdf:about="https://w3id.org/emmo#ParallelWorkflow">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Workflow"/>
  <rdfs:label xml:lang="en">ParallelWorkflow</rdfs:label>
  <rdfs:comment xml:lang="en">A workflow can be seen as a direct acyclic graph, whose nodes are tasks and edges are asymmetric causal relations. A parallel graph occurs when the topological order of such graph if not unique, meaning that there is at least one portion of the workflow in which at least two tasks are running concurrently. 
Concurrent tasks may or may not communicate. Communication is represented as a symmetric causality relation, superimposing the direct acyclic graph structure of the workflow.</rdfs:comment>
  <rdfs:comment xml:lang="en">A workflow with some tasks running concurrently.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5848e476_2768_4988_98f9_9053c532307b</core:exactMatch>
  <core:prefLabel xml:lang="en">ParallelWorkflow</core:prefLabel>
  <emmo:conceptualisation xml:lang="en">A workflow can be seen as a direct acyclic graph, whose nodes are tasks and edges are asymmetric causal relations. A parallel graph occurs when the topological order of such graph if not unique, meaning that there is at least one portion of the workflow in which at least two tasks are running concurrently. 
Concurrent tasks may or may not communicate. Communication is represented as a symmetric causality relation, superimposing the direct acyclic graph structure of the workflow.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">A workflow with some tasks running concurrently.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo/raw/1.0.4/doc/figs/ParallelWorkflow.png</emmo:illustration>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Workflow">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasRole"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Task"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Procedure"/>
  <rdfs:label xml:lang="en">Workflow</rdfs:label>

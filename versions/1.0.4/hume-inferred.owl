  <core:prefLabel xml:lang="en">RefractiveIndex</core:prefLabel>
  <emmo:elucidation xml:lang="en">Factor by which the phase velocity of light is reduced in a medium.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.R05240</emmo:iupacReference>

  <rdfs:comment xml:lang="en">Temperature below which quantum effects dominate.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_83424a56_e28f_4aea_8125_bef7b9347ee6</core:exactMatch>
  <core:prefLabel xml:lang="en">CriticalTemperature</core:prefLabel>
  <emmo:elucidation xml:lang="en">Temperature below which quantum effects dominate.</emmo:elucidation>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q1450516</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#BoltzmannConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Entropy"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIExactConstant"/>
  <rdfs:label xml:lang="en">BoltzmannConstant</rdfs:label>
  <rdfs:comment xml:lang="en">A physical constant relating energy at the individual particle level with temperature. It is the gas constant R divided by the Avogadro constant.

It defines the Kelvin unit in the SI system.</rdfs:comment>
  <rdfs:comment xml:lang="en">The DBpedia definition (http://dbpedia.org/page/Boltzmann_constant) is outdated as May 20, 2019. It is now an exact quantity.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ffc7735f_c177_46a4_98e9_a54440d29209</core:exactMatch>
  <core:prefLabel xml:lang="en">BoltzmannConstant</core:prefLabel>
  <emmo:elucidation xml:lang="en">A physical constant relating energy at the individual particle level with temperature. It is the gas constant R divided by the Avogadro constant.

It defines the Kelvin unit in the SI system.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.B00695</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/constant/BoltzmannConstant</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Entropy">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EntropyUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Extensive"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">Entropy</rdfs:label>
  <rdfs:comment xml:lang="en">Logarithmic measure of the number of available states of a system.</rdfs:comment>
  <rdfs:comment xml:lang="en">May also be referred to as a measure of order of  a system.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9bbab0be_f9cc_4f46_9f46_0fd271911b79</core:exactMatch>
  <core:prefLabel xml:lang="en">Entropy</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-18</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Logarithmic measure of the number of available states of a system.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E02149</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/Entropy</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#InternalEnergy">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Energy"/>
  <rdfs:label xml:lang="en">InternalEnergy</rdfs:label>
  <rdfs:comment xml:lang="en">A state quantity equal to the difference between the total energy of a system and the sum of the macroscopic kinetic and potential energies of the system.</rdfs:comment>
  <core:altLabel xml:lang="en">ThermodynamicEnergy</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_830b59f7_d047_438c_90cd_62845749efcb</core:exactMatch>
  <core:prefLabel xml:lang="en">InternalEnergy</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5.20-2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">A state quantity equal to the difference between the total energy of a system and the sum of the macroscopic kinetic and potential energies of the system.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.I03103</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/InternalEnergy</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#TotalMassStoppingPower">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#MassStoppingPowerUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>

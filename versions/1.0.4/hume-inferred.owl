<owl:Class rdf:about="https://w3id.org/emmo#WorkFunction">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatterPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Energy"/>
  <rdfs:label xml:lang="en">WorkFunction</rdfs:label>
  <rdfs:comment xml:lang="en">Least energy required for the emission of a conduction electron.</rdfs:comment>
  <rdfs:comment xml:lang="en">Work function is the energy difference between an electron at rest at infinity and an electron at the Fermi level in the interior of a substance.</rdfs:comment>
  <core:altLabel xml:lang="en">ElectronWorkFunction</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_a0c4322d_4de2_4770_991c_5fad4e6ec25b</core:exactMatch>
  <core:prefLabel xml:lang="en">WorkFunction</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-06-35</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-24.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Least energy required for the emission of a conduction electron.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E02015</emmo:iupacReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q783800</emmo:wikidataReference>
</owl:Class>


  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hydrogen peroxide is HO</core:example>
  <core:prefLabel xml:lang="en">EmpiricalFormula</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An expression that provide information about the element type of a compound and their relative ratio.</emmo:elucidation>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#SpecialUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#DerivedUnit"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#UnitSymbol"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#BaseUnit"/>
  <rdfs:label xml:lang="en">SpecialUnit</rdfs:label>
  <rdfs:comment xml:lang="en">A unit symbol that stands for a derived unit.</rdfs:comment>
  <rdfs:comment xml:lang="en">Special units are semiotic shortcuts to more complex composed symbolic objects.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3ee80521_3c23_4dd1_935d_9d522614a3e2</core:exactMatch>
  <core:example xml:lang="en">Pa stands for N/m2
J stands for N m</core:example>
  <core:prefLabel xml:lang="en">SpecialUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">A unit symbol that stands for a derived unit.</emmo:elucidation>
</owl:Class>


  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasAtomicNumber"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasIUPAC2016AtomicMass"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">79.904</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Atom"/>
  <rdfs:label xml:lang="en">BromineAtom</rdfs:label>
  <rdfs:comment xml:lang="en">Atom subclass for bromine.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b3dfa085-5206-5868-b060-13efa01caf8e</core:exactMatch>
  <core:prefLabel xml:lang="en">BromineAtom</core:prefLabel>
  <emmo:elucidation xml:lang="en">Atom subclass for bromine.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#NeonSymbol">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>

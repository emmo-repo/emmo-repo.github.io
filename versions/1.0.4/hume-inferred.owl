    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIDimensionalUnit"/>
  <rdfs:label xml:lang="en">ReciprocalLengthUnit</rdfs:label>

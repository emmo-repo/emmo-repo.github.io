  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CompositeFermion"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Hadron"/>
  <rdfs:label xml:lang="en">Baryon</rdfs:label>
  <rdfs:comment xml:lang="en">Subatomic particle which contains an odd number of valence quarks, at least 3.</rdfs:comment>

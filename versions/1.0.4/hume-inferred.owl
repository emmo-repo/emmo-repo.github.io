  <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasDeclarer"/>
  <rdfs:label xml:lang="en">isDeclarerFor</rdfs:label>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_a1b66ab5_0b29_4b9d_823e_5aec9768517e</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#isDeclarerFor</core:exactMatch>
  <core:prefLabel xml:lang="en">isDeclarerFor</core:prefLabel>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasMetrologicalUncertainty">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#ObjectiveProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#MetrologicalUncertainty"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasObjectiveProperty"/>
  <rdfs:label xml:lang="en">hasMetrologicalUncertainty</rdfs:label>
  <rdfs:comment xml:lang="en">Assigns a quantifiable uncertainty to an objective property through a well-defined procecure.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_662c64e7_fc72_49b3_a161_f50fd42deafa</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasMetrologicalUncertainty</core:exactMatch>
  <core:prefLabel xml:lang="en">hasMetrologicalUncertainty</core:prefLabel>
  <emmo:elucidation xml:lang="en">Assigns a quantifiable uncertainty to an objective property through a well-defined procecure.</emmo:elucidation>
  <emmo:note xml:lang="en">Since measurement uncertainty is a subclass of objective property, this relation can also describe the uncertainty of an measurement uncertainty.</emmo:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#equalsTo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasPart"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isPartOf"/>
  <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#hasProperPart"/>
  <rdfs:label xml:lang="en">equalsTo</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between two individuals representing the same entity.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_6835537c_d294_4005_a770_ec9621f29ed1</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#equalsTo</core:exactMatch>
  <core:prefLabel xml:lang="en">equalsTo</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between two individuals representing the same entity.</emmo:elucidation>
  <emmo:note xml:lang="en">Equality is here defined following a mereological approach.</emmo:note>
</owl:ObjectProperty>


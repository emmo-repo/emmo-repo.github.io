  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f8a2fe9f_458b_4771_9aba_a50e76afc52d</core:exactMatch>
  <core:prefLabel xml:lang="en">DifferentialOperator</core:prefLabel>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Displacement">

  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom rdf:resource="https://w3id.org/emmo#Atom"/>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasProperty"/>
        </rdf:Description>
      </owl:onProperty>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#PureNumberQuantity"/>
  <rdfs:label xml:lang="en">MassNumber</rdfs:label>
  <rdfs:comment xml:lang="en">Number of nucleons in an atomic nucleus.</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AtomicMassNumber</core:altLabel>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NucleonNumber</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_dc6c8de0_cfc4_4c66_a7dc_8f720e732d54</core:exactMatch>

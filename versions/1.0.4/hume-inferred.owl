</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasPiece">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasProperPart"/>
  <owl:inverseOf rdf:resource="https://w3id.org/emmo#isPieceOf"/>
  <rdfs:label xml:lang="en">hasPiece</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between two individuals representing an entity and a non-maximal proper part, meaning the the latter is connected with the rest of the whole.</rdfs:comment>
  <core:altLabel xml:lang="en">hasNotMaximalPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_76413949_896c_4363_a955_de4722c6e149</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasPiece</core:exactMatch>
  <core:prefLabel xml:lang="en">hasPiece</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between two individuals representing an entity and a non-maximal proper part, meaning the the latter is connected with the rest of the whole.</emmo:elucidation>
  <emmo:note xml:lang="en">A non-maximal part is a proper part that is connected with the rest of the whole.</emmo:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasConstitutiveProcess">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Object"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

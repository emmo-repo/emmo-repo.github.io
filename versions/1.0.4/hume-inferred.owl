  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-21.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Sum of the product of the proton number and the hydrogen atomic mass, and the neutron rest mass, minus the rest mass of the atom.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MassDefect</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q26897126</emmo:wikidataReference>
</owl:Class>


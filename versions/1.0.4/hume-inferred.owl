  <emmo:elucidation xml:lang="en">The magnetic flux density for disappearance of superconductivity in a type I superconductor.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ThermodynamicCriticalMagneticFluxDensity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q106103200</emmo:wikidataReference>
</owl:Class>


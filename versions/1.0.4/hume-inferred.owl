  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-23.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">The ratio of the binding energy of a nucleus to the atomic mass number.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/BindingFraction</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98058362</emmo:wikidataReference>
</owl:Class>


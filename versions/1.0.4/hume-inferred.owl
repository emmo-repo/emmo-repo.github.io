  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-14.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">The pressure measured relative to the ambient atmospheric pressure.</emmo:elucidation>
  <emmo:note xml:lang="en">Gauge pressure can be measured using a diaphragm sensor, where one side of the diaphragm is exposed to the pressure media that is to be measured, while the other side is exposed to the ambient atmospheric pressure.</emmo:note>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q109594211</emmo:wikidataReference>
</owl:Class>


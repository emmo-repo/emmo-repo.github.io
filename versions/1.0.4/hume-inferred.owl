<owl:Class rdf:about="https://w3id.org/emmo#CubicExpansionCoefficient">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CoefficientOfThermalExpansion"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#LinearExpansionCoefficient"/>
  <rdfs:label xml:lang="en">CubicExpansionCoefficient</rdfs:label>
  <rdfs:comment xml:lang="en">Quantity characterizing the variation with thermodynamic temperature T of the volume V of a body, under given conditions.</rdfs:comment>
  <rdfs:comment xml:lang="en">alpha_V = (1/V) * (dV/dT)</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_1c1ec02e_4def_4979_aff9_572c06a95391</core:exactMatch>
  <core:prefLabel xml:lang="en">CubicExpansionCoefficient</core:prefLabel>
  <emmo:IEVReference xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-28</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-3.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quantity characterizing the variation with thermodynamic temperature T of the volume V of a body, under given conditions.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/CubicExpansionCoefficient</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q74761076</emmo:wikidataReference>
</owl:Class>


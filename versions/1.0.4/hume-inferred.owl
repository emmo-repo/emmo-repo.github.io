<rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
  <rdfs:comment xml:lang="en">EMMO applies the naming convension to its sub-properties of rdfs:seeAlso that their label must end with one of the following terms:
  - 'Match': resolvable URLs to corresponding entity in another ontology
  - 'Entry': resolvable URLs to a human readable resource describing the subject
  - 'Ref': non-resolvable reference to a human readable resource describing the subject</rdfs:comment>
  <rdfs:comment xml:lang="en">Indicate a resource that might provide additional information about the subject resource.</rdfs:comment>
</rdf:Description>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasBeginTile">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/reductionistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#BeginTile"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasTemporalTile"/>
  <rdfs:label xml:lang="en">hasBeginTile</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relation between the whole and a temporal tile that has only outgoing temporal connections.</rdfs:comment>
  <core:altLabel xml:lang="en">hasTemporalFirst</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_fe63194f_7c04_4dbd_a244_524b38b6699b</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasBeginTile</core:exactMatch>
  <core:prefLabel xml:lang="en">hasBeginTile</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relation between the whole and a temporal tile that has only outgoing temporal connections.</emmo:elucidation>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasTemporalTile">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/reductionistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#TemporalTile"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasSpatioTemporalTile"/>
  <rdfs:label xml:lang="en">hasTemporalTile</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that establishes for the whole a univocal tessellation in temporal parts forming the tessellation.</rdfs:comment>
  <core:altLabel xml:lang="en">hasTemporalDirectPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_65a2c5b8_e4d8_4a51_b2f8_e55effc0547d</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasTemporalTile</core:exactMatch>
  <core:prefLabel xml:lang="en">hasTemporalTile</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that establishes for the whole a univocal tessellation in temporal parts forming the tessellation.</emmo:elucidation>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasNumericalPart">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#QuantityValue"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Numerical"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasSpatialTile"/>
  <rdfs:label xml:lang="en">hasNumericalPart</rdfs:label>
  <rdfs:comment xml:lang="en">Relates a quantity to its numerical value through spatial direct parthood.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8ef3cd6d_ae58_4a8d_9fc0_ad8f49015cd0</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasNumericalPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasNumericalPart</core:prefLabel>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasSpatialTile">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/reductionistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#SpatialTile"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasSpatioTemporalTile"/>
  <rdfs:label xml:lang="en">hasSpatialTile</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation between the whole and one of its tiles, where the tile is only spatially connected with the other tiles forming the tessellation.</rdfs:comment>
  <core:altLabel xml:lang="en">hasSpatialDirectPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b2282816_b7a3_44c6_b2cb_3feff1ceb7fe</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasSpatialTile</core:exactMatch>
  <core:prefLabel xml:lang="en">hasSpatialTile</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation between the whole and one of its tiles, where the tile is only spatially connected with the other tiles forming the tessellation.</emmo:elucidation>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#foreruns">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#successorOf"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#indirectlyCauses"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isBefore"/>
  <owl:inverseOf rdf:resource="https://w3id.org/emmo#successorOf"/>
  <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#alongsideWith"/>
  <rdfs:label xml:lang="en">foreruns</rdfs:label>
  <rdfs:comment xml:lang="en">A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x).</rdfs:comment>
  <core:altLabel xml:lang="en">hasSuccessor</core:altLabel>
  <core:altLabel xml:lang="en">isAntecedentOf</core:altLabel>
  <core:altLabel xml:lang="en">predecessorOf</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#foreruns</core:exactMatch>
  <core:example xml:lang="en">My life between 18-24 years foreruns my life between 32-40 years, since there is an intermediary (i.e. my life between 25-32 years).</core:example>
  <core:prefLabel xml:lang="en">foreruns</core:prefLabel>
  <emmo:elucidation xml:lang="en">A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x).</emmo:elucidation>
  <emmo:note xml:lang="en">Transitivity is implemented at A-Box level with a SWRL rule.</emmo:note>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#successorOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#indirectlyCausedBy"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isAfter"/>
  <rdfs:label xml:lang="en">successorOf</rdfs:label>
  <core:altLabel xml:lang="en">isAncestorOf</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#successorOf</core:exactMatch>
  <core:prefLabel xml:lang="en">successorOf</core:prefLabel>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#isBefore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isCauseOf"/>
  <rdfs:label xml:lang="en">isBefore</rdfs:label>
  <rdfs:comment xml:lang="en">A relation between entities that are only one-directionally causally connected.</rdfs:comment>
  <rdfs:comment xml:lang="en">A relation jointly covered by hasNext and hasSuccessor relations, which are mutually exclusive.</rdfs:comment>
  <core:altLabel xml:lang="en">isTemporallyBefore</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ebc9e62c_5dc4_44db_9060_7923740bdf78</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#isBefore</core:exactMatch>
  <core:prefLabel xml:lang="en">isBefore</core:prefLabel>
  <emmo:definition xml:lang="en">A relation jointly covered by hasNext and hasSuccessor relations, which are mutually exclusive.</emmo:definition>
  <emmo:elucidation xml:lang="en">A relation between entities that are only one-directionally causally connected.</emmo:elucidation>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#isInfluencedBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isJoinedBy"/>
  <owl:inverseOf rdf:resource="https://w3id.org/emmo#influences"/>
  <rdfs:label xml:lang="en">isInfluencedBy</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between an object O that proper overlaps a process P, where the non-overlapping part of P causes O.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_2d572205_274c_414a_9564_01c3e14e3c8f</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#isInfluencedBy</core:exactMatch>
  <core:prefLabel xml:lang="en">isInfluencedBy</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between an object O that proper overlaps a process P, where the non-overlapping part of P causes O.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://raw.githubusercontent.com/emmo-repo/EMMO/master/doc/figs/isInfluencedBy.png</emmo:illustration>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#isJoinedBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Object"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

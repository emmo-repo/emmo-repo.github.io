  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-7</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">At a given point within a domain of quasi-infinitesimal volume V, vector quantity equal to the electric dipole moment p of the substance contained within the domain divided by the volume V.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ElectricPolarization</emmo:qudtReference>
  <emmo:wikidataReference xml:lang="en">https://www.wikidata.org/wiki/Q1050425</emmo:wikidataReference>
</owl:Class>


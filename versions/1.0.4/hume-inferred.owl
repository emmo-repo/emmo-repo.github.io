<owl:Class rdf:about="https://w3id.org/emmo#IonizationEnergy">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatterPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Energy"/>
  <rdfs:label xml:lang="en">IonizationEnergy</rdfs:label>
  <rdfs:comment xml:lang="en">Difference between energy of an electron at rest at infinity and a certain energy level which is the energy of an electron in the interior of a substance.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f0b903be_d86f_4d28_9f42_b4d4753e2cf4</core:exactMatch>
  <core:prefLabel xml:lang="en">IonizationEnergy</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-06-39</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-24.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Difference between energy of an electron at rest at infinity and a certain energy level which is the energy of an electron in the interior of a substance.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.I03199</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/IonizationEnergy</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q483769</emmo:wikidataReference>
</owl:Class>


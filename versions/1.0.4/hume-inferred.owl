  <rdfs:label xml:lang="en">Heap</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass for all classes of entities that have at least two non overlapping proper parts of the same type of the whole.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_2dddfc30_d4e1_4e3e_a0ca_755c4d9d2cf4</core:exactMatch>
  <core:prefLabel xml:lang="en">Heap</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass for all classes of entities that have at least two non overlapping proper parts of the same type of the whole.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Heap.png</emmo:illustration>
  <emmo:note xml:lang="en">A heap class H (subclass of Heap) is defined by choosing a reference type φ, with H subclass of φ, so that each H entity has non overlapping φ parts.</emmo:note>
</owl:Class>


    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIDimensionalUnit"/>
  <rdfs:label xml:lang="en">PerPressureUnit</rdfs:label>
  <rdfs:comment xml:lang="en">The class of units with dimensionality 'PerPressure'.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_2a068ad0_582c_4f50_90d2_89d9e28977c1</core:exactMatch>
  <core:prefLabel xml:lang="en">PerPressureUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">The class of units with dimensionality 'PerPressure'.</emmo:elucidation>
</owl:Class>


<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasUnitNonPrefixPart">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#PrefixedUnit"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#MeasurementUnit"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasSpatialTile"/>
  <rdfs:label xml:lang="en">hasUnitNonPrefixPart</rdfs:label>
  <rdfs:comment xml:lang="en">Relates a prefixed unit to its non-prefixed part.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_78c79b48_4b76_4cbe_812f_b32dbb04fd44</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasUnitNonPrefixPart</core:exactMatch>
  <core:example xml:lang="en">For example the unit CentiNewtonMetre has prefix "Centi" and non-prefix part "NewtonMetre".</core:example>
  <core:prefLabel xml:lang="en">hasUnitNonPrefixPart</core:prefLabel>
  <emmo:elucidation xml:lang="en">Relates a prefixed unit to its non-prefixed part.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#isDistinctPartOf">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo#hasDistinctPart"/>

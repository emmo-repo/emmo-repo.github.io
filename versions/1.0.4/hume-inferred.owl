  <rdfs:label xml:lang="en">incomingOverlaps</rdfs:label>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_64be8885_2c8a_4e84_a4fc_9d2de61b4d0d</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#incomingOverlaps</core:exactMatch>
  <core:prefLabel xml:lang="en">incomingOverlaps</core:prefLabel>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasTile">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Tessellation"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/reductionistic#"/>
  <rdfs:range rdf:resource="https://w3id.org/emmo#Tile"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#hasDirectPart"/>
  <rdfs:label xml:lang="en">hasTile</rdfs:label>
  <rdfs:comment xml:lang="en">The relation grouping all direct parthood relations used in the reductionistic perspective.</rdfs:comment>
  <rdfs:comment xml:lang="en">Tiling parthood enables the establishment of hierarchy of granularities, starting with an entity and providing several tessellation levels according to specific criteria.
The criteria are implemented in specialised versions of the tiling parthood relation (e.g., metrological direct part, XML format direct part).
The tiles and the tessellated entity (tessellation) are causally self connected (i.e., items), coherently with the concept behind the definition of the reductionistic perspective.
The tiles of specific granularity level provide a covering for the whole and are mutually non-overlapping, as the label "tile" suggests.</rdfs:comment>
  <core:altLabel xml:lang="en">hasDirectPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_74a75cf1_3418_4244_b43c_b5db94635d42</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasTile</core:exactMatch>
  <core:prefLabel xml:lang="en">hasTile</core:prefLabel>
  <emmo:conceptualisation xml:lang="en">Tiling parthood enables the establishment of hierarchy of granularities, starting with an entity and providing several tessellation levels according to specific criteria.
The criteria are implemented in specialised versions of the tiling parthood relation (e.g., metrological direct part, XML format direct part).
The tiles and the tessellated entity (tessellation) are causally self connected (i.e., items), coherently with the concept behind the definition of the reductionistic perspective.
The tiles of specific granularity level provide a covering for the whole and are mutually non-overlapping, as the label "tile" suggests.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">The relation grouping all direct parthood relations used in the reductionistic perspective.</emmo:elucidation>
  <emmo:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This relation is a simple collector of all relations inverse functional direct parthoods that can be defined in specialised theories using reductionism.</emmo:note>
  <emmo:note xml:lang="en">This relation is not antitransitive, to enable partitioning of a causal structure with more than one tiling scheme (e.g. time and space partitioning).</emmo:note>
</owl:AsymmetricProperty>

<owl:AsymmetricProperty rdf:about="https://w3id.org/emmo#hasInput">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/emmo#Process"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#isIncomingOverlappedBy"/>
  <rdfs:label xml:lang="en">hasInput</rdfs:label>
  <rdfs:comment xml:lang="en">The relation between a process P that proper overlaps an item I, where the non-overlapping part of I causes P.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_36e69413_8c59_4799_946c_10b05d266e22</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasInput</core:exactMatch>
  <core:prefLabel xml:lang="en">hasInput</core:prefLabel>
  <emmo:elucidation xml:lang="en">The relation between a process P that proper overlaps an item I, where the non-overlapping part of I causes P.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://raw.githubusercontent.com/emmo-repo/EMMO/master/doc/figs/hasInput.png</emmo:illustration>
</owl:AsymmetricProperty>

<rdfs:Datatype rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"/>


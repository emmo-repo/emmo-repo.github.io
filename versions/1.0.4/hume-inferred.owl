  <rdfs:comment xml:lang="en">A direct part that is obtained by partitioning a whole hybridly in spatial, temporal and spatiotemporal parts.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_d4c95fa1_5bda_4063_a22d_62c81fcea284</core:exactMatch>
  <core:prefLabel xml:lang="en">JunctionTile</core:prefLabel>
  <emmo:elucidation xml:lang="en">A direct part that is obtained by partitioning a whole hybridly in spatial, temporal and spatiotemporal parts.</emmo:elucidation>
  <emmo:illustration rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo/raw/1.0.4/doc/figs/JunctionTile.png</emmo:illustration>
</owl:Class>


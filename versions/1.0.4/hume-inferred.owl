<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#meanQuantityValue">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_ea67144c_56fd_4312_a4f4_af78edd5eacc"/>
  <rdfs:label xml:lang="en">meanQuantityValue</rdfs:label>
  <rdfs:comment xml:lang="en">The probabilistic expected value of an EMMO data entity.</rdfs:comment>
  <core:altLabel xml:lang="en">expectationValue</core:altLabel>
  <core:altLabel xml:lang="en">expectedValue</core:altLabel>
  <core:altLabel xml:lang="en">meanValue</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_593ce968_e1ec_4101_822a_1739ef13fb2b</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#meanQuantityValue</core:exactMatch>
  <core:prefLabel xml:lang="en">meanQuantityValue</core:prefLabel>
  <emmo:elucidation xml:lang="en">The probabilistic expected value of an EMMO data entity.</emmo:elucidation>
  <emmo:note xml:lang="en">The expectation value (or expected value) is the theoretical long-run average outcome of a random variable over many trials, calculated as the sum of all possible values, each weighted by its probability of occurrence. It acts as a probability-weighted mean, representing the center of a probability distribution, denoted as 'E[X]' or 'µ'.</emmo:note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#standardUncertainty">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#uncertainty"/>
  <rdfs:label xml:lang="en">standardUncertainty</rdfs:label>
  <rdfs:comment xml:lang="en">An uncertainty specified as a standard deviation.</rdfs:comment>
  <core:altLabel xml:lang="en">standardDeviation</core:altLabel>
  <core:altLabel xml:lang="en">standardMeasuremetnUncertainty</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_bba7f0f0_3707_42b9_b3fa_fd04610ef147</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#standardUncertainty</core:exactMatch>
  <core:prefLabel xml:lang="en">standardUncertainty</core:prefLabel>
  <emmo:VIMTerm xml:lang="en">VIM4: 3.6 standard measurement uncertainty</emmo:VIMTerm>
  <emmo:elucidation xml:lang="en">An uncertainty specified as a standard deviation.</emmo:elucidation>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#uncertainty">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#dataValue"/>
  <rdfs:label xml:lang="en">uncertainty</rdfs:label>
  <rdfs:comment xml:lang="en">A parameter characterising the dispersion of a data value.</rdfs:comment>
  <core:altLabel xml:lang="en">measurementUncertainty</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_39cbed73_6e97_4ab2_bede_dc670e9469c9</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#uncertainty</core:exactMatch>
  <core:prefLabel xml:lang="en">uncertainty</core:prefLabel>
  <emmo:VIMTerm xml:lang="en">VIM4: 3.1 measurement uncertainty</emmo:VIMTerm>
  <emmo:elucidation xml:lang="en">A parameter characterising the dispersion of a data value.</emmo:elucidation>
  <emmo:note xml:lang="en">The uncertainty data property doesn't specify how the uncertainty is defined. For accuracy, use one of the specialised sub-properties.</emmo:note>
  <emmo:note xml:lang="en">VIM defined 'measurement uncertainty' as a "parameter characterising the dispersion of the values being attributed to a measurand, based on the information used".</emmo:note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#coverageInterval">

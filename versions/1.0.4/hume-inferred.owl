  <emmo:elucidation xml:lang="en">Antimatter is matter that is composed only of the antiparticles of those that constitute ordinary matter.</emmo:elucidation>
  <emmo:note xml:lang="en">This branch is not expanded due to the limited use of such entities.</emmo:note>
</owl:Class>


    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/emmo#Mathematical"/>
        <rdf:Description rdf:about="https://w3id.org/emmo#SymbolicConstruct"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">MathematicalConstruct</rdfs:label>
  <rdfs:comment xml:lang="en">A construct of two or more mathematical symbols.</rdfs:comment>

  <emmo:note xml:lang="en">Transitivity for parthood.</emmo:note>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#FunctionalIcon"/>
  <owl:annotatedTarget xml:lang="en">FunctionalIcon</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin functiō (“performance, execution”), from functus, perfect participle of fungor (“to perform, execute, discharge”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#elucidation"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#IRI"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://datatracker.ietf.org/doc/rfc3987/</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">An Internationalized Resource Identifier (IRI) is a compact sequence of characters that identifies an abstract or physical resource. It is similar to URI, but greatly extends the allowed character set from ASCII to the Universal Character Set (Unicode/ISO 10646)..</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Collection"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onClass rdf:resource="https://w3id.org/emmo#Item"/>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasSingleMember"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    </owl:Restriction>
  </owl:annotatedTarget>
  <emmo:note xml:lang="en">Every collection has at least two item members, since a collection of one item is a self-connected entity (and then an item).</emmo:note>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#CausalCluster"/>
  <owl:annotatedTarget xml:lang="en">CausalCluster</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Proto-Germanic *klas-, *klus- (“to clump, lump together”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#FormingBlasting"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 65099-3:1989-11</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shot peening is shot peening for shaping or straightening workpieces by introducing residual compressive stresses (from: DIN 8200/10.82).</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#note"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Dismantling"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 9110:2018-08</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">action to disassemble a product or a component by removing all or some of its constituent parts with the intent to salvage</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Measurement"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/standard/45324.html</rdfs:isDefinedBy>
  <owl:annotatedTarget xml:lang="en">A measurement is the process of experimentally obtaining one or more measurement results that can reasonably be attributed to a quantity.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#TechnologyProcess"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN EN 14943:2006-03</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conversion of materials and assembly of components for the manufacture of products</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#CausalPath"/>
  <owl:annotatedTarget xml:lang="en">CausalChain</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Old French chaine, chaene (“chain”), from Latin catēna (“chain”).</emmo:etymology>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#note"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Annealing"/>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EN 10028-1:2017-07</rdfs:seeAlso>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat treatment consisting of heating and soaking at a suitable temperature, followed by cooling under conditions such that, after return to ambient temperature, the metal will be in a structural state closer to that of equilibrium</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:hasValue rdf:resource="https://w3id.org/emmo#universe"/>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasPart"/>
        </rdf:Description>
      </owl:onProperty>
    </owl:Restriction>
  </owl:annotatedTarget>
  <emmo:note xml:lang="en">All EMMO individuals are part of the most comprehensive entity which is the universe.</emmo:note>
</owl:Axiom>

<owl:Axiom>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#hasRedundantPart"/>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#definition"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Fundamental"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental(x) ≡ ∃φ[φ(x) ∧ ¬∃yRP⟨φ⟩(y, x)]</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Holistic"/>

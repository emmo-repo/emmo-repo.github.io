<owl:Class rdf:about="https://w3id.org/emmo#ElectricConductivity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricConductivityUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Intensive"/>
  <rdfs:label xml:lang="en">ElectricConductivity</rdfs:label>
  <rdfs:comment xml:lang="en">Conductivity is equeal to the resiprocal of resistivity.</rdfs:comment>
  <rdfs:comment xml:lang="en">Measure of a material's ability to conduct an electric current.</rdfs:comment>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductivity</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_cde4368c_1d4d_4c94_8548_604749523c6d</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricConductivity</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-43</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Measure of a material's ability to conduct an electric current.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.C01245</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/ElectricConductivity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q4593291</emmo:wikidataReference>
</owl:Class>


<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#y"/>
          <swrl:propertyPredicate rdf:resource="https://w3id.org/emmo#hasProperPart"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:argument1 rdf:resource="urn:swrl:var#y"/>
              <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/emmo#hasProperPart"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
          <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
          <swrl:propertyPredicate rdf:resource="https://w3id.org/emmo#hasProperPart"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <emmo:note xml:lang="en">Transitivity for proper parthood.</emmo:note>
</swrl:Imp>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>

  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_53935db0_af45_4426_b9e9_244a0d77db00</core:exactMatch>
  <core:prefLabel xml:lang="en">MesoscopicModel</core:prefLabel>

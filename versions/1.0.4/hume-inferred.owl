<owl:Class rdf:about="https://w3id.org/emmo#MolarGasConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EntropyPerAmountUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIExactConstant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#SpecificGasConstant"/>
  <rdfs:label xml:lang="en">MolarGasConstant</rdfs:label>
  <rdfs:comment xml:lang="en">Equivalent to the Boltzmann constant, but expressed in units of energy per temperature increment per mole (rather than energy per temperature increment per particle).</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ad6c76cf_b400_423e_820f_cf0c4e77f455</core:exactMatch>
  <core:prefLabel xml:lang="en">MolarGasConstant</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9-37.1</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Equivalent to the Boltzmann constant, but expressed in units of energy per temperature increment per mole (rather than energy per temperature increment per particle).</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.G02579</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/constant/MolarGasConstant</emmo:qudtReference>
</owl:Class>


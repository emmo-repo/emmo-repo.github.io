  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_755eaac8_735e_438c_8c19_a8b5e6a81728</core:exactMatch>
  <core:prefLabel xml:lang="en">RapidPrototyping</core:prefLabel>
  <emmo:elucidation xml:lang="en">Application of additive manufacturing intended for reducing the time needed for producing prototypes.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#AdditiveManufacturing">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#FromNotProperShapeToWorkPiece"/>
  <rdfs:label xml:lang="en">AdditiveManufacturing</rdfs:label>
  <core:altLabel xml:lang="en">GenerativeManufacturing</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_03eb9b46_8ff0_4fcd_b1a0_73f65ae7434e</core:exactMatch>
  <core:prefLabel xml:lang="en">AdditiveManufacturing</core:prefLabel>
  <emmo:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">process of joining materials to make parts from 3D model data, usually layer upon layer, as opposed to subtractive manufacturing (3.1.29) and formative manufacturing methodologies,</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ElectricCurrentUnit">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

<owl:Class rdf:about="https://w3id.org/emmo#MathematicalOperator">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MathematicalSymbol"/>
  <rdfs:label xml:lang="en">MathematicalOperator</rdfs:label>
  <rdfs:comment xml:lang="en">A mapping that acts on elements of one space and produces elements of another space.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f6d0c26a_98b6_4cf8_8632_aa259131faaa</core:exactMatch>
  <core:example xml:lang="en">The algebraic operator '+' that acts on two real numbers and produces one real number.</core:example>
  <core:example xml:lang="en">The differential operator that acts on a C1 real function and produces another real function.</core:example>
  <core:prefLabel xml:lang="en">MathematicalOperator</core:prefLabel>
  <emmo:elucidation xml:lang="en">A mapping that acts on elements of one space and produces elements of another space.</emmo:elucidation>
</owl:Class>


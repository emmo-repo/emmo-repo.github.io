  <rdfs:label xml:lang="en">hasJunctionPart</rdfs:label>
  <rdfs:comment xml:lang="en">The part is connected with the rest item or members with both hasNext (or its inverse) and hasContact relations.</rdfs:comment>
  <core:altLabel xml:lang="en">hasSpatioTemporalPart</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_408a46b2_3930_46da_b936_e9ce72ffdde9</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasJunctionPart</core:exactMatch>
  <core:prefLabel xml:lang="en">hasJunctionPart</core:prefLabel>
  <emmo:elucidation xml:lang="en">The part is connected with the rest item or members with both hasNext (or its inverse) and hasContact relations.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#isJunctionPartOf">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>

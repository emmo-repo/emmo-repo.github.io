  <emmo:OWLRL2DLAxioms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disjointUnionOf: Becquerel, Coulomb, DegreeCelsius, Farad, Gray, Henry, Hertz, Joule, Katal, Lumen, Lux, Newton, Ohm, Pascal, Radian, Siemens, Sievert, Steradian, Tesla, Volt, Watt, Weber</emmo:OWLRL2DLAxioms>
  <emmo:elucidation xml:lang="en">The 22 derived units that are given a special name in the SI system that stands for units derived by SI base units.</emmo:elucidation>
  <emmo:note xml:lang="en">These units are SI coherent by definition.</emmo:note>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/International_System_of_Units#Derived_units</emmo:wikipediaReference>
</owl:Class>


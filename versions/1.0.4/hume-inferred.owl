<owl:Class rdf:about="https://w3id.org/emmo#RelativeHumidity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#RatioQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ThermodynamicalQuantity"/>
  <owl:disjointWith rdf:resource="https://w3id.org/emmo#RelativeMassConcentrationOfWaterVapour"/>
  <rdfs:label xml:lang="en">RelativeHumidity</rdfs:label>
  <rdfs:comment xml:lang="en">Ratio of the partial pressure p of water vapour in moist air to its partial pressure psat at saturation, at the same temperature φ = p/psat.</rdfs:comment>
  <rdfs:comment xml:lang="en">The relative humidity is often expressed in per cent.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_62273272_4cec_4168_bc7b_448f57feaba6</core:exactMatch>
  <core:prefLabel xml:lang="en">RelativeHumidity</core:prefLabel>
  <emmo:IEVReference xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-65</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-33</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Ratio of the partial pressure p of water vapour in moist air to its partial pressure psat at saturation, at the same temperature φ = p/psat.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/RelativeHumidity</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q2499617</emmo:wikidataReference>
  <emmo:wikipediaReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Humidity#Relative_humidity</emmo:wikipediaReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#RelativeMassConcentrationOfWaterVapour">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#RatioQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ThermodynamicalQuantity"/>
  <rdfs:label xml:lang="en">RelativeMassConcentrationOfWaterVapour</rdfs:label>
  <rdfs:comment xml:lang="en">For normal cases, the relative humidity may be assumed to be equal to relative mass concentration of vapour.</rdfs:comment>
  <rdfs:comment xml:lang="en">Ratio of the mass concentration of water vapour v to its mass concentration at saturation vsat, at the same temperature, thus ψ = v/vsat.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_c106f318_38b1_4261_94cc_f4ac6ccc47af</core:exactMatch>
  <core:prefLabel xml:lang="en">RelativeMassConcentrationOfWaterVapour</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-66</emmo:IEVReference>
  <emmo:elucidation xml:lang="en">Ratio of the mass concentration of water vapour v to its mass concentration at saturation vsat, at the same temperature, thus ψ = v/vsat.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/RelativeMassConcentrationOfVapour</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q76379357</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#RelaxationTime">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatterPhysicsQuantity"/>

  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#interprets</core:exactMatch>
  <core:prefLabel xml:lang="en">interprets</core:prefLabel>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#isPartOf">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#hasPart"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#overlaps"/>
  <rdfs:label xml:lang="en">isPartOf</rdfs:label>
  <rdfs:comment xml:lang="en">Reflexivity: Pxx
Transitivity: (Pxy ∧ Pyz) → Pxz
Antisymmetry: (Pxy ∧ Pyx) → x=y.</rdfs:comment>
  <rdfs:comment xml:lang="en">The inverse relation of hasPart.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#isPartOf</core:exactMatch>
  <core:prefLabel xml:lang="en">isPartOf</core:prefLabel>
  <emmo:definition xml:lang="en">Reflexivity: Pxx
Transitivity: (Pxy ∧ Pyz) → Pxz
Antisymmetry: (Pxy ∧ Pyx) → x=y.</emmo:definition>
  <emmo:elucidation xml:lang="en">The inverse relation of hasPart.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#hasComponent">

  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_608a1b30_df6f_4bbb_9dc3_5c0de92fd9cf</core:exactMatch>
  <core:prefLabel xml:lang="en">ReciprocalLengthUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">The class of units with dimensionality 'ReciprocalLength'.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#AmountFraction">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ChemicalCompositionQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Intensive"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#RatioQuantity"/>
  <rdfs:label xml:lang="en">AmountFraction</rdfs:label>
  <rdfs:comment xml:lang="en">The amount of a constituent divided by the total amount of all constituents in a mixture.</rdfs:comment>
  <core:altLabel xml:lang="en">MoleFraction</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_04b3300c_98bd_42dc_a3b5_e6c29d69f1ac</core:exactMatch>
  <core:prefLabel xml:lang="en">AmountFraction</core:prefLabel>
  <emmo:elucidation xml:lang="en">The amount of a constituent divided by the total amount of all constituents in a mixture.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.A00296</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/MoleFraction</emmo:qudtReference>
</owl:Class>


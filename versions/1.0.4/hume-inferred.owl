<owl:Class rdf:about="https://w3id.org/emmo#PrincipalQuantumNumber">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#QuantumNumber"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PrincipalQuantumNumber</rdfs:label>
  <rdfs:comment xml:lang="en">Atomic quantum number related to the number n−1 of radial nodes of one-electron wave functions.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_385de036_637c_48fa_b6d5_5dca6f79d350</core:exactMatch>
  <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PrincipalQuantumNumber</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-13.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Atomic quantum number related to the number n−1 of radial nodes of one-electron wave functions.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/PrincipalQuantumNumber</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q867448</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MagneticDipoleMoment">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#MagneticDipoleMomentUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">MagneticDipoleMoment</rdfs:label>
  <rdfs:comment xml:lang="en">For an atom or nucleus, this energy is quantized and can be written as:

    W = g μ M B

where g is the appropriate g factor, μ is mostly the Bohr magneton or nuclear magneton, M is magnetic quantum number, and B is magnitude of the magnetic flux density.

-- ISO 80000</rdfs:comment>
  <rdfs:comment xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</core:exactMatch>
  <core:prefLabel xml:lang="en">MagneticDipoleMoment</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-55</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-9.1</emmo:ISO80000Reference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-30</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://goldbook.iupac.org/terms/view/M03688</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/MagneticDipoleMoment</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#VonKlitzingConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectricResistance"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIExactConstant"/>
  <rdfs:label xml:lang="en">VonKlitzingConstant</rdfs:label>
  <rdfs:comment xml:lang="en">Resistance quantum.</rdfs:comment>
  <rdfs:comment xml:lang="en">The von Klitzing constant is defined as Planck constant divided by the square of the elementary charge.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_eb561764_276e_413d_a8cb_3a3154fd9bf8</core:exactMatch>
  <core:prefLabel xml:lang="en">VonKlitzingConstant</core:prefLabel>
  <emmo:definition xml:lang="en">The von Klitzing constant is defined as Planck constant divided by the square of the elementary charge.</emmo:definition>
  <emmo:elucidation xml:lang="en">Resistance quantum.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/constant/VonKlitzingConstant</emmo:qudtReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ElectricResistance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricResistanceUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">ElectricResistance</rdfs:label>
  <rdfs:comment xml:lang="en">Inverse of 'ElectricalConductance'.</rdfs:comment>
  <rdfs:comment xml:lang="en">Measure of the difficulty to pass an electric current through a material.</rdfs:comment>
  <core:altLabel xml:lang="en">Resistance</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_e88f75d6_9a17_4cfc_bdf7_43d7cea5a9a1</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricResistance</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-46</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Measure of the difficulty to pass an electric current through a material.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.E01936</emmo:iupacReference>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/Resistance</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q25358</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SIExactConstant">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ExactConstant"/>
  <rdfs:label xml:lang="en">SIExactConstant</rdfs:label>
  <rdfs:comment xml:lang="en">Physical constant that by definition (after the latest revision of the SI system that was enforsed May 2019) has a known exact numerical value when expressed in SI units.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_f2ca6dd0_0e5f_4392_a92d_cafdae6cfc95</core:exactMatch>
  <core:prefLabel xml:lang="en">SIExactConstant</core:prefLabel>
  <emmo:elucidation xml:lang="en">Physical constant that by definition (after the latest revision of the SI system that was enforsed May 2019) has a known exact numerical value when expressed in SI units.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#PhysicalBasedSimulationSoftware">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SimulationSoftware"/>
  <rdfs:label xml:lang="en">PhysicalBasedSimulationSoftware</rdfs:label>
  <rdfs:comment xml:lang="en">A computational application that uses a physical model to predict the behaviour of a system, providing a identifiable analogy with the original object.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8d4962d7_9608_44f7_a2f1_82a4bb173f4a</core:exactMatch>
  <core:prefLabel xml:lang="en">PhysicalBasedSimulationSoftware</core:prefLabel>
  <emmo:elucidation xml:lang="en">A computational application that uses a physical model to predict the behaviour of a system, providing a identifiable analogy with the original object.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SimulationSoftware">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ApplicationProgram"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#FunctionalIcon"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Information"/>
  <rdfs:label xml:lang="en">SimulationSoftware</rdfs:label>
  <rdfs:comment xml:lang="en">An application program aimed to functionally reproduce an object.</rdfs:comment>
  <core:altLabel xml:lang="en">SimulationApplication</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_8b66ada5_510c_44bd_a8d8_3c64d301a5e9</core:exactMatch>
  <core:example xml:lang="en">An application program that predicts the pressure drop of a fluid in a pipe segment is aimed to functionally reproduce the outcome of a measurement of pressure before and after the segment.</core:example>
  <core:prefLabel xml:lang="en">SimulationSoftware</core:prefLabel>
  <emmo:elucidation xml:lang="en">An application program aimed to functionally reproduce an object.</emmo:elucidation>
</owl:Class>


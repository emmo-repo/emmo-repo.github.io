<owl:Class rdf:about="https://w3id.org/emmo#Mathematical">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Language"/>
  <rdfs:label xml:lang="en">Mathematical</rdfs:label>
  <rdfs:comment xml:lang="en">The class of general mathematical symbolic objects respecting mathematical syntactic rules.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0</core:exactMatch>
  <core:prefLabel xml:lang="en">Mathematical</core:prefLabel>
  <emmo:elucidation xml:lang="en">The class of general mathematical symbolic objects respecting mathematical syntactic rules.</emmo:elucidation>
  <emmo:note xml:lang="en">A mathematical object in this branch is not representing a concept but an actual graphical object built using mathematcal symbols arranged in some way, according to math conventions.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Variable">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

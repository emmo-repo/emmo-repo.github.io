  <rdfs:domain rdf:resource="https://w3id.org/emmo#MeasurementUnit"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#metrologicalReference"/>
  <rdfs:label xml:lang="en">ucumCode</rdfs:label>
  <rdfs:comment xml:lang="en">Unified Code for Units of Measure (UCUM).</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ucum.org/</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <core:changeNote xml:lang="en">Replaced by emmo:ucumCode</core:changeNote>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#ucumCode</core:exactMatch>
  <core:prefLabel xml:lang="en">ucumCode</core:prefLabel>
  <emmo:elucidation xml:lang="en">Unified Code for Units of Measure (UCUM).</emmo:elucidation>
  <emmo:note xml:lang="en">The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units.</emmo:note>
</owl:AnnotationProperty>


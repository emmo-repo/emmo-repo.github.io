<owl:Class rdf:about="https://w3id.org/emmo#Inequality">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MathematicalFormula"/>
  <rdfs:label xml:lang="en">Inequality</rdfs:label>
  <rdfs:comment xml:lang="en">A relation which makes a non-equal comparison between two numbers or other mathematical expressions.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_0b6ebe5a_0026_4bef_a1c1_5be00df9f98e</core:exactMatch>
  <core:example xml:lang="en">f(x) &gt; 0</core:example>
  <core:prefLabel xml:lang="en">Inequality</core:prefLabel>
  <emmo:elucidation xml:lang="en">A relation which makes a non-equal comparison between two numbers or other mathematical expressions.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MathematicalFormula">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/math#"/>

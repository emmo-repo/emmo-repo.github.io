<owl:Axiom>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#Procedure"/>
  <owl:annotatedTarget xml:lang="en">Procedure</owl:annotatedTarget>
  <emmo:etymology xml:lang="en">From Latin pro-cedere (“to go forward, to proceed”).</emmo:etymology>
</owl:Axiom>


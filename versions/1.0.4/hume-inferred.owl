<owl:Class rdf:about="https://w3id.org/emmo#Whole">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/persholistic#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasRole"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Role"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#QualifiedWhole"/>
  <rdfs:label xml:lang="en">Whole</rdfs:label>
  <rdfs:comment xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0</core:exactMatch>
  <core:prefLabel xml:lang="en">Whole</core:prefLabel>
  <emmo:elucidation xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</emmo:elucidation>
  <emmo:note xml:lang="en">A whole is always defined using a criterion expressed through the classical transitive parthood relation.
This class is expected to host the definition of world objects as they appear in its wholeness, dependently on some of their parts and independently on the surroundings.</emmo:note>
  <emmo:note xml:lang="en">A whole is categorized as fundamental (or maximal) or redundant (non-maximal).</emmo:note>
</owl:Class>


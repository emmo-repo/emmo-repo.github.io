    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasDimensionString"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T0 L0 M0 I+1 Θ0 N0 J0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIDimensionalUnit"/>
  <rdfs:label xml:lang="en">ElectricCurrentUnit</rdfs:label>
  <rdfs:comment xml:lang="en">The class of units with dimensionality 'ElectricCurrent'.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_d5f3e0e5_fc7d_4e64_86ad_555e74aaff84</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricCurrentUnit</core:prefLabel>
  <emmo:elucidation xml:lang="en">The class of units with dimensionality 'ElectricCurrent'.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#TaskTile">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Task"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Tile"/>
  <rdfs:label xml:lang="en">TaskTile</rdfs:label>
  <rdfs:comment xml:lang="en">A task that is a well formed tile of a workflow, according to a reductionistic description.</rdfs:comment>
  <rdfs:comment xml:lang="en">While a task is only an holistic part of a workflow, a task tile provide a more precise context about the placement of a task in the topological structure of a workflow by using a reductionistic categorization. A workflow is now seen as a tiling and the task is on of its tiles.</rdfs:comment>
  <core:altLabel xml:lang="en">Step</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9f6ec830_c59f_46aa_8a22_945ba20b6ea3</core:exactMatch>
  <core:prefLabel xml:lang="en">TaskTile</core:prefLabel>
  <emmo:conceptualisation xml:lang="en">While a task is only an holistic part of a workflow, a task tile provide a more precise context about the placement of a task in the topological structure of a workflow by using a reductionistic categorization. A workflow is now seen as a tiling and the task is on of its tiles.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">A task that is a well formed tile of a workflow, according to a reductionistic description.</emmo:elucidation>
  <emmo:note xml:lang="en">A task tile is part of a specific granularity level for the workflow description, as composition of tasks.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Task">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasTask"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Workflow"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Procedure"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Role"/>
  <rdfs:label xml:lang="en">Task</rdfs:label>
  <rdfs:comment xml:lang="en">A procedure that is an hoilistic part of a workflow.</rdfs:comment>
  <rdfs:comment xml:lang="en">The concept of task is developed in strict connection with the concept of workflow: a task is always part of a workflow and a workflow always possess some tasks. This makes the relation between task and workflow an holistic relation, with task as role and workflow as whole.
A task is also holistically connected to an intentional agent, since a task is defined as a procedure. For this reason a task is both a role, with respect to a workflow, and a whole, with respect to an intentional agent.</rdfs:comment>
  <core:altLabel xml:lang="en">Job</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4299e344_a321_4ef2_a744_bacfcce80afc</core:exactMatch>
  <core:prefLabel xml:lang="en">Task</core:prefLabel>
  <emmo:conceptualisation xml:lang="en">The concept of task is developed in strict connection with the concept of workflow: a task is always part of a workflow and a workflow always possess some tasks. This makes the relation between task and workflow an holistic relation, with task as role and workflow as whole.
A task is also holistically connected to an intentional agent, since a task is defined as a procedure. For this reason a task is both a role, with respect to a workflow, and a whole, with respect to an intentional agent.</emmo:conceptualisation>
  <emmo:elucidation xml:lang="en">A procedure that is an hoilistic part of a workflow.</emmo:elucidation>
  <emmo:note xml:lang="en">A task is a generic part of a workflow, without taking care of the task granularities.
It means that you can declare that e.g. tightening a bolt is a task of building an airplane, without caring of the coarser tasks to which this tightening belongs.</emmo:note>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#Tile">
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/emmo#hasTile"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Tessellation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Reductionistic"/>
  <rdfs:label xml:lang="en">Tile</rdfs:label>
  <rdfs:comment xml:lang="en">A causal object that is direct part of a tessellation.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_9953c19f_ee33_4af8_be5e_dbf6d1e33581</core:exactMatch>
  <core:prefLabel xml:lang="en">Tile</core:prefLabel>
  <emmo:elucidation xml:lang="en">A causal object that is direct part of a tessellation.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#ModulusOfAdmittance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectricConductance"/>
  <rdfs:label xml:lang="en">ModulusOfAdmittance</rdfs:label>
  <rdfs:comment xml:lang="en">quotient of the rms value of the electric current in a two-terminal element or a two-terminal circuit by the rms value of the voltage between its terminals.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5e26440d_af47_4c30_a1c3_511e4072c617</core:exactMatch>
  <core:prefLabel xml:lang="en">ModulusOfAdmittance</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-12-52</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-52.4</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">quotient of the rms value of the electric current in a two-terminal element or a two-terminal circuit by the rms value of the voltage between its terminals.</emmo:elucidation>
  <emmo:note xml:lang="en">Apparent admittance is often denoted by Y .</emmo:note>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/ModulusOfAdmittance</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q79466359</emmo:wikidataReference>
</owl:Class>


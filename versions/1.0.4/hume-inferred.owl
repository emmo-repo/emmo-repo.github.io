<owl:Class rdf:about="https://w3id.org/emmo#SourceCode">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ProgrammingLanguage"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Software"/>
  <rdfs:label xml:lang="en">SourceCode</rdfs:label>
  <rdfs:comment xml:lang="en">A programming language entity expressing a formal detailed plan of what a software is intended to do.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_348d39f7_6a17_49d1_9860_9b33b69b51de</core:exactMatch>
  <core:prefLabel xml:lang="en">SourceCode</core:prefLabel>
  <emmo:elucidation xml:lang="en">A programming language entity expressing a formal detailed plan of what a software is intended to do.</emmo:elucidation>
  <emmo:note xml:lang="en">A source code is the companion of an application, being it the entity used to generate the application list of CPU executable instructions.</emmo:note>
  <emmo:note xml:lang="en">Source code (also referred to as source or code) is the version of software as it is originally written (i.e., typed into a computer) by a human in plain text (i.e., human readable alphanumeric characters).</emmo:note>
</owl:Class>


  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-72.3</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Sum of the slowing-down area from fission energy to thermal energy and the diffusion area for thermal neutrons.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/MigrationArea</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q98966325</emmo:wikidataReference>
</owl:Class>


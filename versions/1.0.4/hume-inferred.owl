<owl:Class rdf:about="https://w3id.org/emmo#ElectricFluxDensity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#ElectricDisplacementFieldUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectromagneticQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">ElectricFluxDensity</rdfs:label>
  <rdfs:comment xml:lang="en">Vector quantity obtained at a given point by adding the electric polarization P to the product of the electric field strength E and the electric constant ε0.</rdfs:comment>
  <core:altLabel xml:lang="en">ElectricDisplacement</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_4ef8c0e4_1b0b_4699_a135_8c89ca289802</core:exactMatch>
  <core:prefLabel xml:lang="en">ElectricFluxDensity</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-40</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-12</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Vector quantity obtained at a given point by adding the electric polarization P to the product of the electric field strength E and the electric constant ε0.</emmo:elucidation>
  <emmo:qudtReference xml:lang="en">https://qudt.org/vocab/quantitykind/ElectricDisplacementField</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q371907</emmo:wikidataReference>
</owl:Class>


<owl:Class rdf:about="https://w3id.org/emmo#PhysicsEquationSolution">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/models#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Mathematical"/>
  <rdfs:label xml:lang="en">PhysicsEquationSolution</rdfs:label>
  <rdfs:comment xml:lang="en">A function solution of a physics equation that provides a methods for the prediction of some quantitiative properties of an object.</rdfs:comment>
  <rdfs:comment xml:lang="en">This must be a mathematical function v(t), x(t).
A dataset as solution is a conventional sign.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_6e0664f2_4d4d_4407_bf60_e1b3c07198d7</core:exactMatch>
  <core:example xml:lang="en">A parabolic function is a prediction of the trajectory of a falling object in a gravitational field. While it has predictive capabilities it lacks of an analogical character, since it does not show the law behind that trajectory.</core:example>
  <core:prefLabel xml:lang="en">PhysicsEquationSolution</core:prefLabel>
  <emmo:elucidation xml:lang="en">A function solution of a physics equation that provides a methods for the prediction of some quantitiative properties of an object.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#MutualInductance">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectricInductance"/>
  <rdfs:label xml:lang="en">MutualInductance</rdfs:label>
  <rdfs:comment xml:lang="en">Given an electric current in a thin conducting loop and the linked flux caused by that electric current in another loop, the mutual inductance of the two loops is the linked flux divided by the electric current.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_ea7ef02a_589c_4971_908d_dee6688eebda</core:exactMatch>
  <core:prefLabel xml:lang="en">MutualInductance</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-12-36</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-41.2</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Given an electric current in a thin conducting loop and the linked flux caused by that electric current in another loop, the mutual inductance of the two loops is the linked flux divided by the electric current.</emmo:elucidation>
  <emmo:iupacReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.M04076</emmo:iupacReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q78101401</emmo:wikidataReference>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#SpecificActivity">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasMeasurementUnit"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#PerTimeMassUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomicAndNuclearPhysicsQuantity"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ISQDerivedQuantity"/>
  <rdfs:label xml:lang="en">SpecificActivity</rdfs:label>
  <rdfs:comment xml:lang="en">Quotient of the activity A of a sample and the mass m of that sample.</rdfs:comment>
  <core:altLabel xml:lang="en">MassicActivity</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_5adcbbb9_4325_4c23_ac50_62c77569e9c4</core:exactMatch>
  <core:prefLabel xml:lang="en">SpecificActivity</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=395-01-08</emmo:IEVReference>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=881-04-43</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-28</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Quotient of the activity A of a sample and the mass m of that sample.</emmo:elucidation>

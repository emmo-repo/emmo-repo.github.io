<owl:Class rdf:about="https://w3id.org/emmo#Fluid">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#StateOfMatter"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/emmo#Gas"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/emmo#Plasma"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/emmo#Liquid"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdfs:label xml:lang="en">Fluid</rdfs:label>
  <rdfs:comment xml:lang="en">A continuum that has no fixed shape and yields easily to external pressure.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8</core:exactMatch>
  <core:example xml:lang="en">Gas, liquid, plasma,</core:example>
  <core:prefLabel xml:lang="en">Fluid</core:prefLabel>
  <emmo:elucidation xml:lang="en">A continuum that has no fixed shape and yields easily to external pressure.</emmo:elucidation>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/emmo#TinAtom">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/periodictable#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf>
    <owl:Restriction>

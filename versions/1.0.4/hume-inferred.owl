  <rdfs:comment xml:lang="en">The abstract notion of angle.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_930ce8d9_6cde_4ef9_9cb2_a98a63852b96</core:exactMatch>
  <core:prefLabel xml:lang="en">AngularMeasure</core:prefLabel>
  <emmo:IEVReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=102-04-14</emmo:IEVReference>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-5</emmo:ISO80000Reference>

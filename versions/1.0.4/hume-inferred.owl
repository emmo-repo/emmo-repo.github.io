  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/emmo#hasDimensionString"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T-2 L+2 M+1 I0 Θ0 N-1 J0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#SIDimensionalUnit"/>

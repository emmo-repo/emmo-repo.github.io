<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#EMMO_ea67144c_56fd_4312_a4f4_af78edd5eacc">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#dataValue"/>
  <rdfs:label xml:lang="en">quantityValue</rdfs:label>
  <core:altLabel xml:lang="en">measuredQuantityValue</core:altLabel>
  <core:altLabel xml:lang="en">measuredValue</core:altLabel>
  <emmo:VIMTerm xml:lang="en">VIM4: 2.11 measured value of a quantity</emmo:VIMTerm>
  <emmo:note xml:lang="en">In VIM, dataValue correspond to "measured value" which is defined as a "value of a quantity representing a measurement result".</emmo:note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#dataValue">
  <rdfs:domain rdf:resource="https://w3id.org/emmo#SymbolicData"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/symbolic#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:label xml:lang="en">dataValue</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The owl:dataProperty that provides a serialisation of an EMMO data entity.</rdfs:comment>
  <core:altLabel xml:lang="en">hasDataValue</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_b6292331_94af_4f00_976b_ea55960c2f1c</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#dataValue</core:exactMatch>
  <core:prefLabel xml:lang="en">dataValue</core:prefLabel>
  <emmo:elucidation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The owl:dataProperty that provides a serialisation of an EMMO data entity.</emmo:elucidation>
  <emmo:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the superproperty of all data properties used to serialise a fundamental data type in the EMMO Data perspective. An entity can have only one data value expressing its serialisation (e.g. a Real entity cannot have two different real values).</emmo:note>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://w3id.org/emmo#hasDimensionString">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/sidimensionalunits#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>

<owl:Axiom>
  <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#definition"/>
  <owl:annotatedSource rdf:resource="https://w3id.org/emmo#universe"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u ≡ σx⟨P(x, x)⟩</owl:annotatedTarget>
  <emmo:note xml:lang="en">This definition reads: "The universe is the sum of all entities that are part of themselves". Since parthood (P) is reflexive by axiom, then the universe is the sum of all mereological entities.</emmo:note>
</owl:Axiom>


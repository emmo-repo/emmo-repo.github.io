  <rdfs:comment xml:lang="en">Relates an object to one of its constitutive process parts that contributes to the object under some spatial-based criteria.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_e3850f08_8e79_454b_9d83_c517cab42857</core:exactMatch>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#hasConstitutiveProcess</core:exactMatch>
  <core:prefLabel xml:lang="en">hasConstitutiveProcess</core:prefLabel>
  <emmo:elucidation xml:lang="en">Relates an object to one of its constitutive process parts that contributes to the object under some spatial-based criteria.</emmo:elucidation>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/emmo#interprets">

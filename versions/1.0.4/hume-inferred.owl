  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verfestigungsstrahlen</core:altLabel>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_dc0874e8_36e1_44df_947d_0d7c81167a09</core:exactMatch>

<owl:Class rdf:about="https://w3id.org/emmo#DebyeAngularFrequency">
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  <rdfs:isDefinedBy rdf:resource="#"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AngularFrequency"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#CondensedMatterPhysicsQuantity"/>
  <rdfs:label xml:lang="en">DebyeAngularFrequency</rdfs:label>
  <rdfs:comment xml:lang="en">Cut-off angular frequency in the Debye model of the vibrational spectrum of a solid.</rdfs:comment>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#EMMO_65ec122c_b67f_4009_8b16_2df7dfae118a</core:exactMatch>
  <core:prefLabel xml:lang="en">DebyeAngularFrequency</core:prefLabel>
  <emmo:ISO80000Reference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-10</emmo:ISO80000Reference>
  <emmo:elucidation xml:lang="en">Cut-off angular frequency in the Debye model of the vibrational spectrum of a solid.</emmo:elucidation>
  <emmo:qudtReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/DebyeAngularFrequency</emmo:qudtReference>
  <emmo:wikidataReference rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q105580986</emmo:wikidataReference>
</owl:Class>


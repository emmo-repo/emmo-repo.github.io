  <owl:onProperty rdf:resource="https://w3id.org/emmo#dataValue"/>
  <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#negativeInteger"/>
</owl:Restriction>

<owl:Restriction>
